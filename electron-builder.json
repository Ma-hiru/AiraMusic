{
  "$schema": "docs/schema/electron-builder.schema.json",
  "appId": "com.mahiru.airamusic",
  "productName": "AiraMusic",
  "directories": {
    "app": "packages/app",
    "output": "dist"
  },
  "files": ["dist/**/*", "package.json"],
  "extraResources": [
    {
      "from": "packages/ui/dist",
      "to": "ui"
    },
    {
      "from": "packages/app/dist/preload/index.js",
      "to": "preload.js"
    },
    {
      "from": "packages/app/assets",
      "to": "assets"
    },
    {
      "from": "packages/app/cert",
      "to": "cert"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "icon": "packages/app/assets/logo.png",
    "category": "AudioVideo",
    "vendor": "Ma-hiru",
    "description": "A third party music player for Netease Music",
    "artifactName": "${productName}_${version}_linux_${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "AiraMusic",
        "Comment": "A third-party music player for Netease Music",
        "Categories": "AudioVideo;Audio;",
        "Keywords": "music;audio;player;netease;"
      }
    },
    "extraResources": [
      {
        "from": "packages/store/dist/aira-music-cache",
        "to": "bin/aira-music-cache"
      },
      {
        "from": "packages/native/index.node",
        "to": "native/index.node"
      },
      {
        "from": "packages/agent/agent",
        "to": "bin/agent"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "icon": "packages/app/assets/logo.png",
    "category": "public.app-category.music",
    "artifactName": "${productName}_${version}_mac_${arch}.${ext}",
    "identity": "-",
    "hardenedRuntime": false,
    "notarize": false,
    "extraResources": [
      {
        "from": "packages/store/dist/aira-music-cache",
        "to": "bin/aira-music-cache"
      },
      {
        "from": "packages/native/index.node",
        "to": "native/index.node"
      },
      {
        "from": "packages/agent/agent",
        "to": "bin/agent"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "icon": "packages/app/assets/logo.png",
    "artifactName": "${productName}_${version}_win_${arch}.${ext}",
    "extraResources": [
      {
        "from": "packages/store/dist/aira-music-cache.exe",
        "to": "bin/aira-music-cache.exe"
      },
      {
        "from": "packages/native/index.node",
        "to": "native/index.node"
      },
      {
        "from": "packages/agent/agent.exe",
        "to": "bin/agent.exe"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "runAfterFinish": false
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "runAfterFinish": false
  },
  "deb": {
    "packageCategory": "sound",
    "priority": "optional",
    "compression": "xz"
  },
  "rpm": {
    "packageCategory": "Applications/Multimedia",
    "compression": "xz"
  },
  "dmg": {
    "title": "${productName} ${version}",
    "backgroundColor": "#ffffff",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 130,
        "y": 220,
        "type": "file"
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "iconSize": 80,
    "iconTextSize": 12,
    "format": "UDZO",
    "sign": false
  }
}
