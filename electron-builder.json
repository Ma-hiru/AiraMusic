{
  "appId": "com.mahiru.airamusic",
  "productName": "AiraMusic",
  "directories": {
    "app": "packages/app",
    "output": "dist"
  },
  "files": ["dist/**/*", "package.json"],
  "extraResources": [
    {
      "from": "packages/ui/dist",
      "to": "ui"
    },
    {
      "from": "packages/app/dist/preload/index.js",
      "to": "preload.js"
    },
    {
      "from": "packages/app/assets",
      "to": "assets"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "icon": "packages/app/assets/logo.png",
    "category": "Audio",
    "description": "A third party music player for Netease Music",
    "artifactName": "${name}_${version}_linux_${arch}.${ext}",
    "extraResources": [
      {
        "from": "packages/store/dist/aira-music-cache",
        "to": "bin/aira-music-cache"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "icon": "packages/app/assets/logo.png",
    "artifactName": "${name}_${version}_win_${arch}.${ext}",
    "extraResources": [
      {
        "from": "packages/store/dist/aira-music-cache.exe",
        "to": "bin/aira-music-cache.exe"
      },
      {
        "from": "packages/native/index.node",
        "to": "native/index.node"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "runAfterFinish": false
  },
  "msi": {
    "oneClick": false,
    "perMachine": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "runAfterFinish": false
  },
  "deb": {
    "packageCategory": "sound",
    "priority": "optional",
    "compression": "xz"
  },
  "rpm": {
    "packageCategory": "Applications/Audio",
    "compression": "xz"
  },
  "appImage": {}
}
