{
  "name": "@mahiru/agent",
  "type": "module",
  "version": "1.0.0",
  "types": "dist/index.d.ts",
  "main": "index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./browser.ts",
      "default": "./browser.ts"
    }
  },
  "files": [
    "agent",
    "agent.exe",
    "dist",
    "generated",
    "browser.ts",
    "index.ts"
  ],
  "scripts": {
    "build": "cargo build --release && cargo test --lib && yarn run -T rimraf dist && yarn run -T tsgo -b && yarn run -T tsx scripts/copy.ts",
    "clean:dist": "yarn run -T rimraf dist agent agent.exe generated",
    "clean:cargo": "cargo clean",
    "lint": "cargo fmt && cargo clippy --all-targets -- -D warnings",
    "lint:check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "test": "cargo test && yarn run -T vitest run",
    "test:ui": "yarn run -T vitest --ui",
    "test:rust": "cargo test"
  }
}
