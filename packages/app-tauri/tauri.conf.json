{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiraMusic-tauri-experimental",
  "version": "1.4.0",
  "identifier": "com.mahiru.airamusic",
  "build": {
    "devUrl": "http://localhost:8827",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Experimental Tauri build of AiraMusic",
    "longDescription": "Experimental Tauri build of AiraMusic, a third-party Netease Music desktop client with immersive visuals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
