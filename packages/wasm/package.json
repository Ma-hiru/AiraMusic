{
  "name": "@mahiru/wasm",
  "type": "module",
  "version": "1.0.0",
  "files": [
    "pkg/*.wasm",
    "pkg/*.js",
    "pkg/*.d.ts"
  ],
  "main": "pkg/wasm.js",
  "types": "pkg/wasm.d.ts",
  "sideEffects": [
    "./pkg/wasm.js",
    "./pkg/snippets/*"
  ],
  "scripts": {
    "clean:cargo": "cargo clean",
    "clean:dist": "rimraf pkg",
    "build": "wasm-pack build --target web --out-dir pkg --release && rimraf pkg/package.json",
    "lint": "cargo fmt && cargo clippy --all-targets -- -D warnings",
    "test": "cargo test"
  }
}
