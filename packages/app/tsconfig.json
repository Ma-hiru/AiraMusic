{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "paths": {
      "@/*": ["./src/*"]
    },
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "references": [
    { "path": "../log/tsconfig.json" },
    { "path": "../store/tsconfig.json" },
    { "path": "../ipc/tsconfig.json" },
    { "path": "../native/tsconfig.json" },
    { "path": "../agent/tsconfig.json" }
  ],
  "include": ["src/**/*", "../../types/**/*"]
}
