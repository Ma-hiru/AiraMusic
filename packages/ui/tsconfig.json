{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.buildinfo",
    "noEmit": true,
    "paths": {
      "@mahiru/ui/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "../log/tsconfig.json" },
    { "path": "../message/tsconfig.json" },
    { "path": "../wasm/tsconfig.json" }
  ],
  "include": ["src/**/*", "../../types/**/*"]
}
