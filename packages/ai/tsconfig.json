{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "types": ["vitest/globals", "node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-types",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../log/tsconfig.json" }],
  "include": ["../../types/**/*", "src/**/*", "tests/**/*"]
}
