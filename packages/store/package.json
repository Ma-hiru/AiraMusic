{
  "name": "@mahiru/store",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*",
    "index.ts"
  ],
  "scripts": {
    "clean:go": "go clean --cache",
    "clean:dist": "rimraf dist",
    "build": "run-script-os",
    "build:win32": "set \"CGO_ENABLED=0\" && go build -trimpath -ldflags \"-s -w -buildid=\" -o ./dist/aira-music-cache.exe -v main.go",
    "build:linux": "CGO_ENABLED=0 && go build -trimpath -ldflags \"-s -w -buildid=\" -o ./dist/aira-music-cache -v main.go",
    "build:darwin": "CGO_ENABLED=0 go build -trimpath -ldflags \"-s -w -buildid=\" -o ./dist/aira-music-cache -v main.go",
    "lint": "run-script-os",
    "lint:darwin": "go fmt ./... && go vet ./... && (command -v golangci-lint >/dev/null && golangci-lint run --fix || echo 'skip golangci-lint')",
    "lint:linux": "go fmt ./... && go vet ./... && (command -v golangci-lint >/dev/null && golangci-lint run --fix || echo 'skip golangci-lint')",
    "lint:win32": "go fmt ./... && go vet ./... && (where golangci-lint && golangci-lint run --fix || echo 'skip golangci-lint')",
    "lint:check": "run-script-os",
    "lint:check:darwin": "gofmt -l . | grep . && exit 1 || go vet ./...",
    "lint:check:linux": "gofmt -l . | grep . && exit 1 || go vet ./...",
    "lint:check:win32": "gofmt -l . | findstr . && exit 1 || go vet ./...",
    "test": "go test ./..."
  },
  "devDependencies": {
    "run-script-os": "^1.1.6"
  }
}
