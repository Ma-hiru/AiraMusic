{
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Ma-hiru/AiraMusic",
  "author": {
    "name": "Ma-hiru",
    "email": "tenshimahiru@qq.com",
    "github": "https://github.com/Ma-hiru"
  },
  "keywords": [
    "music",
    "player",
    "electron",
    "netease",
    "react",
    "网易云",
    "galss",
    "dynamic-theme"
  ],
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "build": "yarn build:bin && yarn build:desktop",
    "build:bin": "yarn npm-run-all --parallel build:wasm build:native build:store build:agent",
    "build:desktop": "yarn npm-run-all --parallel build:ui build:app && yarn build:electron",
    "build:ui": "yarn workspace @mahiru/ui build",
    "build:app": "yarn tsx ./scripts/version.ts && yarn workspace aira-music build",
    "build:wasm": "yarn workspace @mahiru/wasm build",
    "build:native": "yarn workspace @mahiru/native build",
    "build:store": "yarn workspace @mahiru/store build",
    "build:agent": "yarn workspace @mahiru/agent build",
    "build:electron": "yarn run-script-os",
    "build:electron:linux": "yarn electron-builder build --linux --publish never",
    "build:electron:win32": "yarn electron-builder build --win --publish never",
    "build:electron:darwin": "yarn electron-builder build --mac --publish never",
    "dev": "yarn npm-run-all --parallel --race dev:ui dev:app dev:electron",
    "dev:ui": "yarn workspace @mahiru/ui dev",
    "dev:app": "yarn workspace aira-music dev",
    "dev:electron": "yarn wait-on tcp:8827 && yarn wait-on packages/app/dist/app/main.mjs && yarn electronmon ./packages/app --inspect=9229",
    "devtools": "yarn react-devtools",
    "clean": "yarn npm-run-all --parallel clean:vite clean:cargo clean:go clean:dist",
    "clean:dist": "yarn rimraf dist && yarn workspace @mahiru/wasm clean:dist && yarn workspace @mahiru/native clean:dist && yarn workspace @mahiru/store clean:dist && yarn workspace @mahiru/agent clean:dist && yarn workspace @mahiru/ui clean:dist && yarn workspace aira-music clean:dist",
    "clean:vite": "yarn rimraf ./packages/ui/node_modules/.vite",
    "clean:cargo": "yarn workspace @mahiru/wasm clean:cargo && yarn workspace @mahiru/native clean:cargo && yarn workspace @mahiru/agent clean:cargo",
    "clean:go": "yarn workspace @mahiru/store clean:go",
    "preview:ui": "yarn workspace @mahiru/ui preview",
    "generate:cert": "bash scripts/generate-localhost-cert.sh",
    "check": "yarn tsgo -b --force --verbose --extendedDiagnostics",
    "check:fast": "yarn tsgo -b",
    "lint": "yarn npm-run-all --parallel lint:ts lint:wasm lint:native lint:store lint:agent",
    "lint:ts": "yarn eslint . --fix && yarn prettier --write .",
    "lint:wasm": "yarn workspace @mahiru/wasm lint",
    "lint:native": "yarn workspace @mahiru/native lint",
    "lint:store": "yarn workspace @mahiru/store lint",
    "lint:agent": "yarn workspace @mahiru/agent lint",
    "lint:check": "yarn npm-run-all --parallel lint:check:ts lint:check:wasm lint:check:native lint:check:store lint:check:agent",
    "lint:check:ts": "yarn prettier --check . && yarn eslint .",
    "lint:check:wasm": "yarn workspace @mahiru/wasm lint:check",
    "lint:check:native": "yarn workspace @mahiru/native lint:check",
    "lint:check:store": "yarn workspace @mahiru/store lint:check",
    "lint:check:agent": "yarn workspace @mahiru/agent lint:check",
    "test": "yarn npm-run-all --parallel test:ts test:wasm test:store test:agent",
    "test:ts": "yarn vitest run",
    "test:ts:ui": "yarn vitest --ui --coverage",
    "test:wasm": "yarn workspace @mahiru/wasm test",
    "test:store": "yarn workspace @mahiru/store test",
    "test:agent": "yarn workspace @mahiru/agent test:rust",
    "push-check": "yarn npm-run-all --parallel check lint test",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "latest",
    "react-devtools": "^7.0.1",
    "rimraf": "^6.1.0",
    "run-script-os": "^1.1.6",
    "sharp": "^0.35.5",
    "tsdown": "^0.23.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "unrun": "^0.3.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "electronmon": {
    "patterns": [
      "!**/*",
      "./packages/app/dist/**/*"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
