<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja-JP"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="group" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><amll:meta key="ncmMusicId" value="41643530"/><amll:meta key="appleMusicId" value="1538280987"/><amll:meta key="musicName" value="夜空。"/><amll:meta key="artists" value="miwa"/><amll:meta key="album" value="miwa ballad collection 〜graduation〜"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:22.885" end="00:23.974">sayo</span><span begin="00:23.974" end="00:24.999">nara</span><span begin="00:25.138" end="00:26.617">itoshi</span><span begin="00:26.617" end="00:28.764">kihitoyo</span></text><text for="L2"><span begin="00:28.955" end="00:29.789">mo</span><span begin="00:29.789" end="00:30.807">unidotoae</span><span begin="00:30.890" end="00:32.222">nai</span></text><text for="L3"><span begin="00:32.332" end="00:32.742">nai</span><span begin="00:32.742" end="00:33.933">soukimeta</span><span begin="00:33.933" end="00:34.649">noni</span></text><text for="L4"><span begin="00:34.830" end="00:36.097">doushi</span><span begin="00:36.256" end="00:37.530">tedoushite</span></text><text for="L5"><span begin="00:37.540" end="00:37.871"></span><span begin="00:37.871" end="00:38.202">a</span><span begin="00:38.202" end="00:39.703">natawowasurerarenai</span><span begin="00:39.703" end="00:41.306">ndarou</span></text><text for="L6"><span begin="00:41.586" end="00:42.389">kyou</span><span begin="00:42.389" end="00:43.631">moyozora</span></text><text for="L8"><span begin="00:58.800" end="00:59.365">do</span><span begin="00:59.365" e