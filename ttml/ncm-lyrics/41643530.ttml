03:34.926" end="03:36.309">ka</span></text><text for="L45"><span begin="03:35.498" end="03:38.268">anatawaanatade</span><span begin="03:38.268" end="03:39.653">irarete</span><span begin="03:39.653" end="03:40.555">ima</span><span begin="03:40.555" end="03:42.329">suka</span></text><text for="L46"><span begin="03:41.062" end="03:43.913">kimiwakimirashi</span><span begin="03:43.913" end="03:46.196">kuirareteima</span><span begin="03:46.196" end="03:47.222">suka</span></text><text for="L47"><span begin="03:46.667" end="03:47.347">watashi</span><span begin="03:47.347" end="03:48.064">waana</span><span begin="03:48.064" end="03:48.950">tawotado't</span><span begin="03:48.950" end="03:49.836">teimashi</span></text><text for="L48"><span begin="03:50.046" end="03:51.091">ikidoma</span><span begin="03:51.091" end="03:52.136">rinomainichi</span></text><text for="L49"><span begin="03:52.145" end="03:54.396">mayoikondama</span><span begin="03:54.584" end="03:55.200">mamae</span><span begin="03:55.200" end="03:56.572">nisusume</span><span begin="03:56.572" end="03:57.797">zuni</span></text><text for="L50"><span begin="03:58.022" end="03:58.611">ore</span><span begin="03:58.611" end="03:59.496">mokiminoko</span><span begin="03:59.496" end="04:00.381">toomo't</span><span begin="04:00.381" end="04:01.265">teimashi</span></text><text for="L51"><span begin="04:01.640" end="04:02.345">konya</span><span begin="04:02.345" end="04:03.765">moanokoronoma</span><span begin="04:03.765" end="04:04.982">manofutari</span></text><text for="L52"><span begin="04:04.991" end="04:06.108">i'sshonii</span><span begin="04:06.108" end="04:06.775">tajikan</span></text><text for="L53"><span begin="04:06.785" end="04:07.511">nan</span><span begin="04:07.511" end="04:08.822">domoatamanonaka</span><span begin="04:08.822" end="04:09.819">dekurikaesa</span><span begin="04:09.819" end="04:12.501">reru</span></text><text for="L54"><span begin="04:20.027" end="04:21.116">sayo</span><span begin="04:21.116" end="04:22.141">nara</span><span begin="04:22.280" end="04:23.759">itoshi</span><span begin="04:23.759" end="04:25.906">kihitoyo</span></text><text for="L55"><span begin="04:26.124" end="04:26.958">mou</span><span begin="04:26.958" end="04:27.976">nidotoaena</span><span begin="04:28.059" end="04:29.391">i</span></text><text for="L56"><span begin="04:29.465" end="04:29.875">iso</span><span begin="04:29.875" end="04:31.066">ukimeta</span><span begin="04:31.066" end="04:31.782">noni</span></text><text for="L57"><span begin="04:31.924" end="04:33.191">doushi</span><span begin="04:33.350" end="04:34.624">tedoushite</span></text><text for="L58"><span begin="04:34.731" end="04:35.414">ana</span><span begin="04:35.414" end="04:36.859">tawowasurerarenai</span><span begin="04:36.859" end="04:38.575">ndarou</span></text><text for="L59"><span begin="04:38.770" end="04:39.573">kyoumo</span><span begin="04:39.573" end="04:40.902">yozorani</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="05:11.573"><div begin="00:22.885" end="04:44.315"><p begin="00:22.885" end="00:28.764" ttm:agent="v3" itunes:key="L1"><span begin="00:22.885" end="00:23.974">さよな</span><span begin="00:23.974" end="00:24.999">ら</span> <span begin="00:25.138" end="00:26.617">愛しき</span><span begin="00:26.617" end="00:28.764">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="00:28.955" end="00:32.222" ttm:agent="v3" itunes:key="L2"><span begin="00:28.955" end="00:29.789">もう二度と</span><span begin="00:29.789" end="00:30.807">会えない</span> <span begin="00:30.890" end="00:32.222">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="00:32.332" end="00:34.649" ttm:agent="v3" itunes:key="L3"><span begin="00:32.332" end="00:32.742">そう</span><span begin="00:32.742" end="00:33.933">決めたの</span><span begin="00:33.933" end="00:34.649">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明决定不再见你</span></p><p begin="00:34.830" end="00:37.530" ttm:agent="v3" itunes:key="L4"><span begin="00:34.830" end="00:36.097">どうして</span> <span begin="00:36.256" end="00:37.530">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="00:37.540" end="00:41.306" ttm:agent="v3" itunes:key="L5"><span begin="00:37.540" end="00:37.871">あなた</span><span begin="00:37.871" end="00:38.202">を</span> <span begin="00:38.202" end="00:39.703">忘れられないん</span><span begin="00:39.703" end="00:41.306">だろう？</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="00:41.586" end="00:43.631" ttm:agent="v3" itunes:key="L6"><span begin="00:41.586" end="00:42.389">今日も</span><span begin="00:42.389" end="00:43.631">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="00:43.727" end="00:47.144" ttm:agent="v3" itunes:key="L7"><span begin="00:43.727" end="00:45.106">ネガウ</span> <span begin="00:45.106" end="00:45.921">アイ</span><span begin="00:45.921" end="00:47.144">タイ</span></p><p begin="00:58.800" end="01:02.364" ttm:agent="v3" itunes:key="L8"><span begin="00:58.800" end="00:59.365">どう</span><span begin="00:59.365" end="01:00.244">して</span> <span begin="01:00.244" end="01:01.238">あなた</span><span begin="01:01.238" end="01:02.364">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么我</span></p><p begin="01:03.374" end="01:07.800" ttm:agent="v3" itunes:key="L9"><span begin="01:03.374" end="01:03.974">好きに</span><span begin="01:03.974" end="01:05.136">なって</span><span begin="01:05.136" end="01:06.521">しまったん</span><span begin="01:06.521" end="01:07.800">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">会喜欢上你呢</span></p><p begin="01:10.243" end="01:14.769" ttm:agent="v3" itunes:key="L10"><span begin="01:10.243" end="01:11.580">出会った</span> <span begin="01:11.580" end="01:12.311">その</span><span begin="01:12.311" end="01:13.776">瞬間か</span><span begin="01:13.776" end="01:14.769">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">在相遇的那个瞬间</span></p><p begin="01:15.262" end="01:19.797" ttm:agent="v3" itunes:key="L11"><span begin="01:15.262" end="01:16.087">心</span><span begin="01:16.087" end="01:17.330">奪われて</span><span begin="01:17.330" end="01:18.357">しまった</span><span begin="01:18.357" end="01:19.797">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">心就已经被你夺走</span></p><p begin="01:21.120" end="01:23.071" ttm:agent="v1" itunes:key="L12"><span begin="01:21.120" end="01:22.245">俺のどこが</span><span begin="01:22.245" end="01:23.071">いいのか</span><span ttm:role="x-translation" xml:lang="zh-Hans">我到底有什么好的</span></p><p begin="01:23.266" end="01:26.012" ttm:agent="v1" itunes:key="L13"><span begin="01:23.266" end="01:24.445">わからないけど</span> <span begin="01:24.445" end="01:26.012">君は言ってた</span><span ttm:role="x-translation" xml:lang="zh-Hans">我真的不知道 可你却对我说</span></p><p begin="01:26.022" end="01:29.808" ttm:agent="v3" itunes:key="L14"><span begin="01:26.022" end="01:26.800">あなたが</span> <span begin="01:26.800" end="01:27.890">望むように</span> <span begin="01:27.890" end="01:28.657">私が</span><span begin="01:28.657" end="01:29.808">変わるから</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;我会努力变成</span></p><p begin="01:29.818" end="01:32.377" ttm:agent="v1" itunes:key="L15"><span begin="01:29.818" end="01:30.170">でも</span> <span begin="01:30.170" end="01:31.058">そういうこと</span><span begin="01:31.058" end="01:32.377">じゃなかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">可并不应该是这样</span></p><p begin="01:32.587" end="01:33.756" ttm:agent="v2" itunes:key="L16"><span begin="01:32.587" end="01:33.756">今の俺には</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;现在的我</span></p><p begin="01:33.756" end="01:38.152" ttm:agent="v2" itunes:key="L17"><span begin="01:33.756" end="01:34.275">君を</span><span begin="01:34.275" end="01:36.046">幸せにすることは</span><span begin="01:36.046" end="01:38.152">できないからって</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有办法</span></p><p begin="01:38.362" end="01:40.798" ttm:agent="v3" itunes:key="L18"><span begin="01:38.362" end="01:38.781">そう</span> <span begin="01:38.781" end="01:39.492">あなたは</span><span begin="01:39.492" end="01:40.798">言ってたけど</span><span ttm:role="x-translation" xml:lang="zh-Hans">你虽然那么说</span></p><p begin="01:40.908" end="01:42.418" ttm:agent="v3" itunes:key="L19"><span begin="01:40.908" end="01:42.418">幸せだった</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是我真的很幸福</span></p><p begin="01:42.585" end="01:46.120" ttm:agent="v3" itunes:key="L20"><span begin="01:42.585" end="01:43.949">あなたの隣に</span><span begin="01:43.949" end="01:45.128">いるだけ</span><span begin="01:45.128" end="01:46.120">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是陪在你的身边</span></p><p begin="01:46.499" end="01:48.549" ttm:agent="v3" itunes:key="L21"><span begin="01:46.499" end="01:46.841">ただ</span><span begin="01:46.841" end="01:48.002">それだけ</span><span begin="01:48.002" end="01:48.549">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">仅仅如此就已足够</span></p><p begin="01:48.608" end="01:54.487" ttm:agent="v2" itunes:key="L22"><span begin="01:48.608" end="01:49.697">さよな</span><span begin="01:49.697" end="01:50.722">ら</span> <span begin="01:50.861" end="01:52.340">愛しき</span><span begin="01:52.340" end="01:54.487">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="01:54.646" end="01:57.913" ttm:agent="v2" itunes:key="L23"><span begin="01:54.646" end="01:55.480">もう二度と</span><span begin="01:55.480" end="01:56.498">会えない</span> <span begin="01:56.581" end="01:57.913">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="01:58.013" end="02:00.330" ttm:agent="v2" itunes:key="L24"><span begin="01:58.013" end="01:58.423">そう</span><span begin="01:58.423" end="01:59.614">決めたの</span><span begin="01:59.614" end="02:00.330">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明决定不再见你</span></p><p begin="02:00.479" end="02:03.179" ttm:agent="v2" itunes:key="L25"><span begin="02:00.479" end="02:01.746">どうして</span> <span begin="02:01.905" end="02:03.179">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="02:03.261" end="02:07.085" ttm:agent="v2" itunes:key="L26"><span begin="02:03.261" end="02:03.944">あなたを</span> <span begin="02:03.944" end="02:05.394">忘れられないん</span><span begin="02:05.394" end="02:07.085">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="02:07.344" end="02:09.476" ttm:agent="v2" itunes:key="L27"><span begin="02:07.344" end="02:08.021">今日も</span><span begin="02:08.021" end="02:09.476">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="02:09.384" end="02:12.851" ttm:agent="v2" itunes:key="L28"><span begin="02:09.384" end="02:10.816">ネガウ</span> <span begin="02:10.931" end="02:11.590">アイ</span><span begin="02:11.590" end="02:12.851">タイ</span></p><p begin="02:24.408" end="02:28.497" ttm:agent="v1" itunes:key="L29"><span begin="02:24.408" end="02:26.170">どうして</span> <span begin="02:26.170" end="02:26.858">君</span><span begin="02:26.858" end="02:28.497">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么我</span></p><p begin="02:29.151" end="02:33.931" ttm:agent="v1" itunes:key="L30"><span begin="02:29.151" end="02:30.199">別れる</span><span begin="02:30.199" end="02:31.114">ことを</span><span begin="02:31.114" end="02:32.157">選んだん</span><span begin="02:32.157" end="02:33.931">だろう</span></p><p begin="02:35.879" end="02:40.511" ttm:agent="v1" itunes:key="L31"><span begin="02:35.879" end="02:37.331">離れた</span> <span begin="02:37.331" end="02:37.989">その</span><span begin="02:37.989" end="02:39.424">瞬間か</span><span begin="02:39.424" end="02:40.511">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">在分开的那个瞬间</span></p><p begin="02:40.895" end="02:45.815" ttm:agent="v1" itunes:key="L32"><span begin="02:40.895" end="02:41.840">心</span><span begin="02:41.840" end="02:43.021">失って</span><span begin="02:43.021" end="02:43.813">しまった</span><span begin="02:43.813" end="02:45.815">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我就丢了自己的心</span></p><p begin="02:46.754" end="02:48.968" ttm:agent="v3" itunes:key="L33"><span begin="02:46.754" end="02:47.885">つないだ手の</span><span begin="02:47.885" end="02:48.968">温もり</span><span ttm:role="x-translation" xml:lang="zh-Hans">牵手的温度</span></p><p begin="02:48.977" end="02:51.731" ttm:agent="v3" itunes:key="L34"><span begin="02:48.977" end="02:50.499">見上げた星空の</span><span begin="02:50.499" end="02:51.731">下ふたり</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你并肩仰望的星空</span></p><p begin="02:51.982" end="02:52.527" ttm:agent="v2" itunes:key="L35"><span begin="02:51.982" end="02:52.527">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么现在想起的</span></p><p begin="02:52.527" end="02:55.386" ttm:agent="v2" itunes:key="L36"><span begin="02:52.527" end="02:53.585">楽しかった</span><span begin="02:53.585" end="02:54.399">思い出の</span><span begin="02:54.399" end="02:55.386">事ばかり</span></p><p begin="02:55.397" end="02:57.513" ttm:agent="v2" itunes:key="L37"><span begin="02:55.397" end="02:56.279">よみがえって</span><span begin="02:56.279" end="02:57.513">くるんだろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽是那些愉快的回忆</span></p><p begin="02:57.720" end="03:00.471" ttm:agent="v1" itunes:key="L38"><span begin="02:57.720" end="02:59.128">もっと寄り添って</span><span begin="02:59.128" end="03:00.471">やりたかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;还想陪你再久一点&quot;</span></p><p begin="03:00.471" end="03:03.979" ttm:agent="v3" itunes:key="L39"><span begin="03:00.471" end="03:01.072">もっと</span><span begin="03:01.072" end="03:02.513">あなたの癒しに</span><span begin="03:02.513" end="03:03.979">なりたかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;还想治愈你</span></p><p begin="03:04.090" end="03:06.238" ttm:agent="v2" itunes:key="L40"><span begin="03:04.090" end="03:04.660">もしも</span> <span begin="03:04.660" end="03:05.195">想い</span><span begin="03:05.195" end="03:06.238">届くなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">再多一些&quot;</span></p><p begin="03:06.249" end="03:08.988" ttm:agent="v1" itunes:key="L41"><span begin="03:06.249" end="03:07.197">もう一度</span> <span begin="03:07.197" end="03:07.839">あの日に</span><span begin="03:07.839" end="03:08.988">戻りたい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还想再次回到那一天</span></p><p begin="03:09.109" end="03:12.551" ttm:agent="v3" itunes:key="L42"><span begin="03:09.109" end="03:10.075">もう一度</span> <span begin="03:10.075" end="03:10.729">あなたと</span><span begin="03:10.729" end="03:11.225">出逢い</span><span begin="03:11.225" end="03:12.551">たい</span><span ttm:role="x-translation" xml:lang="zh-Hans">还想再次与你相逢</span></p><p begin="03:23.923" end="03:30.577" ttm:agent="v3" itunes:key="L43"><span begin="03:23.923" end="03:25.303">あなたは</span> <span begin="03:25.303" end="03:26.753">誰かと</span><span begin="03:26.753" end="03:28.240">笑えて</span><span begin="03:28.240" end="03:29.163">います</span><span begin="03:29.163" end="03:30.577">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你正在和他人相视而笑吗</span></p><p begin="03:29.701" end="03:36.309" ttm:agent="v1" itunes:key="L44"><span begin="03:29.701" end="03:32.474">君は今どこで</span><span begin="03:32.474" end="03:33.894">過ごして</span><span begin="03:33.894" end="03:34.926">います</span><span begin="03:34.926" end="03:36.309">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你在哪里过着你的人生呢</span></p><p begin="03:35.498" end="03:42.329" ttm:agent="v3" itunes:key="L45"><span begin="03:35.498" end="03:38.268">あなたはあなたで</span><span begin="03:38.268" end="03:39.653">いられて</span><span begin="03:39.653" end="03:40.555">います</span><span begin="03:40.555" end="03:42.329">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你是否还是当初的那个你</span></p><p begin="03:41.062" end="03:47.222" ttm:agent="v1" itunes:key="L46"><span begin="03:41.062" end="03:43.913">君は君らしく</span><span begin="03:43.913" end="03:46.196">いられています</span><span begin="03:46.196" end="03:47.222">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你是否仍然坚持做你自己</span></p><p begin="03:46.667" end="03:49.836" ttm:agent="v3" itunes:key="L47"><span begin="03:46.667" end="03:47.347">私は</span> <span begin="03:47.347" end="03:48.064">あなたを</span><span begin="03:48.064" end="03:48.950">辿って</span><span begin="03:48.950" end="03:49.836">いました</span><span ttm:role="x-translation" xml:lang="zh-Hans">我仍追溯着你往昔的幻影</span></p><p begin="03:50.046" end="03:52.136" ttm:agent="v3" itunes:key="L48"><span begin="03:50.046" end="03:51.091">行き止まりの</span><span begin="03:51.091" end="03:52.136">毎日に</span><span ttm:role="x-translation" xml:lang="zh-Hans">迷失在裹足不前的每一天</span></p><p begin="03:52.145" end="03:57.797" ttm:agent="v3" itunes:key="L49"><span begin="03:52.145" end="03:54.396">迷い込んだまま</span> <span begin="03:54.584" end="03:55.200">前に</span><span begin="03:55.200" end="03:56.572">進めず</span><span begin="03:56.572" end="03:57.797">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">未能向前迈进一步</span></p><p begin="03:58.022" end="04:01.265" ttm:agent="v1" itunes:key="L50"><span begin="03:58.022" end="03:58.611">俺も</span> <span begin="03:58.611" end="03:59.496">君のこと</span><span begin="03:59.496" end="04:00.381">想って</span><span begin="04:00.381" end="04:01.265">いました</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也仍然思念着你</span></p><p begin="04:01.640" end="04:04.982" ttm:agent="v1" itunes:key="L51"><span begin="04:01.640" end="04:02.345">今夜も</span> <span begin="04:02.345" end="04:03.765">あの頃のまま</span><span begin="04:03.765" end="04:04.982">の二人</span><span ttm:role="x-translation" xml:lang="zh-Hans">那时候的我们</span></p><p begin="04:04.991" end="04:06.775" ttm:agent="v2" itunes:key="L52"><span begin="04:04.991" end="04:06.108">一緒にいた</span><span begin="04:06.108" end="04:06.775">時間が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一起共度的时光</span></p><p begin="04:06.785" end="04:12.501" ttm:agent="v2" itunes:key="L53"><span begin="04:06.785" end="04:07.511">何度も</span> <span begin="04:07.511" end="04:08.822">頭の中で</span><span begin="04:08.822" end="04:09.819">繰り返され</span><span begin="04:09.819" end="04:12.501">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">今晚也在脑海中一遍遍闪现</span></p><p begin="04:20.027" end="04:25.906" ttm:agent="v2" itunes:key="L54"><span begin="04:20.027" end="04:21.116">さよな</span><span begin="04:21.116" end="04:22.141">ら</span> <span begin="04:22.280" end="04:23.759">愛しき</span><span begin="04:23.759" end="04:25.906">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="04:26.124" end="04:29.391" ttm:agent="v2" itunes:key="L55"><span begin="04:26.124" end="04:26.958">もう二度と</span><span begin="04:26.958" end="04:27.976">会えない</span> <span begin="04:28.059" end="04:29.391">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="04:29.465" end="04:31.782" ttm:agent="v2" itunes:key="L56"><span begin="04:29.465" end="04:29.875">そう</span><span begin="04:29.875" end="04:31.066">決めたの</span><span begin="04:31.066" end="04:31.782">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明决定不再见你</span></p><p begin="04:31.924" end="04:34.624" ttm:agent="v2" itunes:key="L57"><span begin="04:31.924" end="04:33.191">どうして</span> <span begin="04:33.350" end="04:34.624">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="04:34.731" end="04:38.575" ttm:agent="v2" itunes:key="L58"><span begin="04:34.731" end="04:35.414">あなたを</span> <span begin="04:35.414" end="04:36.859">忘れられないん</span><span begin="04:36.859" end="04:38.575">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="04:38.770" end="04:40.902" ttm:agent="v2" itunes:key="L59"><span begin="04:38.770" end="04:39.573">今日も</span><span begin="04:39.573" end="04:40.902">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="04:40.898" end="04:44.315" ttm:agent="v2" itunes:key="L60"><span begin="04:40.898" end="04:42.277">ネガウ</span> <span begin="04:42.277" end="04:43.092">アイ</span><span begin="04:43.092" end="04:44.315">タイ</span></p></div></body></tt>