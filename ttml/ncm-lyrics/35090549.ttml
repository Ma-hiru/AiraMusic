<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="35090549"/><amll:meta key="appleMusicId" value="1784954520"/><amll:meta key="musicName" value="The Nights"/><amll:meta key="artists" value="Avicii / Nicholas Furlong"/><amll:meta key="album" value="Stories"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="02:56.658"><div begin="00:02.586" end="02:50.730"><p begin="00:02.586" end="00:03.058" ttm:agent="v1" itunes:key="L1"><span begin="00:02.586" end="00:03.058">Hey</span><span ttm:role="x-translation" xml:lang="zh-Hans">嘿 还年少时</span></p><p begin="00:03.068" end="00:04.729" ttm:agent="v1" itunes:key="L2"><span begin="00:03.068" end="00:03.386">Once</span> <span begin="00:03.386" end="00:03.757">upon</span> <span begin="00:03.757" end="00:04.039">a</span> <span begin="00:04.039" end="00:04.426">younger</span> <span begin="00:04.426" end="00:04.729">year</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们心底所有的阴霾都消逝</span></p><p begin="00:04.729" end="00:06.599" ttm:agent="v1" itunes:key="L3"><span begin="00:04.729" end="00:05.013">When</span> <span begin="00:05.013" end="00:05.269">all</span> <span begin="00:05.269" end="00:05.501">our</span> <span begin="00:05.501" end="00:05.967">shadows</span> <span begin="00:05.967" end="00:06.599">disappeared</span></p><p begin="00:06.599" end="00:09.585" ttm:agent="v1" itunes:key="L4"><span begin="00:06.599" end="00:06.842">The</span> <span begin="00:06.842" end="00:07.570">animals</span> <span begin="00:07.570" end="00:08.052">inside</span> <span begin="00:08.052" end="00:08.287">came</span> <span begin="00:08.287" end="00:08.538">out</span> <span begin="00:08.538" end="00:08.786">to</span> <span begin="00:08.786" end="00:09.585">play</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽情释放内心的狂野</span></p><p begin="00:10.390" end="00:12.580" ttm:agent="v1" itunes:key="L5"><span begin="00:10.390" end="00:10.721">Went</span> <span begin="00:10.721" end="00:10.985">face</span> <span begin="00:10.985" end="00:11.217">to</span> <span begin="00:11.217" end="00:11.433">face</span> <span begin="00:11.433" end="00:11.651">with</span> <span begin="00:11.651" end="00:11.918">all</span> <span begin="00:11.918" end="00:12.099">our</span> <span begin="00:12.099" end="00:12.580">fears</span><span ttm:role="x-translation" xml:lang="zh-Hans">嘿 当我们直面恐惧时</span></p><p begin="00:12.590" end="00:14.356" ttm:agent="v1" itunes:key="L6"><span begin="00:12.590" end="00:12.910">Learned</span> <span begin="00:12.910" end="00:13.126">our</span> <span begin="00:13.126" end="00:13.558">lessons</span> <span begin="00:13.558" end="00:13.758">through</span> <span begin="00:13.758" end="00:13.926">the</span> <span begin="00:13.926" end="00:14.356">tears</span><span ttm:role="x-translation" xml:lang="zh-Hans">从眼泪中汲取教训</span></p><p begin="00:14.356" end="00:17.429" ttm:agent="v1" itunes:key="L7"><span begin="00:14.356" end="00:14.588">Made</span> <span begin="00:14.588" end="00:15.235">memories</span> <span begin="00:15.235" end="00:15.518">we</span> <span begin="00:15.518" end="00:15.752">knew</span> <span begin="00:15.752" end="00:16.003">would</span> <span begin="00:16.003" end="00:16.368">never</span> <span begin="00:16.368" end="00:17.429">fade</span><span ttm:role="x-translation" xml:lang="zh-Hans">深知这些回忆是我们抹不去的曾经</span></p><p begin="00:17.569" end="00:21.760" ttm:agent="v1" itunes:key="L8"><span begin="00:17.569" end="00:17.844">One</span> <span begin="00:17.844" end="00:18.094">day,</span> <span begin="00:18.094" end="00:18.377">my</span> <span begin="00:18.377" end="00:19.044">father,</span> <span begin="00:19.044" end="00:19.294">he</span> <span begin="00:19.294" end="00:19.526">told</span> <span begin="00:19.526" end="00:19.742">me,</span> <span begin="00:19.742" end="00:20.014">"Son,</span> <span begin="00:20.014" end="00:20.262">don't</span> <span begin="00:20.262" end="00:20.526">let</span> <span begin="00:20.526" end="00:20.700">it</span> <span begin="00:20.700" end="00:21.062">slip</span> <span begin="00:21.062" end="00:21.760">away"</span><span ttm:role="x-translation" xml:lang="zh-Hans">有一天父亲对我说</span></p><p begin="00:21.870" end="00:25.027" ttm:agent="v1" itunes:key="L9"><span begin="00:21.870" end="00:22.110">He</span> <span begin="00:22.110" end="00:22.331">took</span> <span begin="00:22.331" end="00:22.531">me</span> <span begin="00:22.531" end="00:22.830">in</span> <span begin="00:22.830" end="00:23.046">his</span> <span begin="00:23.046" end="00:23.281">arms,</span> <span begin="00:23.281" end="00:23.547">I</span> <span begin="00:23.547" end="00:23.779">heard</span> <span begin="00:23.779" end="00:24.030">him</span> <span begin="00:24.030" end="00:25.027">say</span><span ttm:role="x-translation" xml:lang="zh-Hans">他将我拥入他怀中 我听到他说</span></p><p begin="00:25.239" end="00:29.577" ttm:agent="v1" itunes:key="L10"><span begin="00:25.239" end="00:25.495">"When</span> <span begin="00:25.495" end="00:25.722">you</span> <span begin="00:25.722" end="00:25.988">get</span> <span begin="00:25.988" end="00:26.674">older,</span> <span begin="00:26.674" end="00:26.906">your</span> <span begin="00:26.906" end="00:27.156">wild</span> <span begin="00:27.156" end="00:27.655">heart</span> <span begin="00:27.655" end="00:27.906">will</span> <span begin="00:27.906" end="00:28.156">live</span> <span begin="00:28.156" end="00:28.388">for</span> <span begin="00:28.388" end="00:28.823">younger</span> <span begin="00:28.823" end="00:29.577">days</span><span ttm:role="x-translation" xml:lang="zh-Hans">当你长大后</span></p><p begin="00:29.657" end="00:32.713" ttm:agent="v1" itunes:key="L11"><span begin="00:29.657" end="00:29.966">Think</span> <span begin="00:29.966" end="00:30.217">of</span> <span begin="00:30.217" end="00:30.518">me</span> <span begin="00:30.518" end="00:30.785">if</span> <span begin="00:30.785" end="00:31.017">ever</span> <span begin="00:31.017" end="00:31.566">you're</span> <span begin="00:31.566" end="00:32.713">afraid"</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你害怕就想想我说的话</span></p><p begin="00:32.733" end="00:36.538" ttm:agent="v1" itunes:key="L12"><span begin="00:32.733" end="00:33.101">He</span> <span begin="00:33.101" end="00:33.298">said,</span> <span begin="00:33.298" end="00:33.533">"One</span> <span begin="00:33.533" end="00:34.250">day,</span> <span begin="00:34.250" end="00:34.482">you'll</span> <span begin="00:34.482" end="00:34.765">leave</span> <span begin="00:34.765" end="00:35.016">this</span> <span begin="00:35.016" end="00:35.317">world</span> <span begin="00:35.317" end="00:36.538">behind</span><span ttm:role="x-translation" xml:lang="zh-Hans">他说 总有一天 你将会离开这个世界</span></p><p begin="00:36.538" end="00:40.267" ttm:agent="v1" itunes:key="L13"><span begin="00:36.538" end="00:36.794">So</span> <span begin="00:36.794" end="00:37.106">live</span> <span begin="00:37.106" end="00:37.338">a</span> <span begin="00:37.338" end="00:38.056">life</span> <span begin="00:38.056" end="00:38.322">you</span> <span begin="00:38.322" end="00:39.069">will</span> <span begin="00:39.069" end="00:40.267">remember"</span><span ttm:role="x-translation" xml:lang="zh-Hans">就活出你的人生 这回忆值得你铭记</span></p><p begin="00:40.447" end="00:44.064" ttm:agent="v1" itunes:key="L14"><span begin="00:40.447" end="00:40.684">My</span> <span begin="00:40.684" end="00:41.202">father</span> <span begin="00:41.202" end="00:41.586">told</span> <span begin="00:41.586" end="00:41.884">me</span> <span begin="00:41.884" end="00:42.135">when</span> <span begin="00:42.135" end="00:42.370">I</span> <span begin="00:42.370" end="00:42.586">was</span> <span begin="00:42.586" end="00:42.852">just</span> <span begin="00:42.852" end="00:43.084">a</span> <span begin="00:43.084" end="00:44.064">child</span><span ttm:role="x-translation" xml:lang="zh-Hans">父亲对我说这些时我还只是个孩子</span></p><p begin="00:44.214" end="00:47.627" ttm:agent="v1" itunes:key="L15"><span begin="00:44.214" end="00:44.491">These</span> <span begin="00:44.491" end="00:44.739">are</span> <span begin="00:44.739" end="00:45.041">the</span> <span begin="00:45.041" end="00:45.606">nights</span> <span begin="00:45.606" end="00:45.891">that</span> <span begin="00:45.891" end="00:46.841">never</span> <span begin="00:46.841" end="00:47.627">die</span><span ttm:role="x-translation" xml:lang="zh-Hans">这些夜晚永远不会逝去</span></p><p begin="00:47.627" end="00:48.902" ttm:agent="v1" itunes:key="L16"><span begin="00:47.627" end="00:47.908">My</span> <span begin="00:47.908" end="00:48.342">father</span> <span begin="00:48.342" end="00:48.593">told</span> <span begin="00:48.593" end="00:48.902">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的父亲对我说</span></p><p begin="01:19.001" end="01:21.088" ttm:agent="v1" itunes:key="L17"><span begin="01:19.001" end="01:19.348">When</span> <span begin="01:19.348" end="01:19.648">thunder</span> <span begin="01:19.648" end="01:19.948">clouds</span> <span begin="01:19.948" end="01:20.198">start</span> <span begin="01:20.198" end="01:20.598">pouring</span> <span begin="01:20.598" end="01:21.088">down</span><span ttm:role="x-translation" xml:lang="zh-Hans">当风暴乌云席卷而来</span></p><p begin="01:21.138" end="01:22.909" ttm:agent="v1" itunes:key="L18"><span begin="01:21.138" end="01:21.402">Light</span> <span begin="01:21.402" end="01:21.586">a</span> <span begin="01:21.586" end="01:21.903">fire</span> <span begin="01:21.903" end="01:22.103">they</span> <span begin="01:22.103" end="01:22.351">can't</span> <span begin="01:22.351" end="01:22.570">put</span> <span begin="01:22.570" end="01:22.909">out</span><span ttm:role="x-translation" xml:lang="zh-Hans">点燃无法熄灭的火焰</span></p><p begin="01:23.009" end="01:26.082" ttm:agent="v1" itunes:key="L19"><span begin="01:23.009" end="01:23.231">Carve</span> <span begin="01:23.231" end="01:23.533">your</span> <span begin="01:23.533" end="01:23.783">name</span> <span begin="01:23.783" end="01:24.234">into</span> <span begin="01:24.234" end="01:24.517">those</span> <span begin="01:24.517" end="01:24.981">shining</span> <span begin="01:24.981" end="01:26.082">stars</span><span ttm:role="x-translation" xml:lang="zh-Hans">将你的名字刻入那闪耀的繁星中</span></p><p begin="01:26.082" end="01:28.674" ttm:agent="v1" itunes:key="L20"><span begin="01:26.082" end="01:26.349">He</span> <span begin="01:26.349" end="01:26.660">said,</span> <span begin="01:26.660" end="01:26.943">"Go</span> <span begin="01:26.943" end="01:27.361">venture</span> <span begin="01:27.361" end="01:27.711">far</span> <span begin="01:27.711" end="01:28.087">beyond</span> <span begin="01:28.087" end="01:28.221">the</span> <span begin="01:28.221" end="01:28.674">shores</span><span ttm:role="x-translation" xml:lang="zh-Hans">他说 离开海岸 去远方冒险吧</span></p><p begin="01:28.724" end="01:30.521" ttm:agent="v1" itunes:key="L21"><span begin="01:28.724" end="01:29.007">Don't</span> <span begin="01:29.007" end="01:29.489">forsake</span> <span begin="01:29.489" end="01:29.708">this</span> <span begin="01:29.708" end="01:29.956">life</span> <span begin="01:29.956" end="01:30.140">of</span> <span begin="01:30.140" end="01:30.521">yours</span><span ttm:role="x-translation" xml:lang="zh-Hans">永远不要放弃你的人生</span></p><p begin="01:30.521" end="01:33.480" ttm:agent="v1" itunes:key="L22"><span begin="01:30.521" end="01:30.780">I'll</span> <span begin="01:30.780" end="01:30.972">guide</span> <span begin="01:30.972" end="01:31.204">you</span> <span begin="01:31.204" end="01:31.439">home</span> <span begin="01:31.439" end="01:31.639">no</span> <span begin="01:31.639" end="01:32.105">matter</span> <span begin="01:32.105" end="01:32.337">where</span> <span begin="01:32.337" end="01:32.673">you</span> <span begin="01:32.673" end="01:33.480">are"</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论你身处何处 我都会指引你回家</span></p><p begin="01:33.732" end="01:37.851" ttm:agent="v1" itunes:key="L23"><span begin="01:33.732" end="01:34.060">One</span> <span begin="01:34.060" end="01:34.343">day,</span> <span begin="01:34.343" end="01:34.609">my</span> <span begin="01:34.609" end="01:35.159">father,</span> <span begin="01:35.159" end="01:35.425">he</span> <span begin="01:35.425" end="01:35.692">told</span> <span begin="01:35.692" end="01:35.943">me,</span> <span begin="01:35.943" end="01:36.193">"Son,</span> <span begin="01:36.193" end="01:36.476">don't</span> <span begin="01:36.476" end="01:36.727">let</span> <span begin="01:36.727" end="01:36.943">it</span> <span begin="01:36.943" end="01:37.175">slip</span> <span begin="01:37.175" end="01:37.851">away"</span><span ttm:role="x-translation" xml:lang="zh-Hans">有一天父亲对我说</span></p><p begin="01:38.031" end="01:41.254" ttm:agent="v1" itunes:key="L24"><span begin="01:38.031" end="01:38.311">When</span> <span begin="01:38.311" end="01:38.562">I</span> <span begin="01:38.562" end="01:38.828">was</span> <span begin="01:38.828" end="01:39.076">just</span> <span begin="01:39.076" end="01:39.362">a</span> <span begin="01:39.362" end="01:39.594">kid,</span> <span begin="01:39.594" end="01:39.828">I</span> <span begin="01:39.828" end="01:40.044">heard</span> <span begin="01:40.044" end="01:40.311">him</span> <span begin="01:40.311" end="01:41.254">say</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还只是个孩子时 父亲就对我说了这些话</span></p><p begin="01:41.344" end="01:45.783" ttm:agent="v1" itunes:key="L25"><span begin="01:41.344" end="01:41.627">"When</span> <span begin="01:41.627" end="01:41.875">you</span> <span begin="01:41.875" end="01:42.160">get</span> <span begin="01:42.160" end="01:42.827">older,</span> <span begin="01:42.827" end="01:43.093">your</span> <span begin="01:43.093" end="01:43.541">wild</span> <span begin="01:43.541" end="01:43.885">heart</span> <span begin="01:43.885" end="01:44.104">will</span> <span begin="01:44.104" end="01:44.397">live</span> <span begin="01:44.397" end="01:44.664">for</span> <span begin="01:44.664" end="01:45.016">younger</span> <span begin="01:45.016" end="01:45.783">days</span><span ttm:role="x-translation" xml:lang="zh-Hans">当你长大后</span></p><p begin="01:45.843" end="01:48.884" ttm:agent="v1" itunes:key="L26"><span begin="01:45.843" end="01:46.200">Think</span> <span begin="01:46.200" end="01:46.432">of</span> <span begin="01:46.432" end="01:46.695">me</span> <span begin="01:46.695" end="01:46.962">if</span> <span begin="01:46.962" end="01:47.371">ever</span> <span begin="01:47.371" end="01:47.688">you're</span> <span begin="01:47.688" end="01:48.884">afraid"</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果你害怕就想想我说的话</span></p><p begin="01:48.937" end="01:52.577" ttm:agent="v1" itunes:key="L27"><span begin="01:48.937" end="01:49.233">He</span> <span begin="01:49.233" end="01:49.470">said,</span> <span begin="01:49.470" end="01:49.721">"One</span> <span begin="01:49.721" end="01:50.404">day,</span> <span begin="01:50.404" end="01:50.686">you'll</span> <span begin="01:50.686" end="01:50.937">leave</span> <span begin="01:50.937" end="01:51.172">this</span> <span begin="01:51.172" end="01:51.572">world</span> <span begin="01:51.572" end="01:52.577">behind</span><span ttm:role="x-translation" xml:lang="zh-Hans">他说 总有一天 你将会离开这个世界</span></p><p begin="01:52.701" end="01:56.464" ttm:agent="v1" itunes:key="L28"><span begin="01:52.701" end="01:53.013">So</span> <span begin="01:53.013" end="01:53.280">live</span> <span begin="01:53.280" end="01:53.496">a</span> <span begin="01:53.496" end="01:54.162">life</span> <span begin="01:54.162" end="01:54.429">you</span> <span begin="01:54.429" end="01:55.256">will</span> <span begin="01:55.256" end="01:56.464">remember"</span><span ttm:role="x-translation" xml:lang="zh-Hans">就活出你的人生 这回忆值得你铭记</span></p><p begin="01:56.604" end="02:00.282" ttm:agent="v1" itunes:key="L29"><span begin="01:56.604" end="01:56.927">My</span> <span begin="01:56.927" end="01:57.345">father</span> <span begin="01:57.345" end="01:57.777">told</span> <span begin="01:57.777" end="01:58.079">me</span> <span begin="01:58.079" end="01:58.279">when</span> <span begin="01:58.279" end="01:58.495">I</span> <span begin="01:58.495" end="01:58.745">was</span> <span begin="01:58.745" end="01:59.063">just</span> <span begin="01:59.063" end="01:59.297">a</span> <span begin="01:59.297" end="02:00.282">child</span><span ttm:role="x-translation" xml:lang="zh-Hans">父亲对我说这些时我还只是个孩子</span></p><p begin="02:00.406" end="02:03.761" ttm:agent="v1" itunes:key="L30"><span begin="02:00.406" end="02:00.694">These</span> <span begin="02:00.694" end="02:00.894">are</span> <span begin="02:00.894" end="02:01.177">the</span> <span begin="02:01.177" end="02:01.875">nights</span> <span begin="02:01.875" end="02:02.177">that</span> <span begin="02:02.177" end="02:03.027">never</span> <span begin="02:03.027" end="02:03.761">die</span><span ttm:role="x-translation" xml:lang="zh-Hans">这些夜晚永远不会逝去</span></p><p begin="02:03.761" end="02:05.108" ttm:agent="v1" itunes:key="L31"><span begin="02:03.761" end="02:03.971">My</span> <span begin="02:03.971" end="02:04.454">father</span> <span begin="02:04.454" end="02:04.705">told</span> <span begin="02:04.705" end="02:05.108">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的父亲对我说</span></p><p begin="02:15.631" end="02:19.054" ttm:agent="v1" itunes:key="L32"><span begin="02:15.631" end="02:15.900">These</span> <span begin="02:15.900" end="02:16.202">are</span> <span begin="02:16.202" end="02:16.434">the</span> <span begin="02:16.434" end="02:17.151">nights</span> <span begin="02:17.151" end="02:17.418">that</span> <span begin="02:17.418" end="02:18.234">never</span> <span begin="02:18.234" end="02:19.054">die</span><span ttm:role="x-translation" xml:lang="zh-Hans">这些夜晚永远不会逝去</span></p><p begin="02:19.054" end="02:20.331" ttm:agent="v1" itunes:key="L33"><span begin="02:19.054" end="02:19.325">My</span> <span begin="02:19.325" end="02:19.679">father</span> <span begin="02:19.679" end="02:19.914">told</span> <span begin="02:19.914" end="02:20.331">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的父亲对我说</span></p><p begin="02:49.499" end="02:50.730" ttm:agent="v1" itunes:key="L34"><span begin="02:49.499" end="02:49.696">My</span> <span begin="02:49.696" end="02:50.214">father</span> <span begin="02:50.214" end="02:50.430">told</span> <span begin="02:50.430" end="02:50.730">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的父亲对我说</span></p></div></body></tt>