<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="2060973088"/><amll:meta key="appleMusicId" value="1695666895"/><amll:meta key="musicName" value="地球儀"/><amll:meta key="artists" value="米津玄師"/><amll:meta key="album" value="地球儀"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:33.438"><div begin="00:16.131" end="04:15.204"><p begin="00:16.131" end="00:21.640" ttm:agent="v1" itunes:key="L1"><span begin="00:16.131" end="00:16.565">僕</span><span begin="00:16.565" end="00:17.049">が</span><span begin="00:17.533" end="00:18.016">生</span><span begin="00:18.016" end="00:18.365">まれ</span><span begin="00:18.365" end="00:18.867">た</span><span begin="00:19.123" end="00:19.715">日</span><span begin="00:19.715" end="00:20.312">の</span><span begin="00:20.312" end="00:20.712">空</span><span begin="00:20.712" end="00:21.640">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">我出生那天的天空</span></p><p begin="00:23.428" end="00:29.262" ttm:agent="v1" itunes:key="L2"><span begin="00:23.428" end="00:23.802">高</span><span begin="00:23.802" end="00:24.407">く</span><span begin="00:24.936" end="00:25.320">遠</span><span begin="00:25.320" end="00:25.873">く</span><span begin="00:26.450" end="00:26.941">晴れ</span><span begin="00:26.941" end="00:28.093">渡っ</span><span begin="00:28.093" end="00:28.490">てい</span><span begin="00:28.490" end="00:29.262">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">高旷幽远 万里无云</span></p><p begin="00:31.510" end="00:36.859" ttm:agent="v1" itunes:key="L3"><span begin="00:31.510" end="00:31.934">行っ</span><span begin="00:31.934" end="00:32.321">て</span><span begin="00:32.321" end="00:32.718">お</span><span begin="00:32.718" end="00:33.102">いで</span><span begin="00:33.102" end="00:33.601">と</span><span begin="00:34.469" end="00:35.353">背中</span><span begin="00:35.353" end="00:35.718">を</span><span begin="00:35.718" end="00:36.121">撫で</span><span begin="00:36.121" end="00:36.859">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">那一天我听见有声音抚过后背</span></p><p begin="00:38.859" end="00:42.791" ttm:agent="v1" itunes:key="L4"><span begin="00:38.859" end="00:39.202">声</span><span begin="00:39.202" end="00:39.603">を</span><span begin="00:40.311" end="00:40.735">聞い</span><span begin="00:40.735" end="00:41.195">た</span><span begin="00:41.830" end="00:42.234">あの</span><span begin="00:42.234" end="00:42.791">日</span><span ttm:role="x-translation" xml:lang="zh-Hans">让我勇敢地前进吧</span></p><p begin="00:45.346" end="00:50.751" ttm:agent="v1" itunes:key="L5"><span begin="00:45.346" end="00:46.289">季節</span><span begin="00:46.807" end="00:47.249">の</span><span begin="00:47.249" end="00:47.567">中</span><span begin="00:47.567" end="00:48.138">で</span><span begin="00:48.394" end="00:48.799">す</span><span begin="00:48.799" end="00:49.548">れ</span><span begin="00:49.548" end="00:49.916">違</span><span begin="00:49.916" end="00:50.751">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">四季轮回 与无数人擦肩</span></p><p begin="00:52.703" end="00:58.416" ttm:agent="v1" itunes:key="L6"><span begin="00:52.703" end="00:53.077">時</span><span begin="00:53.077" end="00:53.482">に</span><span begin="00:54.134" end="00:54.483">人</span><span begin="00:54.483" end="00:55.012">を</span><span begin="00:55.683" end="00:56.099">傷</span><span begin="00:56.099" end="00:56.883">つ</span><span begin="00:56.883" end="00:57.232">け</span><span begin="00:57.232" end="00:57.638">なが</span><span begin="00:57.638" end="00:58.416">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">有时也曾伤害了他人</span></p><p begin="01:00.743" end="01:06.146" ttm:agent="v1" itunes:key="L7"><span begin="01:00.743" end="01:01.527">光</span><span begin="01:01.527" end="01:01.908">に</span><span begin="01:01.908" end="01:02.292">触れ</span><span begin="01:02.292" end="01:02.922">て</span><span begin="01:03.756" end="01:04.143">影</span><span begin="01:04.143" end="01:04.559">を</span><span begin="01:04.559" end="01:04.975">伸</span><span begin="01:04.975" end="01:05.359">ばし</span><span begin="01:05.359" end="01:06.146">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">当我触碰到光时 影子也随之拉长</span></p><p begin="01:08.092" end="01:12.222" ttm:agent="v1" itunes:key="L8"><span begin="01:08.092" end="01:08.472">更</span><span begin="01:08.472" end="01:08.919">に</span><span begin="01:09.543" end="01:09.933">空</span><span begin="01:09.933" end="01:10.471">は</span><span begin="01:11.133" end="01:11.499">遠</span><span begin="01:11.499" end="01:12.222">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空愈发遥远</span></p><p begin="01:17.265" end="01:23.354" ttm:agent="v1" itunes:key="L9"><span begin="01:17.265" end="01:17.638">風</span><span begin="01:17.638" end="01:18.077">を受</span><span begin="01:18.077" end="01:18.548">け</span><span begin="01:18.797" end="01:19.474">走</span><span begin="01:19.474" end="01:19.960">り出</span><span begin="01:19.960" end="01:20.291">す</span> <span begin="01:20.291" end="01:21.459">瓦礫</span><span begin="01:21.459" end="01:21.808">を</span><span begin="01:21.808" end="01:22.208">越え</span><span begin="01:22.208" end="01:22.627">てい</span><span begin="01:22.627" end="01:23.354">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">迎着风迈步奔跑</span></p><p begin="01:23.384" end="01:29.464" ttm:agent="v1" itunes:key="L10"><span begin="01:23.384" end="01:23.914">この</span><span begin="01:23.914" end="01:24.250">道</span><span begin="01:24.250" end="01:24.769">の</span><span begin="01:24.908" end="01:25.698">行く</span><span begin="01:25.698" end="01:26.066">先</span><span begin="01:26.066" end="01:26.450">に</span> <span begin="01:26.450" end="01:27.250">誰</span><span begin="01:27.250" end="01:28.013">かが</span><span begin="01:28.013" end="01:28.397">待っ</span><span begin="01:28.397" end="01:28.813">てい</span><span begin="01:28.813" end="01:29.464">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这条路的前方</span></p><p begin="01:29.514" end="01:36.406" ttm:agent="v1" itunes:key="L11"><span begin="01:29.514" end="01:30.031">光</span><span begin="01:30.031" end="01:30.366">さ</span><span begin="01:30.366" end="01:30.871">す</span><span begin="01:31.102" end="01:31.883">夢</span><span begin="01:31.883" end="01:32.299">を見</span><span begin="01:32.299" end="01:32.683">る</span> <span begin="01:32.683" end="01:33.467">いつ</span><span begin="01:33.467" end="01:34.216">の</span><span begin="01:34.216" end="01:34.982">日</span><span begin="01:34.982" end="01:36.406">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论何时 我总做着明媚耀眼的梦</span></p><p begin="01:38.803" end="01:44.903" ttm:agent="v1" itunes:key="L12"><span begin="01:38.803" end="01:39.270">扉</span><span begin="01:39.270" end="01:39.573">を</span><span begin="01:39.573" end="01:40.338">今</span><span begin="01:40.338" end="01:41.074">開け</span><span begin="01:41.074" end="01:41.439">放</span><span begin="01:41.439" end="01:41.732">つ</span> <span begin="01:41.890" end="01:42.442">秘密</span><span begin="01:42.442" end="01:42.623">を</span><span begin="01:42.623" end="01:43.423">暴</span><span begin="01:43.423" end="01:43.623">く</span><span begin="01:43.623" end="01:44.207">よう</span><span begin="01:44.207" end="01:44.903">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">此刻我要推开那扇门</span></p><p begin="01:44.963" end="01:51.165" ttm:agent="v1" itunes:key="L13"><span begin="01:44.963" end="01:45.725">飽き足ら</span><span begin="01:45.725" end="01:45.985">ず</span><span begin="01:46.109" end="01:47.290">思い</span><span begin="01:47.290" end="01:47.658">馳せ</span><span begin="01:47.658" end="01:48.074">る</span> <span begin="01:48.074" end="01:48.842">地球儀</span><span begin="01:48.842" end="01:49.197">を</span><span begin="01:49.197" end="01:49.925">回す</span><span begin="01:49.925" end="01:50.325">よう</span><span begin="01:50.325" end="01:51.165">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">意犹未尽地尽情畅想</span></p><p begin="02:03.829" end="02:09.136" ttm:agent="v1" itunes:key="L14"><span begin="02:03.829" end="02:04.168">僕</span><span begin="02:04.168" end="02:04.826">が</span><span begin="02:05.350" end="02:06.102">愛し</span><span begin="02:06.102" end="02:06.592">た</span><span begin="02:06.867" end="02:07.235">あ</span><span begin="02:07.235" end="02:08.051">の</span><span begin="02:08.051" end="02:08.384">人</span><span begin="02:08.384" end="02:09.136">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">我所爱的那个人</span></p><p begin="02:11.121" end="02:16.778" ttm:agent="v1" itunes:key="L15"><span begin="02:11.121" end="02:11.518">誰</span><span begin="02:11.518" end="02:12.070">も</span><span begin="02:12.584" end="02:13.004">知ら</span><span begin="02:13.004" end="02:13.502">ない</span><span begin="02:14.153" end="02:14.502">とこ</span><span begin="02:14.502" end="02:15.409">ろ</span><span begin="02:15.409" end="02:15.705">へ</span><span begin="02:15.705" end="02:16.086">行っ</span><span begin="02:16.086" end="02:16.778">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">去了无人知晓的地方</span></p><p begin="02:19.252" end="02:24.504" ttm:agent="v1" itunes:key="L16"><span begin="02:19.252" end="02:19.617">あの</span><span begin="02:19.617" end="02:20.350">日の</span><span begin="02:20.350" end="02:20.787">まま</span><span begin="02:20.787" end="02:21.303">の</span><span begin="02:22.215" end="02:22.585">優</span><span begin="02:22.585" end="02:23.401">しい</span><span begin="02:23.401" end="02:23.750">顔</span><span begin="02:23.750" end="02:24.504">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">一如往日的温柔模样</span></p><p begin="02:26.568" end="02:30.670" ttm:agent="v1" itunes:key="L17"><span begin="02:26.568" end="02:26.943">今</span><span begin="02:26.943" end="02:27.459">も</span><span begin="02:27.986" end="02:28.391">どこ</span><span begin="02:28.391" end="02:28.909">か</span><span begin="02:29.543" end="02:29.925">遠</span><span begin="02:29.925" end="02:30.670">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今已在不知名的远方</span></p><p begin="02:35.729" end="02:41.792" ttm:agent="v1" itunes:key="L18"><span begin="02:35.729" end="02:36.096">雨</span><span begin="02:36.096" end="02:36.532">を受</span><span begin="02:36.532" end="02:37.044">け</span><span begin="02:37.265" end="02:37.983">歌</span><span begin="02:37.983" end="02:38.417">い出</span><span begin="02:38.417" end="02:38.783">す</span> <span begin="02:38.783" end="02:39.951">人目</span><span begin="02:39.951" end="02:40.300">も</span><span begin="02:40.300" end="02:40.684">構</span><span begin="02:40.684" end="02:41.084">わ</span><span begin="02:41.084" end="02:41.792">ず</span><span ttm:role="x-translation" xml:lang="zh-Hans">淋着雨放声歌唱</span></p><p begin="02:41.842" end="02:47.897" ttm:agent="v1" itunes:key="L19"><span begin="02:41.842" end="02:42.301">この</span><span begin="02:42.301" end="02:42.685">道</span><span begin="02:42.685" end="02:43.151">が</span><span begin="02:43.463" end="02:44.181">続</span><span begin="02:44.181" end="02:44.549">くの</span><span begin="02:44.549" end="02:44.799">は</span> <span begin="02:44.930" end="02:46.155">続け</span><span begin="02:46.155" end="02:46.354">と</span><span begin="02:46.354" end="02:46.898">願っ</span><span begin="02:46.898" end="02:47.298">たか</span><span begin="02:47.298" end="02:47.897">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">这条路之所以延续</span></p><p begin="02:48.047" end="02:55.117" ttm:agent="v1" itunes:key="L20"><span begin="02:48.047" end="02:48.867">また出会</span><span begin="02:48.867" end="02:49.290">う</span><span begin="02:49.547" end="02:50.376">夢</span><span begin="02:50.376" end="02:50.779">を見</span><span begin="02:50.779" end="02:51.041">る</span> <span begin="02:51.113" end="02:51.913">いつ</span><span begin="02:51.913" end="02:53.462">まで</span><span begin="02:53.462" end="02:55.117">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">一直以来 我都梦想着能与你再会</span></p><p begin="02:57.293" end="03:03.343" ttm:agent="v1" itunes:key="L21"><span begin="02:57.293" end="02:58.274">一欠片</span><span begin="02:58.416" end="02:59.582">握り</span><span begin="02:59.582" end="02:59.949">込ん</span><span begin="02:59.949" end="03:00.242">だ</span> <span begin="03:00.349" end="03:00.890">秘密</span><span begin="03:00.890" end="03:01.133">を</span><span begin="03:01.133" end="03:01.883">忘</span><span begin="03:01.883" end="03:02.333">れぬ</span><span begin="03:02.333" end="03:02.667">よう</span><span begin="03:02.667" end="03:03.343">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">把碎片紧握在手中</span></p><p begin="03:03.443" end="03:09.616" ttm:agent="v1" itunes:key="L22"><span begin="03:03.443" end="03:04.041">最後</span><span begin="03:04.041" end="03:04.498">まで</span><span begin="03:04.578" end="03:05.359">思</span><span begin="03:05.359" end="03:05.759">い</span><span begin="03:05.759" end="03:06.127">馳せ</span><span begin="03:06.127" end="03:06.432">る</span> <span begin="03:06.483" end="03:07.244">地球儀</span><span begin="03:07.244" end="03:07.641">を</span><span begin="03:07.641" end="03:08.425">回す</span><span begin="03:08.425" end="03:08.825">よう</span><span begin="03:08.825" end="03:09.616">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">放任回忆播放到最后</span></p><p begin="03:16.100" end="03:22.556" ttm:agent="v1" itunes:key="L23"><span begin="03:16.100" end="03:16.497">小</span><span begin="03:16.497" end="03:16.929">さ</span><span begin="03:16.929" end="03:17.097">な</span><span begin="03:17.097" end="03:17.646">自分</span><span begin="03:17.646" end="03:18.225">の</span> <span begin="03:18.423" end="03:18.780">正</span><span begin="03:18.780" end="03:19.230">しい</span><span begin="03:19.230" end="03:19.544">願</span><span begin="03:19.544" end="03:19.913">いか</span><span begin="03:19.913" end="03:20.540">ら</span><span begin="03:20.731" end="03:21.129">始</span><span begin="03:21.129" end="03:21.467">ま</span><span begin="03:21.467" end="03:21.830">るも</span><span begin="03:21.830" end="03:22.556">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切开始于微不足道的我</span></p><p begin="03:23.771" end="03:31.226" ttm:agent="v1" itunes:key="L24"><span begin="03:23.771" end="03:24.182">ひと</span><span begin="03:24.182" end="03:24.982">つ</span><span begin="03:25.276" end="03:25.731">寂</span><span begin="03:25.731" end="03:26.131">し</span><span begin="03:26.131" end="03:26.510">さを</span><span begin="03:26.510" end="03:26.961">抱</span><span begin="03:26.961" end="03:27.518">え</span> <span begin="03:27.972" end="03:28.638">僕は</span><span begin="03:28.638" end="03:29.000">道</span><span begin="03:29.000" end="03:29.686">を</span><span begin="03:30.263" end="03:30.782">曲が</span><span begin="03:30.782" end="03:31.226">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">于是怀着一点寂寞</span></p><p begin="03:34.947" end="03:41.065" ttm:agent="v1" itunes:key="L25"><span begin="03:34.947" end="03:35.266">風</span><span begin="03:35.266" end="03:35.727">を受</span><span begin="03:35.727" end="03:36.236">け</span><span begin="03:36.494" end="03:37.230">走</span><span begin="03:37.230" end="03:37.630">り出</span><span begin="03:37.630" end="03:37.923">す</span> <span begin="03:38.030" end="03:39.179">瓦礫</span><span begin="03:39.179" end="03:39.560">を</span><span begin="03:39.560" end="03:39.928">越え</span><span begin="03:39.928" end="03:40.328">てい</span><span begin="03:40.328" end="03:41.065">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">迎着风迈步奔跑</span></p><p begin="03:41.115" end="03:47.148" ttm:agent="v1" itunes:key="L26"><span begin="03:41.115" end="03:41.512">この</span><span begin="03:41.512" end="03:41.917">道</span><span begin="03:41.917" end="03:42.427">の</span><span begin="03:42.670" end="03:43.383">行く</span><span begin="03:43.383" end="03:43.767">先</span><span begin="03:43.767" end="03:44.073">に</span> <span begi