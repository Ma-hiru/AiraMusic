<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><amll:meta key="ncmMusicId" value="496869422"/><amll:meta key="appleMusicId" value="1263790415"/><amll:meta key="musicName" value="Uchiagehanabi"/><amll:meta key="artists" value="DAOKO×米津玄師"/><amll:meta key="album" value="Uchiagehanabi - Single"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:49.335"><div begin="00:19.836" end="03:48.179"><p begin="00:19.836" end="00:29.285" ttm:agent="v1" itunes:key="L1"><span begin="00:19.836" end="00:20.555">あの</span><span begin="00:20.555" end="00:21.247">日</span><span begin="00:21.247" end="00:21.485">見</span><span begin="00:21.485" end="00:22.427">渡</span><span begin="00:22.427" end="00:23.025">した</span><span begin="00:23.025" end="00:24.001">渚</span><span begin="00:24.001" end="00:24.505">を</span> <span begin="00:24.953" end="00:26.141">今も</span><span begin="00:26.141" end="00:26.815">思い</span><span begin="00:26.815" end="00:27.422">出す</span><span begin="00:27.422" end="00:27.717">ん</span><span begin="00:27.717" end="00:29.285">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">那天所眺望的海岸</span></p><p begin="00:29.753" end="00:38.999" ttm:agent="v1" itunes:key="L2"><span begin="00:29.753" end="00:31.046">砂の</span><span begin="00:31.046" end="00:31.525">上</span><span begin="00:31.525" end="00:32.135">に</span><span begin="00:32.135" end="00:33.400">刻んだ</span><span begin="00:33.400" end="00:34.015">言</span><span begin="00:34.015" end="00:34.683">葉</span> <span begin="00:34.846" end="00:35.598">君</span><span begin="00:35.598" end="00:35.995">の</span><span begin="00:35.995" end="00:37.256">後ろ</span><span begin="00:37.256" end="00:38.999">姿</span><span ttm:role="x-translation" xml:lang="zh-Hans">在沙滩上刻下的话语</span></p><p begin="00:39.975" end="00:49.013" ttm:agent="v1" itunes:key="L3"><span begin="00:39.975" end="00:40.603">寄り</span><span begin="00:40.603" end="00:41.857">返す</span><span begin="00:41.857" end="00:42.464">波</span><span begin="00:42.464" end="00:43.221">が</span> <span begin="00:43.333" end="00:44.462">足元</span><span begin="00:44.462" end="00:44.894">を</span><span begin="00:45.011" end="00:45.905">よぎり</span><span begin="00:45.905" end="00:46.486">何</span><span begin="00:46.486" end="00:47.066">かを</span><span begin="00:47.066" end="00:49.013">攫う</span><span ttm:role="x-translation" xml:lang="zh-Hans">涌动的波浪</span></p><p begin="00:49.915" end="00:58.736" ttm:agent="v1" itunes:key="L4"><span begin="00:49.915" end="00:50.535">夕</span><span begin="00:50.535" end="00:51.920">凪</span><span begin="00:51.920" end="00:52.126">の</span><span begin="00:52.126" end="00:53.278">中</span> <span begin="00:53.346" end="00:54.321">日暮れ</span><span begin="00:54.321" end="00:54.940">だけ</span><span begin="00:54.940" end="00:55.339">が</span><span begin="00:55.339" end="00:56.141">通り</span><span begin="00:56.141" end="00:57.176">過ぎて</span><span begin="00:57.176" end="00:57.387">行</span><span begin="00:57.387" end="00:58.736">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">风平浪静之中</span></p><p begin="00:59.887" end="01:04.669" ttm:agent="v1" itunes:key="L5"><span begin="00:59.887" end="01:00.411">パッと</span><span begin="01:00.411" end="01:00.851">光っ</span><span begin="01:00.851" end="01:01.167">て</span><span begin="01:01.167" end="01:01.715">咲い</span><span begin="01:01.715" end="01:02.263">た</span> <span begin="01:02.357" end="01:03.097">花火</span><span begin="01:03.097" end="01:03.437">を</span><span begin="01:03.437" end="01:03.891">見て</span><span begin="01:03.891" end="01:04.194">い</span><span begin="01:04.194" end="01:04.669">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">光芒怦然绽放</span></p><p begin="01:04.938" end="01:09.408" ttm:agent="v1" itunes:key="L6"><span begin="01:04.938" end="01:05.403">きっと</span><span begin="01:05.403" end="01:05.744">まだ</span> <span begin="01:06.276" end="01:07.088">終わら</span><span begin="01:07.088" end="01:07.506">ない</span><span begin="01:07.506" end="01:07.890">夏</span><span begin="01:07.890" end="01:09.408">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一定是夏天还未结束</span></p><p begin="01:09.842" end="01:14.831" ttm:agent="v1" itunes:key="L7"><span begin="01:09.842" end="01:10.983">曖昧な</span><span begin="01:10.983" end="01:11.673">心</span><span begin="01:11.673" end="01:12.102">を</span> <span begin="01:12.401" end="01:12.787">溶</span><span begin="01:12.787" end="01:13.387">かして</span><span begin="01:13.387" end="01:14.185">繋い</span><span begin="01:14.185" end="01:14.831">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">将暧昧的心结解开再紧紧相连</span></p><p begin="01:14.839" end="01:20.168" ttm:agent="v1" itunes:key="L8"><span begin="01:14.839" end="01:15.350">この</span><span begin="01:15.350" end="01:16.154">夜が</span> <span begin="01:16.189" end="01:17.253">続いて</span><span begin="01:17.253" end="01:17.936">欲し</span><span begin="01:17.936" end="01:18.289">かっ</span><span begin="01:18.289" end="01:20.168">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿今夜永不结束</span></p><p begin="01:30.211" end="01:34.891" ttm:agent="v2" itunes:key="L9"><span begin="01:30.211" end="01:30.684">「あと</span><span begin="01:30.684" end="01:31.162">何度</span><span begin="01:31.162" end="01:31.655">君と</span><span begin="01:31.655" end="01:32.332">同じ</span><span begin="01:32.332" end="01:33.045">花火を</span><span begin="01:33.045" end="01:33.782">見られる</span><span begin="01:33.782" end="01:34.306">かな」っ</span><span begin="01:34.306" end="01:34.891">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">还能与你一起看几次</span></p><p begin="01:34.900" end="01:39.046" ttm:agent="v2" itunes:key="L10"><span begin="01:34.900" end="01:35.237">笑</span><span begin="01:35.237" end="01:35.478">う</span><span begin="01:35.478" end="01:35.962">顔</span><span begin="01:35.962" end="01:36.124">に</span><span begin="01:36.124" end="01:36.581">何</span><span begin="01:36.581" end="01:36.717">が</span><span begin="01:36.717" end="01:37.379">できる</span><span begin="01:37.379" end="01:37.940">だろう</span><span begin="01:37.940" end="01:39.046">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">面对你的笑容 我又能做些什么呢</span></p><p begin="01:40.277" end="01:44.761" ttm:agent="v2" itunes:key="L11"><span begin="01:40.277" end="01:40.971">傷つ</span><span begin="01:40.971" end="01:41.112">く</span><span begin="01:41.112" end="01:41.603">こと</span> <span begin="01:41.603" end="01:42.290">喜ぶ</span><span begin="01:42.290" end="01:42.870">こと</span> <span begin="01:42.870" end="01:43.602">繰り返す</span><span begin="01:43.602" end="01:44.073">波と</span><span begin="01:44.073" end="01:44.761">情動</span><span ttm:role="x-translation" xml:lang="zh-Hans">受伤亦或是喜悦</span></p><p begin="01:44.804" end="01:49.628" ttm:agent="v2" itunes:key="L12"><span begin="01:44.804" end="01:45.416">焦</span><span begin="01:45.416" end="01:45.902">燥</span> <span begin="01:45.902" end="01:47.868">最終列車</span><span begin="01:47.868" end="01:48.084">の</span><span begin="01:48.084" end="01:49.628">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">焦躁 响起了末班列车的声音</span></p><p begin="01:50.411" end="01:55.070" ttm:agent="v2" itunes:key="L13"><span begin="01:50.411" end="01:51.537">何度</span><span begin="01:51.537" end="01:51.818">で</span><span begin="01:51.818" end="01:52.499">も</span> <span begin="01:52.499" end="01:52.823">言</span><span begin="01:52.823" end="01:53.298">葉</span><span begin="01:53.298" end="01:53.900">にして</span><span begin="01:53.900" end="01:54.199">君</span><span begin="01:54.199" end="01:54.584">を</span><span begin="01:54.584" end="01:55.070">呼ぶよ</span><span ttm:role="x-translation" xml:lang="zh-Hans">无数次用言语呼唤着你</span></p><p begin="01:55.070" end="01:57.838" ttm:agent="v2" itunes:key="L14"><span begin="01:55.070" end="01:55.852">波間を</span><span begin="01:55.852" end="01:56.460">選び</span> <span begin="01:56.460" end="01:56.839">もう</span><span begin="01:56.839" end="01:57.838">一度</span><span ttm:role="x-translation" xml:lang="zh-Hans">向着海浪 再一次</span></p><p begin="02:00.558" end="02:08.569" ttm:agent="v2" itunes:key="L15"><span begin="02:00.558" end="02:01.302">もう</span><span begin="02:01.302" end="02:02.279">二度と</span><span begin="02:02.478" end="02:02.842">悲</span><span begin="02:02.842" end="02:03.620">し</span><span begin="02:03.620" end="02:03.946">まず</span><span begin="02:03.946" end="02:05.343">に</span><span begin="02:06.469" end="02:06.909">済</span><span begin="02:06.909" end="02:07.234">む</span><span begin="02:07.234" end="02:07.789">よう</span><span begin="02:07.789" end="02:08.569">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">祈祷不再感受那份悲伤</span></p><p begin="02:17.351" end="02:22.400" ttm:agent="v1" itunes:key="L16"><span begin="02:17.351" end="02:17.950">はっと</span><span begin="02:17.950" end="02:18.642">息を</span><span begin="02:18.642" end="02:19.164">飲め</span><span begin="02:19.164" end="02:19.860">ば</span> <span begin="02:19.914" end="02:20.281">消え</span><span begin="02:20.281" end="02:20.599">ちゃい</span><span begin="02:20.599" end="02:21.120">そうな</span><span begin="02:21.120" end="02:21.665">光</span><span begin="02:21.665" end="02:22.400">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">呼吸骤然停滞</span></p><p begin="02:22.408" end="02:26.932" ttm:agent="v1" itunes:key="L17"><span begin="02:22.408" end="02:22.921">きっと</span><span begin="02:22.921" end="02:23.529">まだ</span> <span begin="02:23.753" end="02:24.458">胸に</span><span begin="02:24.458" end="02:24.967">住</span><span begin="02:24.967" end="02:25.235">んで</span><span begin="02:25.235" end="02:25.355">い</span><span begin="02:25.355" end="02:26.932">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">一定仍留存在心中</span></p><p begin="02:27.335" end="02:32.314" ttm:agent="v1" itunes:key="L18"><span begin="02:27.335" end="02:27.770">手を</span><span begin="02:27.770" end="02:28.050">伸ば</span><span begin="02:28.050" end="02:28.457">せ</span><span begin="02:28.457" end="02:28.720">ば</span><span begin="02:28.720" end="02:29.164">触れ</span><span begin="02:29.164" end="02:29.944">た</span> <span begin="02:29.944" end="02:30.455">あった</span><span begin="02:30.455" end="02:30.931">かい</span><span begin="02:30.931" end="02:31.663">未来</span><span begin="02:31.663" end="02:32.314">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">伸出手就能触及</span></p><p begin="02:32.323" end="02:37.622" ttm:agent="v1" itunes:key="L19"><span begin="02:32.323" end="02:33.140">ひそかに</span><span begin="02:33.140" end="02:34.257">二</span><span begin="02:34.257" end="02:34.684">人</span><span begin="02:34.684" end="02:34.893">を</span><span begin="02:34.893" end="02:35.757">見て</span><span begin="02:35.757" end="02:35.984">い</span><span begin="02:35.984" end="02:37.622">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">默默地守望着两人</span></p><p begin="02:38.424" end="02:40.548" ttm:agent="v1" itunes:key="L20"><span begin="02:38.424" end="02:38.857">パッと</span><span begin="02:38.857" end="02:39.306">花火</span><span begin="02:39.306" end="02:40.548">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">怦然绽放的烟花</span></p><p begin="02:39.490" end="02:41.521" ttm:agent="v2" itunes:key="L21"><span begin="02:39.490" end="02:40.051">パッと</span><span begin="02:40.051" end="02:40.582">花火</span><span begin="02:40.582" end="02:41.521">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">在夜空中绽放后</span></p><p begin="02:40.858" end="02:42.663" ttm:agent="v1" itunes:key="L22"><span begin="02:40.858" end="02:41.457">夜に</span><span begin="02:41.457" end="02:41.800">咲い</span><span begin="02:41.800" end="02:42.663">た</span></p><p begin="02:42.189" end="02:43.854" ttm:agent="v2" itunes:key="L23"><span begin="02:42.189" end="02:42.842">夜に</span><span begin="02:42.842" end="02:43.021">咲い</span><span begin="02:43.021" end="02:43.854">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">在夜空中绽放后</span></p><p begin="02:43.387" end="02:45.606" ttm:agent="v1" itunes:key="L24"><span begin="02:43.387" end="02:44.013">夜に</span><span begin="02:44.013" end="02:44.308">咲い</span><span begin="02:44.308" end="02:45.606">て</span></p><p begin="02:44.598" end="02:46.284" ttm:agent="v2" itunes:key="L25"><span begin="02:44.598" end="02:45.173">夜に</span><span begin="02:45.173" end="02:45.570">咲い</span><span begin="02:45.570" end="02:46.284">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">又静静地消失</span></p><p begin="02:46.014" end="02:47.991" ttm:agent="v1" itunes:key="L26"><span begin="02:46.014" end="02:46.632">静かに</span><span begin="02:46.632" end="02:46.882">消え</span><span begin="02:46.882" end="02:47.991">た</span></p><p begin="02:47.072" end="02:48.722" ttm:agent="v2" itunes:key="L27"><span begin="02:47.072" end="02:47.741">静かに</span><span begin="02:47.741" end="02:48.058">消え</span><span begin="02:48.058" end="02:48.722">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">请不要离开</span></p><p begin="02:48.388" end="02:50.394" ttm:agent="v1" itunes:key="L28"><span begin="02:48.388" end="02:49.199">離さない</span><span begin="02:49.199" end="02:50.394">で</span></p><p begin="02:49.543" end="02:51.201" ttm:agent="v2" itunes:key="L29"><span begin="02:49.543" end="02:50.274">離れ</span><span begin="02:50.274" end="02:50.538">ない</span><span begin="02:50.538" end="02:51.201">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">再给一点点时间</span></p><p begin="02:50.852" end="02:52.805" ttm:agent="v1" itunes:key="L30"><span begin="02:50.852" end="02:51.195">もう</span><span begin="02:51.195" end="02:51.752">少しだ</span><span begin="02:51.752" end="02:52.805">け</span></p><p begin="02:52.214" end="02:54.044" ttm:agent="v2" itunes:key="L31"><span begin="02:52.214" end="02:52.503">もう</span><span begin="02:52.503" end="02:52.938">少し</span><span begin="02:52.938" end="02:53.101">だ</span><span begin="02:53.101" end="02:54.044">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">再给一点点时间</span></p><p begin="02:53.355" end="02:54.600" ttm:agent="v1" itunes:key="L32"><span begin="02:53.355" end="02:53.673">もう</span><span begin="02:53.673" end="02:54.275">少しだ</span><span begin="02:54.275" end="02:54.600">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">就这样一直</span></p><p begin="02:54.557" end="02:57.464" ttm:agent="v1" itunes:key="L33"><span begin="02:54.557" end="02:54.926">この</span><span begin="02:54.926" end="02:55.258">ま</span><span begin="02:55.258" end="02:55.890">ま</span><span begin="02:55.890" end="02:57.464">で</span></p><p begin="03:07.303" end="03:16.772" ttm:agent="v1" itunes:key="L34"><span begin="03:07.303" end="03:08.092">あの</span><span begin="03:08.092" end="03:08.695">日</span><span begin="03:08.695" end="03:09.908">見渡</span><span begin="03:09.908" end="03:10.593">した</span><span begin="03:10.593" end="03:11.599">渚</span><span begin="03:11.599" end="03:12.357">を</span> <span begin="03:12.357" end="03:13.438">今も</span><span begin="03:13.438" end="03:14.364">思い</span><span begin="03:14.364" end="03:15.289">出すん</span><span begin="03:15.289" end="03:16.772">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">那天所眺望的海岸</span></p><p begin="03:17.328" end="03:26.839" ttm:agent="v1" itunes:key="L35"><span begin="03:17.328" end="03:18.172">砂</span><span begin="03:18.172" end="03:18.514">の</span><span begin="03:18.514" end="03:19.633">上に</span><span begin="03:19.633" end="03:20.875">刻んだ</span><span begin="03:20.875" end="03:21.598">言</span><span begin="03:21.598" end="03:22.124">葉</span> <span begin="03:22.352" end="03:23.096">君</span><span begin="03:23.096" end="03:23.493">の</span><span begin="03:23.493" end="03:24.665">後ろ</span><span begin="03:24.665" end="03:26.839">姿</span><span ttm:role="x-translation" xml:lang="zh-Hans">在沙滩上刻下的话语</span></p><p begin="03:27.474" end="03:32.186" ttm:agent="v1" itunes:key="L36"><span begin="03:27.474" end="03:28.027">パッと</span><span begin="03:28.027" end="03:28.621">光って</span><span begin="03:28.621" end="03:29.241">咲い</span><span begin="03:29.241" end="03:29.651">た</span> <span begin="03:29.758" end="03:30.495">花火</span><span begin="03:30.495" end="03:30.898">を</span><span begin="03:30.898" end="03:31.373">見て</span><span begin="03:31.373" end="03:31.591">い</span><span begin="03:31.591" end="03:32.186">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">光芒怦然绽放</span></p><p begin="03:32.482" end="03:36.857" ttm:agent="v1" itunes:key="L37"><span begin="03:32.482" end="03:32.937">きっと</span><span begin="03:32.937" end="03:33.359">まだ</span> <span begin="03:33.772" end="03:34.231">終わ</span><span begin="03:34.231" end="03:34.538">ら</span><span begin="03:34.538" end="03:35.015">ない</span><span begin="03:35.015" end="03:35.304">夏</span><span begin="03:35.304" end="03:36.857">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">还未结束的夏天 一定会将</span></p><p begin="03:37.449" end="03:42.146" ttm:agent="v1" itunes:key="L38"><span begin="03:37.449" end="03:38.457">曖昧な</span><span begin="03:38.457" end="03:39.195">心</span><span begin="03:39.195" end="03:39.655">を</span> <span begin="03:39.824" end="03:40.275">溶</span><span begin="03:40.275" end="03:40.390">か</span><span begin="03:40.390" end="03:40.924">して</span><span begin="03:40.924" end="03:41.659">繋い</span><span begin="03:41.659" end="03:42.146">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">暧昧的心结融化相连在一起</span></p><p begin="03:42.444" end="03:48.179" ttm:agent="v1" itunes:key="L39"><span begin="03:42.444" end="03:42.750">この</span><span begin="03:42.750" end="03:43.125">夜</span><span begin="03:43.125" end="03:43.663">が</span> <span begin="03:43.663" end="03:44.323">続</span><span begin="03:44.323" end="03:44.672">いて</span><span begin="03:44.672" end="03:45.291">欲し</span><span begin="03:45.291" end="03:45.813">かっ</span><span begin="03:45.813" end="03:48.179">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿今夜永不结束</span></p></div></body></tt>