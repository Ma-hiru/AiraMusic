<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="ncmMusicId" value="3337657311"/><amll:meta key="appleMusicId" value="1867687787"/><amll:meta key="musicName" value="Cold Night"/><amll:meta key="artists" value="HANA"/><amll:meta key="album" value="Cold Night - Single"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:12.995"><div begin="00:04.474" end="03:09.324"><p begin="00:04.474" end="00:05.739" ttm:agent="v1" itunes:key="L1"><span begin="00:04.474" end="00:04.658">I</span> <span begin="00:04.658" end="00:04.853">don't</span> <span begin="00:04.853" end="00:05.036">believe</span> <span begin="00:05.036" end="00:05.176">in</span> <span begin="00:05.176" end="00:05.381">my</span><span begin="00:05.381" end="00:05.739">self</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不相信自己</span></p><p begin="00:08.350" end="00:09.531" ttm:agent="v1" itunes:key="L2"><span begin="00:08.350" end="00:08.679">高</span><span begin="00:08.679" end="00:08.922">く</span><span begin="00:08.922" end="00:09.151">飛</span><span begin="00:09.151" end="00:09.531">ぶ</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要高高飞翔</span></p><p begin="00:12.157" end="00:13.816" ttm:agent="v1" itunes:key="L3"><span begin="00:12.157" end="00:12.446">They</span> <span begin="00:12.446" end="00:12.735">think</span> <span begin="00:12.735" end="00:13.021">I'm</span> <span begin="00:13.021" end="00:13.231">a</span> <span begin="00:13.231" end="00:13.816">fool</span><span ttm:role="x-translation" xml:lang="zh-Hans">他们都认为我是傻瓜</span></p><p begin="00:15.918" end="00:17.423" ttm:agent="v1" itunes:key="L4"><span begin="00:15.918" end="00:16.207">They</span> <span begin="00:16.207" end="00:16.496">think</span> <span begin="00:16.496" end="00:16.782">I'm</span> <span begin="00:16.782" end="00:16.992">a</span> <span begin="00:16.992" end="00:17.423">fool</span><span ttm:role="x-translation" xml:lang="zh-Hans">他们都认为我是傻瓜</span></p><p begin="00:17.433" end="00:19.092" ttm:agent="v1" itunes:key="L5"><span begin="00:17.433" end="00:17.759">They</span> <span begin="00:17.759" end="00:18.048">think</span> <span begin="00:18.048" end="00:18.334">I'm</span> <span begin="00:18.334" end="00:18.544">a</span> <span begin="00:18.544" end="00:19.092">fool</span><span ttm:role="x-translation" xml:lang="zh-Hans">他们都认为我是傻瓜</span></p><p begin="00:19.102" end="00:20.129" ttm:agent="v1" itunes:key="L6"><span begin="00:19.102" end="00:19.613">Rain</span> <span begin="00:19.613" end="00:20.129">drop</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨滴落下 哪怕睁开了双眼</span></p><p begin="00:21.217" end="00:22.917" ttm:agent="v1" itunes:key="L7"><span begin="00:21.217" end="00:21.789">目を</span><span begin="00:21.789" end="00:22.443">覚まし</span><span begin="00:22.443" end="00:22.745">て</span><span begin="00:22.745" end="00:22.917">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便睁开双眼</span></p><p begin="00:22.968" end="00:24.158" ttm:agent="v1" itunes:key="L8"><span begin="00:22.968" end="00:23.517">Same</span> <span begin="00:23.517" end="00:24.158">old</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切如故 依然毫无改变</span></p><p begin="00:25.054" end="00:26.744" ttm:agent="v1" itunes:key="L9"><span begin="00:25.054" end="00:25.847">何も</span><span begin="00:25.847" end="00:26.744">変わらない</span><span ttm:role="x-translation" xml:lang="zh-Hans">一切如旧不曾改变</span></p><p begin="00:26.817" end="00:28.251" ttm:agent="v1" itunes:key="L10"><span begin="00:26.817" end="00:27.547">Grow</span> <span begin="00:27.547" end="00:28.251">up</span><span ttm:role="x-translation" xml:lang="zh-Hans">历经成长 我对镜中的自己说</span></p><p begin="00:28.987" end="00:31.729" ttm:agent="v1" itunes:key="L11"><span begin="00:28.987" end="00:29.775">Mirrorの</span><span begin="00:29.775" end="00:30.703">私に</span><span begin="00:30.703" end="00:31.150">言う</span><span begin="00:31.150" end="00:31.729">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">对着镜中的自己说道</span></p><p begin="00:31.863" end="00:34.452" ttm:agent="v1" itunes:key="L12"><span begin="00:31.863" end="00:32.806">泣いても</span><span begin="00:32.806" end="00:33.932">変わらない</span><span begin="00:33.932" end="00:34.452">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">哭泣也改变不了现状</span></p><p begin="00:34.484" end="00:38.251" ttm:agent="v1" itunes:key="L13"><span begin="00:34.484" end="00:35.228">I</span> <span begin="00:35.228" end="00:35.800">don't</span> <span begin="00:35.800" end="00:36.477">know</span> <span begin="00:36.477" end="00:36.935">where</span> <span begin="00:36.935" end="00:37.243">to</span> <span begin="00:37.243" end="00:38.251">go</span><span ttm:role="x-translation" xml:lang="zh-Hans">我根本不知道该何去何从</span></p><p begin="00:38.261" end="00:42.074" ttm:agent="v1" itunes:key="L14"><span begin="00:38.261" end="00:39.404">叶</span><span begin="00:39.552" end="00:40.253">えたい</span><span begin="00:40.253" end="00:40.989">夢が</span><span begin="00:40.989" end="00:41.679">あるの</span><span begin="00:41.679" end="00:42.074">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明心怀渴望实现的愿望</span></p><p begin="00:42.137" end="00:46.554" ttm:agent="v1" itunes:key="L15"><span begin="00:42.137" end="00:42.897">あ</span><span begin="00:42.897" end="00:43.384">の</span><span begin="00:43.384" end="00:43.703">子</span><span begin="00:43.703" end="00:44.807">みたいに</span><span begin="00:44.807" end="00:45.315">は</span><span begin="00:45.315" end="00:46.019">なれな</span><span begin="00:46.019" end="00:46.554">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">却无法成为像那孩子一样的人</span></p><p begin="00:47.191" end="00:49.555" ttm:agent="v1" itunes:key="L16"><span begin="00:47.191" end="00:48.029">慣れな</span><span begin="00:48.029" end="00:49.555">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">难以适应这样的现实</span></p><p begin="00:50.496" end="00:51.761" ttm:agent="v1" itunes:key="L17"><span begin="00:50.496" end="00:50.699">I</span> <span begin="00:50.699" end="00:50.885">don't</span> <span begin="00:50.885" end="00:51.058">believe</span> <span begin="00:51.058" end="00:51.198">in</span> <span begin="00:51.198" end="00:51.403">my</span><span begin="00:51.403" end="00:51.761">self</span><span ttm:role="x-translation" xml:lang="zh-Hans">我根本就不相信我自己</span></p><p begin="00:51.962" end="00:53.766" ttm:agent="v1" itunes:key="L18"><span begin="00:51.962" end="00:52.251">But</span> <span begin="00:52.251" end="00:52.749">I</span> <span begin="00:52.749" end="00:53.220">don't</span> <span begin="00:53.220" end="00:53.766">care</span><span ttm:role="x-translation" xml:lang="zh-Hans">但我完全不会在意</span></p><p begin="00:54.438" end="00:55.619" ttm:agent="v1" itunes:key="L19"><span begin="00:54.438" end="00:54.767">高</span><span begin="00:54.767" end="00:55.010">く</span><span begin="00:55.010" end="00:55.239">飛</span><span begin="00:55.239" end="00:55.619">ぶ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我要高飞而起</span></p><p begin="00:55.769" end="00:58.085" ttm:agent="v1" itunes:key="L20"><span begin="00:55.769" end="00:56.185">With</span> <span begin="00:56.185" end="00:56.624">my</span> <span begin="00:56.624" end="00:57.119">new</span> <span begin="00:57.119" end="00:58.085">shoes</span><span ttm:role="x-translation" xml:lang="zh-Hans">踩着脚上的这双新鞋</span></p><p begin="00:58.206" end="00:59.910" ttm:agent="v1" itunes:key="L21"><span begin="00:58.206" end="00:58.495">They</span> <span begin="00:58.495" end="00:58.784">think</span> <span begin="00:58.784" end="00:59.070">I'm</span> <span begin="00:59.070" end="00:59.280">a</span> <span begin="00:59.280" end="00:59.910">fool</span><span ttm:role="x-translation" xml:lang="zh-Hans">那些人都认为我很愚蠢</span></p><p begin="00:59.920" end="01:01.429" ttm:agent="v1" itunes:key="L22"><span begin="00:59.920" end="01:00.446">I</span> <span begin="01:00.446" end="01:00.922">don't</span> <span begin="01:00.922" end="01:01.429">care</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我完全不在乎</span></p><p begin="01:01.904" end="01:03.403" ttm:agent="v1" itunes:key="L23"><span begin="01:01.904" end="01:02.401">I</span> <span begin="01:02.401" end="01:02.895">don't</span> <span begin="01:02.895" end="01:03.403">care</span><span ttm:role="x-translation" xml:lang="zh-Hans">我根本不在意 都无所谓</span></p><p begin="01:03.620" end="01:05.201" ttm:agent="v1" itunes:key="L24"><span begin="01:03.620" end="01:04.218">I</span> <span begin="01:04.218" end="01:04.694">don't</span> <span begin="01:04.694" end="01:05.201">care</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不在乎</span></p><p begin="01:06.186" end="01:07.786" ttm:agent="v1" itunes:key="L25"><span begin="01:06.186" end="01:06.755">Watch</span> <span begin="01:06.755" end="01:07.786">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">认真看好 这就是我</span></p><p begin="01:07.796" end="01:09.547" ttm:agent="v1" itunes:key="L26"><span begin="01:07.796" end="01:08.607">This</span> <span begin="01:08.607" end="01:08.935">is</span> <span begin="01:08.935" end="01:09.547">me</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我</span></p><p begin="01:09.729" end="01:13.419" ttm:agent="v1" itunes:key="L27"><span begin="01:09.729" end="01:10.545">転ん</span><span begin="01:10.545" end="01:11.648">だ</span> <span begin="01:11.773" end="01:12.427">数</span><span begin="01:12.427" end="01:12.791">だ</span><span begin="01:12.791" end="01:13.419">け</span><span ttm:role="x-translation" xml:lang="zh-Hans">不论跌倒多少次</span></p><p begin="01:13.429" end="01:16.917" ttm:agent="v1" itunes:key="L28"><span begin="01:13.429" end="01:13.721">I've</span> <span begin="01:13.721" end="01:14.018">got</span> <span begin="01:14.018" end="01:15.211">nothing</span> <span begin="01:15.580" end="01:15.782">but</span> <span begin="01:15.782" end="01:16.259">this</span> <span begin="01:16.259" end="01:16.917">fire</span><span ttm:role="x-translation" xml:lang="zh-Hans">我一无所有 但心怀不熄的火焰</span></p><p begin="01:17.461" end="01:19.045" ttm:agent="v1" itunes:key="L29"><span begin="01:17.461" end="01:17.850">I'll</span> <span begin="01:17.850" end="01:18.282">show</span> <span begin="01:18.282" end="01:19.045">you</span><span ttm:role="x-translation" xml:lang="zh-Hans">我会让你们看到我的可能性</span></p><p begin="01:19.083" end="01:21.418" ttm:agent="v1" itunes:key="L30"><span begin="01:19.083" end="01:19.441">What</span> <span begin="01:19.441" end="01:19.723">I</span> <span begin="01:19.723" end="01:20.164">can</span> <span begin="01:20.164" end="01:21.418">do</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的一切</span></p><p begin="01:21.428" end="01:22.968" ttm:agent="v1" itunes:key="L31"><span begin="01:21.428" end="01:22.072">Cold</span> <span begin="01:22.072" end="01:22.968">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">寒夜漫漫 不见光芒</span></p><p begin="01:22.481" end="01:24.021" ttm:agent="v2" itunes:key="L32"><span begin="01:22.481" end="01:23.125">Cold</span> <span begin="01:23.125" end="01:24.021">night</span><span ttm:role="x-translation" xml:lang="zh-Hans">寒夜漫漫</span></p><p begin="01:23.448" end="01:24.875" ttm:agent="v1" itunes:key="L33"><span begin="01:23.448" end="01:24.028">No</span> <span begin="01:24.028" end="01:24.875">light</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有光芒</span></p><p begin="01:24.420" end="01:25.847" ttm:agent="v2" itunes:key="L34"><span begin="01:24.420" end="01:25.000">No</span> <span begin="01:25.000" end="01:25.847">light</span><span ttm:role="x-translation" xml:lang="zh-Hans">膝盖渗血 从来不曾有人注意到这样的我</span></p><p begin="01:25.374" end="01:28.802" ttm:agent="v1" itunes:key="L35"><span begin="01:25.374" end="01:25.851">Blood</span> <span begin="01:25.