<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="3338315382"/><amll:meta key="appleMusicId" value="6808173147"/><amll:meta key="musicName" value="lulu."/><amll:meta key="artists" value="Mrs. GREEN APPLE"/><amll:meta key="album" value="lulu."/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:01.509" end="00:01.892">owa</span><span begin="00:01.892" end="00:02.743">riga</span><span begin="00:02.857" end="00:03.090">kita</span><span begin="00:03.090" end="00:03.511">ra</span></text><text for="L3"><span begin="00:06.950" end="00:07.555">douse</span><span begin="00:07.742" end="00:08.348">na</span><span begin="00:08.348" end="00:08.484">ra</span><span begin="00:08.484" end="00:08.590">ho</span><span begin="00:08.590" end="00:08.986">ra</span></text><text for="L5"><span begin="00:12.482" end="00:12.863">itsu</span><span begin="00:12.863" end="00:13.794">kano</span><span begin="00:13.930" end="00:14.203">ana</span><span begin="00:14.203" end="00:15.026">tano</span><span begin="00:15.251" end="00:15.892">kotoba</span><span begin="00:16.126" end="00:17.066">ga</span></text><text for="L6"><span begin="00:17.933" end="00:18.640">hidokusa</span><span begin="00:18.640" end="00:19.645">sa'tterua</span></text><text for="L8"><span begin="00:44.628" end="00:44.845">shi</span><span begin="00:44.845" end="00:45.465">reba</span><span begin="00:45.530" end="00:46.202">shirudakede</span><span begin="00:46.314" end="00:46.981">iino</span><span begin="00:46.981" end="00:47.244">ni</span></text><text for="L9"><span begin="00: