564" end="01:23.971">imamo</span><span begin="01:23.971" end="01:25.256">zu'tto</span><span begin="01:25.256" end="01:27.154">sou</span></text><text for="L22"><span begin="01:28.084" end="01:28.511">itsu</span><span begin="01:28.511" end="01:29.146">kanemo</span></text><text for="L23"><span begin="01:29.212" end="01:29.415">mou</span><span begin="01:29.415" end="01:29.897">suko</span><span begin="01:29.897" end="01:30.051">shi</span><span begin="01:30.051" end="01:30.608">ne</span></text><text for="L24"><span begin="01:30.611" end="01:30.877">se</span><span begin="01:30.877" end="01:31.420">kaini</span><span begin="01:31.420" end="01:32.029">yasashii</span><span begin="01:32.238" end="01:33.064">kaze</span><span begin="01:33.498" end="01:34.150">fuita</span><span begin="01:34.150" end="01:34.681">ra</span></text><text for="L25"><span begin="01:34.881" end="01:35.964">nanika</span><span begin="01:36.311" end="01:36.903">kawaru</span><span begin="01:36.903" end="01:37.455">no</span><span begin="01:37.475" end="01:38.309">deshou</span><span begin="01:38.309" end="01:38.759">ka</span></text><text for="L26"><span begin="01:39.076" end="01:39.977">「kaerita</span><span begin="01:40.151" end="01:40.735">ibashoga</span><span begin="01:40.878" end="01:41.508">aru」</span></text><text for="L27"><span begin="01:41.516" end="01:42.321">daremoga</span><span begin="01:42.489" end="01:43.447">konohoshino</span><span begin="01:43.447" end="01:44.191">shison</span></text><text for="L28"><span begin="01:44.275" end="01:44.569">yaku</span><span begin="01:44.569" end="01:45.184">sokuwa</span><span begin="01:45.184" end="01:45.609">ne</span></text><text for="L30"><span begin="01:47.291" end="01:47.743">atata</span><span begin="01:47.743" end="01:49.288">kaku</span><span begin="01:49.638" end="01:50.557">noko'tte</span><span begin="01:50.557" end="01:53.474">ru</span></text><text for="L31"><span begin="02:12.443" end="02:12.638">shi</span><span begin="02:12.638" end="02:13.250">reba</span><span begin="02:13.250" end="02:13.763">shirudake</span><span begin="02:13.854" end="02:14.677">komaruno</span><span begin="02:14.677" end="02:14.941">ni</span></text><text for="L32"><span begin="02:15.004" end="02:15.827">senakani</span><span begin="02:15.827" end="02:16.576">yudanete</span><span begin="02:16.576" end="02:17.228">shimau</span></text><text for="L34"><span begin="02:18.611" end="02:19.264">dokonimo</span><span begin="02:19.264" end="02:19.616">ika</span><span begin="02:19.879" end="02:20.172">na</span></text><text for="L35"><span begin="02:20.671" end="02:21.192">kokoni</span><span begin="02:21.192" end="02:21.527">ite</span><span begin="02:21.527" end="02:22.620">hoshiiyo</span></text><text for="L37"><span begin="02:23.441" end="02:24.047">sagashi</span><span begin="02:24.047" end="02:24.761">terumono</span><span begin="02:24.761" end="02:25.161">mitsuka</span><span begin="02:25.528" end="02:25.975">tara</span></text><text for="L38"><span begin="02:26.001" end="02:26.750">nanikaga</span><span begin="02:26.909" end="02:27.740">kuzurechai</span><span begin="02:27.740" end="02:28.219">sou</span></text><text for="L39"><span begin="02:28.885" end="02:29.143">tada</span><span begin="02:29.143" end="02:30.133">kuchibiru</span><span begin="02:30.133" end="02:30.611">wokami</span><span begin="02:30.801" end="02:31.292">rarara</span></text><text for="L40"><span begin="02:31.296" end="02:31.761">yureru</span><span begin="02:31.761" end="02:32.426">reesuno</span><span begin="02:32.426" end="02:33.054">kaate</span><span begin="02:33.054" end="02:33.803">nda</span></text><text for="L41"><span begin="02:34.037" end="02:34.489">wasu</span><span begin="02:34.489" end="02:36.417">renai</span><span begin="02:36.417" end="02:36.898"></span><span begin="02:37.006" end="02:38.229">noni</span></text><text for="L43"><span begin="02:44.655" end="02:45.364">kokorono</span><span begin="02:45.364" end="02:46.754">okusokoni</span><span begin="02:46.754" end="02:48.268">daijini</span><span begin="02:48.268" end="02:48.604">kimi</span><span begin="02:48.604" end="02:49.197">ga</span><span begin="02:49.262" end="02:49.511">i</span><span begin="02:49.511" end="02:50.155">ru</span></text><text for="L47"><span begin="02:55.896" end="02:56.323">itsu</span><span begin="02:56.323" end="02:56.958">ka</span></text><text for="L49"><span begin="03:06.659" end="03:07.515">watashi</span><span begin="03:07.515" end="03:08.917">ga</span><span begin="03:09.121" end="03:10.455">yasashiku</span><span begin="03:10.455" end="03:11.566">areta</span><span begin="03:11.566" end="03:13.167">ra</span></text><text for="L50"><span begin="03:13.638" end="03:14.368">nani</span><span begin="03:14.368" end="03:15.355">ka</span><span begin="03:15.391" end="03:16.266">kawaru</span><span begin="03:16.266" end="03:16.619">no</span><span begin="03:16.619" end="03:17.808">deshou</span><span begin="03:17.808" end="03:20.165">ka</span></text><text for="L51"><span begin="03:44.978" end="03:46.119">anohino</span><span begin="03:46.445" end="03:47.298">omoide</span><span begin="03:47.298" end="03:47.755">ni</span></text><text for="L52"><span begin="03:47.763" end="03:48.449">yasashiku</span><span begin="03:48.676" end="03:49.352">tsutsumare</span><span begin="03:49.352" end="03:49.796">aruko</span><span begin="03:49.796" end="03:50.450">u</span></text><text for="L53"><span begin="03:50.483" end="03:51.643">sabishisano</span><span begin="03:52.019" end="03:52.966">namidawo</span><span begin="03:53.362" end="03:54.785"></span><span begin="03:54.785" end="03:56.100"></span></text><text for="L54"><span begin="03:56.218" end="03:57.119">「kaerita</span><span begin="03:57.293" end="03:57.877">ibasho</span><span begin="03:58.020" end="03:58.650">gaaru」</span></text><text for="L55"><span begin="03:58.718" end="03:59.523">daremoga</span><span begin="03:59.691" end="04:00.649">konohoshino</span><span begin="04:00.649" end="04:01.393">shison</span></text><text for="L56"><span begin="04:01.432" end="04:01.658">ano</span><span begin="04:01.658" end="04:02.289">tokino</span><span begin="04:02.289" end="04:02.390"></span><span begin="04:02.390" end="04:02.783">neko</span></text><text for="L57"><span begin="04:02.916" end="04:03.455">kochi</span><span begin="04:03.455" end="04:03.669">wa</span><span begin="04:03.669" end="04:04.066">ne</span></text><text for="L58"><span begin="04:04.332" end="04:04.784">a</span><span begin="04:04.784" end="04:06.525">tataka</span><span begin="04:07.125" end="04:07.854">noko'tte</span><span begin="04:07.854" end="04:11.184">ru</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="04:30.627"><div begin="00:01.509" end="04:11.184"><p begin="00:01.509" end="00:03.511" ttm:agent="v1" itunes:key="L1"><span begin="00:01.509" end="00:01.892">終わ</span><span begin="00:01.892" end="00:02.743">りが</span><span begin="00:02.857" end="00:03.090">来た</span><span begin="00:03.090" end="00:03.511">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">在迎来结束的时刻时 我该说些什么呢</span></p><p begin="00:03.717" end="00:05.850" ttm:agent="v1" itunes:key="L2"><span begin="00:03.717" end="00:04.496">なんて</span><span begin="00:04.697" end="00:04.880">言</span><span begin="00:04.880" end="00:05.850">おう</span><span ttm:role="x-translation" xml:lang="zh-Hans">该说些什么才好</span></p><p begin="00:06.950" end="00:08.986" ttm:agent="v1" itunes:key="L3"><span begin="00:06.950" end="00:07.555">どうせ</span><span begin="00:07.742" end="00:08.348">な</span><span begin="00:08.348" end="00:08.484">ら</span> <span begin="00:08.484" end="00:08.590">ほ</span><span begin="00:08.590" end="00:08.986">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">既然如此的话 索性啊 别让我显得那么悲伤</span></p><p begin="00:09.017" end="00:11.133" ttm:agent="v1" itunes:key="L4"><span begin="00:09.017" end="00:09.930">哀しくない</span><span begin="00:10.162" end="00:10.262">様</span><span begin="00:10.262" end="00:11.133">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">不如让它不那么悲伤吧</span></p><p begin="00:12.482" end="00:17.066" ttm:agent="v1" itunes:key="L5"><span begin="00:12.482" end="00:12.863">いつ</span><span begin="00:12.863" end="00:13.794">かの</span><span begin="00:13.930" end="00:14.203">あな</span><span begin="00:14.203" end="00:15.026">たの</span><span begin="00:15.251" end="00:15.892">言葉</span><span begin="00:16.126" end="00:17.066">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">你曾经说过的每一字每一句</span></p><p begin="00:17.933" end="00:19.645" ttm:agent="v1" itunes:key="L6"><span begin="00:17.933" end="00:18.640">酷く</span><span begin="00:18.640" end="00:19.645">刺さってる</span><span ttm:role="x-translation" xml:lang="zh-Hans">都深深地刺痛我的心 却也留下温暖的印记</span></p><p begin="00:19.690" end="00:25.690" ttm:agent="v1" itunes:key="L7"><span begin="00:19.690" end="00:20.142">温</span><span begin="00:20.142" end="00:21.687">かく</span><span begin="00:22.037" end="00:22.956">残って</span><span begin="00:22.956" end="00:25.690">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">余温却依然残存</span></p><p begin="00:44.628" end="00:47.244" ttm:agent="v1" itunes:key="L8"><span begin="00:44.628" end="00:44.845">知</span><span begin="00:44.845" end="00:45.465">れば</span><span begin="00:45.530" end="00:46.202">知るだけで</span><span begin="00:46.314" end="00:46.981">いいの</span><span begin="00:46.981" end="00:47.244">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">只要能够有所了解就已经足够</span></p><p begin="00:47.259" end="00:49.387" ttm:agent="v1" itunes:key="L9"><span begin="00:47.259" end="00:47.907">何かを</span><span begin="00:48.195" end="00:49.387">求めてしまう</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我总忍不住有所渴求</span></p><p begin="00:49.987" end="00:50.813" ttm:agent="v1" itunes:key="L10"><span begin="00:49.987" end="00:50.813">大丈夫</span><span ttm:role="x-translation" xml:lang="zh-Hans">没关系</span></p><p begin="00:50.877" end="00:52.677" ttm:agent="v1" itunes:key="L11"><span begin="00:50.877" end="00:51.472">どこにも</span><span begin="00:51.599" end="00:51.847">行か</span><span begin="00:52.059" end="00:52.677">ないよ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我哪里都不会去的</span></p><p begin="00:52.937" end="00:54.900" ttm:agent="v1" itunes:key="L12"><span begin="00:52.937" end="00:53.540">どこにも</span><span begin="00:53.670" end="00:53.966">行け</span><span begin="00:54.134" end="00:54.900">ないよ。</span><span ttm:role="x-translation" xml:lang="zh-Hans">其实我已无处可去</span></p><p begin="00:55.144" end="00:55.640" ttm:agent="v1" itunes:key="L13"><span begin="00:55.144" end="00:55.640">ね。</span><span ttm:role="x-translation" xml:lang="zh-Hans">对吧</span></p><p begin="00:55.645" end="00:58.241" ttm:agent="v1" itunes:key="L14"><span begin="00:55.645" end="00:56.266">探</span><span begin="00:56.266" end="00:56.969">してるもの</span><span begin="00:56.969" end="00:57.275">見つ</span><span begin="00:57.275" end="00:58.241">かったら</span><span ttm:role="x-translation" xml:lang="zh-Hans">当我终于找到寻觅已久的东西时</span></p><p begin="00:58.245" end="01:00.693" ttm:agent="v1" itunes:key="L15"><span begin="00:58.245" end="00:59.013">何かが</span><span begin="00:59.147" end="00:59.910">途切れちゃい</span><span begin="00:59.910" end="01:00.693">そう</span><span ttm:role="x-translation" xml:lang="zh-Hans">似乎就有什么会戛然而止</span></p><p begin="01:01.126" end="01:03.513" ttm:agent="v1" itunes:key="L16"><span begin="01:01.126" end="01:01.334">ただ</span><span begin="01:01.334" end="01:01.977">鼻</span><span begin="01:01.977" end="01:02.848">歌に隠し</span> <span begin="01:03.000" end="01:03.513">ラララ</span><span ttm:role="x-translation" xml:lang="zh-Hans">只能将心绪藏进哼唱的旋律 啦啦啦</span></p><p begin="01:03.522" end="01:05.940" ttm:agent="v1" itunes:key="L17"><span begin="01:03.522" end="01:04.631">続く日めくり</span><span begin="01:04.797" end="01:04.962">カ</span><span begin="01:05.168" end="01:05.434">レン</span><span begin="01:05.478" end="01:05.940">ダー</span><span ttm:role="x-translation" xml:lang="zh-Hans">就这样一页页地翻过日历</span></p><p begin="01:06.335" end="01:10.527" ttm:agent="v1" itunes:key="L18"><span begin="01:06.335" end="01:06.787">忘れ</span><span begin="01:06.787" end="01:08.715">な</span><span begin="01:08.715" end="01:09.196">いの</span><span begin="01:09.304" end="01:10.527">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明就不曾忘记 为何仍会就此远去</span></p><p begin="01:11.608" end="01:16.210" ttm:agent="v1" itunes:key="L19"><span begin="01:11.608" end="01:12.080">何故か</span><span begin="01:12.228" end="01:14.021">遠</span><span begin="01:14.021" end="01:14.560">くな</span><span begin="01:14.560" end="01:16.210">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">为何却渐行渐远</span></p><p begin="01:16.919" end="01:22.265" ttm:agent="v1" itunes:key="L20"><span begin="01:16.919" end="01:17.591">瞳の</span><span begin="01:17.591" end="01:19.492">裏</span><span begin="01:19.492" end="01:20.281">にいつも</span><span begin="01:20.504" end="01:20.889">君</span><span begin="01:20.889" end="01:21.311">は</span><span begin="01:21.377" end="01:21.616">居</span><span begin="01:21.616" end="01:22.265">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">你始终存在于我的双眸深处</span></p><p begin="01:22.564" end="01:27.154" ttm:agent="v1" itunes:key="L21"><span begin="01:22.564" end="01:23.971">今も</span> <span begin="01:23.971" end="01:25.256">ずっと</span><span begin="01:25.256" end="01:27.154">そう</span><span ttm:role="x-translation" xml:lang="zh-Hans">时至今日 依旧如此</span></p><p begin="01:28.084" end="01:29.146" ttm:agent="v1" itunes:key="L22"><span begin="01:28.084" end="01:28.511">い</span><span begin="01:28.511" end="01:29.146">つかね</span><span ttm:role="x-translation" xml:lang="zh-Hans">会有那一天 再稍微等一下吧</span></p><p begin="01:29.212" end="01:30.608" ttm:agent="v1" itunes:key="L23"><span begin="01:29.212" end="01:29.415">もう</span><span begin="01:29.415" end="01:29.897">少</span><span begin="01:29.897" end="01:30.051">し</span><span begin="01:30.051" end="01:30.608">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">再稍等片刻吧</span></p><p begin="01:30.611" end="01:34.681" ttm:agent="v1" itunes:key="L24"><span begin="01:30.611" end="01:30.877">世</span><span begin="01:30.877" end="01:31.420">界に</span><span begin="01:31.420" end="01:32.029">優しい</span><span begin="01:32.238" end="01:33.064">風が</span><span begin="01:33.498" end="01:34.150">吹いた</span><span begin="01:34.150" end="01:34.681">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若是这个世界拂过一阵温柔的风</span></p><p begin="01:34.881" end="01:38.759" ttm:agent="v1" itunes:key="L25"><span begin="01:34.881" end="01:35.964">何か</span><span begin="01:36.311" end="01:36.903">変わる</span><span begin="01:36.903" end="01:37.455">の</span><span begin="01:37.475" end="01:38.309">でしょう</span><span begin="01:38.309" end="01:38.759">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">是否会有什么随之发生改变</span></p><p begin="01:39.076" end="01:41.508" ttm:agent="v1" itunes:key="L26"><span begin="01:39.076" end="01:39.977">「帰りたい</span><span begin="01:40.151" end="01:40.735">場所が</span><span begin="01:40.878" end="01:41.508">ある」</span><span ttm:role="x-translation" xml:lang="zh-Hans">“我有渴望回去的归所”</span></p><p begin="01:41.516" end="01:44.191" ttm:agent="v1" itunes:key="L27"><span begin="01:41.516" end="01:42.321">誰もが</span><span begin="01:42.489" end="01:43.447">この星の</span><span begin="01:43.447" end="01:44.191">子孫</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们每个人都是这颗星球的子孙</span></p><p begin="01:44.275" end="01:45.609" ttm:agent="v1" itunes:key="L28"><span begin="01:44.275" end="01:44.569">約</span><span begin="01:44.569" end="01:45.184">束は</span><span begin="01:45.184" end="01:45.609">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">约定这种事情 需要格外珍惜</span></p><p begin="01:45.919" end="01:47.009" ttm:agent="v1" itunes:key="L29"><span begin="01:45.919" end="01:46.388">大</span><span begin="01:46.388" end="01:47.009">事にね</span><span ttm:role="x-translation" xml:lang="zh-Hans">要好好珍藏啊</span></p><p begin="01:47.291" end="01:53.474" ttm:agent="v1" itunes:key="L30"><span begin="01:47.291" end="01:47.743">温</span><span begin="01:47.743" end="01:49.288">かく</span><span begin="01:49.638" end="01:50.557">残って</span><span begin="01:50.557" end="01:53.474">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">它会留下温暖的印记</span></p><p begin="02:12.443" end="02:14.941" ttm:agent="v1" itunes:key="L31"><span begin="02:12.443" end="02:12.638">知</span><span begin="02:12.638" end="02:13.250">れば</span><span begin="02:13.250" end="02:13.763">知るだけ</span><span begin="02:13.854" end="02:14.677">困るの</span><span begin="02:14.677" end="02:14.941">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明随着不断了解而感到困惑</span></p><p begin="02:15.004" end="02:17.228" ttm:agent="v1" itunes:key="L32"><span begin="02:15.004" end="02:15.827">背中に</span><span begin="02:15.827" end="02:16.576">委ねて</span><span begin="02:16.576" end="02:17.228">しまう</span><span ttm:role="x-translation" xml:lang="zh-Hans">却还是将一切交付于那道背影</span></p><p begin="02:17.760" end="02:18.522" ttm:agent="v1" itunes:key="L33"><span begin="02:17.760" end="02:18.522">大丈夫？</span><span ttm:role="x-translation" xml:lang="zh-Hans">这样没关系吗？</span></p><p begin="02:18.611" end="02:20.172" ttm:agent="v1" itunes:key="L34"><span begin="02:18.611" end="02:19.264">どこにも</span><span begin="02:19.264" end="02:19.616">行か</span><span begin="02:19.879" end="02:20.172">ない？</span><span ttm:role="x-translation" xml:lang="zh-Hans">真的哪里都不去吗？</span></p><p begin="02:20.671" end="02:22.620" ttm:agent="v1" itunes:key="L35"><span begin="02:20.671" end="02:21.192">ここに</span><span begin="02:21.192" end="02:21.527">居て</span><span begin="02:21.527" end="02:22.620">欲しいよ。</span><span ttm:role="x-translation" xml:lang="zh-Hans">我希望你可以留在这里</span></p><p begin="02:22.895" end="02:23.418" ttm:agent="v1" itunes:key="L36"><span begin="02:22.895" end="02:23.418">ね？</span><span ttm:role="x-translation" xml:lang="zh-Hans">可以吗？</span></p><p begin="02:23.441" end="02:25.975" ttm:agent="v1" itunes:key="L37"><span begin="02:23.441" end="02:24.047">探</span><span begin="02:24.047" end="02:24.761">してるもの</span><span begin="02:24.761" end="02:25.161">見つかっ</span><span begin="02:25.528" end="02:25.975">たら</span><span ttm:role="x-translation" xml:lang="zh-Hans">当我终于找到寻觅已久的东西时</span></p><p begin="02:26.001" end="02:28.219" ttm:agent="v1" itunes:key="L38"><span begin="02:26.001" end="02:26.750">何かが</span><span begin="02:26.909" end="02:27.740">崩れちゃい</span><span begin="02:27.740" end="02:28.219">そう</span><span ttm:role="x-translation" xml:lang="zh-Hans">似乎就有什么会分崩离析</span></p><p begin="02:28.885" end="02:31.292" ttm:agent="v1" itunes:key="L39"><span begin="02:28.885" end="02:29.143">ただ</span><span begin="02:29.143" end="02:30.133">唇</span><span begin="02:30.133" end="02:30.611">を噛み</span> <span begin="02:30.801" end="02:31.292">ラララ</span><span ttm:role="x-translation" xml:lang="zh-Hans">最后只能紧紧咬住嘴唇 啦啦啦</span></p><p begin="02:31.296" end="02:33.803" ttm:agent="v1" itunes:key="L40"><span begin="02:31.296" end="02:31.761">揺れる</span> <span begin="02:31.761" end="02:32.426">レースの</span><span begin="02:32.426" end="02:33.054">カーテン</span><span begin="02:33.054" end="02:33.803">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">蕾丝窗帘轻轻地摇曳了起来</span></p><p begin="02:34.037" end="02:38.229" ttm:agent="v1" itunes:key="L41"><span begin="02:34.037" end="02:34.489">忘れ</span><span begin="02:34.489" end="02:36.417">な</span><span begin="02:36.417" end="02:36.898">いの</span><span begin="02:37.006" end="02:38.229">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明就不曾忘记 为何仍会就此远去</span></p><p begin="02:39.323" end="02:43.925" ttm:agent="v1" itunes:key="L42"><span begin="02:39.323" end="02:39.795">何故か</span><span begin="02:39.943" end="02:41.736">遠</span><span begin="02:41.736" end="02:42.275">くな</span><span begin="02:42.275" end="02:43.925">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">为何却渐行渐远</span></p><p begin="02:44.655" end="02:50.155" ttm:agent="v1" itunes:key="L43"><span begin="02:44.655" end="02:45.364">心の</span><span begin="02:45.364" end="02:46.754">奥底に</span><span begin="02:46.754" end="02:48.268">大事に</span><span begin="02:48.268" end="02:48.604">君</span><span begin="02:48.604" end="02:49.197">が</span><span begin="02:49.262" end="02:49.511">居</span><span begin="02:49.511" end="02:50.155">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">小心翼翼将你安放在我的心底</span></p><p begin="02:50.256" end="02:51.600" ttm:agent="v1" itunes:key="L44"><span begin="02:50.256" end="02:51.600">いつも</span><span ttm:role="x-translation" xml:lang="zh-Hans">始终如此 一直以来都是如此</span></p><p begin="02:51.749" end="02:52.968" ttm:agent="v1" itunes:key="L45"><span begin="02:51.749" end="02:52.968">ずっと</span><span ttm:role="x-translation" xml:lang="zh-Hans">永远</span></p><p begin="02:53.061" end="02:55.459" ttm:agent="v1" itunes:key="L46"><span begin="02:53.061" end="02:55.459">そう</span><span ttm:role="x-translation" xml:lang="zh-Hans">如此</span></p><p begin="02:55.896" end="02:56.958" ttm:agent="v1" itunes:key="L47"><span begin="02:55.896" end="02:56.323">い</span><span begin="02:56.323" end="02:56.958">つかね</span><span ttm:role="x-translation" xml:lang="zh-Hans">会有那一天 再稍微等一下吧</span></p><p begin="03:00.590" end="03:05.607" ttm:agent="v1" itunes:key="L48"><span begin="03:00.590" end="03:01.217">もう</span><span begin="03:01.217" end="03:01.863">少し</span><span begin="03:01.863" end="03:05.607">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">再稍等片刻吧</span></p><p begin="03:06.659" end="03:13.167" ttm:agent="v1" itunes:key="L49"><span begin="03:06.659" end="03:07.515">私</span><span begin="03:07.515" end="03:08.917">が</span><span begin="03:09.121" end="03:10.455">優しく</span><span begin="03:10.455" end="03:11.566">在れた</span><span begin="03:11.566" end="03:13.167">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若是一切我都能温柔以待</span></p><p begin="03:13.638" end="03:20.165" ttm:agent="v1" itunes:key="L50"><span begin="03:13.638" end="03:14.368">何</span><span begin="03:14.368" end="03:15.355">か</span><span begin="03:15.391" end="03:16.266">変わる</span><span begin="03:16.266" end="03:16.619">の</span><span begin="03:16.619" end="03:17.808">でしょう</span><span begin="03:17.808" end="03:20.165">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">是否会有什么随之发生改变</span></p><p begin="03:44.978" end="03:47.755" ttm:agent="v1" itunes:key="L51"><span begin="03:44.978" end="03:46.119">あの日の</span><span begin="03:46.445" end="03:47.298">思い出</span><span begin="03:47.298" end="03:47.755">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">就让那一天的回忆</span></p><p begin="03:47.763" end="03:50.450" ttm:agent="v1" itunes:key="L52"><span begin="03:47.763" end="03:48.449">優しく</span><span begin="03:48.676" end="03:49.352">包まれ</span><span begin="03:49.352" end="03:49.796">歩</span><span begin="03:49.796" end="03:50.450">こう</span><span ttm:role="x-translation" xml:lang="zh-Hans">温柔地萦绕着我 迈步而行</span></p><p begin="03:50.483" end="03:56.100" ttm:agent="v1" itunes:key="L53"><span begin="03:50.483" end="03:51.643">寂しさの</span><span begin="03:52.019" end="03:52.966">涙を</span><span begin="03:53.362" end="03:54.785">流すことも</span><span begin="03:54.785" end="03:56.100">あるでしょう</span><span ttm:role="x-translation" xml:lang="zh-Hans">在人生之旅中</span></p><p begin="03:56.218" end="03:58.650" ttm:agent="v1" itunes:key="L54"><span begin="03:56.218" end="03:57.119">「帰りたい</span><span begin="03:57.293" end="03:57.877">場所が</span><span begin="03:58.020" end="03:58.650">ある」</span><span ttm:role="x-translation" xml:lang="zh-Hans">“我有渴望回去的归所”</span></p><p begin="03:58.718" end="04:01.393" ttm:agent="v1" itunes:key="L55"><span begin="03:58.718" end="03:59.523">誰もが</span><span begin="03:59.691" end="04:00.649">この星の</span><span begin="04:00.649" end="04:01.393">子孫</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们每个人都是这颗星球的子孙</span></p><p begin="04:01.432" end="04:02.783" ttm:agent="v1" itunes:key="L56"><span begin="04:01.432" end="04:01.658">あの</span><span begin="04:01.658" end="04:02.289">時</span><span begin="04:02.289" end="04:02.390">の</span><span begin="04:02.390" end="04:02.783">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">曾经感受到的 那份心情啊</span></p><p begin="04:02.916" end="04:04.066" ttm:agent="v1" itunes:key="L57"><span begin="04:02.916" end="04:03.455">心</span><span begin="04:03.455" end="04:03.669">地</span><span begin="04:03.669" end="04:04.066">はね</span><span ttm:role="x-translation" xml:lang="zh-Hans">那份安稳啊</span></p><p begin="04:04.332" end="04:11.184" ttm:agent="v1" itunes:key="L58"><span begin="04:04.332" end="04:04.784">温</span><span begin="04:04.784" end="04:06.525">かく</span><span begin="04:07.125" end="04:07.854">残って</span><span begin="04:07.854" end="04:11.184">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">会在我心里留下温暖的印记</span></p></div></body></tt>