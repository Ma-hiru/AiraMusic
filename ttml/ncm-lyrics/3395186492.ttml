<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="3395186492"/><amll:meta key="appleMusicId" value="6781555622"/><amll:meta key="musicName" value="猫じゃらし"/><amll:meta key="artists" value="7co"/><amll:meta key="album" value="猫じゃらし"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:00.917" end="00:01.244">kyo</span><span begin="00:01.656" end="00:01.824">u</span><span begin="00:01.824" end="00:02.158">ga</span><span begin="00:02.523" end="00:03.065">ichi</span><span begin="00:03.407" end="00:03.958">ban</span><span begin="00:04.522" end="00:06.300">kireina</span><span begin="00:06.300" end="00:07.752">watashi</span></text><text for="L2"><span begin="00:08.285" end="00:08.613">to't</span><span begin="00:08.972" end="00:09.368">temo</span><span begin="00:09.863" end="00:10.494">aato't</span><span begin="00:10.761" end="00:11.278">temo</span><span begin="00:12.026" end="00:13.736"></span><span begin="00:13.736" end="00:15.200"></span></text><text for="L3"><span begin="00:30.051" end="00:31.375">sokorahennihaeteiru</span><span begin="00:31.375" end="00:31.678">gusa</span></text><text for="L4"><span begin="00:31.911" end="00:32.228">daremo</span><span begin="00:32.312" end="00:32.519">mi</span><span begin="00:32.561" end="00:32.874">muki</span><span begin="00:32.981" end="00:33.159">moshina</span><span begin="00:33.171" end="00:33.544">igusa</span></text><text for="L5"><span begin="00:33.811" end="00:34.568">kimi</span><span begin="00:34.568" end="00:35.898">nifumarete</span><span begin="00:35.898" end="00:36.