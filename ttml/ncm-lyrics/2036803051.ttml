<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="2036803051"/><amll:meta key="appleMusicId" value="1681043393"/><amll:meta key="musicName" value="メフィスト"/><amll:meta key="artists" value="女王蜂"/><amll:meta key="album" value="メフィスト"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:30.209" end="00:31.507">rasutochan</span><span begin="00:31.507" end="00:32.189">suniue</span><span begin="00:32.189" end="00:32.947">tatsuma</span><span begin="00:32.947" end="00:33.570">sakiga</span></text><text for="L2"><span begin="00:33.580" end="00:34.833">odoridasuma</span><span begin="00:34.833" end="00:35.482">makake</span><span begin="00:35.482" end="00:35.875">tako</span><span begin="00:35.875" end="00:36.745">noyozora</span></text><text for="L3"><span begin="00:36.755" end="00:37.222">nami</span><span begin="00:37.222" end="00:38.070">nosutansu</span><span begin="00:38.070" end="00:38.841">janabika</span><span begin="00:38.841" end="00:39.385">nai</span></text><text for="L4"><span begin="00:39.395" end="00:39.934">hoshi</span><span begin="00:39.983" end="00:41.221">wahousekino</span><span begin="00:41.221" end="00:41.829">ako</span><span begin="00:41.829" end="00:43.047">gare</span></text><text for="L5"><span begin="00:43.163" end="00:44.264">ukabunami</span><span begin="00:44.367" end="00:44.955">datoase</span><span begin="00:44.955" end="00:45.316">wa</span><span begin="00:45.316" end="00:45.858">chinona</span><span begin="00:45.858" end="00:46.369">gori</span></text><text for="L6"><span begin="00:46.369" end="00: