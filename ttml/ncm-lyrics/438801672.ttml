<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="438801672"/><amll:meta key="appleMusicId" value="1616118960"/><amll:meta key="musicName" value="让我留在你身边"/><amll:meta key="artists" value="陈奕迅"/><amll:meta key="album" value="让我留在你身边"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:05.384"><div begin="00:00.900" end="02:48.142"><p begin="00:00.900" end="00:03.431" ttm:agent="v1" itunes:key="L1"><span begin="00:00.900" end="00:01.244">我</span><span begin="00:01.244" end="00:01.655">從</span><span begin="00:01.655" end="00:02.662">來不說</span><span begin="00:02.662" end="00:03.431">話</span><span ttm:role="x-translation" xml:lang="zh-Hans">我从来不说话</span></p><p begin="00:04.040" end="00:09.680" ttm:agent="v1" itunes:key="L2"><span begin="00:04.040" end="00:04.429">因</span><span begin="00:04.429" end="00:05.228">為</span><span begin="00:05.228" end="00:05.576">我</span><span begin="00:05.576" end="00:06.310">害</span><span begin="00:06.310" end="00:06.688">怕</span> <span begin="00:06.911" end="00:07.280">沒</span><span begin="00:07.280" end="00:08.014">有</span><span begin="00:08.014" end="00:08.342">人</span><span begin="00:08.342" end="00:09.048">回</span><span begin="00:09.048" end="00:09.680">答</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为我害怕 没有人回答</span></p><p begin="00:12.177" end="00:14.475" ttm:agent="v1" itunes:key="L3"><span begin="00:12.177" end="00:12.536">我</span><span begin="00:12.536" end="00:13.985">從來不掙</span><span begin="00:13.985" end="00:14.475">扎</span><span ttm:role="x-translation" xml:lang="zh-Hans">我从来不挣扎</span></p><p begin="00:15.355" end="00:21.082" ttm:agent="v1" itunes:key="L4"><span begin="00:15.355" end="00:15.726">因</span><span begin="00:15.726" end="00:16.444">為</span><span begin="00:16.444" end="00:16.795">我</span><span begin="00:16.795" end="00:17.494">知</span><span begin="00:17.494" end="00:17.906">道</span> <span begin="00:18.166" end="00:18.545">這</span><span begin="00:18.545" end="00:19.247">世</span><span begin="00:19.247" end="00:19.564">界</span><span begin="00:19.564" end="00:20.281">太</span><span begin="00:20.281" end="00:21.082">大</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为我知道 这世界太大</span></p><p begin="00:23.400" end="00:32.033" ttm:agent="v1" itunes:key="L5"><span begin="00:23.400" end="00:23.945">太</span><span begin="00:23.945" end="00:25.276">多時間浪</span><span begin="00:25.276" end="00:25.815">費</span> <span begin="00:26.266" end="00:28.080">太多事要面</span><span begin="00:28.080" end="00:28.601">對</span> <span begin="00:29.072" end="00:30.974">太多已無所</span><span begin="00:30.974" end="00:32.033">謂</span><span ttm:role="x-translation" xml:lang="zh-Hans">太多时间浪费 太多事要面对 太多已无所谓</span></p><p begin="00:34.664" end="00:43.139" ttm:agent="v1" itunes:key="L6"><span begin="00:34.664" end="00:36.597">太多難辨真</span><span begin="00:36.597" end="00:37.181">偽</span> <span begin="00:37.509" end="00:39.398">太多紛擾是</span><span begin="00:39.398" end="00:39.936">非</span> <span begin="00:40.387" end="00:42.170">在你身邊是</span><span begin="00:42.170" end="00:43.139">誰</span><span ttm:role="x-translation" xml:lang="zh-Hans">太多难辨真伪 太多纷扰是非 在你身边是谁</span></p><p begin="00:46.334" end="00:51.809" ttm:agent="v1" itunes:key="L7"><span begin="00:46.334" end="00:46.734">最</span><span begin="00:46.734" end="00:47.739">渺小的</span><span begin="00:47.739" end="00:48.912">我</span> <span begin="00:49.218" end="00:49.540">有</span><span begin="00:49.540" end="00:50.634">大大的</span><span begin="00:50.634" end="00:51.809">夢</span><span ttm:role="x-translation" xml:lang="zh-Hans">最渺小的我 有大大的梦</span></p><p begin="00:51.995" end="00:58.148" ttm:agent="v1" itunes:key="L8"><span begin="00:51.995" end="00:53.478">時間向前</span><span begin="00:53.478" end="00:54.195">走</span> <span begin="00:54.195" end="00:56.609">一定只有路口沒</span><span begin="00:56.609" end="00:57.364">有</span><span begin="00:57.364" end="00:57.698">盡</span><span begin="00:57.698" end="00:58.148">頭</span><span ttm:role="x-translation" xml:lang="zh-Hans">时间向前走 一定只有路口没有尽头</span></p><p begin="00:58.320" end="01:04.200" ttm:agent="v1" itunes:key="L9"><span begin="00:58.320" end="00:59.145">紛紛</span><span begin="00:59.145" end="00:59.847">擾</span><span begin="00:59.847" end="01:01.281">擾這個世</span><span begin="01:01.281" end="01:01.665">界</span> <span begin="01:01.906" end="01:02.666">所</span><span begin="01:02.666" end="01:03.052">有</span><span begin="01:03.052" end="01:03.516">的了</span><span begin="01:03.516" end="01:04.200">解</span><span ttm:role="x-translation" xml:lang="zh-Hans">纷纷扰扰这个世界 所有的了解</span></p><p begin="01:04.374" end="01:08.838" ttm:agent="v1" itunes:key="L10"><span begin="01:04.374" end="01:04.799">只</span><span begin="01:04.799" end="01:05.221">要</span> <span begin="01:05.415" end="01:07.619">讓我留在你身</span><span begin="01:07.619" end="01:08.838">邊</span><span ttm:role="x-translation" xml:lang="zh-Hans">只要 让我留在你身边</span></p><p begin="01:08.934" end="01:14.409" ttm:agent="v1" itunes:key="L11"><span begin="01:08.934" end="01:09.334">最</span><span begin="01:09.334" end="01:10.339">渺小的</span><span begin="01:10.339" end="01:11.512">我</span> <span begin="01:11.818" end="01:12.140">有</span><span begin="01:12.140" end="01:13.234">大大的</span><span begin="01:13.234" end="01:14.409">夢</span><span ttm:role="x-translation" xml:lang="zh-Hans">最渺小的我 有大大的梦</span></p><p begin="01:14.583" end="01:20.723" ttm:agent="v1" itunes:key="L12"><span begin="01:14.583" end="01:14.957">我</span><span begin="01:14.957" end="01:16.053">願意安</span><span begin="01:16.053" end="01:16.819">靜</span><span begin="01:16.819" end="01:19.307">的活在每個有你</span><span begin="01:19.307" end="01:19.940">的</span><span begin="01:19.940" end="01:20.291">角</span><span begin="01:20.291" end="01:20.723">落</span><span ttm:role="x-translation" xml:lang="zh-Hans">我愿意安静的活在每个有你的角落</span></p><p begin="01:20.975" end="01:26.685" ttm:agent="v1" itunes:key="L13"><span begin="01:20.975" end="01:21.628">如果</span><span begin="01:21.628" end="01:22.338">生</span><span begin="01:22.338" end="01:23.850">活還有什</span><span begin="01:23.850" end="01:24.236">麽</span> <span begin="01:24.502" end="01:25.234">會</span><span begin="01:25.234" end="01:25.600">讓</span><span begin="01:25.600" end="01:26.169">你難</span><span begin="01:26.169" end="01:26.685">過</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果生活还有什么 会让你难过</span></p><p begin="01:26.960" end="01:36.745" ttm:agent="v1" itunes:key="L14"><span begin="01:26.960" end="01:27.521">別</span><span begin="01:27.521" end="01:27.803">怕</span> <span begin="01:28.016" end="01:30.189">讓我留在你身</span><span begin="01:30.189" end="01:31.474">邊</span> <span begin="01:31.552" end="01:33.042">都陪你度</span><span begin="01:33.042" end="01:36.745">過</span><span ttm:role="x-translation" xml:lang="zh-Hans">别怕 让我留在你身边 都陪你度过</span></p><p begin="01:54.079" end="01:59.608" ttm:agent="v1" itunes:key="L15"><span begin="01:54.079" end="01:54.508">最</span><span begin="01:54.508" end="01:55.521">渺小的</span><span begin="01:55.521" end="01:56.213">我</span> <span begin="01:56.945" end="01:57.389">最</span><span begin="01:57.389" end="01:58.329">卑微的</span><span begin="01:58.329" end="01:59.608">夢</span><span ttm:role="x-translation" xml:lang="zh-Hans">最渺小的我 最卑微的梦</span></p><p begin="01:59.747" end="02:05.900" ttm:agent="v1" itunes:key="L16"><span begin="01:59.747" end="02:00.140">我</span><span begin="02:00.140" end="02:01.182">發現這</span><span begin="02:01.182" end="02:01.941">世</span><span begin="02:01.941" end="02:04.442">界沒有那麽那麽</span><span begin="02:04.442" end="02:05.061">的</span><span begin="02:05.061" end="02:05.444">不</span><span begin="02:05.444" end="02:05.900">同</span><span ttm:role="x-translation" xml:lang="zh-Hans">我发现这世界没有那么那么的不同</span></p><p begin="02:06.083" end="02:11.825" ttm:agent="v1" itunes:key="L17"><span begin="02:06.083" end="02:06.884">現實</span><span begin="02:06.884" end="02:07.671">如</span><span begin="02:07.671" end="02:09.056">果對你不</span><span begin="02:09.056" end="02:09.415">公</span> <span begin="02:09.688" end="02:10.475">別</span><span begin="02:10.475" end="02:11.302">計較太</span><span begin="02:11.302" end="02:11.825">多</span><span ttm:role="x-translation" xml:lang="zh-Hans">现实如果对你不公 别计较太多</span></p><p begin="02:12.088" end="02:19.164" ttm:agent="v1" itunes:key="L18"><span begin="02:12.088" end="02:12.572">走</span><span begin="02:12.572" end="02:12.956">吧</span> <span begin="02:13.168" end="02:14.981">暴風雨後的</span><span begin="02:14.981" end="02:15.611">彩</span><span begin="02:15.611" end="02:19.164">虹</span><span ttm:role="x-translation" xml:lang="zh-Hans">走吧 暴风雨后的彩虹</span></p><p begin="02:19.510" end="02:24.993" ttm:agent="v1" itunes:key="L19"><span begin="02:19.510" end="02:19.879">也</span><span begin="02:19.879" end="02:21.010">許會落</span><span begin="02:21.010" end="02:22.179">空</span> <span begin="02:22.422" end="02:22.804">也</span><span begin="02:22.804" end="02:23.858">許會普</span><span begin="02:23.858" end="02:24.993">通</span><span ttm:role="x-translation" xml:lang="zh-Hans">也许会落空 也许会普通</span></p><p begin="02:25.160" end="02:31.350" ttm:agent="v1" itunes:key="L20"><span begin="02:25.160" end="02:26.665">也許這庸</span><span begin="02:26.665" end="02:27.375">庸</span><span begin="02:27.375" end="02:29.850">碌碌的黑白世界</span><span begin="02:29.850" end="02:30.567">你</span><span begin="02:30.567" end="02:30.918">不</span><span begin="02:30.918" end="02:31.350">懂</span><span ttm:role="x-translation" xml:lang="zh-Hans">也许这庸庸碌碌的黑白世界你不懂</span></p><p begin="02:31.520" end="02:37.327" ttm:agent="v1" itunes:key="L21"><span begin="02:31.520" end="02:32.306">生命</span><span begin="02:32.306" end="02:33.005">中</span><span begin="02:33.005" end="02:34.805">所有的路口</span> <span begin="02:35.096" end="02:35.826">絕</span><span begin="02:35.826" end="02:36.192">不</span><span begin="02:36.192" end="02:36.712">是盡</span><span begin="02:36.712" end="02:37.327">頭</span><span ttm:role="x-translation" xml:lang="zh-Hans">生命中所有的路口 绝不是尽头</span></p><p begin="02:37.542" end="02:48.142" ttm:agent="v1" itunes:key="L22"><span begin="02:37.542" end="02:38.103">別</span><span begin="02:38.103" end="02:38.385">怕</span> <span begin="02:38.598" end="02:40.771">讓我留在你身</span><span begin="02:40.771" end="02:43.919">邊</span> <span begin="02:44.933" end="02:45.259">都</span><span begin="02:45.259" end="02:46.367">陪你度</span><span begin="02:46.367" end="02:48.142">過</span><span ttm:role="x-translation" xml:lang="zh-Hans">别怕 让我留在你身边 都陪你度过</span></p></div></body></tt>