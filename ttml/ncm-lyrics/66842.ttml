<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="66842"/><amll:meta key="appleMusicId" value="651456011"/><amll:meta key="musicName" value="十年"/><amll:meta key="artists" value="陈奕迅"/><amll:meta key="album" value="黑白灰"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:25.424"><div begin="00:15.244" end="03:03.636"><p begin="00:15.244" end="00:18.996" ttm:agent="v1" itunes:key="L1"><span begin="00:15.244" end="00:15.702">如果</span><span begin="00:15.702" end="00:16.164">那</span><span begin="00:16.164" end="00:16.530">兩</span><span begin="00:16.662" end="00:17.453">個字</span><span begin="00:17.545" end="00:18.101">沒有</span><span begin="00:18.101" end="00:18.396">顫</span><span begin="00:18.396" end="00:18.996">抖</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果那两个字没有颤抖</span></p><p begin="00:19.128" end="00:22.181" ttm:agent="v1" itunes:key="L2"><span begin="00:19.128" end="00:19.326">我</span><span begin="00:19.326" end="00:19.583">不</span><span begin="00:19.583" end="00:19.954">會</span><span begin="00:20.200" end="00:20.420">發</span><span begin="00:20.420" end="00:20.846">現</span><span begin="00:20.846" end="00:21.179">我</span><span begin="00:21.179" end="00:21.433">難</span><span begin="00:21.433" end="00:22.181">受</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不会发现我难受</span></p><p begin="00:22.461" end="00:24.524" ttm:agent="v1" itunes:key="L3"><span begin="00:22.461" end="00:22.744">怎</span><span begin="00:22.744" end="00:22.985">麼</span><span begin="00:22.985" end="00:23.234">說</span><span begin="00:23.234" end="00:23.470">出</span><span begin="00:23.470" end="00:24.524">口</span><span ttm:role="x-translation" xml:lang="zh-Hans">怎么说出口</span></p><p begin="00:26.029" end="00:28.603" ttm:agent="v1" itunes:key="L4"><span begin="00:26.029" end="00:26.543">也不</span><span begin="00:26.543" end="00:26.724">過</span><span begin="00:26.724" end="00:26.996">是</span><span begin="00:26.996" end="00:27.241">分</span><span begin="00:27.241" end="00:28.603">手</span><span ttm:role="x-translation" xml:lang="zh-Hans">也不过是分手</span></p><p begin="00:30.653" end="00:34.594" ttm:agent="v1" itunes:key="L5"><span begin="00:30.653" end="00:31.189">如果</span><span begin="00:31.189" end="00:31.687">對</span><span begin="00:31.687" end="00:32.147">於</span><span begin="00:32.147" end="00:32.602">明</span><span begin="00:32.602" end="00:33.096">天</span><span begin="00:33.096" end="00:33.628">沒有</span><span begin="00:33.628" end="00:33.866">要</span><span begin="00:33.866" end="00:34.594">求</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果对于明天没有要求</span></p><p begin="00:34.725" end="00:37.445" ttm:agent="v1" itunes:key="L6"><span begin="00:34.725" end="00:35.045">牽</span><span begin="00:35.045" end="00:35.509">牽</span><span begin="00:35.509" end="00:35.938">手</span><span begin="00:36.003" end="00:36.223">就</span><span begin="00:36.223" end="00:36.549">像</span><span begin="00:36.549" end="00:36.828">旅</span><span begin="00:36.828" end="00:37.445">遊</span><span ttm:role="x-translation" xml:lang="zh-Hans">牵牵手就像旅游</span></p><p begin="00:37.719" end="00:40.609" ttm:agent="v1" itunes:key="L7"><span begin="00:37.719" end="00:38.246">成千</span><span begin="00:38.246" end="00:38.971">上萬個</span><span begin="00:38.971" end="00:39.258">門</span><span begin="00:39.258" end="00:40.609">口</span><span ttm:role="x-translation" xml:lang="zh-Hans">成千上万个门口</span></p><p begin="00:41.541" end="00:45.013" ttm:agent="v1" itunes:key="L8"><span begin="00:41.541" end="00:41.803">總</span><span begin="00:41.803" end="00:42.476">有一個</span><span begin="00:42.476" end="00:42.750">人</span><span begin="00:42.750" end="00:43.217">要</span><span begin="00:43.217" end="00:43.614">先</span><span begin="00:43.614" end="00:45.013">走</span><span ttm:role="x-translation" xml:lang="zh-Hans">总有一个人要先走</span></p><p begin="00:47.295" end="00:50.525" ttm:agent="v1" itunes:key="L9"><span begin="00:47.295" end="00:47.647">懷</span><span begin="00:47.647" end="00:48.062">抱</span><span begin="00:48.062" end="00:48.641">既然</span><span begin="00:48.641" end="00:49.077">不</span><span begin="00:49.077" end="00:49.384">能</span><span begin="00:49.384" end="00:49.813">逗</span><span begin="00:49.813" end="00:50.525">留</span><span ttm:role="x-translation" xml:lang="zh-Hans">怀抱既然不能逗留</span></p><p begin="00:50.745" end="00:53.432" ttm:agent="v1" itunes:key="L10"><span begin="00:50.745" end="00:51.009">何</span><span begin="00:51.009" end="00:51.230">不</span><span begin="00:51.230" end="00:51.520">在</span><span begin="00:51.520" end="00:52.001">離開</span><span begin="00:52.001" end="00:52.196">的</span><span begin="00:52.196" end="00:52.483">時</span><span begin="00:52.483" end="00:53.432">候</span><span ttm:role="x-translation" xml:lang="zh-Hans">何不在离开的时候</span></p><p begin="00:53.668" end="01:00.484" ttm:agent="v1" itunes:key="L11"><span begin="00:53.668" end="00:53.940">一</span><span begin="00:53.940" end="00:54.154">邊</span><span begin="00:54.154" end="00:54.404">享</span><span begin="00:54.404" end="00:55.884">受</span> <span begin="00:56.281" end="00:57.039">一</span><span begin="00:57.039" end="00:57.797">邊</span><span begin="00:57.797" end="00:58.298">淚</span><span begin="00:58.298" end="01:00.484">流</span><span ttm:role="x-translation" xml:lang="zh-Hans">一边享受 一边泪流</span></p><p begin="01:00.792" end="01:02.661" ttm:agent="v1" itunes:key="L12"><span begin="01:00.792" end="01:01.089">十</span><span begin="01:01.089" end="01:01.383">年</span><span begin="01:01.383" end="01:02.082">之</span><span begin="01:02.082" end="01:02.661">前</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年之前</span></p><p begin="01:02.846" end="01:06.495" ttm:agent="v1" itunes:key="L13"><span begin="01:02.846" end="01:03.350">我</span><span begin="01:03.350" end="01:03.559">不</span><span begin="01:03.559" end="01:04.103">認識</span><span begin="01:04.103" end="01:04.648">你</span> <span begin="01:04.844" end="01:05.176">你</span><span begin="01:05.176" end="01:05.494">不</span><span begin="01:05.494" end="01:06.042">屬於</span><span begin="01:06.042" end="01:06.495">我</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不认识你 你不属于我</span></p><p begin="01:06.746" end="01:08.899" ttm:agent="v1" itunes:key="L14"><span begin="01:06.746" end="01:07.191">我</span><span begin="01:07.191" end="01:07.393">們</span><span begin="01:07.393" end="01:07.976">還是</span><span begin="01:07.976" end="01:08.476">一</span><span begin="01:08.476" end="01:08.899">樣</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们还是一样</span></p><p begin="01:09.137" end="01:12.698" ttm:agent="v1" itunes:key="L15"><span begin="01:09.137" end="01:09.326">陪</span><span begin="01:09.326" end="01:09.562">在</span><span begin="01:09.562" end="01:09.789">一</span><span begin="01:09.789" end="01:10.183">個</span><span begin="01:10.280" end="01:10.675">陌生</span><span begin="01:10.675" end="01:11.227">人</span><span begin="01:11.227" end="01:11.486">左</span><span begin="01:11.486" end="01:12.698">右</span><span ttm:role="x-translation" xml:lang="zh-Hans">陪在一个陌生人左右</span></p><p begin="01:12.963" end="01:16.246" ttm:agent="v1" itunes:key="L16"><span begin="01:12.963" end="01:13.418">走過</span><span begin="01:13.418" end="01:13.708">漸</span><span begin="01:13.708" end="01:14.431">漸</span><span begin="01:14.431" end="01:14.624">熟</span><span begin="01:14.624" end="01:15.113">悉</span><span begin="01:15.113" end="01:15.349">的</span><span begin="01:15.349" end="01:15.920">街</span><span begin="01:15.920" end="01:16.246">頭</span><span ttm:role="x-translation" xml:lang="zh-Hans">走过渐渐熟悉的街头</span></p><p begin="01:16.371" end="01:18.087" ttm:agent="v1" itunes:key="L17"><span begin="01:16.371" end="01:16.577">十</span><span begin="01:16.577" end="01:16.944">年</span><span begin="01:16.944" end="01:17.631">之</span><span begin="01:17.631" end="01:18.087">後</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年之后</span></p><p begin="01:18.309" end="01:21.995" ttm:agent="v1" itunes:key="L18"><span begin="01:18.309" end="01:18.767">我</span><span begin="01:18.767" end="01:19.026">們</span><span begin="01:19.026" end="01:19.587">是朋</span><span begin="01:19.587" end="01:20.117">友</span> <span begin="01:20.327" end="01:20.777">還</span><span begin="01:20.777" end="01:21.282">可以</span><span begin="01:21.282" end="01:21.553">問</span><span begin="01:21.553" end="01:21.995">候</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们是朋友 还可以问候</span></p><p begin="01:22.225" end="01:24.364" ttm:agent="v1" itunes:key="L19"><span begin="01:22.225" end="01:22.622">只</span><span begin="01:22.622" end="01:22.962">是</span><span begin="01:22.962" end="01:23.452">那種</span><span begin="01:23.452" end="01:23.907">溫</span><span begin="01:23.907" end="01:24.364">柔</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是那种温柔</span></p><p begin="01:24.618" end="01:28.258" ttm:agent="v1" itunes:key="L20"><span begin="01:24.618" end="01:25.098">再也</span><span begin="01:25.098" end="01:25.373">找</span><span begin="01:25.373" end="01:25.715">不</span><span begin="01:25.821" end="01:26.015">到</span><span begin="01:26.015" end="01:26.286">擁</span><span begin="01:26.286" end="01:26.815">抱</span><span begin="01:26.815" end="01:27.017">的</span><span begin="01:27.017" end="01:27.468">理</span><span begin="01:27.468" end="01:28.258">由</span><span ttm:role="x-translation" xml:lang="zh-Hans">再也找不到拥抱的理由</span></p><p begin="01:28.429" end="01:36.361" ttm:agent="v1" itunes:key="L21"><span begin="01:28.429" end="01:28.969">情人</span><span begin="01:28.969" end="01:29.260">最</span><span begin="01:29.260" end="01:29.937">後</span><span begin="01:29.937" end="01:30.236">難</span><span begin="01:30.236" end="01:30.699">免</span><span begin="01:30.699" end="01:31.050">淪</span><span begin="01:31.050" end="01:32.388">為</span><span begin="01:32.626" end="01:33.055">朋</span><span begin="01:33.055" end="01:36.361">友</span><span ttm:role="x-translation" xml:lang="zh-Hans">情人最后难免沦为朋友</span></p><p begin="01:57.034" end="02:00.204" ttm:agent="v1" itunes:key="L22"><span begin="01:57.034" end="01:57.220">懷</span><span begin="01:57.220" end="01:57.794">抱</span><span begin="01:57.794" end="01:58.290">既然</span><span begin="01:58.290" end="01:58.797">不</span><span begin="01:58.797" end="01:59.095">能</span><span begin="01:59.095" end="01:59.543">逗</span><span begin="01:59.543" end="02:00.204">留</span><span ttm:role="x-translation" xml:lang="zh-Hans">怀抱既然不能逗留</span></p><p begin="02:00.434" end="02:03.141" ttm:agent="v1" itunes:key="L23"><span begin="02:00.434" end="02:00.629">何</span><span begin="02:00.629" end="02:00.948">不</span><span begin="02:00.948" end="02:01.188">在</span><span begin="02:01.188" end="02:01.671">離開</span><span begin="02:01.671" end="02:01.869">的</span><span begin="02:01.869" end="02:02.206">時</span><span begin="02:02.206" end="02:03.141">候</span><span ttm:role="x-translation" xml:lang="zh-Hans">何不在离开的时候</span></p><p begin="02:03.346" end="02:10.352" ttm:agent="v1" itunes:key="L24"><span begin="02:03.346" end="02:03.830">一邊</span><span begin="02:03.830" end="02:04.140">享</span><span begin="02:04.140" end="02:05.628">受</span> <span begin="02:06.024" end="02:06.728">一</span><span begin="02:06.728" end="02:07.469">邊</span><span begin="02:07.469" end="02:07.954">淚</span><span begin="02:07.954" end="02:10.352">流</span><span ttm:role="x-translation" xml:lang="zh-Hans">一边享受 一边泪流</span></p><p begin="02:10.531" end="02:12.420" ttm:agent="v1" itunes:key="L25"><span begin="02:10.531" end="02:10.864">十</span><span begin="02:10.864" end="02:11.151">年</span><span begin="02:11.151" end="02:11.794">之</span><span begin="02:11.796" end="02:12.420">前</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年之前</span></p><p begin="02:12.589" end="02:16.188" ttm:agent="v1" itunes:key="L26"><span begin="02:12.589" end="02:13.059">我</span><span begin="02:13.059" end="02:13.285">不</span><span begin="02:13.285" end="02:13.491">認</span><span begin="02:13.491" end="02:13.802">識</span><span begin="02:13.802" end="02:14.401">你</span> <span begin="02:14.548" end="02:14.971">你</span><span begin="02:14.971" end="02:15.150">不</span><span begin="02:15.150" end="02:15.679">屬於</span><span begin="02:15.679" end="02:16.188">我</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不认识你 你不属于我</span></p><p begin="02:16.376" end="02:18.559" ttm:agent="v1" itunes:key="L27"><span begin="02:16.376" end="02:16.878">我</span><span begin="02:16.878" end="02:17.121">們</span><span begin="02:17.121" end="02:17.352">還</span><span begin="02:17.352" end="02:17.654">是</span><span begin="02:17.654" end="02:18.102">一</span><span begin="02:18.102" end="02:18.559">樣</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们还是一样</span></p><p begin="02:18.818" end="02:22.399" ttm:agent="v1" itunes:key="L28"><span begin="02:18.818" end="02:19.017">陪</span><span begin="02:19.017" end="02:19.253">在</span><span begin="02:19.253" end="02:19.584">一</span><span begin="02:19.584" end="02:19.998">個</span><span begin="02:20.048" end="02:20.535">陌生</span><span begin="02:20.535" end="02:20.918">人</span><span begin="02:20.918" end="02:21.374">左</span><span begin="02:21.374" end="02:22.399">右</span><span ttm:role="x-translation" xml:lang="zh-Hans">陪在一个陌生人左右</span></p><p begin="02:22.662" end="02:25.925" ttm:agent="v1" itunes:key="L29"><span begin="02:22.662" end="02:23.137">走過</span><span begin="02:23.137" end="02:23.400">漸</span><span begin="02:23.400" end="02:24.110">漸</span><span begin="02:24.110" end="02:24.343">熟</span><span begin="02:24.343" end="02:24.832">悉</span><span begin="02:24.832" end="02:25.118">的</span><span begin="02:25.118" end="02:25.608">街</span><span begin="02:25.608" end="02:25.925">頭</span><span ttm:role="x-translation" xml:lang="zh-Hans">走过渐渐熟悉的街头</span></p><p begin="02:26.048" end="02:27.814" ttm:agent="v1" itunes:key="L30"><span begin="02:26.048" end="02:26.254">十</span><span begin="02:26.254" end="02:26.613">年</span><span begin="02:26.613" end="02:27.295">之</span><span begin="02:27.295" end="02:27.814">後</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年之后</span></p><p begin="02:28.002" end="02:31.718" ttm:agent="v1" itunes:key="L31"><span begin="02:28.002" end="02:28.520">我</span><span begin="02:28.520" end="02:28.708">們</span><span begin="02:28.708" end="02:29.234">是朋</span><span begin="02:29.234" end="02:29.753">友</span> <span begin="02:29.988" end="02:30.462">還</span><span begin="02:30.462" end="02:30.948">可以</span><span begin="02:30.948" end="02:31.212">問</span><span begin="02:31.212" end="02:31.718">候</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们是朋友 还可以问候</span></p><p begin="02:31.854" end="02:34.093" ttm:agent="v1" itunes:key="L32"><span begin="02:31.854" end="02:32.270">只</span><span begin="02:32.270" end="02:32.611">是</span><span begin="02:32.611" end="02:33.116">那種</span><span begin="02:33.116" end="02:33.580">溫</span><span begin="02:33.580" end="02:34.093">柔</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是那种温柔</span></p><p begin="02:34.271" end="02:37.971" ttm:agent="v1" itunes:key="L33"><span begin="02:34.271" end="02:34.774">再也</span><span begin="02:34.774" end="02:35.058">找</span><span begin="02:35.058" end="02:35.520">不</span><span begin="02:35.520" end="02:35.765">到</span><span begin="02:35.765" end="02:36.025">擁</span><span begin="02:36.025" end="02:36.505">抱</span><span begin="02:36.505" end="02:36.772">的</span><span begin="02:36.772" end="02:37.280">理</span><span begin="02:37.280" end="02:37.971">由</span><span ttm:role="x-translation" xml:lang="zh-Hans">再也找不到拥抱的理由</span></p><p begin="02:38.109" end="02:45.585" ttm:agent="v1" itunes:key="L34"><span begin="02:38.109" end="02:38.283">情</span><span begin="02:38.283" end="02:38.618">人</span><span begin="02:38.618" end="02:38.916">最</span><span begin="02:38.916" end="02:39.611">後</span><span begin="02:39.611" end="02:39.870">難</span><span begin="02:39.870" end="02:40.204">免</span><span begin="02:40.204" end="02:40.660">淪</span><span begin="02:40.660" end="02:41.999">為</span><span begin="02:42.315" end="02:42.711">朋</span><span begin="02:42.711" end="02:45.585">友</span><span ttm:role="x-translation" xml:lang="zh-Hans">情人最后难免沦为朋友</span></p><p begin="02:48.049" end="02:51.931" ttm:agent="v1" itunes:key="L35"><span begin="02:48.049" end="02:48.636">直到</span><span begin="02:48.636" end="02:49.546">和你</span><span begin="02:49.546" end="02:50.472">做了</span><span begin="02:50.472" end="02:51.038">多年</span><span begin="02:51.038" end="02:51.327">朋</span><span begin="02:51.327" end="02:51.931">友</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到和你做了多年朋友</span></p><p begin="02:52.151" end="02:54.872" ttm:agent="v1" itunes:key="L36"><span begin="02:52.151" end="02:52.407">才</span><span begin="02:52.407" end="02:52.986">明</span><span begin="02:52.986" end="02:53.447">白</span><span begin="02:53.447" end="02:53.932">我的</span><span begin="02:53.932" end="02:54.314">眼</span><span begin="02:54.314" end="02:54.872">淚</span><span ttm:role="x-translation" xml:lang="zh-Hans">才明白我的眼泪</span></p><p begin="02:55.087" end="02:57.774" ttm:agent="v1" itunes:key="L37"><span begin="02:55.087" end="02:55.311">不</span><span begin="02:55.311" end="02:55.535">是</span><span begin="02:55.535" end="02:55.824">為</span><span begin="02:55.824" end="02:56.049">你</span><span begin="02:56.049" end="02:56.436">而</span><span begin="02:56.436" end="02:57.774">流</span><span ttm:role="x-translation" xml:lang="zh-Hans">不是为你而流</span></p><p begin="02:58.934" end="03:03.636" ttm:agent="v1" itunes:key="L38"><span begin="02:58.934" end="02:59.163">也</span><span begin="02:59.163" end="02:59.379">為</span><span begin="02:59.379" end="02:59.594">別</span><span begin="02:59.594" end="02:59.843">人</span><span begin="02:59.843" end="03:00.356">而</span><span begin="03:00.356" end="03:03.636">流</span><span ttm:role="x-translation" xml:lang="zh-Hans">也为别人而流</span></p></div></body></tt>