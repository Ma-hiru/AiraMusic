<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="462686590"/><amll:meta key="appleMusicId" value="1538114026"/><amll:meta key="musicName" value="平行線"/><amll:meta key="artists" value="さユり"/><amll:meta key="album" value="平行線"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:58.760"><div begin="00:00.729" end="04:48.879"><p begin="00:00.729" end="00:13.139" ttm:agent="v1" itunes:key="L1"><span begin="00:00.729" end="00:02.364">太陽</span><span begin="00:02.364" end="00:03.551">系</span><span begin="00:03.551" end="00:05.617">を抜け出し</span><span begin="00:05.617" end="00:06.364">て</span><span begin="00:07.183" end="00:10.039">平行線で</span><span begin="00:10.039" end="00:11.255">交</span><span begin="00:11.255" end="00:11.795">わ</span><span begin="00:11.795" end="00:13.139">ろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">摆脱太阳系</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta i yo u ke i wo nu ke da shi te</span></p><p begin="00:13.483" end="00:28.829" ttm:agent="v1" itunes:key="L2"><span begin="00:13.483" end="00:15.272">私と</span><span begin="00:15.272" end="00:16.491">君の</span><span begin="00:16.491" end="00:17.304">影</span><span begin="00:17.304" end="00:18.555">のように</span><span begin="00:18.555" end="00:20.219">伸びてい</span><span begin="00:20.219" end="00:21.721">る</span> <span begin="00:24.171" end="00:25.838">平行</span><span begin="00:25.838" end="00:28.829">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">仿佛你我的影子般逐渐拉长</span><span ttm:role="x-roman" xml:lang="ja-Latn">wa ta shi to ki mi no ka ge no yo u ni no bi te i ru</span></p><p begin="00:39.502" end="00:44.627" ttm:agent="v1" itunes:key="L3"><span begin="00:39.502" end="00:40.246">勇気が</span><span begin="00:40.246" end="00:40.878">ないのは</span><span begin="00:40.878" end="00:41.513">時代の</span><span begin="00:41.635" end="00:42.118">せいに</span><span begin="00:42.118" end="00:44.627">してしまえばいい</span><span ttm:role="x-translation" xml:lang="zh-Hans">拿不出勇气</span><span ttm:role="x-roman" xml:lang="ja-Latn">yu u ki ga na i no wa</span></p><p begin="00:44.687" end="00:49.225" ttm:agent="v1" itunes:key="L4"><span begin="00:44.687" end="00:45.289">いつまで</span><span begin="00:45.289" end="00:45.753">たって</span><span begin="00:45.753" end="00:46.361">も</span><span begin="00:46.553" end="00:47.119">思いは</span><span begin="00:47.119" end="00:48.420">口に出せないま</span><span begin="00:48.420" end="00:49.225">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">不管过多久</span><span ttm:role="x-roman" xml:lang="ja-Latn">i tsu ma de ta 't te mo o mo i wa</span></p><p begin="00:49.354" end="00:54.629" ttm:agent="v1" itunes:key="L5"><span begin="00:49.354" end="00:49.685">ただ</span><span begin="00:49.685" end="00:50.866">壊れないように</span><span begin="00:50.866" end="00:51.637">同じ</span><span begin="00:51.637" end="00:52.154">今日を</span><span begin="00:52.154" end="00:52.837">繰り</span><span begin="00:52.837" end="00:53.717">返し</span><span begin="00:53.717" end="00:54.629">なぞって</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是不想破坏这层关系</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta da ko wa re na i yo u ni o na ji</span></p><p begin="00:54.629" end="00:59.037" ttm:agent="v1" itunes:key="L6"><span begin="00:54.629" end="00:55.296">どこにも</span><span begin="00:55.296" end="00:55.845">いけ</span><span begin="00:55.845" end="00:56.544">ない</span> <span begin="00:56.544" end="00:57.162">願いの</span><span begin="00:57.162" end="00:57.776">居場所を</span><span begin="00:57.776" end="00:58.443">探して</span><span begin="00:58.443" end="00:59.037">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">无处可去</span><span ttm:role="x-roman" xml:lang="ja-Latn">do ko ni mo i ke na i</span></p><p begin="00:59.090" end="01:08.782" ttm:agent="v1" itunes:key="L7"><span begin="00:59.090" end="01:00.210">君の</span><span begin="01:00.378" end="01:01.613">唇</span><span begin="01:01.613" end="01:02.263">から</span><span begin="01:02.519" end="01:03.119">零</span><span begin="01:03.119" end="01:03.818">れ</span><span begin="01:03.818" end="01:04.119">だ</span><span begin="01:04.119" end="01:04.719">す</span> <span begin="01:04.719" end="01:06.602">言葉になり</span><span begin="01:06.602" end="01:08.782">たい</span><span ttm:role="x-translation" xml:lang="zh-Hans">想成为你不经意间</span><span ttm:role="x-roman" xml:lang="ja-Latn">ki mi no ku chi bi ru ka ra</span></p><p begin="01:09.719" end="01:19.510" ttm:agent="v1" itunes:key="L8"><span begin="01:09.719" end="01:11.026">太陽</span><span begin="01:11.026" end="01:11.924">系</span><span begin="01:11.924" end="01:12.895">を抜け</span><span begin="01:12.895" end="01:13.543">出し</span><span begin="01:13.543" end="01:14.509">て</span> <span begin="01:14.775" end="01:16.671">平行線</span><span begin="01:16.671" end="01:16.989">で</span><span begin="01:16.989" end="01:17.887">交</span><span begin="01:17.887" end="01:18.205">わ</span><span begin="01:18.205" end="01:19.510">ろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">摆脱太阳系</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta i yo u ke i wo nu ke da shi te</span></p><p begin="01:19.685" end="01:29.785" ttm:agent="v1" itunes:key="L9"><span begin="01:19.685" end="01:20.442">そん</span><span begin="01:20.442" end="01:21.024">な</span><span begin="01:21.024" end="01:22.621">叶わない</span><span begin="01:22.621" end="01:23.418">望</span><span begin="01:23.418" end="01:23.891">みも</span><span begin="01:24.202" end="01:26.082">不甲斐ない</span><span begin="01:26.082" end="01:27.314">声も</span><span begin="01:27.314" end="01:28.615">引き連</span><span begin="01:28.615" end="01:29.785">れて</span><span ttm:role="x-translation" xml:lang="zh-Hans">那无法实现的冀望</span><span ttm:role="x-roman" xml:lang="ja-Latn">so n na ka na wa na i no zo mi mo</span></p><p begin="01:29.845" end="01:39.663" ttm:agent="v1" itunes:key="L10"><span begin="01:29.845" end="01:31.125">感情</span><span begin="01:31.125" end="01:32.357">全部</span><span begin="01:32.357" end="01:33.473">流し</span><span begin="01:33.473" end="01:34.215">切った</span><span begin="01:34.215" end="01:34.809">ら</span><span begin="01:34.809" end="01:35.491">描き</span><span begin="01:35.491" end="01:36.190">始</span><span begin="01:36.190" end="01:37.089">めて</span><span begin="01:37.089" end="01:37.723">み</span><span begin="01:37.723" end="01:38.321">せる</span><span begin="01:38.321" end="01:39.663">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">当感情全部流失之时</span><span ttm:role="x-roman" xml:lang="ja-Latn">ka n jo u ze n bu na ga shi ki 't ta ra</span></p><p begin="01:39.663" end="01:52.850" ttm:agent="v1" itunes:key="L11"><span begin="01:39.663" end="01:40.498">私</span><span begin="01:40.498" end="01:41.164">と</span><span begin="01:41.164" end="01:42.114">君の</span><span begin="01:42.114" end="01:43.084">影に</span><span begin="01:43.084" end="01:43.700">今</span><span begin="01:43.700" end="01:44.930">手を伸ば</span><span begin="01:44.930" end="01:46.476">す</span> <span begin="01:48.127" end="01:49.346">平行</span><span begin="01:49.346" end="01:52.850">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在对你我的影子伸出手</span><span ttm:role="x-roman" xml:lang="ja-Latn">wa ta shi to ki mi no ka ge ni i ma te wo no ba su</span></p><p begin="02:00.071" end="02:05.051" ttm:agent="v1" itunes:key="L12"><span begin="02:00.071" end="02:00.618">勇気が</span><span begin="02:00.618" end="02:01.250">ないのは</span><span begin="02:01.250" end="02:02.034">電子の</span><span begin="02:02.034" end="02:02.503">せいに</span><span begin="02:02.503" end="02:05.051">してしまえばいい</span><span ttm:role="x-translation" xml:lang="zh-Hans">拿不出勇气</span><span ttm:role="x-roman" xml:lang="ja-Latn">yu u ki ga na i no wa</span></p><p begin="02:05.061" end="02:09.532" ttm:agent="v1" itunes:key="L13"><span begin="02:05.061" end="02:05.522">口を</span><span begin="02:05.522" end="02:06.138">つくの</span><span begin="02:06.138" end="02:06.954">は</span><span begin="02:06.954" end="02:07.533">いつでも</span><span begin="02:07.533" end="02:08.799">裏返しの言</span><span begin="02:08.799" end="02:09.532">葉</span><span ttm:role="x-translation" xml:lang="zh-Hans">脱口而出的话</span><span ttm:role="x-roman" xml:lang="ja-Latn">ku chi wo tsu ku no wa</span></p><p begin="02:09.672" end="02:15.037" ttm:agent="v1" itunes:key="L14"><span begin="02:09.672" end="02:10.053">"ねえ</span><span begin="02:10.053" end="02:10.525">隣</span><span begin="02:10.525" end="02:11.301">じゃなくても</span><span begin="02:11.301" end="02:12.085">脳裏に</span><span begin="02:12.085" end="02:12.883">居場所が</span><span begin="02:12.883" end="02:14.800">あればいいか</span><span begin="02:14.800" end="02:15.037">ら"</span><span ttm:role="x-translation" xml:lang="zh-Hans">呐</span><span ttm:role="x-roman" xml:lang="ja-Latn">ne</span></p><p begin="02:15.097" end="02:20.161" ttm:agent="v1" itunes:key="L15"><span begin="02:15.097" end="02:15.510">"君を</span><span begin="02:15.510" end="02:16.028">救う</span><span begin="02:16.028" end="02:16.830">歌</span> <span begin="02:16.993" end="02:17.437">いつか</span><span begin="02:17.437" end="02:18.037">私が</span><span begin="02:18.037" end="02:19.323">作れるように</span><span begin="02:19.323" end="02:20.161">今日も</span><span ttm:role="x-translation" xml:lang="zh-Hans">希望有一天我所写的歌</span><span ttm:role="x-roman" xml:lang="ja-Latn">ki mi wo su ku u u ta</span></p><p begin="02:20.341" end="02:24.503" ttm:agent="v1" itunes:key="L16"><span begin="02:20.341" end="02:21.227">ここで</span><span begin="02:21.227" end="02:22.306">ちゃんと</span><span begin="02:22.306" end="02:23.901">生きてくか</span><span begin="02:23.901" end="02:24.503">ら"</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在这</span><span ttm:role="x-roman" xml:lang="ja-Latn">ko ko de cha n to i ki te ku ka ra</span></p><p begin="02:24.560" end="02:34.286" ttm:agent="v1" itunes:key="L17"><span begin="02:24.560" end="02:25.606">君の</span><span begin="02:26.133" end="02:27.772">苦しみを</span><span begin="02:27.981" end="02:28.562">切り</span><span begin="02:28.562" end="02:29.578">裂け</span><span begin="02:29.578" end="02:30.229">る</span><span begin="02:30.229" end="02:31.413">光に</span><span begin="02:31.413" end="02:32.061">なり</span><span begin="02:32.061" end="02:34.286">たい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想成为</span><span ttm:role="x-roman" xml:lang="ja-Latn">ki mi no ku ru shi mi wo</span></p><p begin="02:35.122" end="02:44.915" ttm:agent="v1" itunes:key="L18"><span begin="02:35.122" end="02:36.461">太陽</span><span begin="02:36.461" end="02:37.711">系の</span><span begin="02:37.711" end="02:38.959">常識</span><span begin="02:38.959" end="02:40.210">を</span><span begin="02:40.210" end="02:41.781">覆</span><span begin="02:41.781" end="02:42.035">し</span><span begin="02:42.035" end="02:43.014">て触</span><span begin="02:43.014" end="02:43.627">れた</span><span begin="02:43.627" end="02:44.915">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要颠覆</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta i yo u ke i no jo u shi ki mo</span></p><p begin="02:45.185" end="02:55.155" ttm:agent="v1" itunes:key="L19"><span begin="02:45.185" end="02:45.873">そん</span><span begin="02:45.873" end="02:46.449">な</span><span begin="02:46.449" end="02:48.078">夢物</span><span begin="02:48.078" end="02:49.313">語が</span><span begin="02:49.593" end="02:51.260">頭を</span><span begin="02:51.260" end="02:51.993">回っ</span><span begin="02:51.993" end="02:52.758">ては</span><span begin="02:52.758" end="02:54.028">消えて</span><span begin="02:54.028" end="02:55.155">くよ</span><span ttm:role="x-translation" xml:lang="zh-Hans">那样的天方夜谭 盘旋在我脑海</span><span ttm:role="x-roman" xml:lang="ja-Latn">so n na yu me mo no ga ta ri ga a ta ma wo</span></p><p begin="02:55.245" end="03:05.082" ttm:agent="v1" itunes:key="L20"><span begin="02:55.245" end="02:56.557">変わっ</span><span begin="02:56.557" end="02:57.890">てくのが</span><span begin="02:57.890" end="02:59.074">怖く</span><span begin="02:59.074" end="02:59.690">て</span><span begin="03:00.338" end="03:01.496">こっ</span><span begin="03:01.496" end="03:02.525">そり</span><span begin="03:02.525" end="03:03.115">書き</span><span begin="03:03.115" end="03:03.907">足し</span><span begin="03:03.907" end="03:05.082">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">对改变感到恐惧</span><span ttm:role="x-roman" xml:lang="ja-Latn">ka wa 't te ku no ga ko wa ku te</span></p><p begin="03:05.165" end="03:18.458" ttm:agent="v1" itunes:key="L21"><span begin="03:05.165" end="03:06.560">私を</span><span begin="03:06.560" end="03:07.522">ふたつに</span><span begin="03:07.522" end="03:08.506">切り</span><span begin="03:08.506" end="03:10.408">離してくよう</span><span begin="03:10.408" end="03:11.972">な</span> <span begin="03:13.522" end="03:14.754">平行</span><span begin="03:14.754" end="03:18.458">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">那仿佛要将我割裂成两半的</span><span ttm:role="x-roman" xml:lang="ja-Latn">wa ta shi wo fu ta tsu ni ki ri ha na shi te ku yo u na</span></p><p begin="03:25.410" end="03:35.123" ttm:agent="v1" itunes:key="L22"><span begin="03:25.410" end="03:26.023">始</span><span begin="03:26.023" end="03:26.722">まら</span><span begin="03:26.722" end="03:27.655">ないふ</span><span begin="03:27.655" end="03:28.882">たり</span><span begin="03:28.882" end="03:29.834">は</span><span begin="03:30.164" end="03:31.980">どこまでも</span><span begin="03:31.980" end="03:33.391">歩い</span><span begin="03:33.391" end="03:34.236">て行く</span><span begin="03:34.236" end="03:35.123">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">永远不会开始的两人</span><span ttm:role="x-roman" xml:lang="ja-Latn">ha ji ma ra na i fu ta ri wa</span></p><p begin="03:35.175" end="03:45.004" ttm:agent="v1" itunes:key="L23"><span begin="03:35.175" end="03:36.463">はじまら</span><span begin="03:36.463" end="03:37.375">ない</span><span begin="03:37.375" end="03:38.607">話</span><span begin="03:38.607" end="03:39.289">だっ</span><span begin="03:39.289" end="03:39.559">て</span> <span begin="03:39.559" end="03:40.771">軌跡</span><span begin="03:40.771" end="03:41.089">を</span><span begin="03:41.089" end="03:42.017">刻</span><span begin="03:42.017" end="03:42.467">んで</span><span begin="03:42.467" end="03:43.348">来た</span><span begin="03:43.348" end="03:45.004">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">永远不会开场的故事</span><span ttm:role="x-roman" xml:lang="ja-Latn">ha ji ma ra na i ha na shi da 't te</span></p><p begin="03:45.452" end="03:55.240" ttm:agent="v1" itunes:key="L24"><span begin="03:45.452" end="03:46.804">太陽</span><span begin="03:46.804" end="03:48.068">系を</span><span begin="03:48.068" end="03:49.335">抜け出す</span><span begin="03:49.335" end="03:50.007">と</span> <span begin="03:50.601" end="03:52.444">平行線</span><span begin="03:52.444" end="03:52.761">は</span><span begin="03:52.761" end="03:53.737">交わ</span><span begin="03:53.737" end="03:54.204">る、</span><span begin="03:54.204" end="03:55.240">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">在摆脱太阳系以后</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta i yo u ke i wo nu ke da su to</span></p><p begin="03:55.510" end="03:59.921" ttm:agent="v1" itunes:key="L25"><span begin="03:55.510" end="03:56.255">そん</span><span begin="03:56.255" end="03:56.820">な</span><span begin="03:56.820" end="03:58.391">夢夜の</span><span begin="03:58.391" end="03:59.407">向こう</span><span begin="03:59.407" end="03:59.921">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在那样的梦里 在黑夜的彼岸</span><span ttm:role="x-roman" xml:lang="ja-Latn">so n na yu me yo no mu ko u ni</span></p><p begin="03:59.971" end="04:05.412" ttm:agent="v1" itunes:key="L26"><span begin="03:59.971" end="04:00.979">答え</span> <span begin="04:00.979" end="04:01.168">す</span><span begin="04:01.168" end="04:01.896">くい</span><span begin="04:01.896" end="04:03.126">上げたな</span><span begin="04:03.126" end="04:05.412">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若能掬起答案</span><span ttm:role="x-roman" xml:lang="ja-Latn">ko ta e su ku i a ge ta na ra</span></p><p begin="04:05.635" end="04:15.334" ttm:agent="v1" itunes:key="L27"><span begin="04:05.635" end="04:06.847">太陽</span><span begin="04:06.847" end="04:07.890">系</span><span begin="04:07.890" end="04:09.272">を抜け出し</span><span begin="04:09.272" end="04:10.673">て</span><span begin="04:10.673" end="04:12.881">平行線で</span><span begin="04:12.881" end="04:13.815">交</span><span begin="04:13.815" end="04:14.148">わ</span><span begin="04:14.148" end="04:15.334">ろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">摆脱太阳系</span><span ttm:role="x-roman" xml:lang="ja-Latn">ta i yo u ke i wo nu ke da shi te</span></p><p begin="04:15.688" end="04:25.677" ttm:agent="v1" itunes:key="L28"><span begin="04:15.688" end="04:16.445">そん</span><span begin="04:16.445" end="04:17.027">な</span><span begin="04:17.027" end="04:18.624">叶わない</span><span begin="04:18.624" end="04:19.385">望</span><span begin="04:19.385" end="04:19.761">みも</span><span begin="04:20.072" end="04:22.085">不甲斐ない</span><span begin="04:22.085" end="04:23.317">声も</span><span begin="04:23.317" end="04:24.618">引き連</span><span begin="04:24.618" end="04:25.677">れて</span><span ttm:role="x-translation" xml:lang="zh-Hans">那无法实现的冀望</span><span ttm:role="x-roman" xml:lang="ja-Latn">so n na ka na wa na i no zo mi mo</span></p><p begin="04:25.757" end="04:35.553" ttm:agent="v1" itunes:key="L29"><span begin="04:25.757" end="04:27.010">感情</span><span begin="04:27.010" end="04:27.978">全</span><span begin="04:27.978" end="04:28.274">部</span><span begin="04:28.274" end="04:29.342">流し</span><span begin="04:29.342" end="04:30.228">切った</span><span begin="04:30.228" end="04:30.660">ら</span> <span begin="04:30.660" end="04:31.361">描き</span><span begin="04:31.361" end="04:32.993">始めて</span><span begin="04:32.993" end="04:34.241">みせる</span><span begin="04:34.241" end="04:35.553">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">当感情全部流失之时</span><span ttm:role="x-roman" xml:lang="ja-Latn">ka n jo u ze n bu na ga shi ki 't ta ra</span></p><p begin="04:35.632" end="04:48.879" ttm:agent="v1" itunes:key="L30"><span begin="04:35.632" end="04:36.467">私</span><span begin="04:36.467" end="04:37.133">と</span><span begin="04:37.133" end="04:38.083">君の</span><span begin="04:38.083" end="04:39.053">影に</span><span begin="04:39.053" end="04:39.669">今</span><span begin="04:39.669" end="04:40.899">手を伸ば</span><span begin="04:40.899" end="04:42.445">す</span> <span begin="04:44.096" end="04:45.315">平行</span><span begin="04:45.315" end="04:48.879">線</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在对你我的影子伸出手</span><span ttm:role="x-roman" xml:lang="ja-Latn">wa ta shi to ki mi no ka ge ni i ma te wo no ba su</span></p></div></body></tt>