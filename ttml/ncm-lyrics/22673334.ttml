<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ko"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="22673334"/><amll:meta key="appleMusicId" value="1591334997"/><amll:meta key="musicName" value="Blue"/><amll:meta key="artists" value="BIGBANG"/><amll:meta key="album" value="ALIVE (Japanese Version)"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:55.107"><div begin="00:08.101" end="03:46.680"><p begin="00:08.101" end="00:13.878" ttm:agent="v1" itunes:key="L1"><span begin="00:08.101" end="00:08.821">겨울이</span> <span begin="00:08.821" end="00:10.099">가고</span> <span begin="00:10.759" end="00:11.183">봄이</span> <span begin="00:11.183" end="00:12.651">찾</span><span begin="00:12.651" end="00:13.075">아오</span><span begin="00:13.075" end="00:13.878">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">冬去春又来</span></p><p begin="00:14.186" end="00:21.486" ttm:agent="v1" itunes:key="L2"><span begin="00:14.186" end="00:14.555">우린</span> <span begin="00:14.555" end="00:15.113">시들</span><span begin="00:15.113" end="00:15.593">고</span> <span begin="00:15.811" end="00:16.473">그리움</span> <span begin="00:16.473" end="00:17.697">속에</span> <span begin="00:18.390" end="00:18.914">맘이</span> <span begin="00:18.914" end="00:20.296">멍</span><span begin="00:20.296" end="00:20.808">들었</span><span begin="00:20.808" end="00:21.486">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心里全是怀念</span></p><p begin="00:21.806" end="00:25.605" ttm:agent="v1" itunes:key="L3"><span begin="00:21.806" end="00:22.012">I'm</span> <span begin="00:22.012" end="00:22.551">singing</span> <span begin="00:22.551" end="00:22.868">ma</span> <span begin="00:22.868" end="00:25.605">blues</span><span ttm:role="x-translation" xml:lang="zh-Hans">I'm singing my blues</span></p><p begin="00:25.615" end="00:31.221" ttm:agent="v1" itunes:key="L4"><span begin="00:25.615" end="00:26.018">파란</span> <span begin="00:26.018" end="00:26.585">눈물</span><span begin="00:26.585" end="00:27.151">에</span> <span begin="00:27.531" end="00:28.051">파란</span> <span begin="00:28.051" end="00:28.530">슬픔</span><span begin="00:28.530" end="00:29.009">에</span> <span begin="00:29.009" end="00:31.221">길들었죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">在蓝色眼泪之中</span></p><p begin="00:29.512" end="00:33.311" ttm:agent="v1" itunes:key="L5"><span begin="00:29.512" end="00:29.718">I'm</span> <span begin="00:29.718" end="00:30.257">singing</span> <span begin="00:30.257" end="00:30.574">ma</span> <span begin="00:30.574" end="00:33.311">blues</span><span ttm:role="x-translation" xml:lang="zh-Hans">I'm singing my blues</span></p><p begin="00:33.558" end="00:38.510" ttm:agent="v1" itunes:key="L6"><span begin="00:33.558" end="00:33.844">뜬</span> <span begin="00:33.844" end="00:34.301">구름</span><span begin="00:34.301" end="00:34.849">에</span> <span begin="00:35.465" end="00:36.539">날려보낸</span> <span begin="00:36.539" end="00:37.546">사랑</span> <span begin="00:37.546" end="00:37.999">Oh,</span> <span begin="00:38.099" end="00:38.510">oh</span><span ttm:role="x-translation" xml:lang="zh-Hans">稍纵即逝 无法握紧的爱情</span></p><p begin="00:37.648" end="00:41.318" ttm:agent="v1" itunes:key="L7"><span begin="00:37.648" end="00:38.023">A-</span><span begin="00:38.107" end="00:38.463">yo</span> <span begin="00:38.566" end="00:39.024">같은</span> <span begin="00:39.024" end="00:39.483">하늘</span> <span begin="00:39.483" end="00:39.923">다른</span> <span begin="00:39.923" end="00:40.210">곳</span> <span begin="00:40.210" end="00:40.691">너와</span> <span begin="00:40.691" end="00:41.318">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">Oh oh</span></p><p begin="00:41.328" end="00:46.266" ttm:agent="v1" itunes:key="L8"><span begin="00:41.328" end="00:42.022">위험하니</span><span begin="00:42.022" end="00:42.716">까</span> <span begin="00:42.892" end="00:43.889">너에게서</span> <span begin="00:43.889" end="00:44.536">떠나</span> <span begin="00:44.536" end="00:45.517">주는</span> <span begin="00:45.517" end="00:45.772">거</span><span begin="00:45.772" end="00:46.266">야</span><span ttm:role="x-translation" xml:lang="zh-Hans">因相伴的危险</span></p><p begin="00:46.473" end="00:48.816" ttm:agent="v1" itunes:key="L9"><span begin="00:46.473" end="00:47.149">님이란</span> <span begin="00:47.149" end="00:47.886">글자에</span> <span begin="00:47.886" end="00:48.165">점</span> <span begin="00:48.165" end="00:48.816">하나</span><span ttm:role="x-translation" xml:lang="zh-Hans">虽然卑怯地</span></p><p begin="00:48.926" end="00:53.255" ttm:agent="v1" itunes:key="L10"><span begin="00:48.926" end="00:49.695">비겁하지</span><span begin="00:49.695" end="00:50.464">만</span> <span begin="00:50.602" end="00:51.070">내가</span> <span begin="00:51.070" end="00:51.523">못나</span> <span begin="00:51.523" end="00:52.162">숨는</span> <span begin="00:52.335" end="00:53.255">거야</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你形同陌路</span></p><p begin="00:53.265" end="00:56.577" ttm:agent="v1" itunes:key="L11"><span begin="00:53.265" end="00:53.732">잔인</span><span begin="00:53.732" end="00:54.156">한</span> <span begin="00:54.156" end="00:54.847">이별은</span> <span begin="00:54.847" end="00:55.613">사랑의</span> <span begin="00:55.613" end="00:56.577">말로</span><span ttm:role="x-translation" xml:lang="zh-Hans">残忍的离别是爱情的末路</span></p><p begin="00:56.754" end="01:00.887" ttm:agent="v1" itunes:key="L12"><span begin="00:56.754" end="00:57.117">그</span> <span begin="00:57.117" end="00:57.579">어떤</span> <span begin="00:57.579" end="00:58.523">말도</span> <span begin="00:58.714" end="00:59.435">위로될</span> <span begin="00:59.435" end="00:59.890">순</span> <span begin="00:59.890" end="01:00.389">없</span><span begin="01:00.389" end="01:00.887">다고</span><span ttm:role="x-translation" xml:lang="zh-Hans">任何言语</span></p><p begin="01:00.897" end="01:04.721" ttm:agent="v1" itunes:key="L13"><span begin="01:00.897" end="01:01.813">아마</span> <span begin="01:01.813" end="01:02.009">내</span> <span begin="01:02.009" end="01:02.833">인생의</span> <span begin="01:02.833" end="01:03.273">마지</span><span begin="01:03.273" end="01:03.713">막</span> <span begin="01:03.713" end="01:04.721">멜로</span><span ttm:role="x-translation" xml:lang="zh-Hans">如今 兴许我这部人生爱情片</span></p><p begin="01:04.731" end="01:07.621" ttm:agent="v1" itunes:key="L14"><span begin="01:04.731" end="01:05.233">막이</span> <span begin="01:05.233" end="01:05.938">내려</span><span begin="01:05.938" end="01:06.642">오네요</span> <span begin="01:06.642" end="01:06.922">이</span><span begin="01:06.922" end="01:07.621">제</span><span ttm:role="x-translation" xml:lang="zh-Hans">即将谢下最后帷幕</span></p><p begin="01:08.170" end="01:11.218" ttm:agent="v1" itunes:key="L15"><span begin="01:08.170" end="01:08.729">태어나</span><span begin="01:08.729" end="01:09.288">서</span> <span begin="01:09.288" end="01:09.836">널</span> <span begin="01:09.836" end="01:10.200">만</span><span begin="01:10.200" end="01:11.218">나고</span><span ttm:role="x-translation" xml:lang="zh-Hans">来到这个世界之后遇见了你</span></p><p begin="01:11.849" end="01:15.326" ttm:agent="v1" itunes:key="L16"><span begin="01:11.849" end="01:12.503">죽을만</span><span begin="01:12.503" end="01:13.157">큼</span> <span begin="01:13.157" end="01:14.541">사랑하</span><span begin="01:14.541" end="01:15.326">고</span><span ttm:role="x-translation" xml:lang="zh-Hans">用拼死的气力去爱你</span></p><p begin="01:15.757" end="01:19.283" ttm:agent="v1" itunes:key="L17"><span begin="01:15.757" end="01:16.466">파랗게</span> <span begin="01:16.466" end="01:17.434">물들어</span> <span begin="01:17.639" end="01:18.015">시린</span> <span begin="01:18.015" end="01:18.402">내</span> <span begin="01:18.402" end="01:19.283">맘</span><span ttm:role="x-translation" xml:lang="zh-Hans">我那颗染上蓝色的</span></p><p begin="01:19.630" end="01:25.131" ttm:agent="v1" itunes:key="L18"><span begin="01:19.630" end="01:20.113">눈을</span> <span begin="01:20.113" end="01:20.377">감</span><span begin="01:20.377" end="01:21.326">아도</span> <span begin="01:21.326" end="01:21.731">널</span> <span begin="01:21.731" end="01:22.187">느</span><span begin="01:22.187" end="01:22.643">낄</span> <span begin="01:22.643" end="01:23.233">수</span> <span begin="01:23.233" end="01:24.173">없잖</span><span begin="01:24.173" end="01:25.131">아</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使闭上双眼</span></p><p begin="01:24.923" end="01:30.700" ttm:agent="v1" itunes:key="L19"><span begin="01:24.923" end="01:25.643">겨울이</span> <span begin="01:25.643" end="01:26.734">가고</span> <span begin="01:27.581" end="01:28.005">봄이</span> <span begin="01:28.005" end="01:29.473">찾</span><span begin="01:29.473" end="01:29.897">아오</span><span begin="01:29.897" end="01:30.700">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">冬去春又来</span></p><p begin="01:30.880" end="01:38.180" ttm:agent="v1" itunes:key="L20"><span begin="01:30.880" end="01:31.249">우린</span> <span begin="01:31.249" end="01:31.807">시들</span><span begin="01:31.807" end="01:32.287">고</span> <span begin="01:32.505" end="01:33.167">그리움</span> <span begin="01:33.167" end="01:34.391">속에</span> <span begin="01:35.084" end="01:35.608">맘이</span> <span begin="01:35.608" end="01:36.990">멍</span><span begin="01:36.990" end="01:37.502">들었</span><span begin="01:37.502" end="01:38.180">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心里全是怀念</span></p><p begin="01:38.557" end="01:42.356" ttm:agent="v1" itunes:key="L21"><span begin="01:38.557" end="01:38.763">I'm</span> <span begin="01:38.763" end="01:39.302">singing</span> <span begin="01:39.302" end="01:39.619">ma</span> <span begin="01:39.619" end="01:42.356">blues</span><span ttm:role="x-translation" xml:lang="zh-Hans">I'm singing my blues</span></p><p begin="01:42.384" end="01:48.052" ttm:agent="v1" itunes:key="L22"><span begin="01:42.384" end="01:43.518">파란</span> <span begin="01:43.518" end="01:44.651">눈물에</span> <span begin="01:44.651" end="01:45.785">파란</span> <span begin="01:45.785" end="01:46.918">슬픔에</span> <span begin="01:46.918" end="01:48.052">길들여져</span><span ttm:role="x-translation" xml:lang="zh-Hans">在蓝色眼泪之中</span></p><p begin="01:46.310" end="01:50.109" ttm:agent="v1" itunes:key="L23"><span begin="01:46.310" end="01:46.516">I'm</span> <span begin="01:46.516" end="01:47.055">singing</span> <span begin="01:47.055" end="01:47.372">ma</span> <span begin="01:47.372" end="01:50.109">blues</span><span ttm:role="x-translation" xml:lang="zh-Hans">I'm singing my blues</span></p><p begin="01:50.348" end="01:55.300" ttm:agent="v1" itunes:key="L24"><span begin="01:50.348" end="01:50.634">뜬</span> <span begin="01:50.634" end="01:51.091">구름</span><span begin="01:51.091" end="01:51.639">에</span> <span begin="01:52.255" end="01:53.329">날려보낸</span> <span begin="01:53.329" end="01:54.336">사랑</span> <span begin="01:54.336" end="01:54.789">Oh,</span> <span begin="01:54.889" end="01:55.300">oh</span><span ttm:role="x-translation" xml:lang="zh-Hans">稍纵即逝 无法握紧的爱情</span></p><p begin="01:55.270" end="01:57.794" ttm:agent="v1" itunes:key="L25"><span begin="01:55.270" end="01:56.076">심장이</span> <span begin="01:56.076" end="01:56.532">멎은</span> <span begin="01:56.532" end="01:56.988">것만</span> <span begin="01:56.988" end="01:57.794">같아</span><span ttm:role="x-translation" xml:lang="zh-Hans">心跳就快停止</span></p><p begin="01:57.804" end="02:03.070" ttm:agent="v1" itunes:key="L26"><span begin="01:57.804" end="01:58.432">전쟁이</span> <span begin="01:58.432" end="01:58.996">끝났</span><span begin="01:58.996" end="01:59.559">고</span> <span begin="01:59.744" end="02:00.397">그곳에</span> <span begin="02:00.397" end="02:00.900">얼어</span><span begin="02:00.900" end="02:01.825">붙은</span> <span begin="02:01.825" end="02:02.304">너</span><span begin="02:02.304" end="02:02.532">와</span> <span begin="02:02.532" end="02:03.070">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">战争停歇后</span></p><p begin="02:03.080" end="02:05.497" ttm:agent="v1" itunes:key="L27"><span begin="02:03.080" end="02:03.295">내</span> <span begin="02:03.295" end="02:03.999">머릿속</span> <span begin="02:03.999" end="02:04.659">새겨진</span> <span begin="02:04.659" end="02:05.078">트라우</span><span begin="02:05.078" end="02:05.497">마</span><span ttm:role="x-translation" xml:lang="zh-Hans">脑海中印刻下的创伤</span></p><p begin="02:05.507" end="02:10.631" ttm:agent="v1" itunes:key="L28"><span begin="02:05.507" end="02:05.742">이</span> <span begin="02:05.742" end="02:06.140">눈물</span> <span begin="02:06.140" end="02:06.563">마르</span><span begin="02:06.563" end="02:07.210">면</span> <span begin="02:07.324" end="02:08.151">촉촉히</span> <span begin="02:08.151" end="02:08.593">기억</span><span begin="02:08.593" end="02:09.523">하리</span> <span begin="02:09.523" end="02:09.899">내</span> <span begin="02:09.899" end="02:10.631">사랑</span><span ttm:role="x-translation" xml:lang="zh-Hans">若是泪水干涸</span></p><p begin="02:10.678" end="02:13.388" ttm:agent="v1" itunes:key="L29"><span begin="02:10.678" end="02:11.202">괴롭지</span><span begin="02:11.202" end="02:11.726">도</span> <span begin="02:11.726" end="02:12.168">외롭지</span><span begin="02:12.168" end="02:12.609">도</span> <span begin="02:12.609" end="02:12.890">않</span><span begin="02:12.890" end="02:13.388">아</span><span ttm:role="x-translation" xml:lang="zh-Hans">不再痛苦 不再孤独</span></p><p begin="02:13.427" end="02:15.263" ttm:agent="v1" itunes:key="L30"><span begin="02:13.427" end="02:13.990">행복은</span> <span begin="02:13.990" end="02:14.371">다</span> <span begin="02:14.371" end="02:15.263">혼자만</span><span ttm:role="x-translation" xml:lang="zh-Hans">幸福全是自说自话</span></p><p begin="02:15.273" end="02:17.945" ttm:agent="v1" itunes:key="L31"><span begin="02:15.273" end="02:15.546">그</span> <span begin="02:15.546" end="02:16.238">이상의</span> <span begin="02:16.238" end="02:16.724">복잡</span><span begin="02:16.724" end="02:17.040">한</span> <span begin="02:17.040" end="02:17.164">건</span> <span begin="02:17.164" end="02:17.382">못</span> <span begin="02:17.382" end="02:17.945">참아</span><span ttm:role="x-translation" xml:lang="zh-Hans">忍受不了更多的复杂</span></p><p begin="02:17.955" end="02:22.801" ttm:agent="v1" itunes:key="L32"><span begin="02:17.955" end="02:18.881">대수롭지</span> <span begin="02:18.881" end="02:20.114">아무렇지도</span> <span begin="02:20.114" end="02:21.024">않아</span> <span begin="02:21.024" end="02:21.300">별</span> <span begin="02:21.300" end="02:21.543">수</span> <span begin="02:21.543" end="02:22.022">없는</span> <span begin="02:22.022" end="02:22.801">방황</span><span ttm:role="x-translation" xml:lang="zh-Hans">不再重要 不再关心</span></p><p begin="02:22.980" end="02:25.890" ttm:agent="v1" itunes:key="L33"><span begin="02:22.980" end="02:23.932">사람들은</span> <span begin="02:23.932" end="02:24.880">왔다</span> <span begin="02:24.880" end="02:25.890">간다</span><span ttm:role="x-translation" xml:lang="zh-Hans">人群来来往往</span></p><p begin="02:24.855" end="02:27.903" ttm:agent="v1" itunes:key="L34"><span begin="02:24.855" end="02:25.414">태어나</span><span begin="02:25.414" end="02:25.973">서</span> <span begin="02:25.973" end="02:26.521">널</span> <span begin="02:26.521" end="02:26.885">만</span><span begin="02:26.885" end="02:27.903">나고</span><span ttm:role="x-translation" xml:lang="zh-Hans">来到这个世界之后遇见了你</span></p><p begin="02:28.660" end="02:32.137" ttm:agent="v1" itunes:key="L35"><span begin="02:28.660" end="02:29.314">죽을만</span><span begin="02:29.314" end="02:29.968">큼</span> <span begin="02:29.968" end="02:31.352">사랑하</span><span begin="02:31.352" end="02:32.137">고</span><span ttm:role="x-translation" xml:lang="zh-Hans">用拼死的气力去爱你</span></p><p begin="02:32.634" end="02:36.160" ttm:agent="v1" itunes:key="L36"><span begin="02:32.634" end="02:33.343">파랗게</span> <span begin="02:33.343" end="02:34.311">물들어</span> <span begin="02:34.516" end="02:34.892">시린</span> <span begin="02:34.892" end="02:35.279">내</span> <span begin="02:35.279" end="02:36.160">맘</span><span ttm:role="x-translation" xml:lang="zh-Hans">我那颗染上蓝色的冰冷的心</span></p><p begin="02:36.361" end="02:41.576" ttm:agent="v1" itunes:key="L37"><span begin="02:36.361" end="02:36.874">너는</span> <span begin="02:36.874" end="02:37.183">떠</span><span begin="02:37.183" end="02:38.005">나도</span> <span begin="02:38.005" end="02:38.539">난</span> <span begin="02:38.539" end="02:39.120">그</span><span begin="02:39.120" end="02:40.055">대로</span> <span begin="02:40.055" end="02:40.860">있잖</span><span begin="02:40.860" end="02:41.576">아</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使你已离去 我还站在原地</span></p><p begin="02:41.629" end="02:47.406" ttm:agent="v1" itunes:key="L38"><span begin="02:41.629" end="02:42.349">겨울이</span> <span begin="02:42.349" end="02:43.627">가고</span> <span begin="02:44.287" end="02:44.711">봄이</span> <span begin="02:44.711" end="02:46.179">찾</span><span begin="02:46.179" end="02:46.603">아오</span><span begin="02:46.603" end="02:47.406">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">冬去春又来</span></p><p begin="02:47.666" end="02:54.966" ttm:agent="v1" itunes:key="L39"><span begin="02:47.666" end="02:48.035">우린</span> <span begin="02:48.035" end="02:48.593">시들</span><span begin="02:48.593" end="02:49.073">고</span> <span begin="02:49.291" end="02:49.953">그리움</span> <span begin="02:49.953" end="02:51.177">속에</span> <span begin="02:51.870" end="02:52.394">맘이</span> <span begin="02:52.394" end="02:53.776">멍</span><span begin="02:53.776" end="02:54.288">들었</span><span begin="02:54.288" end="02:54.966">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心里全是怀念</span></p><p begin="02:55.599" end="03:02.583" ttm:agent="v1" itunes:key="L40"><span begin="02:55.599" end="02:56.279">오늘도</span> <span begin="02:56.279" end="02:57.202">파란</span> <span begin="02:57.202" end="02:57.581">저</span> <span begin="02:57.789" end="02:58.261">달빛</span> <span begin="02:58.261" end="02:59.705">아래에</span> <span begin="02:59.705" end="02:59.932">나</span> <span begin="02:59.932" end="03:00.474">홀로</span> <span begin="03:00.670" end="03:01.096">잠이</span> <span begin="03:01.096" end="03:01.955">들겠</span><span begin="03:01.955" end="03:02.583">죠</span><span ttm:role="x-translation" xml:lang="zh-Hans">今日也会在这蓝色月光下</span></p><p begin="03:03.342" end="03:07.263" ttm:agent="v1" itunes:key="L41"><span begin="03:03.342" end="03:03.529">꿈</span> <span begin="03:03.529" end="03:03.960">속에</span><span begin="03:03.960" end="03:04.559">서</span> <span begin="03:04.559" end="03:05.393">떠난</span> <span begin="03:05.436" end="03:05.883">그대</span><span begin="03:05.883" end="03:06.285">를</span> <span begin="03:06.330" end="03:07.263">찾아</span><span ttm:role="x-translation" xml:lang="zh-Hans">睡梦里我仍在寻找你</span></p><p begin="03:07.383" end="03:12.247" ttm:agent="v1" itunes:key="L42"><span begin="03:07.383" end="03:07.921">헤매</span><span begin="03:07.921" end="03:08.788">이며</span> <span begin="03:08.788" end="03:09.309">이</span> <span begin="03:09.309" end="03:10.525">노래를</span> <span begin="03:10.756" end="03:11.606">불러</span><span begin="03:11.713" end="03:12.247">요</span><span ttm:role="x-translation" xml:lang="zh-Hans">徘徊不前 吟唱此曲</span></p><p begin="03:14.575" end="03:18.374" ttm:agent="v1" itunes:key="L43"><span begin="03:14.575" end="03:14.781">I'm</span> <span begin="03:14.781" end="03:15.320">singing</span> <span begin="03:15.320" end="03:15.546">ma</span> <span begin="03:15.546" end="03:18.374">blues</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的心里全是怀念</span></p><p begin="03:18.470" end="03:24.076" ttm:agent="v1" itunes:key="L44"><span begin="03:18.470" end="03:18.873">파란</span> <span begin="03:18.873" end="03:19.440">눈물</span><span begin="03:19.440" end="03:20.006">에</span> <span begin="03:20.386" end="03:20.906">파란</span> <span begin="03:20.906" end="03:21.385">슬픔</span><span begin="03:21.385" end="03:21.864">에</span> <span begin="03:21.864" end="03:24