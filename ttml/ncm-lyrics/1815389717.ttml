<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ko"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="1815389717"/><amll:meta key="appleMusicId" value="1550907178"/><amll:meta key="musicName" value="Celebrity"/><amll:meta key="artists" value="IU"/><amll:meta key="album" value="Celebrity"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:15.533"><div begin="00:01.350" end="03:13.450"><p begin="00:01.350" end="00:03.538" ttm:agent="v1" itunes:key="L1"><span begin="00:01.350" end="00:01.761">세상</span><span begin="00:01.761" end="00:02.391">의</span> <span begin="00:02.630" end="00:02.830">모</span><span begin="00:02.830" end="00:03.142">서</span><span begin="00:03.142" end="00:03.538">리</span><span ttm:role="x-translation" xml:lang="zh-Hans">活在世界的边缘</span></p><p begin="00:03.646" end="00:05.917" ttm:agent="v1" itunes:key="L2"><span begin="00:03.646" end="00:03.840">구</span><span begin="00:03.840" end="00:04.907">부정하게</span> <span begin="00:04.907" end="00:05.249">커</span><span begin="00:05.249" end="00:05.434">버</span><span begin="00:05.434" end="00:05.917">린</span><span ttm:role="x-translation" xml:lang="zh-Hans">与他人格格不入</span></p><p begin="00:05.966" end="00:09.884" ttm:agent="v1" itunes:key="L3"><span begin="00:05.966" end="00:06.259">골</span><span begin="00:06.259" end="00:07.176">칫거리</span> <span begin="00:07.176" end="00:07.516">Out</span><span begin="00:07.516" end="00:08.176">si</span><span begin="00:08.176" end="00:09.884">der</span><span ttm:role="x-translation" xml:lang="zh-Hans">简直是个不合群的惹祸精</span></p><p begin="00:10.904" end="00:13.084" ttm:agent="v1" itunes:key="L4"><span begin="00:10.904" end="00:11.298">걸음</span><span begin="00:11.298" end="00:11.559">걸</span><span begin="00:11.559" end="00:11.915">이</span> <span begin="00:12.241" end="00:12.414">옷</span><span begin="00:12.414" end="00:13.084">차림</span><span ttm:role="x-translation" xml:lang="zh-Hans">走路姿态 衣服穿搭</span></p><p begin="00:13.288" end="00:15.559" ttm:agent="v1" itunes:key="L5"><span begin="00:13.288" end="00:14.004">이어폰</span> <span begin="00:14.004" end="00:14.575">너머</span> <span begin="00:14.575" end="00:15.226">Play</span><span begin="00:15.226" end="00:15.559">list</span><span ttm:role="x-translation" xml:lang="zh-Hans">就连耳机里的播放列表</span></p><p begin="00:15.569" end="00:19.577" ttm:agent="v1" itunes:key="L6"><span begin="00:15.569" end="00:15.914">음</span><span begin="00:15.914" end="00:16.692">악까지</span> <span begin="00:16.692" end="00:17.042">다</span> <span begin="00:17.042" end="00:17.562">Mi</span><span begin="00:17.562" end="00:19.577">nor</span><span ttm:role="x-translation" xml:lang="zh-Hans">全都是小众音乐</span></p><p begin="00:20.590" end="00:22.679" ttm:agent="v1" itunes:key="L7"><span begin="00:20.590" end="00:21.056">넌</span> <span begin="00:21.268" end="00:21.740">모르</span><span begin="00:21.800" end="00:22.679">지</span><span ttm:role="x-translation" xml:lang="zh-Hans">你不知道吧</span></p><p begin="00:22.708" end="00:24.790" ttm:agent="v1" itunes:key="L8"><span begin="00:22.708" end="00:23.012">떨</span><span begin="00:23.012" end="00:23.487">군</span> <span begin="00:23.635" end="00:24.096">고개</span> <span begin="00:24.203" end="00:24.790">위</span><span ttm:role="x-translation" xml:lang="zh-Hans">你低垂的头顶上方</span></p><p begin="00:24.799" end="00:27.269" ttm:agent="v1" itunes:key="L9"><span begin="00:24.799" end="00:25.320">환한</span> <span begin="00:25.447" end="00:25.907">빛</span> <span begin="00:25.999" end="00:26.588">조명</span><span begin="00:26.588" end="00:27.269">이</span><span ttm:role="x-translation" xml:lang="zh-Hans">有一束耀眼的光芒</span></p><p begin="00:27.278" end="00:29.671" ttm:agent="v1" itunes:key="L10"><span begin="00:27.278" end="00:27.652">어딜</span> <span begin="00:27.825" end="00:28.326">비</span><span begin="00:28.326" end="00:29.002">추는</span><span begin="00:29.002" end="00:29.671">지</span><span ttm:role="x-translation" xml:lang="zh-Hans">它究竟在照耀何方</span></p><p begin="00:29.682" end="00:32.007" ttm:agent="v1" itunes:key="L11"><span begin="00:29.682" end="00:30.144">느려</span><span begin="00:30.144" end="00:30.535">도</span> <span begin="00:30.725" end="00:31.320">좋으</span><span begin="00:31.320" end="00:32.007">니</span><span ttm:role="x-translation" xml:lang="zh-Hans">放慢脚步也无妨</span></p><p begin="00:32.016" end="00:34.398" ttm:agent="v1" itunes:key="L12"><span begin="00:32.016" end="00:32.570">결국</span> <span begin="00:32.570" end="00:33.214">알</span><span begin="00:33.214" end="00:33.460">게</span> <span begin="00:33.460" end="00:33.761">되</span><span begin="00:33.761" end="00:34.398">길</span><span ttm:role="x-translation" xml:lang="zh-Hans">希望最终你会明白</span></p><p begin="00:34.738" end="00:37.078" ttm:agent="v1" itunes:key="L13"><span begin="00:34.738" end="00:35.042">The</span> <span begin="00:35.042" end="00:35.543">one</span> <span begin="00:35.543" end="00:35.843">and</span> <span begin="00:35.843" end="00:36.176">on</span><span begin="00:36.176" end="00:37.078">ly</span><span ttm:role="x-translation" xml:lang="zh-Hans">如此独一无二的你</span></p><p begin="00:37.697" end="00:39.749" ttm:agent="v1" itunes:key="L14"><span begin="00:37.697" end="00:38.014">You're</span> <span begin="00:38.014" end="00:38.255">my</span> <span begin="00:38.255" end="00:38.818">Cele</span><span begin="00:38.818" end="00:39.185">bri</span><span begin="00:39.185" end="00:39.749">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">在我看来 你就是耀眼名人</span></p><p begin="00:40.345" end="00:44.695" ttm:agent="v1" itunes:key="L15"><span begin="00:40.345" end="00:40.920">잊지</span> <span begin="00:40.920" end="00:41.541">마</span> <span begin="00:41.541" end="00:42.126">넌</span> <span begin="00:42.273" end="00:43.000">흐린</span> <span begin="00:43.092" end="00:43.619">어</span><span begin="00:43.619" end="00:43.971">둠</span> <span begin="00:43.971" end="00:44.695">사이</span><span ttm:role="x-translation" xml:lang="zh-Hans">请铭记 你是混沌黑暗中</span></p><p begin="00:45.159" end="00:49.460" ttm:agent="v1" itunes:key="L16"><span begin="00:45.159" end="00:45.825">왼손</span><span begin="00:45.825" end="00:46.869">으로</span> <span begin="00:46.978" end="00:47.803">그린</span> <span begin="00:47.803" end="00:48.384">별</span> <span begin="00:48.384" end="00:48.739">하</span><span begin="00:48.739" end="00:49.460">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">用左手画下的一颗星</span></p><p begin="00:49.976" end="00:54.275" ttm:agent="v1" itunes:key="L17"><span begin="00:49.976" end="00:50.884">보이니</span> <span begin="00:50.884" end="00:51.252">그</span> <span begin="00:51.252" end="00:52.566">유일함이</span> <span begin="00:52.718" end="00:53.158">얼</span><span begin="00:53.158" end="00:53.571">마</span><span begin="00:53.571" end="00:54.275">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看到了吗 你的独一无二</span></p><p begin="00:54.730" end="00:57.081" ttm:agent="v1" itunes:key="L18"><span begin="00:54.730" end="00:55.450">아름다운</span><span begin="00:55.450" end="00:55.840">지</span> <span begin="00:56.080" end="00:56.402">말</span><span begin="00:56.402" end="00:57.081">야</span><span ttm:role="x-translation" xml:lang="zh-Hans">是如此的弥足珍贵</span></p><p begin="00:56.960" end="00:58.964" ttm:agent="v1" itunes:key="L19"><span begin="00:56.960" end="00:57.243">You're</span> <span begin="00:57.243" end="00:57.415">my</span> <span begin="00:57.415" end="00:58.112">Cele</span><span begin="00:58.112" end="00:58.438">bri</span><span begin="00:58.438" end="00:58.964">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是独属于我的名人</span></p><p begin="01:07.074" end="01:08.667" ttm:agent="v1" itunes:key="L20"><span begin="01:07.074" end="01:07.713">Cele</span><span begin="01:07.713" end="01:08.057">bri</span><span begin="01:08.057" end="01:08.667">ty</span></p><p begin="01:16.063" end="01:18.233" ttm:agent="v1" itunes:key="L21"><span begin="01:16.063" end="01:16.411">You're</span> <span begin="01:16.411" end="01:16.598">my</span> <span begin="01:16.598" end="01:17.320">Cele</span><span begin="01:17.320" end="01:17.660">bri</span><span begin="01:17.660" end="01:18.233">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是独属于我的名人</span></p><p begin="01:17.863" end="01:20.314" ttm:agent="v1" itunes:key="L22"><span begin="01:17.863" end="01:18.260">지</span><span begin="01:18.260" end="01:18.681">쳐버</span><span begin="01:18.681" end="01:19.121">린</span> <span begin="01:19.258" end="01:19.703">표정</span> <span begin="01:19.703" end="01:19.885">마</span><span begin="01:19.885" end="01:20.314">치</span><span ttm:role="x-translation" xml:lang="zh-Hans">你一脸的精疲力竭</span></p><p begin="01:20.455" end="01:22.661" ttm:agent="v1" itunes:key="L23"><span begin="01:20.455" end="01:20.604">전</span><span begin="01:20.604" end="01:21.175">원을</span> <span begin="01:21.175" end="01:22.146">꺼놓은</span> <span begin="01:22.146" end="01:22.279">듯</span><span begin="01:22.279" end="01:22.661">이</span><span ttm:role="x-translation" xml:lang="zh-Hans">像被人切断了电源</span></p><p begin="01:22.670" end="01:26.587" ttm:agent="v1" itunes:key="L24"><span begin="01:22.670" end="01:23.316">심장</span> <span begin="01:23.316" end="01:23.906">소린</span> <span begin="01:23.906" end="01:24.372">Too</span> <span begin="01:24.372" end="01:24.819">qui</span><span begin="01:24.819" end="01:26.587">et</span><span ttm:role="x-translation" xml:lang="zh-Hans">心跳声也变得寂静了</span></p><p begin="01:27.446" end="01:29.829" ttm:agent="v1" itunes:key="L25"><span begin="01:27.446" end="01:27.948">네</span><span begin="01:27.948" end="01:28.130">가</span> <span begin="01:28.130" end="01:28.468">가진</span> <span begin="01:28.671" end="01:29.338">반짝</span><span begin="01:29.338" end="01:29.829">거림</span><span ttm:role="x-translation" xml:lang="zh-Hans">你所拥有的闪光点</span></p><p begin="01:29.874" end="01:32.393" ttm:agent="v1" itunes:key="L26"><span begin="01:29.874" end="01:30.223">상</span><span begin="01:30.223" end="01:30.809">상력</span> <span begin="01:30.809" end="01:31.420">Iden</span><span begin="01:31.420" end="01:31.995">ti</span><span begin="01:31.995" end="01:32.393">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">想象力 独特符号</span></p><p begin="01:32.402" end="01:35.771" ttm:agent="v1" itunes:key="L27"><span begin="01:32.402" end="01:32.892">까지</span> <span begin="01:32.892" end="01:33.732">모조리</span> <span begin="01:33.732" end="01:34.442">Di</span><span begin="01:34.442" end="01:35.771">et</span><span ttm:role="x-translation" xml:lang="zh-Hans">一一都被约束</span></p><p begin="01:37.399" end="01:39.224" ttm:agent="v1" itunes:key="L28"><span begin="01:37.399" end="01:37.885">넌</span> <span begin="01:37.991" end="01:38.515">모르</span><span begin="01:38.540" end="01:39.224">지</span><span ttm:role="x-translation" xml:lang="zh-Hans">你不知道吧</span></p><p begin="01:39.532" end="01:41.656" ttm:agent="v1" itunes:key="L29"><span begin="01:39.532" end="01:39.826">아</span><span begin="01:39.826" end="01:40.240">직</span> <span begin="01:40.376" end="01:40.890">못다</span> <span begin="01:41.020" end="01:41.656">핀</span><span ttm:role="x-translation" xml:lang="zh-Hans">花蕾还未完全绽放</span></p><p begin="01:41.667" end="01:44.158" ttm:agent="v1" itunes:key="L30"><span begin="01:41.667" end="01:41.956">널</span> <span begin="01:41.956" end="01:42.271">위</span><span begin="01:42.271" end="01:42.664">해</span> <span begin="01:42.714" end="01:43.275">쓰여</span><span begin="01:43.326" end="01:44.158">진</span><span ttm:role="x-translation" xml:lang="zh-Hans">为你而作的</span></p><p begin="01:44.067" end="01:46.721" ttm:agent="v1" itunes:key="L31"><span begin="01:44.067" end="01:44.673">오래</span><span begin="01:44.673" end="01:45.147">된</span> <span begin="01:45.221" end="01:45.798">사랑</span><span begin="01:45.798" end="01:46.721">시</span><span ttm:role="x-translation" xml:lang="zh-Hans">古老情诗</span></p><p begin="01:46.385" end="01:48.764" ttm:agent="v1" itunes:key="L32"><span begin="01:46.385" end="01:46.980">헤매</span><span begin="01:47.093" end="01:47.407">도</span> <span begin="01:47.525" end="01:48.169">좋으</span><span begin="01:48.169" end="01:48.764">니</span><span ttm:role="x-translation" xml:lang="zh-Hans">彷徨四顾也无妨</span></p><p begin="01:48.772" end="01:51.319" ttm:agent="v1" itunes:key="L33"><span begin="01:48.772" end="01:49.332">웃음</span> <span begin="01:49.332" end="01:49.922">짓</span><span begin="01:49.922" end="01:50.131">게</span> <span begin="01:50.131" end="01:50.500">되</span><span begin="01:50.500" end="01:51.319">길</span><span ttm:role="x-translation" xml:lang="zh-Hans">只愿你笑容满面</span></p><p begin="01:51.439" end="01:54.092" ttm:agent="v1" itunes:key="L34"><span begin="01:51.439" end="01:51.834">The</span> <span begin="01:51.834" end="01:52.211">one</span> <span begin="01:52.384" end="01:52.700">and</span> <span begin="01:52.700" end="01:53.051">on</span><span begin="01:53.051" end="01:54.092">ly</span><span ttm:role="x-translation" xml:lang="zh-Hans">如此独一无二的你</span></p><p begin="01:54.472" end="01:56.642" ttm:agent="v1" itunes:key="L35"><span begin="01:54.472" end="01:54.820">You're</span> <span begin="01:54.820" end="01:55.007">my</span> <span begin="01:55.007" end="01:55.729">Cele</span><span begin="01:55.729" end="01:56.069">bri</span><span begin="01:56.069" end="01:56.642">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">在我看来 你就是耀眼名人</span></p><p begin="01:57.086" end="02:01.436" ttm:agent="v1" itunes:key="L36"><span begin="01:57.086" end="01:57.661">잊지</span> <span begin="01:57.661" end="01:58.222">마</span> <span begin="01:58.383" end="01:58.867">넌</span> <span begin="01:59.014" end="01:59.741">흐린</span> <span begin="01:59.833" end="02:00.360">어</span><span begin="02:00.360" end="02:00.712">둠</span> <span begin="02:00.712" end="02:01.436">사이</span><span ttm:role="x-translation" xml:lang="zh-Hans">请铭记 你是混沌黑暗中</span></p><p begin="02:01.923" end="02:06.279" ttm:agent="v1" itunes:key="L37"><span begin="02:01.923" end="02:02.599">왼손</span><span begin="02:02.599" end="02:03.179">으</span><span begin="02:03.179" end="02:03.685">로</span> <span begin="02:03.839" end="02:04.520">그린</span> <span begin="02:04.677" end="02:05.190">별</span> <span begin="02:05.190" end="02:05.634">하</span><span begin="02:05.634" end="02:06.279">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">用左手画下的一颗星</span></p><p begin="02:06.744" end="02:11.017" ttm:agent="v1" itunes:key="L38"><span begin="02:06.744" end="02:07.675">보이니</span> <span begin="02:07.675" end="02:07.950">그</span> <span begin="02:07.950" end="02:08.626">유일</span><span begin="02:08.626" end="02:08.943">함</span><span begin="02:08.943" end="02:09.365">이</span> <span begin="02:09.509" end="02:10.057">얼</span><span begin="02:10.057" end="02:10.433">마</span><span begin="02:10.433" end="02:11.017">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看到了吗 你的独一无二</span></p><p begin="02:11.535" end="02:13.858" ttm:agent="v1" itunes:key="L39"><span begin="02:11.535" end="02:12.249">아름다운</span><span begin="02:12.249" end="02:12.820">지</span> <span begin="02:12.820" end="02:13.166">말</span><span begin="02:13.166" end="02:13.858">야</span><span ttm:role="x-translation" xml:lang="zh-Hans">是如此的弥足珍贵</span></p><p begin="02:13.702" end="02:15.872" ttm:agent="v1" itunes:key="L40"><span begin="02:13.702" end="02:14.050">You're</span> <span begin="02:14.050" end="02:14.237">my</span> <span begin="02:14.237" end="02:14.959">Cele</span><span begin="02:14.959" end="02:15.299">bri</span><span begin="02:15.299" end="02:15.872">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是独属于我的名人</span></p><p begin="02:16.331" end="02:20.345" ttm:agent="v1" itunes:key="L41"><span begin="02:16.331" end="02:16.990">발자</span><span begin="02:16.990" end="02:17.608">국</span><span begin="02:17.608" end="02:18.217">마다</span> <span begin="02:18.217" end="02:19.035">이어진</span> <span begin="02:19.035" end="02:19.758">별자</span><span begin="02:19.758" end="02:20.345">리</span><span ttm:role="x-translation" xml:lang="zh-Hans">每个足迹都串联成一个星座</span></p><p begin="02:20.364" end="02:25.764" ttm:agent="v1" itunes:key="L42"><span begin="02:20.364" end="02:20.659">그</span> <span begin="02:20.659" end="02:21.448">서투른</span> <span begin="02:21.448" end="02:22.080">걸음</span><span begin="02:22.080" end="02:22.734">이</span> <span begin="02:22.926" end="02:23.909">새겨놓</span><span begin="02:23.909" end="02:24.572">은</span> <span begin="02:24.572" end="02:25.139">밑그</span><span begin="02:25.139" end="02:25.764">림</span><span ttm:role="x-translation" xml:lang="zh-Hans">仓促的脚步描绘出画稿</span></p><p begin="02:26.036" end="02:30.246" ttm:agent="v1" itunes:key="L43"><span begin="02:26.036" end="02:26.457">오롯</span><span begin="02:26.457" end="02:27.206">이</span> <span begin="02:27.206" end="02:27.772">너를</span> <span begin="02:27.772" end="02:28.696">만나러</span> <span begin="02:28.696" end="02:29.322">가는</span> <span begin="02:29.322" end="02:30.246">길</span><span ttm:role="x-translation" xml:lang="zh-Hans">选择那条路 只为遇见你</span></p><p begin="02:29.945" end="02:34.836" ttm:agent="v1" itunes:key="L44"><span begin="02:29.945" end="02:30.818">그리로</span> <span begin="02:30.818" end="02:31.456">가면</span> <span begin="02:31.456" end="02:32.073">돼</span> <span begin="02:32.234" end="02:33.212">점선을</span> <span begin="02:33.212" end="02:33.537">따</span><span begin="02:33.537" end="02:34.836">라</span><span ttm:role="x-translation" xml:lang="zh-Hans">只需一直沿着虚线走下去</span></p><p begin="02:35.540" end="02:39.842" ttm:agent="v1" itunes:key="L45"><span begin="02:35.540" end="02:36.097">잊지</span> <span begin="02:36.097" end="02:36.600">마</span> <span begin="02:36.867" end="02:37.226">이</span> <span begin="02:37.470" end="02:38.099">오랜</span> <span begin="02:38.255" end="02:38.847">겨</span><span begin="02:38.847" end="02:39.126">울</span> <span begin="02:39.126" end="02:39.842">사이</span><span ttm:role="x-translation" xml:lang="zh-Hans">请铭记 你是漫长寒冬里</span></p><p begin="02:40.334" end="02:44.630" ttm:agent="v1" itunes:key="L46"><span begin="02:40.334" end="02:40.652">언</span> <span begin="02:40.652" end="02:40.991">틈</span><span begin="02:40.991" end="02:41.526">으</span><span begin="02:41.576" end="02:42.053">로</span> <span begin="02:42.251" end="02:42.939">피울</span> <span begin="02:43.056" end="02:43.602">꽃</span> <span begin="02:43.602" end="02:44.067">하</span><span begin="02:44.067" end="02:44.630">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">绽放于傲雪凌霜中的花朵</span></p><p begin="02:45.135" end="02:49.425" ttm:agent="v1" itunes:key="L47"><span begin="02:45.135" end="02:45.993">보이니</span> <span begin="02:45.993" end="02:46.653">하루</span> <span begin="02:46.653" end="02:47.033">뒤</span> <span begin="02:47.033" end="02:47.792">봄이</span> <span begin="02:47.869" end="02:48.463">얼</span><span begin="02:48.463" end="02:48.862">마</span><span begin="02:48.862" end="02:49.425">나</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看到了吗 将至的暖春</span></p><p begin="02:49.908" end="02:52.077" ttm:agent="v1" itunes:key="L48"><span begin="02:49.908" end="02:50.519">아름다울</span><span begin="02:50.519" end="02:51.159">지</span> <span begin="02:51.199" end="02:51.521">말</span><span begin="02:51.521" end="02:52.077">야</span><span ttm:role="x-translation" xml:lang="zh-Hans">将会是多么的美丽</span></p><p begin="02:52.085" end="02:54.255" ttm:agent="v1" itunes:key="L49"><span begin="02:52.085" end="02:52.433">You're</span> <span begin="02:52.433" end="02:52.620">my</span> <span begin="02:52.620" end="02:53.342">Cele</span><span begin="02:53.342" end="02:53.682">bri</span><span begin="02:53.682" end="02:54.255">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是独属于我的名人</span></p><p begin="03:02.155" end="03:03.778" ttm:agent="v1" itunes:key="L50"><span begin="03:02.155" end="03:02.977">Cele</span><span begin="03:02.977" end="03:03.218">bri</span><span begin="03:03.218" end="03:03.778">ty</span></p><p begin="03:11.280" end="03:13.450" ttm:agent="v1" itunes:key="L51"><span begin="03:11.280" end="03:11.628">You're</span> <span begin="03:11.628" end="03:11.792">my</span> <span begin="03:11.792" end="03:12.537">Cele</span><span begin="03:12.537" end="03:12.877">bri</span><span begin="03:12.877" end="03:13.450">ty</span><span ttm:role="x-translation" xml:lang="zh-Hans">你是专属我的 闪闪发光的所在</span></p></div></body></tt>