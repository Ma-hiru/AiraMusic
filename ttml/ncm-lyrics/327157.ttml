<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="327157"/><amll:meta key="appleMusicId" value="535770131"/><amll:meta key="musicName" value="欧若拉"/><amll:meta key="artists" value="张韶涵"/><amll:meta key="album" value="欧若拉"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:19.160"><div begin="00:36.415" end="04:00.860"><p begin="00:36.415" end="00:39.185" ttm:agent="v1" itunes:key="L1"><span begin="00:36.415" end="00:37.423">神祕北極圈</span> <span begin="00:37.524" end="00:38.251">阿拉斯加</span><span begin="00:38.251" end="00:38.492">的</span><span begin="00:38.492" end="00:39.185">山巔</span><span ttm:role="x-translation" xml:lang="zh-Hans">神秘北极圈 阿拉斯加的山巅</span></p><p begin="00:39.209" end="00:42.121" ttm:agent="v1" itunes:key="L2"><span begin="00:39.209" end="00:40.089">誰的臉</span><span begin="00:40.241" end="00:40.665">出現</span><span begin="00:40.665" end="00:41.393">海角的</span><span begin="00:41.393" end="00:42.121">天邊</span><span ttm:role="x-translation" xml:lang="zh-Hans">谁的脸出现海角的天边</span></p><p begin="00:42.131" end="00:44.796" ttm:agent="v1" itunes:key="L3"><span begin="00:42.131" end="00:42.569">忽然的</span><span begin="00:42.569" end="00:43.012">瞬間</span> <span begin="00:43.161" end="00:43.572">在那</span><span begin="00:43.572" end="00:44.120">遙遠的</span><span begin="00:44.120" end="00:44.796">地點</span><span ttm:role="x-translation" xml:lang="zh-Hans">忽然的瞬间 在那遥远的地点</span></p><p begin="00:44.914" end="00:47.740" ttm:agent="v1" itunes:key="L4"><span begin="00:44.914" end="00:45.176">我</span><span begin="00:45.176" end="00:45.858">看見</span><span begin="00:45.961" end="00:46.470">戀人</span><span begin="00:46.470" end="00:46.790">幸福</span><span begin="00:46.790" end="00:47.157">的光</span><span begin="00:47.157" end="00:47.740">點</span><span ttm:role="x-translation" xml:lang="zh-Hans">我看见恋人幸福的光点</span></p><p begin="00:47.751" end="00:50.495" ttm:agent="v1" itunes:key="L5"><span begin="00:47.751" end="00:48.240">靈</span><span begin="00:48.358" end="00:48.845">魂</span><span begin="00:49.076" end="00:49.581">在</span><span begin="00:49.581" end="00:50.495">召喚</span><span ttm:role="x-translation" xml:lang="zh-Hans">灵魂在召唤</span></p><p begin="00:50.597" end="00:53.425" ttm:agent="v1" itunes:key="L6"><span begin="00:50.597" end="00:51.360">唱著古老</span><span begin="00:51.555" end="00:52.011">陌生</span><span begin="00:52.011" end="00:52.659">熟悉的</span><span begin="00:52.659" end="00:53.425">歌謠</span><span ttm:role="x-translation" xml:lang="zh-Hans">唱着古老陌生熟悉的歌谣</span></p><p begin="00:53.434" end="00:56.114" ttm:agent="v1" itunes:key="L7"><span begin="00:53.434" end="00:54.009">天</span><span begin="00:54.150" end="00:54.694">空</span><span begin="00:54.873" end="00:55.200">在</span><span begin="00:55.200" end="00:56.114">微笑</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空在微笑</span></p><p begin="00:56.252" end="00:59.114" ttm:agent="v1" itunes:key="L8"><span begin="00:56.252" end="00:57.138">我的世界</span><span begin="00:57.138" end="00:57.997">繽紛</span><span begin="00:57.997" end="00:59.114">閃耀</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的世界缤纷闪耀</span></p><p begin="00:59.115" end="01:01.919" ttm:agent="v1" itunes:key="L9"><span begin="00:59.115" end="00:59.559">愛是</span><span begin="00:59.559" end="01:00.278">一道光</span> <span begin="01:00.465" end="01:00.847">如此</span><span begin="01:00.847" end="01:01.216">美</span><span begin="01:01.216" end="01:01.919">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="01:01.920" end="01:04.764" ttm:agent="v1" itunes:key="L10"><span begin="01:01.920" end="01:02.393">指引</span><span begin="01:02.393" end="01:03.065">我們</span><span begin="01:03.354" end="01:04.033">想要的</span><span begin="01:04.033" end="01:04.764">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">指引我们想要的未来</span></p><p begin="01:04.773" end="01:07.530" ttm:agent="v1" itunes:key="L11"><span begin="01:04.773" end="01:05.131">魔力</span><span begin="01:05.131" end="01:05.878">北極光</span> <span begin="01:06.059" end="01:06.748">奇幻的</span><span begin="01:06.748" end="01:06.975">預</span><span begin="01:06.975" end="01:07.530">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 奇幻的预言</span></p><p begin="01:07.540" end="01:10.432" ttm:agent="v1" itunes:key="L12"><span begin="01:07.540" end="01:08.091">趕快</span><span begin="01:08.091" end="01:08.731">去找</span><span begin="01:08.773" end="01:09.555">不思議</span><span begin="01:09.555" end="01:10.432">的愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">赶快去找不思议的爱</span></p><p begin="01:10.442" end="01:13.197" ttm:agent="v1" itunes:key="L13"><span begin="01:10.442" end="01:10.886">愛是</span><span begin="01:10.886" end="01:11.542">一道光</span> <span begin="01:11.810" end="01:12.198">如此</span><span begin="01:12.198" end="01:12.475">美</span><span begin="01:12.475" end="01:13.197">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="01:13.206" end="01:16.082" ttm:agent="v1" itunes:key="L14"><span begin="01:13.206" end="01:13.756">照亮</span><span begin="01:13.756" end="01:14.420">我們</span><span begin="01:14.628" end="01:15.373">勇氣的</span><span begin="01:15.373" end="01:16.082">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">照亮我们勇气的未来</span></p><p begin="01:16.093" end="01:18.788" ttm:agent="v1" itunes:key="L15"><span begin="01:16.093" end="01:16.473">魔力</span><span begin="01:16.473" end="01:17.168">北極光</span> <span begin="01:17.333" end="01:17.821">傳說的</span><span begin="01:17.821" end="01:18.101">預</span><span begin="01:18.101" end="01:18.788">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 传说的预言</span></p><p begin="01:18.828" end="01:23.772" ttm:agent="v1" itunes:key="L16"><span begin="01:18.828" end="01:19.494">原來</span><span begin="01:19.494" end="01:20.391">就是</span><span begin="01:20.391" end="01:21.000">戀人</span><span begin="01:21.000" end="01:21.399">的</span><span begin="01:21.399" end="01:21.812">眼</span><span begin="01:21.812" end="01:23.772">光</span><span ttm:role="x-translation" xml:lang="zh-Hans">原来就是恋人的眼光</span></p><p begin="01:44.307" end="01:47.107" ttm:agent="v1" itunes:key="L17"><span begin="01:44.307" end="01:45.289">沉默一眨眼</span> <span begin="01:45.419" end="01:46.040">一萬年外</span><span begin="01:46.040" end="01:46.314">的</span><span begin="01:46.314" end="01:47.107">光年</span><span ttm:role="x-translation" xml:lang="zh-Hans">沉默一眨眼 一万年外的光年</span></p><p begin="01:47.140" end="01:49.940" ttm:agent="v1" itunes:key="L18"><span begin="01:47.140" end="01:48.062">我相信</span><span begin="01:48.203" end="01:48.600">未來</span><span begin="01:48.600" end="01:49.158">其實並</span><span begin="01:49.158" end="01:49.940">不遠</span><span ttm:role="x-translation" xml:lang="zh-Hans">我相信未来其实并不远</span></p><p begin="01:49.950" end="01:52.760" ttm:agent="v1" itunes:key="L19"><span begin="01:49.950" end="01:50.512">哭泣的</span><span begin="01:50.512" end="01:51.074">眼淚</span> <span begin="01:51.209" end="01:51.542">是</span><span begin="01:51.542" end="01:51.921">喜悅的</span><span begin="01:51.921" end="01:52.760">讚美</span><span ttm:role="x-translation" xml:lang="zh-Hans">哭泣的眼泪 是喜悦的赞美</span></p><p begin="01:52.773" end="01:55.573" ttm:agent="v1" itunes:key="L20"><span begin="01:52.773" end="01:53.189">是</span><span begin="01:53.189" end="01:53.663">因為</span><span begin="01:53.878" end="01:54.390">有你能</span><span begin="01:54.390" end="01:54.753">展翅</span><span begin="01:54.753" end="01:55.573">高飛</span><span ttm:role="x-translation" xml:lang="zh-Hans">是因为有你能展翅高飞</span></p><p begin="01:55.584" end="01:58.316" ttm:agent="v1" itunes:key="L21"><span begin="01:55.584" end="01:56.126">靈</span><span begin="01:56.279" end="01:56.880">魂</span><span begin="01:57.042" end="01:57.401">在</span><span begin="01:57.401" end="01:58.316">召喚</span><span ttm:role="x-translation" xml:lang="zh-Hans">灵魂在召唤</span></p><p begin="01:58.387" end="02:01.215" ttm:agent="v1" itunes:key="L22"><span begin="01:58.387" end="01:59.062">唱著古老</span><span begin="01:59.448" end="01:59.932">陌生</span><span begin="01:59.932" end="02:00.508">熟悉的</span><span begin="02:00.508" end="02:01.215">歌謠</span><span ttm:role="x-translation" xml:lang="zh-Hans">唱着古老陌生熟悉的歌谣</span></p><p begin="02:01.226" end="02:03.674" ttm:agent="v1" itunes:key="L23"><span begin="02:01.226" end="02:01.751">天</span><span begin="02:01.900" end="02:02.424">空</span><span begin="02:02.576" end="02:02.868">在</span><span begin="02:02.868" end="02:03.674">微笑</span><span ttm:role="x-translation" xml:lang="zh-Hans">天空在微笑</span></p><p begin="02:03.684" end="02:06.841" ttm:agent="v1" itunes:key="L24"><span begin="02:03.684" end="02:04.456">我的世界</span><span begin="02:04.456" end="02:05.147">繽紛</span><span begin="02:05.147" end="02:05.569">閃</span><span begin="02:05.569" end="02:06.841">耀</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的世界缤纷闪耀</span></p><p begin="02:06.912" end="02:09.733" ttm:agent="v1" itunes:key="L25"><span begin="02:06.912" end="02:07.336">愛是</span><span begin="02:07.336" end="02:08.009">一道光</span> <span begin="02:08.288" end="02:08.719">如此</span><span begin="02:08.719" end="02:09.049">美</span><span begin="02:09.049" end="02:09.733">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="02:09.745" end="02:12.565" ttm:agent="v1" itunes:key="L26"><span begin="02:09.745" end="02:10.359">指引</span><span begin="02:10.359" end="02:10.989">我們</span><span begin="02:11.152" end="02:11.702">想要的</span><span begin="02:11.702" end="02:12.565">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">指引我们想要的未来</span></p><p begin="02:12.575" end="02:15.335" ttm:agent="v1" itunes:key="L27"><span begin="02:12.575" end="02:12.934">魔力</span><span begin="02:12.934" end="02:13.584">北極光</span> <span begin="02:13.965" end="02:14.364">奇幻的</span><span begin="02:14.364" end="02:14.638">預</span><span begin="02:14.638" end="02:15.335">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 奇幻的预言</span></p><p begin="02:15.377" end="02:18.237" ttm:agent="v1" itunes:key="L28"><span begin="02:15.377" end="02:15.971">趕快</span><span begin="02:15.971" end="02:16.564">去找</span><span begin="02:16.607" end="02:17.467">不思議</span><span begin="02:17.467" end="02:18.237">的愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">赶快去找不思议的爱</span></p><p begin="02:18.246" end="02:21.051" ttm:agent="v1" itunes:key="L29"><span begin="02:18.246" end="02:18.593">愛是</span><span begin="02:18.593" end="02:19.238">一道光</span> <span begin="02:19.527" end="02:19.929">如此</span><span begin="02:19.929" end="02:20.228">美</span><span begin="02:20.228" end="02:21.051">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="02:21.059" end="02:23.903" ttm:agent="v1" itunes:key="L30"><span begin="02:21.059" end="02:21.633">照亮</span><span begin="02:21.633" end="02:22.224">我們</span><span begin="02:22.386" end="02:23.152">勇氣的</span><span begin="02:23.152" end="02:23.903">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">照亮我们勇气的未来</span></p><p begin="02:23.912" end="02:26.677" ttm:agent="v1" itunes:key="L31"><span begin="02:23.912" end="02:24.249">魔力</span><span begin="02:24.249" end="02:24.916">北極光</span> <span begin="02:25.249" end="02:25.854">傳說的</span><span begin="02:25.854" end="02:26.105">預</span><span begin="02:26.105" end="02:26.677">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 传说的预言</span></p><p begin="02:26.695" end="02:30.961" ttm:agent="v1" itunes:key="L32"><span begin="02:26.695" end="02:27.261">原來</span><span begin="02:27.261" end="02:28.117">就是</span><span begin="02:28.216" end="02:28.828">戀人</span><span begin="02:28.828" end="02:29.230">的</span><span begin="02:29.230" end="02:29.591">眼</span><span begin="02:29.591" end="02:30.961">光</span><span ttm:role="x-translation" xml:lang="zh-Hans">原来就是恋人的眼光</span></p><p begin="02:29.527" end="02:35.191" ttm:agent="v1" itunes:key="L33"><span begin="02:29.527" end="02:30.786">紅橙</span><span begin="02:30.786" end="02:32.035">黃綠藍</span> <span begin="02:32.400" end="02:33.512">五彩的</span><span begin="02:33.512" end="02:35.191">歐若拉</span><span ttm:role="x-translation" xml:lang="zh-Hans">红橙黄绿蓝 五彩的欧若拉</span></p><p begin="02:35.197" end="02:40.810" ttm:agent="v1" itunes:key="L34"><span begin="02:35.197" end="02:36.860">愛就在</span><span begin="02:36.860" end="02:37.569">心中</span> <span begin="02:37.923" end="02:38.898">相信就會</span><span begin="02:38.898" end="02:39.337">存</span><span begin="02:39.337" end="02:40.810">在</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱就在心中 相信就会存在</span></p><p begin="02:40.826" end="02:46.486" ttm:agent="v1" itunes:key="L35"><span begin="02:40.826" end="02:41.937">紅橙</span><span begin="02:42.366" end="02:43.310">黃綠藍</span> <span begin="02:43.582" end="02:44.655">美麗的</span><span begin="02:44.655" end="02:46.486">歐若拉</span><span ttm:role="x-translation" xml:lang="zh-Hans">红橙黄绿蓝 美丽的欧若拉</span></p><p begin="02:46.487" end="02:53.012" ttm:agent="v1" itunes:key="L36"><span begin="02:46.487" end="02:48.080">愛就在</span><span begin="02:48.080" end="02:48.787">心中</span> <span begin="02:49.204" end="02:50.229">相信就是</span><span begin="02:50.229" end="02:50.706">永</span><span begin="02:50.706" end="02:53.012">遠</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱就在心中 相信就是永远</span></p><p begin="03:14.679" end="03:17.569" ttm:agent="v1" itunes:key="L37"><span begin="03:14.679" end="03:15.197">愛是</span><span begin="03:15.197" end="03:15.694">一道光</span> <span begin="03:16.185" end="03:16.591">如此</span><span begin="03:16.591" end="03:16.855">美</span><span begin="03:16.855" end="03:17.569">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="03:17.589" end="03:20.401" ttm:agent="v1" itunes:key="L38"><span begin="03:17.589" end="03:18.160">指引</span><span begin="03:18.160" end="03:18.680">我們</span><span begin="03:19.010" end="03:19.683">想要的</span><span begin="03:19.683" end="03:20.401">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">指引我们想要的未来</span></p><p begin="03:20.409" end="03:23.139" ttm:agent="v1" itunes:key="L39"><span begin="03:20.409" end="03:20.737">魔力</span><span begin="03:20.737" end="03:21.456">北極光</span> <span begin="03:21.783" end="03:22.227">奇幻的</span><span begin="03:22.227" end="03:22.514">預</span><span begin="03:22.514" end="03:23.139">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 奇幻的预言</span></p><p begin="03:23.185" end="03:26.105" ttm:agent="v1" itunes:key="L40"><span begin="03:23.185" end="03:23.801">趕快</span><span begin="03:23.801" end="03:24.439">去找</span><span begin="03:24.465" end="03:25.239">不思議</span><span begin="03:25.239" end="03:26.105">的愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">赶快去找不思议的爱</span></p><p begin="03:26.116" end="03:28.866" ttm:agent="v1" itunes:key="L41"><span begin="03:26.116" end="03:26.469">愛是</span><span begin="03:26.469" end="03:27.064">一道光</span> <span begin="03:27.496" end="03:27.864">如此</span><span begin="03:27.864" end="03:28.106">美</span><span begin="03:28.106" end="03:28.866">妙</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱是一道光 如此美妙</span></p><p begin="03:28.879" end="03:31.723" ttm:agent="v1" itunes:key="L42"><span begin="03:28.879" end="03:29.428">照亮</span><span begin="03:29.428" end="03:29.981">我們</span><span begin="03:30.314" end="03:31.022">勇氣的</span><span begin="03:31.022" end="03:31.723">未來</span><span ttm:role="x-translation" xml:lang="zh-Hans">照亮我们勇气的未来</span></p><p begin="03:31.732" end="03:34.492" ttm:agent="v1" itunes:key="L43"><span begin="03:31.732" end="03:32.103">魔力</span><span begin="03:32.103" end="03:32.700">北極光</span> <span begin="03:33.090" end="03:33.543">傳說的</span><span begin="03:33.543" end="03:33.785">預</span><span begin="03:33.785" end="03:34.492">言</span><span ttm:role="x-translation" xml:lang="zh-Hans">魔力北极光 传说的预言</span></p><p begin="03:34.518" end="03:38.604" ttm:agent="v1" itunes:key="L44"><span begin="03:34.518" end="03:35.102">原來</span><span begin="03:35.102" end="03:35.712">就是</span><span begin="03:36.070" end="03:36.783">戀人</span><span begin="03:36.783" end="03:37.066">的</span><span begin="03:37.066" end="03:37.373">眼</span><span begin="03:37.373" end="03:38.604">光</span><span ttm:role="x-translation" xml:lang="zh-Hans">原来就是恋人的眼光</span></p><p begin="03:37.420" end="03:42.996" ttm:agent="v1" itunes:key="L45"><span begin="03:37.420" end="03:38.483">紅橙</span><span begin="03:38.483" end="03:39.587">黃綠藍</span> <span begin="03:40.149" end="03:41.293">五彩的</span><span begin="03:41.293" end="03:42.996">歐若拉</span><span ttm:role="x-translation" xml:lang="zh-Hans">红橙黄绿蓝 五彩的欧若拉</span></p><p begin="03:43.014" end="03:48.634" ttm:agent="v1" itunes:key="L46"><span begin="03:43.014" end="03:44.856">愛就在</span><span begin="03:44.856" end="03:45.570">心中</span> <span begin="03:45.767" end="03:46.863">相信就會</span><span begin="03:46.863" end="03:47.189">存</span><span begin="03:47.189" end="03:48.634">在</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱就在心中 相信就会存在</span></p><p begin="03:48.656" end="03:54.340" ttm:agent="v1" itunes:key="L47"><span begin="03:48.656" end="03:49.929">紅橙</span><span begin="03:49.929" end="03:51.164">黃綠藍</span> <span begin="03:51.383" end="03:52.594">美麗的</span><span begin="03:52.594" end="03:54.340">歐若拉</span><span ttm:role="x-translation" xml:lang="zh-Hans">红橙黄绿蓝 美丽的欧若拉</span></p><p begin="03:54.355" end="04:00.860" ttm:agent="v1" itunes:key="L48"><span begin="03:54.355" end="03:56.075">愛就在</span><span begin="03:56.075" end="03:56.825">心中</span> <span begin="03:57.019" end="03:58.045">相信就是</span><span begin="03:58.045" end="03:58.694">永</span><span begin="03:58.694" end="04:00.860">遠</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱就在心中 相信就是永远</span></p></div></body></tt>