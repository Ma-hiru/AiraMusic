:49.309"></span><span begin="02:49.309" end="02:49.884"></span></text><text for="L30"><span begin="02:49.986" end="02:50.679">bokuwo</span><span begin="02:50.679" end="02:51.447">terashite</span><span begin="02:51.447" end="02:52.021">kure</span><span begin="02:52.021" end="02:52.941">ru</span><span begin="02:53.202" end="02:53.764">kimino</span><span begin="02:53.764" end="02:54.423">koto</span><span begin="02:54.423" end="02:54.984"></span><span begin="02:54.984" end="02:55.437"></span><span begin="02:55.437" end="02:55.906"></span><span begin="02:55.906" end="02:56.082"></span><span begin="02:56.082" end="02:56.313"></span><span begin="02:56.313" end="02:56.639"></span></text><text for="L31"><span begin="02:56.709" end="02:57.157">anonyu</span><span begin="02:57.157" end="02:58.162">udougumo</span><span begin="02:58.162" end="02:58.555">saetsu</span><span begin="02:58.555" end="02:58.672"></span><span begin="02:58.672" end="02:59.085">kiya</span><span begin="02:59.085" end="02:59.635">bu't</span><span begin="02:59.635" end="03:00.111">te</span><span begin="03:00.346" end="03:01.165"></span><span begin="03:01.165" end="03:01.790"></span><span begin="03:01.790" end="03:02.470"></span><span begin="03:02.470" end="03:03.307"></span></text><text for="L32"><span begin="03:03.408" end="03:03.822">mabushi</span><span begin="03:03.822" end="03:04.134">ku</span><span begin="03:04.134" end="03:04.248"></span><span begin="03:04.248" end="03:04.527">te</span><span begin="03:04.704" end="03:05.141">demoa</span><span begin="03:05.141" end="03:06.176">tataka</span><span begin="03:06.176" end="03:06.628">na</span></text><text for="L33"><span begin="03:06.909" end="03:07.738">kimino</span><span begin="03:07.738" end="03:08.264">mana</span><span begin="03:08.264" end="03:08.854">zashi</span><span begin="03:08.854" end="03:09.248">wa</span><span begin="03:09.469" end="03:10.248">hikari</span><span begin="03:10.248" end="03:11.698">da</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="03:27.470"><div begin="00:00.623" end="03:11.698"><p begin="00:00.623" end="00:05.637" ttm:agent="v1" itunes:key="L1"><span begin="00:00.623" end="00:01.042">雨</span><span begin="00:01.042" end="00:01.591">降り、</span><span begin="00:01.700" end="00:02.581">小さ</span><span begin="00:02.581" end="00:02.820">な</span><span begin="00:02.820" end="00:04.004">傘に</span><span begin="00:04.004" end="00:04.455">身を</span><span begin="00:04.455" end="00:05.049">隠す</span><span begin="00:05.049" end="00:05.418">僕</span><span begin="00:05.418" end="00:05.637">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨滴飘洒 将自己藏身于小小伞下</span></p><p begin="00:05.637" end="00:09.221" ttm:agent="v1" itunes:key="L2"><span begin="00:05.637" end="00:06.088">薄</span><span begin="00:06.088" end="00:06.539">明</span><span begin="00:06.539" end="00:06.952">か</span><span begin="00:06.952" end="00:07.208">り</span><span begin="00:07.208" end="00:07.557">が</span><span begin="00:07.557" end="00:07.757">ひ</span><span begin="00:07.757" end="00:08.187">と</span><span begin="00:08.187" end="00:08.389">す</span><span begin="00:08.389" end="00:09.221">じ</span><span ttm:role="x-translation" xml:lang="zh-Hans">得见一缕微光倾泻而下</span></p><p begin="00:19.973" end="00:26.020" ttm:agent="v1" itunes:key="L3"><span begin="00:19.973" end="00:20.530">また</span><span begin="00:20.530" end="00:21.101">ひとつ</span><span begin="00:21.101" end="00:21.954">諦め</span><span begin="00:21.954" end="00:22.584">る、</span><span begin="00:23.314" end="00:24.242">身体</span><span begin="00:24.242" end="00:24.413">は</span><span begin="00:24.413" end="00:25.042">軽く</span><span begin="00:25.042" end="00:25.327">な</span><span begin="00:25.327" end="00:26.020">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">再次卸下一份执念</span></p><p begin="00:26.615" end="00:32.948" ttm:agent="v1" itunes:key="L4"><span begin="00:26.615" end="00:27.754">足元</span><span begin="00:27.754" end="00:28.020">に</span><span begin="00:28.020" end="00:28.620">引いた</span><span begin="00:28.620" end="00:29.229">線</span><span begin="00:29.229" end="00:29.329">の</span><span begin="00:29.329" end="00:29.429">向</span><span begin="00:29.429" end="00:29.842">こ</span><span begin="00:29.842" end="00:30.042">う</span><span begin="00:30.042" end="00:30.284">か</span><span begin="00:30.284" end="00:31.034">ら</span><span begin="00:31.034" end="00:31.309">手</span><span begin="00:31.309" end="00:31.726">を</span><span begin="00:31.726" end="00:32.246">振る</span><span begin="00:32.246" end="00:32.948">人</span><span ttm:role="x-translation" xml:lang="zh-Hans">自脚下划出的那条线的彼端之处</span></p><p begin="00:33.326" end="00:36.849" ttm:agent="v1" itunes:key="L5"><span begin="00:33.326" end="00:34.089">きみが</span><span begin="00:34.089" end="00:34.644">笑う</span><span begin="00:34.644" end="00:35.249">だけで</span><span begin="00:35.249" end="00:35.860">どうして</span><span begin="00:35.860" end="00:36.413">こんな</span><span begin="00:36.413" end="00:36.513">に</span><span begin="00:36.513" end="00:36.849">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">只要你脸上漾开笑意</span></p><p begin="00:36.869" end="00:39.881" ttm:agent="v1" itunes:key="L6"><span begin="00:36.869" end="00:37.168">過去</span><span begin="00:37.168" end="00:37.443">の</span><span begin="00:37.443" end="00:38.016">自分が</span><span begin="00:38.016" end="00:39.158">ほどかれるの</span><span begin="00:39.158" end="00:39.881">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">让过去的自己彻底得到释然呢</span></p><p begin="00:40.009" end="00:43.475" ttm:agent="v1" itunes:key="L7"><span begin="00:40.009" end="00:40.489">この</span><span begin="00:40.489" end="00:41.340">感情</span><span begin="00:41.340" end="00:41.729">には</span><span begin="00:41.729" end="00:41.926">名</span><span begin="00:41.926" end="00:42.374">前</span><span begin="00:42.374" end="00:42.528">が</span><span begin="00:42.528" end="00:42.984">ある</span><span begin="00:42.984" end="00:43.475">らしい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我所怀揣的感情似乎了拥有姓名</span></p><p begin="00:43.516" end="00:45.494" ttm:agent="v1" itunes:key="L8"><span begin="00:43.516" end="00:44.434">心臓</span><span begin="00:44.434" end="00:44.640">が</span><span begin="00:44.640" end="00:45.027">うる</span><span begin="00:45.027" end="00:45.494">さい</span><span ttm:role="x-translation" xml:lang="zh-Hans">心跳声震耳欲聋</span></p><p begin="00:46.871" end="00:53.089" ttm:agent="v1" itunes:key="L9"><span begin="00:46.871" end="00:47.783">きみと</span><span begin="00:47.783" end="00:48.383">目</span><span begin="00:48.383" end="00:48.639">が</span><span begin="00:48.639" end="00:49.215">あう</span><span begin="00:49.215" end="00:49.711">たび、</span><span begin="00:50.052" end="00:50.831">指</span><span begin="00:50.831" end="00:51.074">が</span><span begin="00:51.074" end="00:51.684">触</span><span begin="00:51.684" end="00:51.916">れ</span><span begin="00:51.916" end="00:52.559">あう</span><span begin="00:52.559" end="00:53.089">たび</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次与你的视线交织</span></p><p begin="00:53.325" end="00:59.905" ttm:agent="v1" itunes:key="L10"><span begin="00:53.325" end="00:54.042">僕の</span><span begin="00:54.042" end="00:54.634">奥の</span><span begin="00:54.634" end="00:55.010">奥</span><span begin="00:55.010" end="00:55.306">ま</span><span begin="00:55.306" end="00:56.169">で</span><span begin="00:56.463" end="00:57.370">見つけて</span><span begin="00:57.370" end="00:58.205">もらえた</span><span begin="00:58.395" end="00:58.640">よう</span><span begin="00:58.640" end="00:59.056">な</span><span begin="00:59.056" end="00:59.371">気が</span><span begin="00:59.371" end="00:59.905">した</span><span ttm:role="x-translation" xml:lang="zh-Hans">都能够让我感受到</span></p><p begin="01:00.179" end="01:06.511" ttm:agent="v1" itunes:key="L11"><span begin="01:00.179" end="01:01.742">言葉を</span><span begin="01:01.742" end="01:01.915">交</span><span begin="01:01.915" end="01:02.406">わ</span><span begin="01:02.406" end="01:02.552">す</span><span begin="01:02.552" end="01:02.783">た</span><span begin="01:02.783" end="01:03.082">び、</span><span begin="01:03.426" end="01:04.065">同</span><span begin="01:04.065" end="01:04.216">じ</span><span begin="01:04.216" end="01:05.080">景色</span><span begin="01:05.080" end="01:05.243">を</span><span begin="01:05.243" end="01:05.936">見る</span><span begin="01:05.936" end="01:06.511">たび</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次与你的言语交谈</span></p><p begin="01:06.683" end="01:13.336" ttm:agent="v1" itunes:key="L12"><span begin="01:06.683" end="01:07.376">僕を</span><span begin="01:07.376" end="01:08.144">照らして</span><span begin="01:08.144" end="01:08.718">くれ</span><span begin="01:08.718" end="01:09.638">る</span><span begin="01:09.899" end="01:10.461">きみの</span><span begin="01:10.461" end="01:11.120">こと、</span><span begin="01:11.120" end="01:11.681">もっと</span><span begin="01:11.681" end="01:12.134">知り</span><span begin="01:12.134" end="01:12.603">た</span><span begin="01:12.603" end="01:12.779">く</span><span begin="01:12.779" end="01:13.010">なる</span><span begin="01:13.010" end="01:13.336">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我都想更进一步了解将我的一切</span></p><p begin="01:13.336" end="01:19.934" ttm:agent="v1" itunes:key="L13"><span begin="01:13.336" end="01:13.784">あの</span><span begin="01:13.784" end="01:14.789">入道雲</span><span begin="01:14.789" end="01:15.182">さえ</span><span begin="01:15.182" end="01:15.299">突</span><span begin="01:15.299" end="01:15.712">き</span><span begin="01:15.712" end="01:16.262">破っ</span><span begin="01:16.262" end="01:16.738">て</span><span begin="01:16.973" end="01:17.792">真っ直ぐ</span><span begin="01:17.792" end="01:18.417">泳ぎ</span><span begin="01:18.417" end="01:19.097">渡って</span><span begin="01:19.097" end="01:19.934">きた</span><span ttm:role="x-translation" xml:lang="zh-Hans">就连那片积雨云都能穿透</span></p><p begin="01:20.016" end="01:23.236" ttm:agent="v1" itunes:key="L14"><span begin="01:20.016" end="01:20.430">眩</span><span begin="01:20.430" end="01:20.742">し</span><span begin="01:20.742" end="01:20.856">く</span><span begin="01:20.856" end="01:21.135">て、</span><span begin="01:21.312" end="01:21.749">でも</span><span begin="01:21.749" end="01:22.784">あたたか</span><span begin="01:22.784" end="01:23.236">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">你那璀璨且温暖的目光</span></p><p begin="01:23.569" end="01:28.658" ttm:agent="v1" itunes:key="L15"><span begin="01:23.569" end="01:24.398">きみの</span><span begin="01:24.398" end="01:24.924">まな</span><span begin="01:24.924" end="01:25.514">ざし</span><span begin="01:25.514" end="01:25.908">は</span><span begin="01:26.129" end="01:26.908">光</span><span begin="01:26.908" end="01:28.658">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">便是于我而言的天光</span></p><p begin="01:37.283" end="01:42.599" ttm:agent="v1" itunes:key="L16"><span begin="01:37.283" end="01:38.195">傷つく</span><span begin="01:38.195" end="01:38.563">こと</span><span begin="01:38.563" end="01:39.296">も、</span><span begin="01:40.011" end="01:40.693">傷つ</span><span begin="01:40.693" end="01:40.883">け</span><span begin="01:40.883" end="01:41.560">られる</span><span begin="01:41.560" end="01:41.974">こと</span><span begin="01:41.974" end="01:42.599">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">不论是历经伤害还是伤害他人的时候</span></p><p begin="01:43.348" end="01:50.281" ttm:agent="v1" itunes:key="L17"><span begin="01:43.348" end="01:44.393">足元</span><span begin="01:44.393" end="01:44.671">に</span><span begin="01:44.671" end="01:45.273">引いた</span><span begin="01:45.273" end="01:46.038">線の</span><span begin="01:46.038" end="01:47.710">中で</span><span begin="01:47.710" end="01:48.371">逃げ</span><span begin="01:48.371" end="01:48.503">て</span><span begin="01:48.503" end="01:48.603">き</span><span begin="01:48.603" end="01:49.447">た</span><span begin="01:49.447" end="01:49.629">け</span><span begin="01:49.629" end="01:50.281">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">都会选择躲入脚下划出的</span></p><p begin="01:50.695" end="01:57.210" ttm:agent="v1" itunes:key="L18"><span begin="01:50.695" end="01:51.092">雨</span><span begin="01:51.092" end="01:51.330">降</span><span begin="01:51.330" end="01:51.673">り、</span><span begin="01:51.673" end="01:52.758">小さな</span><span begin="01:52.758" end="01:54.041">傘に</span><span begin="01:54.041" end="01:54.390">身を</span><span begin="01:54.390" end="01:54.892">隠</span><span begin="01:54.892" end="01:55.249">して</span><span begin="01:55.249" end="01:55.447">そ</span><span begin="01:55.447" end="01:55.934">ぼ</span><span begin="01:55.934" end="01:56.708">濡れて</span><span begin="01:56.708" end="01:57.210">いた</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨滴飘洒 将自己藏身于小小伞下</span></p><p begin="01:57.343" end="02:02.444" ttm:agent="v1" itunes:key="L19"><span begin="01:57.343" end="01:57.980">僕を</span><span begin="01:57.980" end="01:58.586">そっと</span><span begin="01:58.586" end="01:59.460">暖</span><span begin="01:59.460" end="01:59.768">め</span><span begin="01:59.768" end="01:59.869">る</span><span begin="01:59.869" end="02:00.010">よう</span><span begin="02:00.010" end="02:00.255">な</span><span begin="02:00.255" end="02:01.127">光</span><span begin="02:01.127" end="02:01.448">が</span><span begin="02:01.448" end="02:01.664">さ</span><span begin="02:01.664" end="02:02.444">す</span><span ttm:role="x-translation" xml:lang="zh-Hans">足以将我悄然温暖的光芒终将倾洒而下</span></p><p begin="02:03.962" end="02:07.119" ttm:agent="v1" itunes:key="L20"><span begin="02:03.962" end="02:04.412">目を</span><span begin="02:04.412" end="02:04.876">細</span><span begin="02:04.876" end="02:05.205">めて</span><span begin="02:05.205" end="02:06.549">見上げた</span><span begin="02:06.549" end="02:07.119">先</span><span ttm:role="x-translation" xml:lang="zh-Hans">眯起眼睛后抬头仰望上方</span></p><p begin="02:07.304" end="02:12.668" ttm:agent="v1" itunes:key="L21"><span begin="02:07.304" end="02:07.915">どんな</span><span begin="02:07.915" end="02:09.224">言葉でも</span><span begin="02:09.224" end="02:09.888">足ら</span><span begin="02:09.888" end="02:10.349">ない</span><span begin="02:10.349" end="02:11.085">ほどに</span><span begin="02:11.085" end="02:12.668">愛しい</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕用尽世间的千言万语仍难以诉尽般</span></p><p begin="02:12.759" end="02:15.092" ttm:agent="v1" itunes:key="L22"><span begin="02:12.759" end="02:12.932">子</span><span begin="02:12.932" end="02:13.575">供</span><span begin="02:13.575" end="02:14.259">みた</span><span begin="02:14.259" end="02:14.448">い</span><span begin="02:14.448" end="02:14.548">な</span><span begin="02:14.548" end="02:14.675">笑</span><span begin="02:14.675" end="02:15.092">み</span><span ttm:role="x-translation" xml:lang="zh-Hans">你笑得简直像个孩童</span></p><p begin="02:16.923" end="02:19.846" ttm:agent="v1" itunes:key="L23"><span begin="02:16.923" end="02:17.078">ど</span><span begin="02:17.078" end="02:17.563">う</span><span begin="02:17.563" end="02:18.583">しようも</span><span begin="02:18.583" end="02:19.030">な</span><span begin="02:19.030" end="02:19.188">い</span><span begin="02:19.188" end="02:19.846">くらい</span><span ttm:role="x-translation" xml:lang="zh-Hans">甚至让我感到如此不可救药</span></p><p begin="02:20.014" end="02:23.136" ttm:agent="v1" itunes:key="L24"><span begin="02:20.014" end="02:20.217">自</span><span begin="02:20.217" end="02:20.910">分</span><span begin="02:20.910" end="02:21.080">で</span><span begin="02:21.080" end="02:21.712">も</span><span begin="02:21.712" end="02:22.417">怖</span><span begin="02:22.417" end="02:22.526">い</span><span begin="02:22.526" end="02:23.136">くらい</span><span ttm:role="x-translation" xml:lang="zh-Hans">连自己都觉得无比恐惧</span></p><p begin="02:23.156" end="02:26.008" ttm:agent="v1" itunes:key="L25"><span begin="02:23.156" end="02:23.564">もう</span><span begin="02:23.564" end="02:24.434">この目を</span><span begin="02:24.434" end="02:25.044">逸らせ</span><span begin="02:25.044" end="02:25.400">な</span><span begin="02:25.400" end="02:26.008">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不会再轻易地移开视线</span></p><p begin="02:26.467" end="02:30.083" ttm:agent="v1" itunes:key="L26"><span begin="02:26.467" end="02:27.166">きみの</span><span begin="02:27.166" end="02:27.971">まなざし</span><span begin="02:27.971" end="02:28.320">の</span><span begin="02:28.320" end="02:29.070">全</span><span begin="02:29.070" end="02:29.214">て</span><span begin="02:29.214" end="02:29.411">が</span><span begin="02:29.411" end="02:29.552">欲</span><span begin="02:29.552" end="02:30.083">しい</span><span ttm:role="x-translation" xml:lang="zh-Hans">希望自己将你的眸光统统都占据</span></p><p begin="02:30.280" end="02:36.498" ttm:agent="v1" itunes:key="L27"><span begin="02:30.280" end="02:31.192">きみと</span><span begin="02:31.192" end="02:31.792">目</span><span begin="02:31.792" end="02:32.048">が</span><span begin="02:32.048" end="02:32.624">あう</span><span begin="02:32.624" end="02:33.120">たび、</span><span begin="02:33.461" end="02:34.240">指</span><span begin="02:34.240" end="02:34.483">が</span><span begin="02:34.483" end="02:35.093">触</span><span begin="02:35.093" end="02:35.325">れ</span><span begin="02:35.325" end="02:35.968">あう</span><span begin="02:35.968" end="02:36.498">たび</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次与你的视线交织</span></p><p begin="02:36.653" end="02:43.233" ttm:agent="v1" itunes:key="L28"><span begin="02:36.653" end="02:37.370">僕の</span><span begin="02:37.370" end="02:37.962">奥の</span><span begin="02:37.962" end="02:38.338">奥</span><span begin="02:38.338" end="02:38.634">ま</span><span begin="02:38.634" end="02:39.497">で</span><span begin="02:39.791" end="02:40.698">見つけて</span><span begin="02:40.698" end="02:41.533">もらえた</span><span begin="02:41.723" end="02:41.968">よう</span><span begin="02:41.968" end="02:42.384">な</span><span begin="02:42.384" end="02:42.699">気が</span><span begin="02:42.699" end="02:43.233">した</span><span ttm:role="x-translation" xml:lang="zh-Hans">都能够让我感受到</span></p><p begin="02:43.552" end="02:49.884" ttm:agent="v1" itunes:key="L29"><span begin="02:43.552" end="02:45.115">言葉を</span><span begin="02:45.115" end="02:45.288">交</span><span begin="02:45.288" end="02:45.779">わ</span><span begin="02:45.779" end="02:45.925">す</span><span begin="02:45.925" end="02:46.156">た</span><span begin="02:46.156" end="02:46.455">び、</span><span begin="02:46.799" end="02:47.438">同</span><span begin="02:47.438" end="02:47.589">じ</span><span begin="02:47.589" end="02:48.453">景色</span><span begin="02:48.453" end="02:48.616">を</span><span begin="02:48.616" end="02:49.309">見る</span><span begin="02:49.309" end="02:49.884">たび</span><span ttm:role="x-translation" xml:lang="zh-Hans">每一次与你的言语交谈</span></p><p begin="02:49.986" end="02:56.639" ttm:agent="v1" itunes:key="L30"><span begin="02:49.986" end="02:50.679">僕を</span><span begin="02:50.679" end="02:51.447">照らして</span><span begin="02:51.447" end="02:52.021">くれ</span><span begin="02:52.021" end="02:52.941">る</span><span begin="02:53.202" end="02:53.764">きみの</span><span begin="02:53.764" end="02:54.423">こと、</span><span begin="02:54.423" end="02:54.984">もっと</span><span begin="02:54.984" end="02:55.437">知り</span><span begin="02:55.437" end="02:55.906">た</span><span begin="02:55.906" end="02:56.082">く</span><span begin="02:56.082" end="02:56.313">なる</span><span begin="02:56.313" end="02:56.639">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我都想更进一步了解将我的一切</span></p><p begin="02:56.709" end="03:03.307" ttm:agent="v1" itunes:key="L31"><span begin="02:56.709" end="02:57.157">あの</span><span begin="02:57.157" end="02:58.162">入道雲</span><span begin="02:58.162" end="02:58.555">さえ</span><span begin="02:58.555" end="02:58.672">突</span><span begin="02:58.672" end="02:59.085">き</span><span begin="02:59.085" end="02:59.635">破っ</span><span begin="02:59.635" end="03:00.111">て</span><span begin="03:00.346" end="03:01.165">真っ直ぐ</span><span begin="03:01.165" end="03:01.790">泳ぎ</span><span begin="03:01.790" end="03:02.470">渡って</span><span begin="03:02.470" end="03:03.307">きた</span><span ttm:role="x-translation" xml:l