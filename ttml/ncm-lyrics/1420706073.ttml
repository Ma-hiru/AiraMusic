<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="1420706073"/><amll:meta key="appleMusicId" value="1497822969"/><amll:meta key="musicName" value="离开我的依赖"/><amll:meta key="artists" value="王艳薇"/><amll:meta key="album" value="离开我的依赖"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:53.883"><div begin="00:09.292" end="03:46.614"><p begin="00:09.292" end="00:16.085" ttm:agent="v1" itunes:key="L1"><span begin="00:09.292" end="00:10.957">說</span><span begin="00:10.957" end="00:11.390">不</span><span begin="00:11.390" end="00:12.857">出</span><span begin="00:12.857" end="00:13.305">你</span><span begin="00:13.305" end="00:14.412">的</span><span begin="00:14.735" end="00:15.205">輪</span><span begin="00:15.205" end="00:16.085">廓</span><span ttm:role="x-translation" xml:lang="zh-Hans">说不出你的轮廓</span></p><p begin="00:16.606" end="00:22.887" ttm:agent="v1" itunes:key="L2"><span begin="00:16.606" end="00:17.122">看</span><span begin="00:17.122" end="00:18.654">著</span><span begin="00:18.654" end="00:19.116">你</span><span begin="00:19.116" end="00:20.147">的</span><span begin="00:20.527" end="00:21.408">模</span><span begin="00:21.408" end="00:22.887">樣</span><span ttm:role="x-translation" xml:lang="zh-Hans">看着你的模样</span></p><p begin="00:24.474" end="00:32.118" ttm:agent="v1" itunes:key="L3"><span begin="00:24.474" end="00:24.746">眼</span><span begin="00:24.746" end="00:25.737">前</span><span begin="00:25.737" end="00:26.480">的</span><span begin="00:26.480" end="00:28.147">美</span> <span begin="00:28.494" end="00:29.551">風</span><span begin="00:29.551" end="00:30.384">雨</span><span begin="00:30.384" end="00:30.913">沖</span><span begin="00:30.913" end="00:31.235">淡</span><span begin="00:31.235" end="00:31.656">了</span><span begin="00:31.656" end="00:32.118">它</span><span ttm:role="x-translation" xml:lang="zh-Hans">眼前的美 风雨冲淡了它</span></p><p begin="00:32.128" end="00:36.989" ttm:agent="v1" itunes:key="L4"><span begin="00:32.128" end="00:32.390">看</span><span begin="00:32.390" end="00:34.270">天色</span><span begin="00:34.270" end="00:34.858">漸</span><span begin="00:35.194" end="00:35.923">暗</span><span begin="00:35.923" end="00:36.989">了</span><span ttm:role="x-translation" xml:lang="zh-Hans">看天色渐暗了</span></p><p begin="00:39.843" end="00:46.645" ttm:agent="v1" itunes:key="L5"><span begin="00:39.843" end="00:41.408">好</span><span begin="00:41.408" end="00:41.812">陌</span><span begin="00:41.812" end="00:43.303">生</span><span begin="00:43.303" end="00:43.780">的</span><span begin="00:43.780" end="00:44.742">一</span><span begin="00:45.132" end="00:45.661">句</span><span begin="00:45.661" end="00:46.645">話</span><span ttm:role="x-translation" xml:lang="zh-Hans">好陌生的一句话</span></p><p begin="00:47.099" end="00:53.654" ttm:agent="v1" itunes:key="L6"><span begin="00:47.099" end="00:47.531">你</span><span begin="00:47.531" end="00:49.039">看</span><span begin="00:49.039" end="00:49.492">著</span><span begin="00:49.492" end="00:50.525">我</span><span begin="00:50.808" end="00:51.729">說</span><span begin="00:51.729" end="00:53.654">話</span><span ttm:role="x-translation" xml:lang="zh-Hans">你看着我说话</span></p><p begin="00:54.907" end="01:02.577" ttm:agent="v1" itunes:key="L7"><span begin="00:54.907" end="00:55.222">我</span><span begin="00:55.222" end="00:56.108">矇</span><span begin="00:56.108" end="00:56.953">上</span><span begin="00:56.953" end="00:57.119">了</span><span begin="00:57.119" end="00:58.551">眼</span> <span begin="00:58.899" end="01:00.904">彷彿</span><span begin="01:00.904" end="01:01.368">你</span><span begin="01:01.368" end="01:01.600">在</span><span begin="01:01.600" end="01:02.130">身</span><span begin="01:02.130" end="01:02.577">旁</span><span ttm:role="x-translation" xml:lang="zh-Hans">我蒙上了眼 仿佛你在身旁</span></p><p begin="01:02.587" end="01:08.565" ttm:agent="v1" itunes:key="L8"><span begin="01:02.587" end="01:02.839">當</span><span begin="01:02.839" end="01:03.788">你</span><span begin="01:03.788" end="01:04.704">不</span><span begin="01:04.704" end="01:05.221">再</span><span begin="01:05.718" end="01:06.389">應</span><span begin="01:06.389" end="01:08.565">答</span><span ttm:role="x-translation" xml:lang="zh-Hans">当你不再应答</span></p><p begin="01:08.953" end="01:12.514" ttm:agent="v1" itunes:key="L9"><span begin="01:08.953" end="01:11.318">我來不及道</span><span begin="01:11.318" end="01:11.633">聲</span><span begin="01:11.633" end="01:12.053">不</span><span begin="01:12.053" end="01:12.514">安</span><span ttm:role="x-translation" xml:lang="zh-Hans">我来不及道声不安</span></p><p begin="01:12.752" end="01:16.538" ttm:agent="v1" itunes:key="L10"><span begin="01:12.752" end="01:13.247">有</span><span begin="01:13.247" end="01:13.496">點</span><span begin="01:13.496" end="01:14.015">混</span><span begin="01:14.015" end="01:14.383">亂</span> <span begin="01:14.661" end="01:16.109">有點緩</span><span begin="01:16.109" end="01:16.538">慢</span><span ttm:role="x-translation" xml:lang="zh-Hans">有点混乱 有点缓慢</span></p><p begin="01:16.548" end="01:23.917" ttm:agent="v1" itunes:key="L11"><span begin="01:16.548" end="01:18.927">才發現承諾</span><span begin="01:18.927" end="01:19.214">是</span><span begin="01:19.214" end="01:19.723">謊</span><span begin="01:19.723" end="01:20.129">話</span> <span begin="01:20.638" end="01:21.068">你倒</span><span begin="01:21.068" end="01:21.609">下</span><span begin="01:21.609" end="01:22.330">了</span> <span begin="01:22.330" end="01:23.050">我只能</span><span begin="01:23.050" end="01:23.527">旁</span><span begin="01:23.527" end="01:23.917">觀</span><span ttm:role="x-translation" xml:lang="zh-Hans">才发现承诺是谎话 你倒下了 我只能旁观</span></p><p begin="01:24.175" end="01:26.318" ttm:agent="v1" itunes:key="L12"><span begin="01:24.175" end="01:24.948">我越來</span><span begin="01:24.948" end="01:25.434">越</span><span begin="01:25.434" end="01:26.318">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">我越来越爱</span></p><p begin="01:26.518" end="01:27.957" ttm:agent="v1" itunes:key="L13"><span begin="01:26.518" end="01:26.815">愛</span><span begin="01:26.815" end="01:27.315">不</span><span begin="01:27.315" end="01:27.957">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱不爱</span></p><p begin="01:27.967" end="01:31.570" ttm:agent="v1" itunes:key="L14"><span begin="01:27.967" end="01:29.940">都成為我</span><span begin="01:29.940" end="01:30.173">們</span><span begin="01:30.173" end="01:31.173">的負</span><span begin="01:31.173" end="01:31.570">擔</span><span ttm:role="x-translation" xml:lang="zh-Hans">都成为我们的负担</span></p><p begin="01:31.811" end="01:39.021" ttm:agent="v1" itunes:key="L15"><span begin="01:31.811" end="01:32.130">我</span><span begin="01:32.130" end="01:35.143">想要痛快地離</span><span begin="01:35.143" end="01:35.673">開</span><span begin="01:35.673" end="01:36.607">我的</span><span begin="01:36.607" end="01:37.581">依</span><span begin="01:37.581" end="01:39.021">賴</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想要痛快地离开我的依赖</span></p><p begin="01:48.428" end="01:55.210" ttm:agent="v1" itunes:key="L16"><span begin="01:48.428" end="01:49.893">一</span><span begin="01:49.893" end="01:50.435">句</span><span begin="01:50.435" end="01:51.856">句</span><span begin="01:51.856" end="01:52.324">你</span><span begin="01:52.324" end="01:53.306">的</span><span begin="01:53.679" end="01:54.243">責</span><span begin="01:54.243" end="01:55.210">罵</span><span ttm:role="x-translation" xml:lang="zh-Hans">一句句你的责骂</span></p><p begin="01:55.516" end="02:02.748" ttm:agent="v1" itunes:key="L17"><span begin="01:55.516" end="01:56.024">是</span><span begin="01:56.024" end="01:57.547">存</span><span begin="01:57.547" end="01:58.070">在</span><span begin="01:58.070" end="01:59.093">的</span><span begin="01:59.468" end="02:00.366">代</span><span begin="02:00.366" end="02:02.748">價</span><span ttm:role="x-translation" xml:lang="zh-Hans">是存在的代价</span></p><p begin="02:03.434" end="02:11.086" ttm:agent="v1" itunes:key="L18"><span begin="02:03.434" end="02:03.682">不</span><span begin="02:03.682" end="02:05.434">想讓</span><span begin="02:05.434" end="02:05.632">我</span><span begin="02:05.632" end="02:06.640">慌</span><span begin="02:06.640" end="02:07.219">亂</span> <span begin="02:07.582" end="02:09.458">忍痛</span><span begin="02:09.458" end="02:09.954">責</span><span begin="02:09.954" end="02:10.202">備</span><span begin="02:10.202" end="02:10.665">的</span><span begin="02:10.665" end="02:11.086">話</span><span ttm:role="x-translation" xml:lang="zh-Hans">不想让我慌乱 忍痛责备的话</span></p><p begin="02:11.096" end="02:17.329" ttm:agent="v1" itunes:key="L19"><span begin="02:11.096" end="02:11.379">看</span><span begin="02:11.379" end="02:13.068">天再</span><span begin="02:13.068" end="02:13.210">一</span><span begin="02:13.210" end="02:13.775">次</span><span begin="02:14.260" end="02:14.980">暗</span><span begin="02:14.980" end="02:17.329">了</span><span ttm:role="x-translation" xml:lang="zh-Hans">看天再一次暗了</span></p><p begin="02:17.559" end="02:21.150" ttm:agent="v1" itunes:key="L20"><span begin="02:17.559" end="02:19.924">我來不及道</span><span begin="02:19.924" end="02:20.228">聲</span><span begin="02:20.228" end="02:20.659">不</span><span begin="02:20.659" end="02:21.150">安</span><span ttm:role="x-translation" xml:lang="zh-Hans">我来不及道声不安</span></p><p begin="02:21.304" end="02:25.080" ttm:agent="v1" itunes:key="L21"><span begin="02:21.304" end="02:21.799">有</span><span begin="02:21.799" end="02:22.126">點</span><span begin="02:22.126" end="02:22.596">混</span><span begin="02:22.596" end="02:23.050">亂</span> <span begin="02:23.213" end="02:24.661">有點緩</span><span begin="02:24.661" end="02:25.080">慢</span><span ttm:role="x-translation" xml:lang="zh-Hans">有点混乱 有点缓慢</span></p><p begin="02:25.099" end="02:32.568" ttm:agent="v1" itunes:key="L22"><span begin="02:25.099" end="02:27.478">才發現承諾</span><span begin="02:27.478" end="02:27.765">是</span><span begin="02:27.765" end="02:28.274">謊</span><span begin="02:28.274" end="02:28.776">話</span> <span begin="02:29.245" end="02:29.619">你倒</span><span begin="02:29.619" end="02:30.160">下</span><span begin="02:30.160" end="02:30.892">了</span> <span begin="02:30.892" end="02:31.624">我只能</span><span begin="02:31.624" end="02:32.134">旁</span><span begin="02:32.134" end="02:32.568">觀</span><span ttm:role="x-translation" xml:lang="zh-Hans">才发现承诺是谎话 你倒下了 我只能旁观</span></p><p begin="02:32.785" end="02:34.898" ttm:agent="v1" itunes:key="L23"><span begin="02:32.785" end="02:33.546">我越來</span><span begin="02:33.546" end="02:33.998">越</span><span begin="02:33.998" end="02:34.898">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">我越来越爱</span></p><p begin="02:35.101" end="02:36.580" ttm:agent="v1" itunes:key="L24"><span begin="02:35.101" end="02:35.398">愛</span><span begin="02:35.398" end="02:35.872">不</span><span begin="02:35.872" end="02:36.580">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱不爱</span></p><p begin="02:36.596" end="02:40.149" ttm:agent="v1" itunes:key="L25"><span begin="02:36.596" end="02:38.541">都成為我</span><span begin="02:38.541" end="02:38.790">們</span><span begin="02:38.790" end="02:39.705">的負</span><span begin="02:39.705" end="02:40.149">擔</span><span ttm:role="x-translation" xml:lang="zh-Hans">都成为我们的负担</span></p><p begin="02:40.505" end="02:47.605" ttm:agent="v1" itunes:key="L26"><span begin="02:40.505" end="02:40.773">我</span><span begin="02:40.773" end="02:43.693">想要痛快地離</span><span begin="02:43.693" end="02:44.246">開</span><span begin="02:44.246" end="02:45.196">我的</span><span begin="02:45.196" end="02:46.184">依</span><span begin="02:46.184" end="02:47.605">賴</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想要痛快地离开我的依赖</span></p><p begin="02:47.941" end="02:55.505" ttm:agent="v1" itunes:key="L27"><span begin="02:47.941" end="02:52.376">多少個忍受痛的夜晚</span> <span begin="02:52.376" end="02:54.688">你叫我別回</span><span begin="02:54.688" end="02:55.505">來</span><span ttm:role="x-translation" xml:lang="zh-Hans">多少个忍受痛的夜晚 你叫我别回来</span></p><p begin="02:55.615" end="03:06.777" ttm:agent="v1" itunes:key="L28"><span begin="02:55.615" end="02:58.930">我掙扎看你的臉</span> <span begin="02:58.930" end="03:00.666">憔悴的心</span> <span begin="03:00.798" end="03:02.269">怎放得</span><span begin="03:02.269" end="03:06.777">開</span><span ttm:role="x-translation" xml:lang="zh-Hans">我挣扎看你的脸 憔悴的心 怎放得开</span></p><p begin="03:07.020" end="03:10.681" ttm:agent="v1" itunes:key="L29"><span begin="03:07.020" end="03:09.385">我來不及道</span><span begin="03:09.385" end="03:09.731">聲</span><span begin="03:09.731" end="03:10.204">不</span><span begin="03:10.204" end="03:10.681">安</span><span ttm:role="x-translation" xml:lang="zh-Hans">我来不及道声不安</span></p><p begin="03:10.808" end="03:14.624" ttm:agent="v1" itunes:key="L30"><span begin="03:10.808" end="03:11.372">有</span><span begin="03:11.372" end="03:11.626">點</span><span begin="03:11.626" end="03:12.141">混</span><span begin="03:12.141" end="03:12.542">亂</span> <span begin="03:12.779" end="03:14.242">有點緩</span><span begin="03:14.242" end="03:14.624">慢</span><span ttm:role="x-translation" xml:lang="zh-Hans">有点混乱 有点缓慢</span></p><p begin="03:14.635" end="03:22.104" ttm:agent="v1" itunes:key="L31"><span begin="03:14.635" end="03:17.014">才發現承諾</span><span begin="03:17.014" end="03:17.301">是</span><span begin="03:17.301" end="03:17.802">謊</span><span begin="03:17.802" end="03:18.184">話</span> <span begin="03:18.725" end="03:19.155">你倒</span><span begin="03:19.155" end="03:19.696">下</span><span begin="03:19.696" end="03:20.417">了</span> <span begin="03:20.417" end="03:21.137">我只能</span><span begin="03:21.137" end="03:21.614">旁</span><span begin="03:21.614" end="03:22.104">觀</span><span ttm:role="x-translation" xml:lang="zh-Hans">才发现承诺是谎话 你倒下了 我只能旁观</span></p><p begin="03:22.298" end="03:24.361" ttm:agent="v1" itunes:key="L32"><span begin="03:22.298" end="03:23.071">我越來</span><span begin="03:23.071" end="03:23.520">越</span><span begin="03:23.520" end="03:24.361">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">我越来越爱</span></p><p begin="03:24.604" end="03:26.073" ttm:agent="v1" itunes:key="L33"><span begin="03:24.604" end="03:24.901">愛</span><span begin="03:24.901" end="03:25.415">不</span><span begin="03:25.415" end="03:26.073">愛</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱不爱</span></p><p begin="03:26.084" end="03:29.697" ttm:agent="v1" itunes:key="L34"><span begin="03:26.084" end="03:28.045">都成為我</span><span begin="03:28.045" end="03:28.290">們</span><span begin="03:28.290" end="03:29.267">的負</span><span begin="03:29.267" end="03:29.697">擔</span><span ttm:role="x-translation" xml:lang="zh-Hans">都成为我们的负担</span></p><p begin="03:29.898" end="03:37.168" ttm:agent="v1" itunes:key="L35"><span begin="03:29.898" end="03:30.217">我</span><span begin="03:30.217" end="03:33.215">想要痛快地離</span><span begin="03:33.215" end="03:33.760">開</span><span begin="03:33.760" end="03:34.694">我的</span><span begin="03:34.694" end="03:35.699">依</span><span begin="03:35.699" end="03:37.168">賴</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想要痛快地离开我的依赖</span></p><p begin="03:37.459" end="03:46.614" ttm:agent="v1" itunes:key="L36"><span begin="03:37.459" end="03:37.778">我</span><span begin="03:37.778" end="03:40.893">想要痛快地離</span><span begin="03:40.893" end="03:41.531">開</span><span begin="03:41.531" end="03:41.992">我</span><span begin="03:41.992" end="03:42.598">的</span><span begin="03:42.598" end="03:43.696">依</span><span begin="03:43.696" end="03:46.614">賴</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想要痛快地离开我的依赖</span></p></div></body></tt>