<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="33911781"/><amll:meta key="appleMusicId" value="1537814502"/><amll:meta key="musicName" value="secret base ~君がくれたもの~ (10 years after Ver.)"/><amll:meta key="artists" value="茅野愛衣 / 戸松遥 / 早見沙織"/><amll:meta key="album" value="secret base ～君がくれたもの～"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="05:52.493"><div begin="00:00.390" end="04:53.686"><p begin="00:00.390" end="00:07.496" ttm:agent="v1" itunes:key="L1"><span begin="00:00.390" end="00:01.090">君と</span><span begin="00:01.090" end="00:01.808">夏の</span><span begin="00:01.808" end="00:02.629">終わり</span> <span begin="00:02.629" end="00:03.759">将来の</span><span begin="00:03.759" end="00:04.378">夢</span> <span begin="00:04.378" end="00:05.298">大きな</span><span begin="00:05.298" end="00:06.219">希望</span> <span begin="00:06.219" end="00:07.027">忘れ</span><span begin="00:07.027" end="00:07.496">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">这个有你的夏天</span><span ttm:role="x-roman" xml:lang="ja-Latn">kyoku ：machi da nori hiko</span></p><p begin="00:07.496" end="00:14.431" ttm:agent="v1" itunes:key="L2"><span begin="00:07.496" end="00:08.965">10年後の</span><span begin="00:08.965" end="00:09.749">8月</span> <span begin="00:09.749" end="00:10.445">また</span><span begin="00:10.445" end="00:11.629">出会えるのを</span> <span begin="00:11.629" end="00:12.364">信</span><span begin="00:12.364" end="00:12.713">じ</span><span begin="00:12.713" end="00:14.431">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年后的八月</span><span ttm:role="x-roman" xml:lang="ja-Latn">juu nen go no hachi gatsu</span></p><p begin="00:14.778" end="00:22.913" ttm:agent="v1" itunes:key="L3"><span begin="00:14.778" end="00:16.232">最高</span><span begin="00:16.232" end="00:18.032">の</span><span begin="00:18.377" end="00:19.223">思い</span><span begin="00:19.223" end="00:19.827">出</span><span begin="00:19.827" end="00:22.913">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">给我一份最美的回忆</span><span ttm:role="x-roman" xml:lang="ja-Latn">sai kou no omo i de wo</span></p><p begin="00:40.336" end="00:47.039" ttm:agent="v1" itunes:key="L4"><span begin="00:40.336" end="00:41.377">出会いは</span> <span begin="00:41.377" end="00:42.201">ふっとした</span> <span begin="00:42.201" end="00:43.527">瞬間</span> <span begin="00:43.802" end="00:45.345">帰り道の</span><span begin="00:45.345" end="00:46.509">交差点</span><span begin="00:46.509" end="00:47.039">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">初次邂逅是个不经意的瞬间</span><span ttm:role="x-roman" xml:lang="ja-Latn">de a i wa futto shi ta</span></p><p begin="00:47.039" end="00:53.027" ttm:agent="v1" itunes:key="L5"><span begin="00:47.039" end="00:48.026">声を</span><span begin="00:48.026" end="00:48.651">かけて</span><span begin="00:48.651" end="00:50.069">くれたね</span><span begin="00:50.069" end="00:51.173">「一緒に</span><span begin="00:51.173" end="00:51.600">帰</span><span begin="00:51.600" end="00:53.027">ろう」</span><span ttm:role="x-translation" xml:lang="zh-Hans">你对我打声招呼</span><span ttm:role="x-roman" xml:lang="ja-Latn">koe wo ka ke te ku re ta ne</span></p><p begin="00:54.499" end="01:01.498" ttm:agent="v1" itunes:key="L6"><span begin="00:54.499" end="00:55.537">僕は</span> <span begin="00:55.537" end="00:56.605">照れくさ</span><span begin="00:56.605" end="00:57.861">そうに</span> <span begin="00:58.118" end="00:59.027">カバンで</span><span begin="00:59.027" end="01:00.035">顔を隠</span><span begin="01:00.035" end="01:00.643">しな</span><span begin="01:00.643" end="01:01.498">がら</span><span ttm:role="x-translation" xml:lang="zh-Hans">我羞得手足无措</span><span ttm:role="x-roman" xml:lang="ja-Latn">boku wa te re ku sa so u ni</span></p><p begin="01:01.868" end="01:07.373" ttm:agent="v1" itunes:key="L7"><span begin="01:01.868" end="01:02.736">本当は</span> <span begin="01:02.736" end="01:03.806">とても</span> <span begin="01:03.806" end="01:04.883">とても</span> <span begin="01:04.883" end="01:06.381">嬉しかった</span><span begin="01:06.381" end="01:07.373">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">其实心里</span><span ttm:role="x-roman" xml:lang="ja-Latn">hon tou wa to te mo to te mo</span></p><p begin="01:08.932" end="01:16.146" ttm:agent="v1" itunes:key="L8"><span begin="01:08.932" end="01:10.124">あぁ</span> <span begin="01:10.124" end="01:11.978">花火が夜空</span> <span begin="01:11.978" end="01:13.028">きれいに</span><span begin="01:13.028" end="01:13.884">咲いて</span> <span begin="01:13.884" end="01:14.424">ちょっと</span><span begin="01:14.424" end="01:16.146">セツナク</span><span ttm:role="x-translation" xml:lang="zh-Hans">烟花在夜空中</span><span ttm:role="x-roman" xml:lang="ja-Latn">a a hana bi ga yo zora</span></p><p begin="01:16.271" end="01:22.583" ttm:agent="v1" itunes:key="L9"><span begin="01:16.271" end="01:17.483">あぁ</span> <span begin="01:17.483" end="01:18.188">風が</span><span begin="01:18.188" end="01:19.231">時間と</span><span begin="01:19.231" end="01:19.935">ともに</span> <span begin="01:19.935" end="01:20.309">流</span><span begin="01:20.309" end="01:20.706">れ</span><span begin="01:20.706" end="01:22.583">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">时光就像风儿一样匆匆流淌</span><span ttm:role="x-roman" xml:lang="ja-Latn">a a</span></p><p begin="01:22.930" end="01:29.907" ttm:agent="v1" itunes:key="L10"><span begin="01:22.930" end="01:23.497">嬉</span><span begin="01:23.497" end="01:24.585">しくって</span> <span begin="01:24.585" end="01:25.270">楽</span><span begin="01:25.270" end="01:26.419">しくって</span> <span begin="01:26.419" end="01:27.892">冒険も</span> <span begin="01:27.892" end="01:29.021">いろいろ</span><span begin="01:29.021" end="01:29.496">した</span><span begin="01:29.496" end="01:29.907">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">多少开心的相伴</span><span ttm:role="x-roman" xml:lang="ja-Latn">ure shi kutte tano shi kutte</span></p><p begin="01:29.907" end="01:36.710" ttm:agent="v1" itunes:key="L11"><span begin="01:29.907" end="01:31.743">二人の</span> <span begin="01:31.743" end="01:33.098">秘密の</span> <span begin="01:33.098" end="01:33.722">基地の</span><span begin="01:33.722" end="01:36.710">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">都在属于你我的秘密基地中</span><span ttm:role="x-roman" xml:lang="ja-Latn">futa ri no hi mitsu no</span></p><p begin="01:37.080" end="01:44.121" ttm:agent="v1" itunes:key="L12"><span begin="01:37.080" end="01:37.780">君と</span><span begin="01:37.780" end="01:38.498">夏の</span><span begin="01:38.498" end="01:39.319">終わり</span> <span begin="01:39.319" end="01:40.449">将来の</span><span begin="01:40.449" end="01:41.068">夢</span> <span begin="01:41.068" end="01:41.988">大きな</span><span begin="01:41.988" end="01:42.909">希望</span> <span begin="01:42.909" end="01:43.717">忘れ</span><span begin="01:43.717" end="01:44.121">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">这个有你的夏天</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi to natsu no o wa ri</span></p><p begin="01:44.121" end="01:51.056" ttm:agent="v1" itunes:key="L13"><span begin="01:44.121" end="01:45.590">10年後の</span><span begin="01:45.590" end="01:46.374">8月</span> <span begin="01:46.374" end="01:46.937">ま</span><span begin="01:46.937" end="01:47.238">た</span><span begin="01:47.238" end="01:48.254">出会えるのを</span> <span begin="01:48.254" end="01:48.989">信</span><span begin="01:48.989" end="01:49.338">じ</span><span begin="01:49.338" end="01:51.056">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年后的八月</span><span ttm:role="x-roman" xml:lang="ja-Latn">juu nen go no hachi gatsu</span></p><p begin="01:51.335" end="01:58.403" ttm:agent="v1" itunes:key="L14"><span begin="01:51.335" end="01:52.049">君が</span><span begin="01:52.049" end="01:53.352">最後まで</span> <span begin="01:53.352" end="01:54.096">心</span><span begin="01:54.096" end="01:54.659">から</span> <span begin="01:54.659" end="01:55.543">「ありがとう」</span><span begin="01:55.543" end="01:56.605">叫んでた</span><span begin="01:56.605" end="01:57.276">こと</span> <span begin="01:57.276" end="01:58.089">知ってた</span><span begin="01:58.089" end="01:58.403">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到最后你都发自内心地</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi ga sai go ma de</span></p><p begin="01:58.566" end="02:05.530" ttm:agent="v1" itunes:key="L15"><span begin="01:58.566" end="01:59.190">涙</span><span begin="01:59.190" end="01:59.598">を</span><span begin="01:59.598" end="02:00.487">こらえて</span> <span begin="02:00.487" end="02:01.716">笑顔で</span><span begin="02:01.716" end="02:02.450">さようなら</span> <span begin="02:02.450" end="02:03.285">せつない</span><span begin="02:03.285" end="02:03.743">よ</span><span begin="02:03.743" end="02:05.530">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">含着眼泪</span><span ttm:role="x-roman" xml:lang="ja-Latn">namida wo ko ra e te</span></p><p begin="02:05.813" end="02:13.288" ttm:agent="v1" itunes:key="L16"><span begin="02:05.813" end="02:07.202">最高</span><span begin="02:07.202" end="02:09.120">の</span><span begin="02:09.585" end="02:10.361">思い</span><span begin="02:10.361" end="02:10.832">出</span><span begin="02:10.832" end="02:13.288">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">给我一份最美的回忆</span><span ttm:role="x-roman" xml:lang="ja-Latn">sai kou no omo i de wo</span></p><p begin="02:13.502" end="02:20.390" ttm:agent="v1" itunes:key="L17"><span begin="02:13.502" end="02:13.938">あ</span><span begin="02:13.938" end="02:14.671">ぁ</span> <span begin="02:14.803" end="02:15.239">夏</span><span begin="02:15.239" end="02:16.075">休み</span><span begin="02:16.075" end="02:16.576">も</span> <span begin="02:16.576" end="02:17.048">あと</span><span begin="02:17.048" end="02:17.800">少し</span><span begin="02:17.800" end="02:18.356">で</span> <span begin="02:18.356" end="02:19.027">終わっ</span><span begin="02:19.027" end="02:19.687">ちゃうか</span><span begin="02:19.687" end="02:20.390">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">这个暑假的时光</span><span ttm:role="x-roman" xml:lang="ja-Latn">a a natsu yasu mi mo</span></p><p begin="02:20.661" end="02:26.940" ttm:agent="v1" itunes:key="L18"><span begin="02:20.661" end="02:21.207">あ</span><span begin="02:21.207" end="02:21.820">ぁ</span> <span begin="02:21.955" end="02:23.158">太陽と</span><span begin="02:23.158" end="02:23.713">月</span> <span begin="02:23.713" end="02:24.735">仲良く</span><span begin="02:24.735" end="02:25.353">し</span><span begin="02:25.353" end="02:26.940">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿太阳和月亮能够好好相伴</span><span ttm:role="x-roman" xml:lang="ja-Latn">a a tai you to tsuki</span></p><p begin="02:27.245" end="02:34.553" ttm:agent="v1" itunes:key="L19"><span begin="02:27.245" end="02:27.910">悲</span><span begin="02:27.910" end="02:29.232">しくって</span> <span begin="02:29.232" end="02:29.748">寂</span><span begin="02:29.748" end="02:30.990">しくって</span> <span begin="02:30.990" end="02:31.808">喧嘩</span><span begin="02:31.808" end="02:32.251">も</span> <span begin="02:32.251" end="02:33.219">いろいろ</span><span begin="02:33.219" end="02:33.952">した</span><span begin="02:33.952" end="02:34.553">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">也有过伤心寂寞</span><span ttm:role="x-roman" xml:lang="ja-Latn">kana shi kutte sabi shi kutte</span></p><p begin="02:34.563" end="02:41.473" ttm:agent="v1" itunes:key="L20"><span begin="02:34.563" end="02:35.151">二</span><span begin="02:35.151" end="02:35.833">人</span><span begin="02:35.833" end="02:36.453">の</span> <span begin="02:36.453" end="02:37.109">秘密</span><span begin="02:37.109" end="02:37.606">の</span> <span begin="02:37.606" end="02:38.291">基地の</span><span begin="02:38.291" end="02:41.473">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">都在属于你我的秘密基地中</span><span ttm:role="x-roman" xml:lang="ja-Latn">futa ri no hi mitsu no</span></p><p begin="02:41.546" end="02:48.754" ttm:agent="v1" itunes:key="L21"><span begin="02:41.546" end="02:42.260">君が</span><span begin="02:42.260" end="02:43.463">最後まで</span> <span begin="02:43.463" end="02:44.307">心</span><span begin="02:44.307" end="02:44.800">から</span> <span begin="02:44.800" end="02:45.754">「ありがとう」</span><span begin="02:45.754" end="02:47.397">叫んでたこと</span> <span begin="02:47.397" end="02:48.320">知ってた</span><span begin="02:48.320" end="02:48.754">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到最后你都发自内心地</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi ga sai go ma de</span></p><p begin="02:48.768" end="02:55.762" ttm:agent="v1" itunes:key="L22"><span begin="02:48.768" end="02:49.674">涙を</span><span begin="02:49.674" end="02:50.535">こらえて</span> <span begin="02:50.535" end="02:50.851">笑</span><span begin="02:50.851" end="02:51.408">顔</span><span begin="02:51.408" end="02:51.732">で</span><span begin="02:51.732" end="02:52.530">さようなら</span> <span begin="02:52.530" end="02:53.412">せつない</span><span begin="02:53.412" end="02:53.768">よ</span><span begin="02:53.768" end="02:55.762">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">含着眼泪</span><span ttm:role="x-roman" xml:lang="ja-Latn">namida wo ko ra e te</span></p><p begin="02:56.050" end="03:03.344" ttm:agent="v1" itunes:key="L23"><span begin="02:56.050" end="02:56.605">最</span><span begin="02:56.605" end="02:57.454">高</span><span begin="02:57.454" end="02:59.255">の</span><span begin="02:59.680" end="03:00.388">思い</span><span begin="03:00.388" end="03:00.829">出</span><span begin="03:00.829" end="03:03.344">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">给我一份最美的回忆</span><span ttm:role="x-roman" xml:lang="ja-Latn">sai kou no omo i de wo</span></p><p begin="03:03.759" end="03:24.342" ttm:agent="v1" itunes:key="L24"><span begin="03:03.759" end="03:07.164">突然</span><span begin="03:07.164" end="03:10.337">の</span> <span begin="03:10.948" end="03:12.699">転</span><span begin="03:12.699" end="03:14.698">校</span><span begin="03:14.698" end="03:17.411">で</span> <span begin="03:17.963" end="03:19.110">ど</span><span begin="03:19.110" end="03:20.064">うし</span><span begin="03:20.064" end="03:20.977">よう</span><span begin="03:20.977" end="03:21.967">もな</span><span begin="03:21.967" end="03:24.342">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">突如其来的转学我也无能为力</span><span ttm:role="x-roman" xml:lang="ja-Latn">totsu zen no ten kou de</span></p><p begin="03:24.794" end="03:31.862" ttm:agent="v1" itunes:key="L25"><span begin="03:24.794" end="03:25.531">手紙</span> <span begin="03:25.531" end="03:26.332">書くよ</span> <span begin="03:26.332" end="03:27.359">電話も</span><span begin="03:27.359" end="03:28.129">するよ</span> <span begin="03:28.129" end="03:29.196">忘れない</span><span begin="03:29.196" end="03:29.946">でね</span> <span begin="03:29.946" end="03:30.575">僕の</span><span begin="03:30.575" end="03:31.192">こと</span><span begin="03:31.192" end="03:31.862">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">我一定会给你写信给你打电话</span><span ttm:role="x-roman" xml:lang="ja-Latn">te gami ka ku yo</span></p><p begin="03:31.862" end="03:38.742" ttm:agent="v1" itunes:key="L26"><span begin="03:31.862" end="03:33.405">いつまでも</span> <span begin="03:33.758" end="03:34.883">二人の</span> <span begin="03:34.883" end="03:35.347">基地</span><span begin="03:35.347" end="03:35.774">の</span><span begin="03:35.774" end="03:38.742">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论何时都要记得我们的秘密基地</span><span ttm:role="x-roman" xml:lang="ja-Latn">i tsu ma de mo</span></p><p begin="03:38.948" end="03:45.989" ttm:agent="v1" itunes:key="L27"><span begin="03:38.948" end="03:39.543">君と</span><span begin="03:39.543" end="03:40.257">夏の</span><span begin="03:40.257" end="03:41.161">終わり</span> <span begin="03:41.161" end="03:41.813">ずっと</span><span begin="03:41.813" end="03:42.345">話</span><span begin="03:42.345" end="03:42.964">して</span> <span begin="03:42.964" end="03:43.758">夕日を</span><span begin="03:43.758" end="03:44.770">見てから</span><span begin="03:44.770" end="03:45.375">星を</span><span begin="03:45.375" end="03:45.989">眺め</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你在那个夏末 说不完的话</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi to natsu no o wa ri</span></p><p begin="03:45.989" end="03:53.098" ttm:agent="v1" itunes:key="L28"><span begin="03:45.989" end="03:46.794">君の</span><span begin="03:46.794" end="03:47.568">頬を</span> <span begin="03:47.568" end="03:48.437">流れた</span><span begin="03:48.437" end="03:49.150">涙</span><span begin="03:49.150" end="03:49.452">は</span> <span begin="03:49.452" end="03:49.911">ずっと</span><span begin="03:49.911" end="03:50.371">忘</span><span begin="03:50.371" end="03:51.185">れな</span><span begin="03:51.185" end="03:53.098">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">你脸颊滑落的泪水</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi no hoho wo</span></p><p begin="03:53.336" end="04:00.365" ttm:agent="v1" itunes:key="L29"><span begin="03:53.336" end="03:54.000">君が</span><span begin="03:54.000" end="03:54.636">最後</span><span begin="03:54.636" end="03:55.067">まで</span> <span begin="03:55.067" end="03:55.981">大きく</span><span begin="03:55.981" end="03:56.489">手を</span><span begin="03:56.489" end="03:57.274">振って</span><span begin="03:57.274" end="03:57.780">く</span><span begin="03:57.780" end="03:58.565">れたこと</span> <span begin="03:58.565" end="03:59.174">きっと</span><span begin="03:59.174" end="03:59.853">忘れ</span><span begin="03:59.853" end="04:00.365">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到最后</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi ga sai go ma de</span></p><p begin="04:00.375" end="04:07.463" ttm:agent="v1" itunes:key="L30"><span begin="04:00.375" end="04:01.282">だから</span> <span begin="04:01.282" end="04:02.135">こうして</span> <span begin="04:02.135" end="04:02.860">夢の</span><span begin="04:02.860" end="04:03.576">中で</span> <span begin="04:03.576" end="04:04.221">ずっと</span><span begin="04:04.221" end="04:05.402">永遠</span><span begin="04:05.402" end="04:07.463">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果这是一场梦</span><span ttm:role="x-roman" xml:lang="ja-Latn">da ka ra ko u shi te</span></p><p begin="04:07.593" end="04:14.617" ttm:agent="v1" itunes:key="L31"><span begin="04:07.593" end="04:08.286">君と</span><span begin="04:08.286" end="04:08.955">夏の</span><span begin="04:08.955" end="04:09.775">終わり</span> <span begin="04:09.775" end="04:10.896">将来の</span><span begin="04:10.896" end="04:11.538">夢</span> <span begin="04:11.538" end="04:12.490">大きな</span><span begin="04:12.490" end="04:13.295">希望</span> <span begin="04:13.295" end="04:14.171">忘れ</span><span begin="04:14.171" end="04:14.617">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">这个有你的夏天</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi to natsu no o wa ri</span></p><p begin="04:14.775" end="04:21.552" ttm:agent="v1" itunes:key="L32"><span begin="04:14.775" end="04:15.216">10</span><span begin="04:15.216" end="04:16.050">年後の</span><span begin="04:16.050" end="04:16.563">8</span><span begin="04:16.563" end="04:16.994">月</span> <span begin="04:16.994" end="04:17.484">ま</span><span begin="04:17.484" end="04:17.800">た</span><span begin="04:17.800" end="04:18.777">出会えるのを</span> <span begin="04:18.777" end="04:19.467">信</span><span begin="04:19.467" end="04:19.797">じ</span><span begin="04:19.797" end="04:21.552">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">十年后的八月</span><span ttm:role="x-roman" xml:lang="ja-Latn">juu nen go no hachi gatsu</span></p><p begin="04:21.930" end="04:28.989" ttm:agent="v1" itunes:key="L33"><span begin="04:21.930" end="04:22.574">君が</span><span begin="04:22.574" end="04:23.248">最後</span><span begin="04:23.248" end="04:23.799">まで</span> <span begin="04:23.799" end="04:24.575">心</span><span begin="04:24.575" end="04:25.125">から</span> <span begin="04:25.125" end="04:26.084">「ありがとう」</span><span begin="04:26.084" end="04:26.840">叫んで</span><span begin="04:26.840" end="04:27.700">たこと</span> <span begin="04:27.700" end="04:28.557">知ってた</span><span begin="04:28.557" end="04:28.989">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">直到最后</span><span ttm:role="x-roman" xml:lang="ja-Latn">kimi ga sai go ma de</span></p><p begin="04:29.065" end="04:36.090" ttm:agent="v1" itunes:key="L34"><span begin="04:29.065" end="04:29.645">涙</span><span begin="04:29.645" end="04:30.047">を</span><span begin="04:30.047" end="04:31.005">こらえて</span> <span begin="04:31.005" end="04:32.019">笑顔で</span><span begin="04:32.019" end="04:32.849">さようなら</span> <span begin="04:32.849" end="04:33.764">せつない</span><span begin="04:33.764" end="04:34.094">よ</span><span begin="04:34.094" end="04:36.090">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">含着眼泪</span><span ttm:role="x-roman" xml:lang="ja-Latn">namida wo ko ra e te</span></p><p begin="04:36.373" end="04:43.478" ttm:agent="v1" itunes:key="L35"><span begin="04:36.373" end="04:36.897">最</span><span begin="04:36.897" end="04:37.650">高</span><span begin="04:37.650" end="04:39.680">の</span><span begin="04:39.973" end="04:40.691">思い</span><span begin="04:40.691" end="04:41.143">出</span><span begin="04:41.143" end="04:43.478">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">给我一份最美的回忆</span><span ttm:role="x-roman" xml:lang="ja-Latn">sai kou no omo i de wo</span></p><p begin="04:43.519" end="04:53.686" ttm:agent="v1" itunes:key="L36"><span begin="04:43.519" end="04:44.093">最</span><span begin="04:44.093" end="04:44.790">高</span><span begin="04:44.790" end="04:46.910">の</span><span begin="04:47.143" end="04:47.836">思い</span><span begin="04:47.836" end="04:48.308">出</span><span begin="04:48.308" end="04:53.686">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">给我一份最美的回忆</span><span ttm:role="x-roman" xml:lang="ja-Latn">sai kou no omo i de wo</span></p></d