<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="1378491298"/><amll:meta key="appleMusicId" value="1472727605"/><amll:meta key="musicName" value="愛にできることはまだあるかい"/><amll:meta key="artists" value="RADWIMPS"/><amll:meta key="album" value="天気の子"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:01.323" end="00:02.376">ini</span><span begin="00:02.376" end="00:03.018">deki</span><span begin="00:03.018" end="00:03.646">ru</span><span begin="00:03.819" end="00:04.902">kotowa</span><span begin="00:04.902" end="00:05.764">mada</span><span begin="00:05.764" end="00:06.662">aru</span><span begin="00:06.662" end="00:08.381">kai</span></text><text for="L2"><span begin="00:11.824" end="00:12.552">nimomo</span><span begin="00:12.552" end="00:13.376">tazu</span><span begin="00:13.376" end="00:14.239">ni</span><span begin="00:15.046" end="00:15.832">umareochi</span><span begin="00:15.832" end="00:16.530">ta</span><span begin="00:16.530" end="00:17.419">boku</span></text><text for="L3"><span begin="00:18.623" end="00:19.427">towanosu</span><span begin="00:19.427" end="00:20.052">kima</span><span begin="00:20.052" end="00:20.724">de</span><span begin="00:21.619" end="00:22.656">notauchima</span><span begin="00:22.656" end="00:24.160">wa'tteru</span></text><text for="L4"><span begin="00:25.202" end="00:26.292">akirametamo</span><span begin="00:26.292" end="00:27.594">noto</span><span begin="00:28.543" end="00:29.964">kashikoimonoda</span><span begin="00:29.964" end="00:31.116">kega</span></text><text for="L5"><span begin