673" end="05:05.778">owariaruji</span><span begin="05:05.778" end="05:06.990">nseini</span><span begin="05:07.224" end="05:07.702"></span><span begin="05:07.702" end="05:08.327"></span><span begin="05:08.327" end="05:09.116"></span><span begin="05:09.116" end="05:10.000"></span></text><text for="L36"><span begin="05:11.279" end="05:11.635">nazeko</span><span begin="05:11.635" end="05:12.499">notewosu</span><span begin="05:12.499" end="05:13.653">rinukeru</span><span begin="05:14.020" end="05:15.064"></span><span begin="05:15.064" end="05:15.871"></span><span begin="05:15.871" end="05:16.572"></span></text><text for="L37"><span begin="05:17.977" end="05:18.924">soredemonao</span><span begin="05:18.924" end="05:19.329">shiga</span><span begin="05:19.329" end="05:20.409">mitsuku</span><span begin="05:20.740" end="05:21.658">kurawa</span><span begin="05:21.790" end="05:22.518"></span><span begin="05:22.518" end="05:23.218"></span></text><text for="L38"><span begin="05:23.923" end="05:24.958">retomo</span><span begin="05:25.344" end="05:25.978">kireika</span><span begin="05:25.978" end="05:26.898"></span></text><text for="L40"><span begin="05:54.975" end="05:56.649">inoutamo</span><span begin="05:56.649" end="05:57.276"></span><span begin="05:58.250" end="05:59.203">tawaretsu</span><span begin="05:59.203" end="06:00.485">kushita</span><span begin="06:01.658" end="06:02.736"></span><span begin="06:02.736" end="06:03.328"></span><span begin="06:03.328" end="06:03.879"></span><span begin="06:04.828" end="06:05.841"></span><span begin="06:05.841" end="06:06.648"></span><span begin="06:06.648" end="06:07.487"></span></text><text for="L41"><span begin="06:08.464" end="06:09.354">nnako</span><span begin="06:09.354" end="06:10.692">uyani</span><span begin="06:11.680" end="06:13.297">umareochitabo</span><span begin="06:13.297" end="06:13.982">ku</span><span begin="06:14.896" end="06:15.706">kimi</span><span begin="06:16.458" end="06:17.465"></span><span begin="06:18.192" end="06:19.329"></span></text><text for="L42"><span begin="06:21.575" end="06:22.770">ainide</span><span begin="06:22.770" end="06:23.884">kiru</span><span begin="06:24.153" end="06:25.186">kotowa</span><span begin="06:25.186" end="06:26.031">mada</span><span begin="06:26.031" end="06:26.992">aru</span><span begin="06:26.992" end="06:27.862">yo</span></text><text for="L43"><span begin="06:28.374" end="06:29.470">bokuni</span><span begin="06:29.470" end="06:30.647">dekiru</span><span begin="06:30.865" end="06:31.960">kotowa</span><span begin="06:31.960" end="06:32.994">mada</span><span begin="06:32.994" end="06:33.849">aru</span><span begin="06:33.849" end="06:36.101">yo</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="06:54.129"><div begin="00:01.323" end="06:36.101"><p begin="00:01.323" end="00:08.381" ttm:agent="v1" itunes:key="L1"><span begin="00:01.323" end="00:02.376">愛に</span><span begin="00:02.376" end="00:03.018">で</span><span begin="00:03.018" end="00:03.646">きる</span><span begin="00:03.819" end="00:04.902">ことは</span><span begin="00:04.902" end="00:05.764">まだ</span><span begin="00:05.764" end="00:06.662">ある</span><span begin="00:06.662" end="00:08.381">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有什么</span></p><p begin="00:11.824" end="00:17.419" ttm:agent="v1" itunes:key="L2"><span begin="00:11.824" end="00:12.552">何も</span><span begin="00:12.552" end="00:13.376">持たず</span><span begin="00:13.376" end="00:14.239">に</span> <span begin="00:15.046" end="00:15.832">生まれ</span><span begin="00:15.832" end="00:16.530">堕ちた</span><span begin="00:16.530" end="00:17.419">僕</span><span ttm:role="x-translation" xml:lang="zh-Hans">两手空空降生于世的我</span></p><p begin="00:18.623" end="00:24.160" ttm:agent="v1" itunes:key="L3"><span begin="00:18.623" end="00:19.427">永遠の</span><span begin="00:19.427" end="00:20.052">隙間</span><span begin="00:20.052" end="00:20.724">で</span> <span begin="00:21.619" end="00:22.656">のたうち</span><span begin="00:22.656" end="00:24.160">回ってる</span><span ttm:role="x-translation" xml:lang="zh-Hans">在永恒的缝隙间苦苦挣扎</span></p><p begin="00:25.202" end="00:31.116" ttm:agent="v1" itunes:key="L4"><span begin="00:25.202" end="00:26.292">諦めた</span><span begin="00:26.292" end="00:27.594">者と</span> <span begin="00:28.543" end="00:29.964">賢い者</span><span begin="00:29.964" end="00:31.116">だけが</span><span ttm:role="x-translation" xml:lang="zh-Hans">我在唯有不抱希望的人 与足够智慧的人</span></p><p begin="00:31.921" end="00:37.968" ttm:agent="v1" itunes:key="L5"><span begin="00:31.921" end="00:32.802">勝者の</span><span begin="00:32.802" end="00:33.763">時代</span><span begin="00:33.763" end="00:34.537">に</span> <span begin="00:35.504" end="00:36.405">どこで</span><span begin="00:36.405" end="00:37.159">息を</span><span begin="00:37.159" end="00:37.968">吸う</span><span ttm:role="x-translation" xml:lang="zh-Hans">才是胜者的时代里苟延残喘着</span></p><p begin="00:52.226" end="00:57.915" ttm:agent="v1" itunes:key="L6"><span begin="00:52.226" end="00:53.292">支配者も</span><span begin="00:53.292" end="00:54.650">神も</span> <span begin="00:55.633" end="00:56.461">どこか</span><span begin="00:56.461" end="00:57.915">他人顔</span><span ttm:role="x-translation" xml:lang="zh-Hans">无论统治者还是神 都有些事不关己的样子</span></p><p begin="00:59.128" end="01:04.768" ttm:agent="v1" itunes:key="L7"><span begin="00:59.128" end="00:59.879">だけど</span><span begin="00:59.879" end="01:01.455">本当は</span> <span begin="01:02.460" end="01:03.446">分かって</span><span begin="01:03.446" end="01:03.931">いる</span><span begin="01:03.931" end="01:04.768">はず</span><span ttm:role="x-translation" xml:lang="zh-Hans">但其实他们心中应该很明白</span></p><p begin="01:05.720" end="01:11.624" ttm:agent="v1" itunes:key="L8"><span begin="01:05.720" end="01:06.675">勇気や</span><span begin="01:06.675" end="01:08.250">希望や</span> <span begin="01:09.203" end="01:10.614">絆とかの</span><span begin="01:10.614" end="01:11.624">魔法</span><span ttm:role="x-translation" xml:lang="zh-Hans">勇气 希望 牵绊这些魔法</span></p><p begin="01:12.456" end="01:18.376" ttm:agent="v1" itunes:key="L9"><span begin="01:12.456" end="01:14.048">使い道も</span><span begin="01:14.048" end="01:14.928">なく</span> <span begin="01:15.485" end="01:16.362">オトナは</span><span begin="01:16.362" end="01:16.920">眼を</span><span begin="01:16.935" end="01:18.376">背ける</span><span ttm:role="x-translation" xml:lang="zh-Hans">毫无用处 所以大人们都避而不看</span></p><p begin="01:19.226" end="01:25.109" ttm:agent="v1" itunes:key="L10"><span begin="01:19.226" end="01:20.309">それでも</span><span begin="01:20.309" end="01:21.061">あの日</span><span begin="01:21.061" end="01:21.650">の</span> <span begin="01:22.654" end="01:23.390">君が</span><span begin="01:23.390" end="01:24.164">今も</span><span begin="01:24.164" end="01:25.109">まだ</span><span ttm:role="x-translation" xml:lang="zh-Hans">即便如此 那一天的你至今依旧</span></p><p begin="01:26.002" end="01:31.878" ttm:agent="v1" itunes:key="L11"><span begin="01:26.002" end="01:26.689">僕の</span><span begin="01:26.689" end="01:27.849">全正義</span><span begin="01:27.849" end="01:28.424">の</span> <span begin="01:29.506" end="01:30.955">ど真ん中に</span><span begin="01:30.955" end="01:31.878">いる</span><span ttm:role="x-translation" xml:lang="zh-Hans">存在于我所有正义的正中心</span></p><p begin="01:32.773" end="01:38.538" ttm:agent="v1" itunes:key="L12"><span begin="01:32.773" end="01:33.651">世界が</span><span begin="01:33.651" end="01:34.574">背中</span><span begin="01:34.574" end="01:35.191">を</span> <span begin="01:36.228" end="01:37.042">向けても</span><span begin="01:37.042" end="01:37.629">まだ</span><span begin="01:37.629" end="01:38.538">なお</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使全世界都与你背道而行</span></p><p begin="01:39.648" end="01:45.304" ttm:agent="v1" itunes:key="L13"><span begin="01:39.648" end="01:40.734">立ち向かう</span><span begin="01:40.734" end="01:41.331">君</span><span begin="01:41.331" end="01:42.210">が</span> <span begin="01:42.879" end="01:43.568">今も</span><span begin="01:43.568" end="01:44.466">ここに</span><span begin="01:44.466" end="01:45.304">いる</span><span ttm:role="x-translation" xml:lang="zh-Hans">此刻你也会在此对抗整个世界</span></p><p begin="01:46.026" end="01:52.482" ttm:agent="v1" itunes:key="L14"><span begin="01:46.026" end="01:47.202">愛に</span><span begin="01:47.202" end="01:48.467">できる</span><span begin="01:48.651" end="01:49.734">ことは</span><span begin="01:49.734" end="01:50.670">まだ</span><span begin="01:50.670" end="01:51.453">ある</span><span begin="01:51.453" end="01:52.482">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有什么</span></p><p begin="01:52.872" end="02:00.482" ttm:agent="v1" itunes:key="L15"><span begin="01:52.872" end="01:53.970">僕に</span><span begin="01:53.970" end="01:55.093">できる</span><span begin="01:55.368" end="01:56.483">ことは</span><span begin="01:56.483" end="01:57.495">まだ</span><span begin="01:57.495" end="01:58.188">ある</span><span begin="01:58.188" end="02:00.482">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的还有什么</span></p><p begin="02:05.550" end="02:17.789" ttm:agent="v1" itunes:key="L16"><span begin="02:05.550" end="02:06.675">君が</span><span begin="02:06.675" end="02:07.821">くれた</span><span begin="02:08.106" end="02:09.168">勇気</span><span begin="02:09.168" end="02:09.975">だか</span><span begin="02:09.975" end="02:11.295">ら</span> <span begin="02:12.342" end="02:13.368">君の</span><span begin="02:13.368" end="02:14.511">ために</span><span begin="02:14.818" end="02:15.953">使い</span><span begin="02:15.953" end="02:16.762">たいん</span><span begin="02:16.762" end="02:17.789">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">是你曾给予我勇气</span></p><p begin="02:19.008" end="02:31.239" ttm:agent="v1" itunes:key="L17"><span begin="02:19.008" end="02:20.235">君と</span><span begin="02:20.235" end="02:21.840">分け合った</span><span begin="02:21.840" end="02:22.720">愛</span><span begin="02:22.720" end="02:23.509">だか</span><span begin="02:23.509" end="02:24.627">ら</span> <span begin="02:25.876" end="02:26.938">君と</span><span begin="02:26.938" end="02:28.111">じゃなきゃ</span><span begin="02:28.405" end="02:29.543">意味が</span><span begin="02:29.543" end="02:30.259">ないん</span><span begin="02:30.259" end="02:31.239">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">是只属于你和我的爱</span></p><p begin="02:31.719" end="02:38.105" ttm:agent="v1" itunes:key="L18"><span begin="02:31.719" end="02:32.895">愛に</span><span begin="02:32.895" end="02:34.160">できる</span><span begin="02:34.344" end="02:35.427">ことは</span><span begin="02:35.427" end="02:36.363">まだ</span><span begin="02:36.363" end="02:37.146">ある</span><span begin="02:37.146" end="02:38.105">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有什么</span></p><p begin="02:38.471" end="02:45.501" ttm:agent="v1" itunes:key="L19"><span begin="02:38.471" end="02:39.679">僕に</span><span begin="02:39.679" end="02:40.692">できる</span><span begin="02:40.967" end="02:42.082">ことは</span><span begin="02:42.082" end="02:42.998">まだ</span><span begin="02:42.998" end="02:43.787">ある</span><span begin="02:43.787" end="02:45.501">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的还有什么</span></p><p begin="03:04.021" end="03:09.848" ttm:agent="v1" itunes:key="L20"><span begin="03:04.021" end="03:05.117">運命とは</span><span begin="03:05.117" end="03:06.493">つまり</span> <span begin="03:07.322" end="03:08.564">サイコロの</span><span begin="03:08.564" end="03:09.115">出た</span><span begin="03:09.115" end="03:09.848">目？</span><span ttm:role="x-translation" xml:lang="zh-Hans">所谓命运就是骰子显示的数字</span></p><p begin="03:10.763" end="03:16.644" ttm:agent="v1" itunes:key="L21"><span begin="03:10.763" end="03:11.914">はたまた</span><span begin="03:11.914" end="03:13.143">神の</span> <span begin="03:14.279" end="03:15.270">いつもの</span><span begin="03:15.270" end="03:16.644">気まぐれ</span><span ttm:role="x-translation" xml:lang="zh-Hans">又或许是神明的一时兴起</span></p><p begin="03:17.622" end="03:23.221" ttm:agent="v1" itunes:key="L22"><span begin="03:17.622" end="03:18.208">選び</span><span begin="03:18.208" end="03:19.235">選ばれ</span><span begin="03:19.235" end="03:20.080">た</span> <span begin="03:20.995" end="03:22.022">脱げられぬ</span><span begin="03:22.022" end="03:23.221">鎧</span><span ttm:role="x-translation" xml:lang="zh-Hans">选择与被选择 脱不掉的铠甲</span></p><p begin="03:24.275" end="03:30.107" ttm:agent="v1" itunes:key="L23"><span begin="03:24.275" end="03:25.316">もしくは</span><span begin="03:25.316" end="03:26.580">遥かな</span> <span begin="03:27.756" end="03:28.378">揺らぐ</span><span begin="03:28.378" end="03:29.223">ことない</span><span begin="03:29.223" end="03:30.107">意志</span><span ttm:role="x-translation" xml:lang="zh-Hans">又或者是</span></p><p begin="03:31.078" end="03:37.011" ttm:agent="v1" itunes:key="L24"><span begin="03:31.078" end="03:32.004">果たさぬ</span><span begin="03:32.004" end="03:32.682">願い</span><span begin="03:32.682" end="03:33.562">と</span> <span begin="03:34.509" end="03:35.358">叶わぬ</span><span begin="03:35.358" end="03:36.520">再会</span><span begin="03:36.520" end="03:37.011">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法实现的心愿 无法兑现的再会</span></p><p begin="03:37.822" end="03:43.702" ttm:agent="v1" itunes:key="L25"><span begin="03:37.822" end="03:38.782">ほどけぬ</span><span begin="03:38.782" end="03:39.553">誤解</span><span begin="03:39.553" end="03:40.282">と</span> <span begin="03:41.291" end="03:42.338">降り積もる</span><span begin="03:42.338" end="03:42.904">憎悪</span><span begin="03:42.904" end="03:43.702">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法消弭的误解 不断累积的憎恶</span></p><p begin="03:44.625" end="03:50.393" ttm:agent="v1" itunes:key="L26"><span begin="03:44.625" end="03:46.312">許し合う声</span><span begin="03:46.312" end="03:47.028">と</span> <span begin="03:48.020" end="03:49.577">握りしめ合う</span><span begin="03:49.577" end="03:50.393">手を</span><span ttm:role="x-translation" xml:lang="zh-Hans">相互谅解的声音 相互紧握的双手</span></p><p begin="03:51.372" end="03:57.073" ttm:agent="v1" itunes:key="L27"><span begin="03:51.372" end="03:52.475">この星は</span><span begin="03:52.475" end="03:53.648">今日も</span> <span begin="03:54.701" end="03:55.932">抱えて</span><span begin="03:55.932" end="03:57.073">生きてる</span><span ttm:role="x-translation" xml:lang="zh-Hans">这颗星球今天仍旧拥抱着这一切 坦然生存</span></p><p begin="03:57.878" end="04:04.292" ttm:agent="v1" itunes:key="L28"><span begin="03:57.878" end="03:58.943">愛に</span><span begin="03:58.943" end="04:00.114">できる</span><span begin="04:00.462" end="04:01.565">ことは</span><span begin="04:01.565" end="04:02.463">まだ</span><span begin="04:02.463" end="04:03.196">ある</span><span begin="04:03.196" end="04:04.292">かい？</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有什么</span></p><p begin="04:04.672" end="04:12.482" ttm:agent="v1" itunes:key="L29"><span begin="04:04.672" end="04:05.880">僕に</span><span begin="04:05.880" end="04:06.893">できる</span><span begin="04:07.168" end="04:08.283">ことは</span><span begin="04:08.283" end="04:09.199">まだ</span><span begin="04:09.199" end="04:09.988">ある</span><span begin="04:09.988" end="04:12.482">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的还有什么</span></p><p begin="04:17.328" end="04:29.417" ttm:agent="v1" itunes:key="L30"><span begin="04:17.328" end="04:18.453">君が</span><span begin="04:18.453" end="04:19.599">くれた</span><span begin="04:19.884" end="04:20.946">勇気</span><span begin="04:20.946" end="04:21.753">だか</span><span begin="04:21.753" end="04:23.073">ら</span> <span begin="04:24.120" end="04:25.146">君の</span><span begin="04:25.146" end="04:26.289">ために</span><span begin="04:26.596" end="04:27.731">使い</span><span begin="04:27.731" end="04:28.540">たいん</span><span begin="04:28.540" end="04:29.417">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">是你曾给予我勇气</span></p><p begin="04:30.876" end="04:43.147" ttm:agent="v1" itunes:key="L31"><span begin="04:30.876" end="04:31.987">君と</span><span begin="04:31.987" end="04:33.111">育て</span><span begin="04:33.345" end="04:33.694">た</span><span begin="04:33.694" end="04:34.557">愛</span><span begin="04:34.557" end="04:35.325">だか</span><span begin="04:35.325" end="04:36.446">ら</span> <span begin="04:37.745" end="04:38.772">君と</span><span begin="04:38.772" end="04:39.941">じゃなきゃ</span><span begin="04:40.221" end="04:41.250">意味が</span><span begin="04:41.250" end="04:42.037">ないん</span><span begin="04:42.037" end="04:43.147">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">是只属于你和我的爱</span></p><p begin="04:43.526" end="04:50.012" ttm:agent="v1" itunes:key="L32"><span begin="04:43.526" end="04:44.702">愛に</span><span begin="04:44.702" end="04:45.967">できる</span><span begin="04:46.151" end="04:47.234">ことは</span><span begin="04:47.234" end="04:48.170">まだ</span><span begin="04:48.170" end="04:48.953">ある</span><span begin="04:48.953" end="04:50.012">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有什么</span></p><p begin="04:50.326" end="04:57.563" ttm:agent="v1" itunes:key="L33"><span begin="04:50.326" end="04:51.534">僕に</span><span begin="04:51.534" end="04:52.547">できる</span><span begin="04:52.822" end="04:53.937">ことは</span><span begin="04:53.937" end="04:54.853">まだ</span><span begin="04:54.853" end="04:55.642">ある</span><span begin="04:55.642" end="04:57.563">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的还有什么</span></p><p begin="04:57.923" end="05:03.025" ttm:agent="v1" itunes:key="L34"><span begin="04:57.923" end="04:59.025">何もない</span><span begin="04:59.025" end="05:00.108">僕たちに</span> <span begin="05:00.444" end="05:00.988">なぜ</span><span begin="05:00.988" end="05:01.665">夢を</span><span begin="05:01.665" end="05:02.381">見させた</span><span begin="05:02.381" end="05:03.025">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">为何要让一无所有的我们</span></p><p begin="05:04.673" end="05:10.000" ttm:agent="v1" itunes:key="L35"><span begin="05:04.673" end="05:05.778">終わりある</span><span begin="05:05.778" end="05:06.990">人生に</span> <span begin="05:07.224" end="05:07.702">なぜ</span><span begin="05:07.702" end="05:08.327">希望を</span><span begin="05:08.327" end="05:09.116">持たせた</span><span begin="05:09.116" end="05:10.000">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">为何要让我们对有限的人生</span></p><p begin="05:11.279" end="05:16.572" ttm:agent="v1" itunes:key="L36"><span begin="05:11.279" end="05:11.635">なぜ</span><span begin="05:11.635" end="05:12.499">この手を</span><span begin="05:12.499" end="05:13.653">すり抜ける</span> <span begin="05:14.020" end="05:15.064">ものばかり</span><span begin="05:15.064" end="05:15.871">与えた</span><span begin="05:15.871" end="05:16.572">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">为何给予我们的一切</span></p><p begin="05:17.977" end="05:23.218" ttm:agent="v1" itunes:key="L37"><span begin="05:17.977" end="05:18.924">それでも</span><span begin="05:18.924" end="05:19.329">なお</span><span begin="05:19.329" end="05:20.409">しがみつく</span> <span begin="05:20.740" end="05:21.658">僕らは</span><span begin="05:21.790" end="05:22.518">醜い</span><span begin="05:22.518" end="05:23.218">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使如此依旧用力想要抓住的我们</span></p><p begin="05:23.923" end="05:26.898" ttm:agent="v1" itunes:key="L38"><span begin="05:23.923" end="05:24.958">それとも、</span><span begin="05:25.344" end="05:25.978">きれい</span><span begin="05:25.978" end="05:26.898">かい</span><span ttm:role="x-translation" xml:lang="zh-Hans">还是说十分美丽呢 回答我啊</span></p><p begin="05:28.529" end="05:29.970" ttm:agent="v1" itunes:key="L39"><span begin="05:28.529" end="05:29.465">答えて</span><span begin="05:29.465" end="05:29.970">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">回答我！</span></p><p begin="05:54.975" end="06:07.487" ttm:agent="v1" itunes:key="L40"><span begin="05:54.975" end="05:56.649">愛の歌</span><span begin="05:56.649" end="05:57.276">も</span> <span begin="05:58.250" end="05:59.203">歌われ</span><span begin="05:59.203" end="06:00.485">尽くした</span> <span begin="06:01.658" end="06:02.736">数多の</span><span begin="06:02.736" end="06:03.328">映画</span><span begin="06:03.328" end="06:03.879">で</span> <span begin="06:04.828" end="06:05.841">語られ</span><span begin="06:05.841" end="06:06.648">尽くし</span><span begin="06:06.648" end="06:07.487">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱的颂歌已经唱尽了</span></p><p begin="06:08.464" end="06:19.329" ttm:agent="v1" itunes:key="L41"><span begin="06:08.464" end="06:09.354">そんな</span><span begin="06:09.354" end="06:10.692">荒野に</span> <span begin="06:11.680" end="06:13.297">生まれ落ちた</span><span begin="06:13.297" end="06:13.982">僕、</span><span begin="06:14.896" end="06:15.706">君</span> <span begin="06:16.458" end="06:17.465">それ</span><span begin="06:18.192" end="06:19.329">でも</span><span ttm:role="x-translation" xml:lang="zh-Hans">降生在这样荒野中的我和你</span></p><p begin="06:21.575" end="06:27.862" ttm:agent="v1" itunes:key="L42"><span begin="06:21.575" end="06:22.770">愛に</span><span begin="06:22.770" end="06:23.884">できる</span><span begin="06:24.153" end="06:25.186">ことは</span><span begin="06:25.186" end="06:26.031">まだ</span><span begin="06:26.031" end="06:26.992">ある</span><span begin="06:26.992" end="06:27.862">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱能做到的还有很多</span></p><p begin="06:28.374" end="06:36.101" ttm:agent="v1" itunes:key="L43"><span begin="06:28.374" end="06:29.470">僕に</span><span begin="06:29.470" end="06:30.647">できる</span><span begin="06:30.865" end="06:31.960">ことは</span><span begin="06:31.960" end="06:32.994">まだ</span><span begin="06:32.994" end="06:33.849">ある</span><span begin="06:33.849" end="06:36.101">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我能做到的还有很多</span></p></div></body></tt>