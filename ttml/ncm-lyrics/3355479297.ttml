an><span begin="02:42.200" end="02:43.097">yondei</span><span begin="02:43.097" end="02:44.171">ru</span></text><text for="L32"><span begin="02:44.331" end="02:45.095">kigiga</span><span begin="02:45.095" end="02:45.828">watashi</span><span begin="02:45.828" end="02:46.160">wo</span><span begin="02:46.160" end="02:47.096">yondei</span><span begin="02:47.096" end="02:48.264">ru</span></text><text for="L33"><span begin="02:48.363" end="02:49.337">kazashimo</span><span begin="02:49.337" end="02:50.071">karari</span><span begin="02:50.071" end="02:51.537">seiten</span></text><text for="L34"><span begin="02:51.592" end="02:51.813">me</span><span begin="02:51.813" end="02:53.595">maibare</span><span begin="02:53.595" end="02:54.819">shiro</span><span begin="02:55.631" end="02:55.904">i</span><span begin="02:55.904" end="02:56.622">ranno</span><span begin="02:56.622" end="02:57.710">tsuki</span></text><text for="L35"><span begin="03:16.308" end="03:16.831">kaze</span><span begin="03:16.831" end="03:18.222">woanataga</span><span begin="03:18.222" end="03:19.102">yondei</span><span begin="03:19.102" end="03:20.173">ru</span></text><text for="L36"><span begin="03:20.352" end="03:21.109">watashi</span><span begin="03:21.109" end="03:21.347">no</span><span begin="03:21.347" end="03:22.227">kazewo</span><span begin="03:22.227" end="03:23.107">yondei</span><span begin="03:23.107" end="03:24.292">ru</span></text><text for="L37"><span begin="03:24.340" end="03:26.121">fuzaketahareno</span><span begin="03:26.121" end="03:27.517">enten</span></text><text for="L38"><span begin="03:27.616" end="03:28.599">ikou</span><span begin="03:28.599" end="03:29.588">wata</span><span begin="03:29.588" end="03:29.846">shi</span><span begin="03:29.846" end="03:30.359">wayo</span><span begin="03:30.359" end="03:31.352">iniyo't</span><span begin="03:31.352" end="03:31.609">ta</span><span begin="03:31.609" end="03:32.282">furi</span></text><text for="L39"><span begin="03:32.371" end="03:33.093">watashi</span><span begin="03:33.093" end="03:33.331">ga</span><span begin="03:33.331" end="03:33.858">kaze</span><span begin="03:33.858" end="03:34.214">wo</span><span begin="03:34.214" end="03:35.111">yondei</span><span begin="03:35.111" end="03:36.128">ru</span></text><text for="L40"><span begin="03:36.368" end="03:37.078">kigiyo</span><span begin="03:37.078" end="03:37.609">sake</span><span begin="03:37.609" end="03:38.195">beto</span><span begin="03:38.195" end="03:39.096">yondei</span><span begin="03:39.096" end="03:40.246">ru</span></text><text for="L41"><span begin="03:40.349" end="03:41.355">kazashimo</span><span begin="03:41.355" end="03:42.144">karari</span><span begin="03:42.144" end="03:43.529">enten</span></text><text for="L42"><span begin="03:43.609" end="03:43.835">me</span><span begin="03:43.835" end="03:45.643">maibare</span><span begin="03:45.643" end="03:46.716">usu</span><span begin="03:47.632" end="03:47.872">i</span><span begin="03:47.872" end="03:48.421">kyou</span><span begin="03:48.421" end="03:48.658">no</span><span begin="03:48.658" end="03:49.782">tsuki</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="04:12.116"><div begin="00:18.345" end="03:49.782"><p begin="00:18.345" end="00:21.638" ttm:agent="v1" itunes:key="L1"><span begin="00:18.345" end="00:18.827">風</span><span begin="00:18.827" end="00:20.236">がおもてで呼</span><span begin="00:20.236" end="00:20.601">ん</span><span begin="00:20.601" end="00:21.137">でい</span><span begin="00:21.137" end="00:21.638">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">风在外面呼唤</span></p><p begin="00:21.638" end="00:22.976" ttm:agent="v1" itunes:key="L2"><span begin="00:21.638" end="00:21.764">呼</span><span begin="00:21.764" end="00:22.113">ん</span><span begin="00:22.113" end="00:22.976">でいる</span><span ttm:role="x-translation" xml:lang="zh-Hans">呼唤着我</span></p><p begin="00:23.046" end="00:26.048" ttm:agent="v1" itunes:key="L3"><span begin="00:23.046" end="00:24.329">さぁ行こう</span><span begin="00:24.329" end="00:25.641">海を脱い</span><span begin="00:25.641" end="00:26.048">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 将海的气息褪去</span></p><p begin="00:26.368" end="00:30.240" ttm:agent="v1" itunes:key="L4"><span begin="00:26.368" end="00:27.350">あなたと</span><span begin="00:27.350" end="00:28.144">私</span> <span begin="00:28.144" end="00:28.580">ちょう</span><span begin="00:28.580" end="00:28.820">ど</span><span begin="00:28.820" end="00:29.331">いい</span><span begin="00:29.331" end="00:30.240">昼間</span><span ttm:role="x-translation" xml:lang="zh-Hans">你与我 适逢恰如其分的日间时光</span></p><p begin="00:34.352" end="00:37.648" ttm:agent="v1" itunes:key="L5"><span begin="00:34.352" end="00:34.804">風</span><span begin="00:34.804" end="00:36.253">がおもてで呼</span><span begin="00:36.253" end="00:36.582">ん</span><span begin="00:36.582" end="00:37.078">でい</span><span begin="00:37.078" end="00:37.648">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">风在外面呼唤</span></p><p begin="00:37.648" end="00:38.886" ttm:agent="v1" itunes:key="L6"><span begin="00:37.648" end="00:38.886">飛んでいる</span><span ttm:role="x-translation" xml:lang="zh-Hans">欣喜雀跃</span></p><p begin="00:39.120" end="00:42.237" ttm:agent="v1" itunes:key="L7"><span begin="00:39.120" end="00:40.367">三時半</span> <span begin="00:40.367" end="00:41.587">腕を振っ</span><span begin="00:41.587" end="00:42.237">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">三点半 挥舞双手</span></p><p begin="00:42.314" end="00:45.840" ttm:agent="v1" itunes:key="L8"><span begin="00:42.314" end="00:43.896">千鳥足の</span><span begin="00:43.896" end="00:44.629">私</span> <span begin="00:44.629" end="00:45.840">不確かに</span><span ttm:role="x-translation" xml:lang="zh-Hans">脚步踉跄的我 迷迷糊糊</span></p><p begin="00:45.840" end="00:48.400" ttm:agent="v1" itunes:key="L9"><span begin="00:45.840" end="00:46.729">今日も</span><span begin="00:46.884" end="00:47.618">回り</span><span begin="00:47.618" end="00:48.400">道</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也绕了个远路</span></p><p begin="00:50.313" end="00:55.586" ttm:agent="v1" itunes:key="L10"><span begin="00:50.313" end="00:51.073">たぶん</span><span begin="00:51.073" end="00:51.826">私</span><span begin="00:51.826" end="00:53.129">は生きてい</span><span begin="00:53.129" end="00:55.586">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">或许 我切实地活着</span></p><p begin="00:56.310" end="01:00.233" ttm:agent="v1" itunes:key="L11"><span begin="00:56.310" end="00:57.094">風が</span><span begin="00:57.094" end="00:57.789">私</span><span begin="00:57.789" end="00:58.215">を呼</span><span begin="00:58.215" end="00:59.074">んでい</span><span begin="00:59.074" end="01:00.233">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">风在呼唤我</span></p><p begin="01:00.335" end="01:04.262" ttm:agent="v1" itunes:key="L12"><span begin="01:00.335" end="01:01.104">鳥が</span><span begin="01:01.104" end="01:01.817">私</span><span begin="01:01.817" end="01:02.272">を呼</span><span begin="01:02.272" end="01:03.084">んでい</span><span begin="01:03.084" end="01:04.262">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">鸟在呼唤我</span></p><p begin="01:04.322" end="01:07.487" ttm:agent="v1" itunes:key="L13"><span begin="01:04.322" end="01:06.129">ふざけた晴れの</span><span begin="01:06.129" end="01:07.487">炎天</span><span ttm:role="x-translation" xml:lang="zh-Hans">烈日当空 响晴得不真实</span></p><p begin="01:07.554" end="01:12.236" ttm:agent="v1" itunes:key="L14"><span begin="01:07.554" end="01:07.907">た</span><span begin="01:07.907" end="01:08.426">だ</span><span begin="01:08.587" end="01:09.607">私</span><span begin="01:09.607" end="01:09.827">は</span><span begin="01:09.827" end="01:10.375">酔</span><span begin="01:10.375" end="01:11.318">いに酔っ</span><span begin="01:11.318" end="01:11.898">た振</span><span begin="01:11.898" end="01:12.236">り</span><span ttm:role="x-translation" xml:lang="zh-Hans">而我却假装早已沉醉</span></p><p begin="01:12.357" end="01:16.210" ttm:agent="v1" itunes:key="L15"><span begin="01:12.357" end="01:13.117">雲が</span><span begin="01:13.117" end="01:13.833">私</span><span begin="01:13.833" end="01:14.249">を呼</span><span begin="01:14.249" end="01:15.132">んでい</span><span begin="01:15.132" end="01:16.210">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">云在呼唤我</span></p><p begin="01:16.348" end="01:20.245" ttm:agent="v1" itunes:key="L16"><span begin="01:16.348" end="01:17.117">木々が</span><span begin="01:17.117" end="01:17.815">私</span><span begin="01:17.815" end="01:18.181">を呼</span><span begin="01:18.181" end="01:19.117">んでい</span><span begin="01:19.117" end="01:20.245">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">树木在呼唤我</span></p><p begin="01:20.366" end="01:23.500" ttm:agent="v1" itunes:key="L17"><span begin="01:20.366" end="01:21.349">風下</span><span begin="01:21.349" end="01:22.120">からり</span><span begin="01:22.120" end="01:23.500">炎天</span><span ttm:role="x-translation" xml:lang="zh-Hans">风拂过处 朗朗艳阳高悬</span></p><p begin="01:23.567" end="01:29.702" ttm:agent="v1" itunes:key="L18"><span begin="01:23.567" end="01:23.834">目</span><span begin="01:23.834" end="01:25.592">眩晴れ</span> <span begin="01:25.592" end="01:26.714">薄</span><span begin="01:27.645" end="01:27.865">い</span><span begin="01:27.865" end="01:28.343">今日</span><span begin="01:28.343" end="01:28.636">の</span><span begin="01:28.636" end="01:29.702">月</span><span ttm:role="x-translation" xml:lang="zh-Hans">晴空刺得目眩 今日月色却淡薄</span></p><p begin="01:46.332" end="01:49.628" ttm:agent="v1" itunes:key="L19"><span begin="01:46.332" end="01:47.309">すすきの</span><span begin="01:47.309" end="01:47.863">中</span><span begin="01:47.863" end="01:49.125">に立ってい</span><span begin="01:49.125" end="01:49.628">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">伫立于芒草丛中</span></p><p begin="01:49.628" end="01:54.104" ttm:agent="v1" itunes:key="L20"><span begin="01:49.628" end="01:50.898">ふいに吹く</span><span begin="01:51.136" end="01:52.365">青風</span> <span begin="01:52.365" end="01:53.127">雲の</span><span begin="01:53.127" end="01:54.104">稜線</span><span ttm:role="x-translation" xml:lang="zh-Hans">清风不经意吹过 层云明暗分明</span></p><p begin="01:54.331" end="01:58.865" ttm:agent="v1" itunes:key="L21"><span begin="01:54.331" end="01:55.144">私</span><span begin="01:55.144" end="01:57.602">このまま死んでしまい</span><span begin="01:57.602" end="01:58.385">そうだ</span><span begin="01:58.385" end="01:58.865">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">我似乎会就这样迎来终结呢</span></p><p begin="02:02.315" end="02:05.630" ttm:agent="v1" itunes:key="L22"><span begin="02:02.315" end="02:02.820">風</span><span begin="02:02.820" end="02:04.251">がおもてで呼</span><span begin="02:04.251" end="02:04.615">ん</span><span begin="02:04.615" end="02:05.114">でい</span><span begin="02:05.114" end="02:05.630">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">风在外面呼唤</span></p><p begin="02:05.630" end="02:06.876" ttm:agent="v1" itunes:key="L23"><span begin="02:05.630" end="02:06.876">泣いている</span><span ttm:role="x-translation" xml:lang="zh-Hans">似在哭泣</span></p><p begin="02:07.079" end="02:10.137" ttm:agent="v1" itunes:key="L24"><span begin="02:07.079" end="02:08.364">さぁ行こう</span><span begin="02:08.364" end="02:09.610">東風を脱い</span><span begin="02:09.610" end="02:10.137">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 挣脱春风的束缚</span></p><p begin="02:10.299" end="02:16.430" ttm:agent="v1" itunes:key="L25"><span begin="02:10.299" end="02:12.576">千鳥足の二人</span> <span begin="02:12.576" end="02:12.889">俯</span><span begin="02:12.889" end="02:14.630">瞰一面の</span><span begin="02:14.870" end="02:16.430">花吹雪</span><span ttm:role="x-translation" xml:lang="zh-Hans">你我脚步踉跄 俯瞰漫天落花纷扬似雪</span></p><p begin="02:18.344" end="02:23.483" ttm:agent="v1" itunes:key="L26"><span begin="02:18.344" end="02:18.541">た</span><span begin="02:18.541" end="02:21.160">ぶんあなたも生きてい</span><span begin="02:21.160" end="02:23.483">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">或许 你也切实地活着</span></p><p begin="02:24.315" end="02:28.187" ttm:agent="v1" itunes:key="L27"><span begin="02:24.315" end="02:25.122">風が</span><span begin="02:25.122" end="02:25.855">私</span><span begin="02:25.855" end="02:26.186">を呼</span><span begin="02:26.186" end="02:27.084">んでい</span><span begin="02:27.084" end="02:28.187">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">风在呼唤我</span></p><p begin="02:28.366" end="02:32.280" ttm:agent="v1" itunes:key="L28"><span begin="02:28.366" end="02:29.082">晴れも</span><span begin="02:29.082" end="02:29.833">私</span><span begin="02:29.833" end="02:30.238">を呼</span><span begin="02:30.238" end="02:31.118">んでい</span><span begin="02:31.118" end="02:32.280">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">晴空也在呼唤我</span></p><p begin="02:32.379" end="02:36.449" ttm:agent="v1" itunes:key="L29"><span begin="02:32.379" end="02:33.354">ふざけた</span><span begin="02:33.354" end="02:33.843">雨</span><span begin="02:33.843" end="02:34.119">の</span><span begin="02:34.119" end="02:35.456">曇天</span><span begin="02:35.603" end="02:35.841">で</span><span begin="02:35.841" end="02:36.449">さえ</span><span ttm:role="x-translation" xml:lang="zh-Hans">就连暴雨倾盆的荒唐阴天</span></p><p begin="02:36.571" end="02:40.264" ttm:agent="v1" itunes:key="L30"><span begin="02:36.571" end="02:37.624">私</span><span begin="02:37.624" end="02:37.841">は</span><span begin="02:37.841" end="02:38.445">酔</span><span begin="02:38.445" end="02:39.328">いに酔っ</span><span begin="02:39.328" end="02:39.877">た振</span><span begin="02:39.877" end="02:40.264">り</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也假装早已沉醉</span></p><p begin="02:40.360" end="02:44.171" ttm:agent="v1" itunes:key="L31"><span begin="02:40.360" end="02:41.100">雲が</span><span begin="02:41.100" end="02:41.833">私</span><span begin="02:41.833" end="02:42.200">を呼</span><span begin="02:42.200" end="02:43.097">んでい</span><span begin="02:43.097" end="02:44.171">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">云在呼唤我</span></p><p begin="02:44.331" end="02:48.264" ttm:agent="v1" itunes:key="L32"><span begin="02:44.331" end="02:45.095">木々が</span><span begin="02:45.095" end="02:45.828">私</span><span begin="02:45.828" end="02:46.160">を呼</span><span begin="02:46.160" end="02:47.096">んでい</span><span begin="02:47.096" end="02:48.264">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">树木在呼唤我</span></p><p begin="02:48.363" end="02:51.537" ttm:agent="v1" itunes:key="L33"><span begin="02:48.363" end="02:49.337">風下</span><span begin="02:49.337" end="02:50.071">からり</span><span begin="02:50.071" end="02:51.537">晴天</span><span ttm:role="x-translation" xml:lang="zh-Hans">风拂过处 朗朗晴空万里</span></p><p begin="02:51.592" end="02:57.710" ttm:agent="v1" itunes:key="L34"><span begin="02:51.592" end="02:51.813">目</span><span begin="02:51.813" end="02:53.595">眩晴れ</span> <span begin="02:53.595" end="02:54.819">白</span><span begin="02:55.631" end="02:55.904">い</span><span begin="02:55.904" end="02:56.622">蘭の</span><span begin="02:56.622" end="02:57.710">月</span><span ttm:role="x-translation" xml:lang="zh-Hans">晴空刺得目眩 月色却皎似幽兰</span></p><p begin="03:16.308" end="03:20.173" ttm:agent="v1" itunes:key="L35"><span begin="03:16.308" end="03:16.831">風</span><span begin="03:16.831" end="03:18.222">をあなたが呼</span><span begin="03:18.222" end="03:19.102">んでい</span><span begin="03:19.102" end="03:20.173">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">你在呼唤风</span></p><p begin="03:20.352" end="03:24.292" ttm:agent="v1" itunes:key="L36"><span begin="03:20.352" end="03:21.109">私</span><span begin="03:21.109" end="03:21.347">の</span><span begin="03:21.347" end="03:22.227">風を呼</span><span begin="03:22.227" end="03:23.107">んでい</span><span begin="03:23.107" end="03:24.292">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">呼唤我的风</span></p><p begin="03:24.340" end="03:27.517" ttm:agent="v1" itunes:key="L37"><span begin="03:24.340" end="03:26.121">ふざけた晴れの</span><span begin="03:26.121" end="03:27.517">炎天</span><span ttm:role="x-tran