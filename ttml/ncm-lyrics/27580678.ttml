d="04:43.140"><p begin="00:27.219" end="00:30.622" ttm:agent="v1" itunes:key="L1"><span begin="00:27.219" end="00:27.918">御伽話(フェア</span><span begin="00:27.918" end="00:28.668">リー</span><span begin="00:28.668" end="00:29.164">テイル)</span><span begin="00:29.164" end="00:30.622">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">耳熟能详的童话故事</span></p><p begin="00:32.632" end="00:36.352" ttm:agent="v1" itunes:key="L2"><span begin="00:32.632" end="00:33.016">さっ</span><span begin="00:33.016" end="00:33.462">き</span><span begin="00:33.462" end="00:34.216">死ん</span><span begin="00:34.216" end="00:34.595">だ</span><span begin="00:34.595" end="00:35.009">み</span><span begin="00:35.009" end="00:35.895">た</span><span begin="00:35.895" end="00:36.352">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">刚才似乎已经死去</span></p><p begin="00:37.886" end="00:46.654" ttm:agent="v1" itunes:key="L3"><span begin="00:37.886" end="00:38.786">煉瓦</span><span begin="00:38.786" end="00:39.365">の</span><span begin="00:39.365" end="00:39.729">病</span><span begin="00:39.729" end="00:39.970">棟</span><span begin="00:39.970" end="00:41.759">で</span><span begin="00:43.409" end="00:44.208">うまく</span><span begin="00:44.208" end="00:44.882">歌</span><span begin="00:44.882" end="00:45.163">え</span><span begin="00:45.163" end="00:45.518">なく</span><span begin="00:45.518" end="00:46.654">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">砖墙林立 病房让人如何歌唱</span></p><p begin="00:48.622" end="00:57.491" ttm:agent="v1" itunes:key="L4"><span begin="00:48.622" end="00:49.321">霧</span><span begin="00:49.321" end="00:49.854">に</span><span begin="00:49.854" end="00:50.266">煙</span><span begin="00:50.266" end="00:50.570">る</span><span begin="00:50.570" end="00:51.904">夜</span> <span begin="00:53.954" end="00:54.932">浮かべ</span><span begin="00:54.932" end="00:55.488">赤</span><span begin="00:55.488" end="00:55.775">い</span><span begin="00:55.775" end="00:57.491">月</span><span ttm:role="x-translation" xml:lang="zh-Hans">雾色蒙蒙 夜空泛起一轮红月</span></p><p begin="00:59.309" end="01:03.389" ttm:agent="v1" itunes:key="L5"><span begin="00:59.309" end="00:59.993">ほら</span><span begin="00:59.993" end="01:00.301">み</span><span begin="01:00.301" end="01:00.850">て</span> <span begin="01:00.850" end="01:01.513">私</span><span begin="01:01.513" end="01:03.389">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">看清楚我</span></p><p begin="01:04.646" end="01:08.290" ttm:agent="v1" itunes:key="L6"><span begin="01:04.646" end="01:05.254">目を</span><span begin="01:05.254" end="01:05.921">逸ら</span><span begin="01:05.921" end="01:06.244">さ</span><span begin="01:06.244" end="01:06.810">ない</span><span begin="01:06.810" end="01:08.290">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">请你别再目光闪躲</span></p><p begin="01:10.705" end="01:13.258" ttm:agent="v1" itunes:key="L7"><span begin="01:10.705" end="01:11.045">黒</span><span begin="01:11.045" end="01:11.196">い</span><span begin="01:11.196" end="01:12.010">鉄</span><span begin="01:12.010" end="01:12.427">格子</span><span begin="01:12.427" end="01:12.648">の</span><span begin="01:12.648" end="01:13.035">中</span><span begin="01:13.035" end="01:13.258">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这漆黑的铁窗中</span></p><p begin="01:13.268" end="01:15.952" ttm:agent="v1" itunes:key="L8"><span begin="01:13.268" end="01:14.083">私</span><span begin="01:14.083" end="01:14.654">は</span><span begin="01:14.654" end="01:14.925">生ま</span><span begin="01:14.925" end="01:15.175">れて</span><span begin="01:15.175" end="01:15.464">きた</span><span begin="01:15.464" end="01:15.952">んだ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我正是诞生于此地</span></p><p begin="01:15.962" end="01:18.326" ttm:agent="v1" itunes:key="L9"><span begin="01:15.962" end="01:16.792">悪意</span><span begin="01:16.792" end="01:16.949">の</span><span begin="01:16.949" end="01:17.463">代償</span><span begin="01:17.463" end="01:17.856">を</span><span begin="01:17.856" end="01:18.012">願</span><span begin="01:18.012" end="01:18.326">え</span><span ttm:role="x-translation" xml:lang="zh-Hans">若你祈求恶有恶报</span></p><p begin="01:18.336" end="01:21.399" ttm:agent="v1" itunes:key="L10"><span begin="01:18.336" end="01:18.752">望</span><span begin="01:18.752" end="01:19.053">む</span><span begin="01:19.053" end="01:19.282">が</span><span begin="01:19.282" end="01:19.657">まま</span><span begin="01:19.657" end="01:19.945">に</span><span begin="01:19.945" end="01:20.112">お</span><span begin="01:20.112" end="01:20.793">前</span><span begin="01:20.793" end="01:21.399">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">我便让你得偿所愿</span></p><p begin="01:21.409" end="01:23.891" ttm:agent="v1" itunes:key="L11"><span begin="01:21.409" end="01:21.932">さあ</span><span begin="01:21.932" end="01:22.547">与</span><span begin="01:22.547" end="01:22.763">え</span><span begin="01:22.763" end="01:23.140">よう</span><span begin="01:23.140" end="01:23.599">正義</span><span begin="01:23.599" end="01:23.891">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿赐予你正义之名</span></p><p begin="01:23.901" end="01:26.711" ttm:agent="v1" itunes:key="L12"><span begin="01:23.901" end="01:24.492">壊</span><span begin="01:24.492" end="01:24.803">し</span><span begin="01:24.803" end="01:25.303">て</span> <span begin="01:25.306" end="01:25.570">壊</span><span begin="01:25.570" end="01:26.022">される</span><span begin="01:26.022" end="01:26.356">前</span><span begin="01:26.356" end="01:26.711">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在毁灭或被灭之前</span></p><p begin="01:26.721" end="01:28.890" ttm:agent="v1" itunes:key="L13"><span begin="01:26.721" end="01:27.206">因</span><span begin="01:27.206" end="01:27.606">果の</span><span begin="01:27.606" end="01:28.381">代償を</span><span begin="01:28.381" end="01:28.574">払</span><span begin="01:28.574" end="01:28.890">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">先偿还因果的代价</span></p><p begin="01:28.900" end="01:36.518" ttm:agent="v1" itunes:key="L14"><span begin="01:28.900" end="01:29.510">共</span><span begin="01:29.510" end="01:29.768">に</span><span begin="01:29.768" end="01:30.467">行こう</span> <span begin="01:30.467" end="01:30.914">名前</span><span begin="01:30.914" end="01:31.279">の</span><span begin="01:31.279" end="01:31.713">ない</span><span begin="01:31.713" end="01:34.740">怪</span><span begin="01:34.740" end="01:36.518">物</span><span ttm:role="x-translation" xml:lang="zh-Hans">一同前行吧 无名的怪物</span></p><p begin="01:47.310" end="01:50.874" ttm:agent="v1" itunes:key="L15"><span begin="01:47.310" end="01:47.844">耳</span><span begin="01:47.844" end="01:48.758">鳴り</span><span begin="01:48.758" end="01:48.972">が</span><span begin="01:48.972" end="01:49.359">して</span><span begin="01:49.359" end="01:50.874">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">耳鸣不已</span></p><p begin="01:52.533" end="01:56.237" ttm:agent="v1" itunes:key="L16"><span begin="01:52.533" end="01:53.367">鉄条</span><span begin="01:53.367" end="01:53.969">網</span><span begin="01:53.969" end="01:54.500">うるさ</span><span begin="01:54.500" end="01:54.839">くっ</span><span begin="01:54.839" end="01:56.237">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">那是铁丝网的噪音</span></p><p begin="01:58.011" end="02:07.840" ttm:agent="v1" itunes:key="L17"><span begin="01:58.011" end="01:58.333">思</span><span begin="01:58.333" end="01:58.627">い</span><span begin="01:58.627" end="01:59.909">出せない</span><span begin="01:59.909" end="02:01.394">の</span> <span begin="02:03.331" end="02:03.907">あの</span><span begin="02:03.907" end="02:04.758">日の</span><span begin="02:04.758" end="02:05.043">旋</span><span begin="02:05.043" end="02:07.840">律</span><span ttm:role="x-translation" xml:lang="zh-Hans">回想不起</span></p><p begin="02:08.665" end="02:11.880" ttm:agent="v1" itunes:key="L18"><span begin="02:08.665" end="02:09.155">雨</span><span begin="02:09.155" end="02:09.583">は</span><span begin="02:09.583" end="02:09.971">ま</span><span begin="02:09.971" end="02:10.269">だ</span><span begin="02:10.269" end="02:10.750">止ま</span><span begin="02:10.750" end="02:11.497">な</span><span begin="02:11.497" end="02:11.880">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨仍未停</span></p><p begin="02:13.939" end="02:17.501" ttm:agent="v1" itunes:key="L19"><span begin="02:13.939" end="02:14.635">何</span><span begin="02:14.635" end="02:15.551">にも</span><span begin="02:15.551" end="02:16.053">見えない</span><span begin="02:16.053" end="02:17.501">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">让人什么也看不清</span></p><p begin="02:19.292" end="02:28.739" ttm:agent="v1" itunes:key="L20"><span begin="02:19.292" end="02:19.804">ほら</span><span begin="02:19.804" end="02:20.731">みて</span> <span begin="02:20.731" end="02:21.446">こんな</span><span begin="02:21.446" end="02:22.907">に</span><span begin="02:24.930" end="02:25.229">大</span><span begin="02:25.229" end="02:25.962">きく</span><span begin="02:25.962" end="02:26.753">なった</span><span begin="02:26.753" end="02:28.739">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">你快看我 已然成为庞然大物</span></p><p begin="02:30.649" end="02:33.271" ttm:agent="v1" itunes:key="L21"><span begin="02:30.649" end="02:31.034">黒</span><span begin="02:31.034" end="02:31.253">い</span><span begin="02:31.253" end="02:31.908">雨</span> <span begin="02:31.908" end="02:32.531">降らせ</span><span begin="02:32.531" end="02:32.865">この</span><span begin="02:32.865" end="02:33.271">空</span><span ttm:role="x-translation" xml:lang="zh-Hans">洒落黑雨的天空下</span></p><p begin="02:33.281" end="02:35.946" ttm:agent="v1" itunes:key="L22"><span begin="02:33.281" end="02:34.005">私</span><span begin="02:34.005" end="02:34.595">は</span><span begin="02:34.669" end="02:34.911">望</span><span begin="02:34.911" end="02:35.449">まれない</span><span begin="02:35.449" end="02:35.946">もの</span><span ttm:role="x-translation" xml:lang="zh-Hans">无人期待我的出现</span></p><p begin="02:35.956" end="02:37.880" ttm:agent="v1" itunes:key="L23"><span begin="02:35.956" end="02:36.499">ひび</span><span begin="02:36.499" end="02:37.077">割れた</span><span begin="02:37.077" end="02:37.655">ノイロー</span><span begin="02:37.655" end="02:37.880">ゼ</span><span ttm:role="x-translation" xml:lang="zh-Hans">支离破碎的神经症</span></p><p begin="02:37.890" end="02:41.367" ttm:agent="v1" itunes:key="L24"><span begin="02:37.890" end="02:38.322">愛</span><span begin="02:38.322" end="02:38.712">す</span><span begin="02:38.712" end="02:39.184">同罪</span><span begin="02:39.184" end="02:39.584">の</span><span begin="02:39.584" end="02:40.109">傍観者</span><span begin="02:40.109" end="02:40.664">達</span><span begin="02:40.664" end="02:41.367">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">同病相怜的旁观者</span></p><p begin="02:41.377" end="02:43.963" ttm:agent="v1" itunes:key="L25"><span begin="02:41.377" end="02:41.836">さあ</span><span begin="02:41.836" end="02:42.548">今</span><span begin="02:42.548" end="02:43.073">ふるえ</span><span begin="02:43.073" end="02:43.669">正義</span><span begin="02:43.669" end="02:43.963">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">此刻让正义得到伸张</span></p><p begin="02:43.973" end="02:46.583" ttm:agent="v1" itunes:key="L26"><span begin="02:43.973" end="02:44.486">消せ</span><span begin="02:44.486" end="02:45.107">ない</span><span begin="02:45.107" end="02:45.434">傷</span><span begin="02:45.434" end="02:45.620">を</span><span begin="02:45.620" end="02:45.963">抱き</span><span begin="02:45.963" end="02:46.311">しめ</span><span begin="02:46.311" end="02:46.583">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">怀着抹不去的伤痕</span></p><p begin="02:46.593" end="02:48.926" ttm:agent="v1" itunes:key="L27"><span begin="02:46.593" end="02:47.148">この</span><span begin="02:47.148" end="02:47.691">身体</span><span begin="02:47.691" end="02:48.072">を</span><span begin="02:48.072" end="02:48.503">受け</span><span begin="02:48.503" end="02:48.926">入れ</span><span ttm:role="x-translation" xml:lang="zh-Hans">接受逃不脱的身躯</span></p><p begin="02:48.936" end="02:56.554" ttm:agent="v1" itunes:key="L28"><span begin="02:48.936" end="02:49.546">共</span><span begin="02:49.546" end="02:49.804">に</span><span begin="02:49.804" end="02:50.503">行こう</span> <span begin="02:50.503" end="02:50.950">名前</span><span begin="02:50.950" end="02:51.315">の</span><span begin="02:51.315" end="02:51.749">ない</span><span begin="02:51.749" end="02:54.776">怪</span><span begin="02:54.776" end="02:56.554">物</span><span ttm:role="x-translation" xml:lang="zh-Hans">一同前行吧 无名的怪物</span></p><p begin="03:13.571" end="03:16.064" ttm:agent="v1" itunes:key="L29"><span begin="03:13.571" end="03:16.064">ああ</span><span ttm:role="x-translation" xml:lang="zh-Hans">啊</span></p><p begin="03:16.074" end="03:34.680" ttm:agent="v1" itunes:key="L30"><span begin="03:16.074" end="03:19.252">神</span><span begin="03:19.252" end="03:21.078">ハ</span><span begin="03:21.295" end="03:22.823">告</span><span begin="03:22.823" end="03:24.400">ゲ</span><span begin="03:24.400" end="03:26.444">ル</span> <span begin="03:26.444" end="03:26.955">真</span><span begin="03:26.955" end="03:28.631">ノ</span><span begin="03:28.631" end="03:29.609">世</span><span begin="03:29.609" end="03:32.269">界</span><span begin="03:32.269" end="03:34.680">ヲ</span><span ttm:role="x-translation" xml:lang="zh-Hans">神将会宣告真正的世界</span></p><p begin="03:55.977" end="03:58.530" ttm:agent="v1" itunes:key="L31"><span begin="03:55.977" end="03:56.317">黒</span><span begin="03:56.317" end="03:56.468">い</span><span begin="03:56.468" end="03:57.282">鉄</span><span begin="03:57.282" end="03:57.699">格子</span><span begin="03:57.699" end="03:57.920">の</span><span begin="03:57.920" end="03:58.307">中</span><span begin="03:58.307" end="03:58.530">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这漆黑的铁窗中</span></p><p begin="03:58.599" end="04:01.283" ttm:agent="v1" itunes:key="L32"><span begin="03:58.599" end="03:59.414">私</span><span begin="03:59.414" end="03:59.985">は</span><span begin="03:59.985" end="04:00.256">生ま</span><span begin="04:00.256" end="04:00.506">れて</span><span begin="04:00.506" end="04:00.795">きた</span><span begin="04:00.795" end="04:01.283">んだ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我正是诞生于此地</span></p><p begin="04:01.309" end="04:03.673" ttm:agent="v1" itunes:key="L33"><span begin="04:01.309" end="04:02.139">悪意</span><span begin="04:02.139" end="04:02.296">の</span><span begin="04:02.296" end="04:02.810">代償</span><span begin="04:02.810" end="04:03.203">を</span><span begin="04:03.203" end="04:03.359">願</span><span begin="04:03.359" end="04:03.673">え</span><span ttm:role="x-translation" xml:lang="zh-Hans">若你祈求恶有恶报</span></p><p begin="04:03.643" end="04:06.706" ttm:agent="v1" itunes:key="L34"><span begin="04:03.643" end="04:04.059">望</span><span begin="04:04.059" end="04:04.360">む</span><span begin="04:04.360" end="04:04.589">が</span><span begin="04:04.589" end="04:04.964">まま</span><span begin="04:04.964" end="04:05.252">に</span><span begin="04:05.252" end="04:05.419">お</span><span begin="04:05.419" end="04:06.100">前</span><span begin="04:06.100" end="04:06.706">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">我便让你得偿所愿</span></p><p begin="04:06.659" end="04:09.141" ttm:agent="v1" itunes:key="L35"><span begin="04:06.659" end="04:07.182">さあ</span><span begin="04:07.182" end="04:07.797">与</span><span begin="04:07.797" end="04:08.013">え</span><span begin="04:08.013" end="04:08.390">よう</span><span begin="04:08.390" end="04:08.849">正義</span><span begin="04:08.849" end="04:09.141">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">愿赐予你正义之名</span></p><p begin="04:09.266" end="04:12.076" ttm:agent="v1" itunes:key="L36"><span begin="04:09.266" end="04:09.857">壊</span><span begin="04:09.857" end="04:10.168">し</span><span begin="04:10.168" end="04:10.668">て</span> <span begin="04:10.671" end="04:10.935">壊</span><span begin="04:10.935" end="04:11.387">される</span><span begin="04:11.387" end="04:11.721">前</span><span begin="04:11.721" end="04:12.076">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在毁灭或被灭之前</span></p><p begin="04:11.985" end="04:14.154" ttm:agent="v1" itunes:key="L37"><span begin="04:11.985" end="04:12.470">因</span><span begin="04:12.470" end="04:12.870">果の</span><span begin="04:12.870" end="04:13.645">代償を</span><span begin="04:13.645" end="04:13.838">払</span><span begin="04:13.838" end="04:14.154">い</span><span ttm:role="x-translation" xml:lang="zh-Hans">先偿还因果的代价</span></p><p begin="04:14.271" end="04:17.354" ttm:agent="v1" itunes:key="L38"><span begin="04:14.271" end="04:14.746">報</span><span begin="04:14.746" end="04:15.167">いよ</span> <span begin="04:15.167" end="04:15.625">名も</span><span begin="04:15.625" end="04:15.964">なき</span><span begin="04:15.964" end="04:16.843">怪</span><span begin="04:16.843" end="04:17.354">物</span><span ttm:role="x-translation" xml:lang="zh-Hans">让善恶得报 无名的怪物</span></p><p begin="04:17.364" end="04:19.986" ttm:agent="v1" itunes:key="L39"><span begin="04:17.364" end="04:17.749">黒</span><span begin="04:17.749" end="04:17.968">い</span><span begin="04:17.968" end="04:18.623">雨</span> <span begin="04:18.623" end="04:19.246">降らせ</span><span begin="04:19.246" end="04:19.580">この</span><span begin="04:19.580" end="04:19.986">空</span><span ttm:role="x-translation" xml:lang="zh-Hans">洒落黑雨的天空下</span></p><p begin="04:19.949" end="04:22.614" ttm:agent="v1" itunes:key="L40"><span begin="04:19.949" end="04:20.673">私</span><span begin="04:20.673" end="04:21.263">は</span><span begin="04:21.337" end="04:21.579">望</span><span begin="04:21.579" end="04:22.117">まれない</span><span begin="04:22.117" end="04:22.614">もの</span><span ttm:role="x-translation" xml:lang="zh-Hans">无人期待我的出现</span></p><p begin="04:22.626" end="04:24.550" ttm:agent="v1" itunes:key="L41"><span begin="04:22.626" end="04:23.169">ひび</span><span begin="04:23.169" end="04:23.747">割れた</span><span begin="04:23.747" end="04:24.325">ノイロー</span><span begin="04:24.325" end="04:24.550">ゼ</span><span ttm:role="x-translation" xml:lang="zh-Hans">支离破碎的神经症</span></