37" end="03:17.452"></span><span begin="03:17.452" end="03:18.679"></span><span begin="03:18.679" end="03:19.484"></span><span begin="03:19.484" end="03:21.106"></span><span begin="03:21.106" end="03:21.573"></span><span begin="03:21.573" end="03:23.354"></span></text><text for="L20"><span begin="03:24.088" end="03:24.767">kowa</span><span begin="03:24.767" end="03:25.389">sa</span><span begin="03:25.389" end="03:25.848">nai</span><span begin="03:25.848" end="03:26.462">de</span></text><text for="L21"><span begin="03:26.472" end="03:27.692">bokuwa</span><span begin="03:27.692" end="03:28.731">mou</span><span begin="03:29.435" end="03:30.376">hitori</span><span begin="03:30.376" end="03:30.856">jana</span><span begin="03:30.856" end="03:31.513">ika</span><span begin="03:31.513" end="03:32.708">ra</span></text><text for="L22"><span begin="03:32.718" end="03:33.303">doko</span><span begin="03:33.303" end="03:34.305">ma</span><span begin="03:34.305" end="03:34.815">de</span><span begin="03:34.815" end="03:36.004"></span><span begin="03:37.219" end="03:38.147">i</span><span begin="03:38.147" end="03:39.118">keru</span><span begin="03:39.118" end="03:39.751">yo</span></text><text for="L23"><span begin="03:39.859" end="03:40.658">tai</span><span begin="03:40.658" end="03:41.463">kutsuna</span><span begin="03:41.463" end="03:42.154">so</span><span begin="03:42.154" end="03:42.856">rade</span><span begin="03:42.856" end="03:43.686"></span><span begin="03:43.686" end="03:44.678"></span><span begin="03:44.678" end="03:46.004"></span><span begin="03:46.004" end="03:46.943"></span><span begin="03:46.943" end="03:47.589"></span><span begin="03:47.589" end="03:48.204"></span><span begin="03:48.204" end="03:50.626"></span></text><text for="L24"><span begin="03:50.636" end="03:51.490">kasa</span><span begin="03:51.490" end="03:52.858">na'tta</span><span begin="03:53.250" end="03:54.113">yawa</span><span begin="03:54.113" end="03:54.933">raka</span><span begin="03:54.933" end="03:56.048">na</span><span begin="03:56.222" end="03:57.329">kodouga</span><span begin="03:57.329" end="03:58.135">ki't</span><span begin="03:58.135" end="03:59.359">to</span></text><text for="L25"><span begin="03:59.369" end="04:00.036">kono</span><span begin="04:00.036" end="04:01.337">toki</span><span begin="04:01.337" end="04:02.809">wo</span><span begin="04:04.005" end="04:04.842">tsuna</span><span begin="04:04.842" end="04:05.668">ide</span><span begin="04:05.668" end="04:06.599">kure</span><span begin="04:06.599" end="04:09.965">ru</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="04:38.084"><div begin="00:32.778" end="04:09.965"><p begin="00:32.778" end="00:45.092" ttm:agent="v1" itunes:key="L1"><span begin="00:32.778" end="00:33.853">薄</span><span begin="00:34.099" end="00:34.876">明か</span><span begin="00:34.876" end="00:35.985">り</span> <span begin="00:36.182" end="00:36.772">温</span><span begin="00:36.772" end="00:37.737">度の</span><span begin="00:37.737" end="00:38.689">ない</span><span begin="00:38.689" end="00:39.863">部屋を</span><span begin="00:39.863" end="00:40.950">通</span><span begin="00:40.950" end="00:41.571">り</span><span begin="00:41.571" end="00:42.659">過</span><span begin="00:42.659" end="00:43.229">ぎ</span><span begin="00:43.229" end="00:45.092">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">微光 穿过没有温度的房间</span></p><p begin="00:46.192" end="00:49.347" ttm:agent="v1" itunes:key="L2"><span begin="00:46.192" end="00:47.368">青</span><span begin="00:47.368" end="00:47.912">い</span><span begin="00:47.912" end="00:49.347">朝</span><span ttm:role="x-translation" xml:lang="zh-Hans">蓝色的清晨</span></p><p begin="00:49.466" end="00:56.634" ttm:agent="v1" itunes:key="L3"><span begin="00:49.466" end="00:50.015">また</span><span begin="00:50.015" end="00:51.099">明日</span><span begin="00:51.099" end="00:52.118">も</span><span begin="00:52.426" end="00:53.270">来る</span><span begin="00:53.270" end="00:54.451">だ</span><span begin="00:54.451" end="00:55.020">ろ</span><span begin="00:55.020" end="00:56.634">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">明天一定也会照常来临</span></p><p begin="00:59.466" end="01:07.657" ttm:agent="v1" itunes:key="L4"><span begin="00:59.466" end="01:00.613">ひた</span><span begin="01:00.613" end="01:01.416">すら</span><span begin="01:01.416" end="01:02.407">に</span> <span begin="01:02.726" end="01:03.301">時間(と</span><span begin="01:03.301" end="01:04.217">き)</span><span begin="01:04.217" end="01:04.611">が</span><span begin="01:04.611" end="01:05.271">流</span><span begin="01:05.271" end="01:06.388">れてゆ</span><span begin="01:06.388" end="01:07.657">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">时间自顾自地前进</span></p><p begin="01:07.705" end="01:11.110" ttm:agent="v1" itunes:key="L5"><span begin="01:07.705" end="01:08.792">音</span><span begin="01:09.289" end="01:09.839">も</span><span begin="01:09.839" end="01:11.110">なく</span><span ttm:role="x-translation" xml:lang="zh-Hans">悄无声息</span></p><p begin="01:11.626" end="01:15.953" ttm:agent="v1" itunes:key="L6"><span begin="01:11.626" end="01:13.115">無邪気に</span><span begin="01:13.115" end="01:14.770">笑</span><span begin="01:14.770" end="01:15.953">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知为何</span></p><p begin="01:16.024" end="01:24.092" ttm:agent="v1" itunes:key="L7"><span begin="01:16.024" end="01:16.532">キ</span><span begin="01:16.532" end="01:17.298">ミの</span><span begin="01:17.298" end="01:18.168">顔</span><span begin="01:18.168" end="01:19.014">が</span> <span begin="01:19.127" end="01:20.618">なぜか</span><span begin="01:20.618" end="01:21.457">焼き</span><span begin="01:21.457" end="01:22.697">付いた</span><span begin="01:22.697" end="01:23.185">ま</span><span begin="01:23.185" end="01:24.092">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">只有你无邪的笑容如此清晰</span></p><p begin="01:24.102" end="01:29.365" ttm:agent="v1" itunes:key="L8"><span begin="01:24.102" end="01:25.354">風</span><span begin="01:25.733" end="01:26.606">を</span> <span begin="01:26.606" end="01:27.393">受け</span><span begin="01:27.393" end="01:27.803">て</span><span begin="01:27.803" end="01:28.548">とんで</span><span begin="01:28.548" end="01:29.365">ゆこう</span><span ttm:role="x-translation" xml:lang="zh-Hans">迎着风出发吧</span></p><p begin="01:29.375" end="01:37.206" ttm:agent="v1" itunes:key="L9"><span begin="01:29.375" end="01:30.594">キミが</span><span begin="01:30.594" end="01:31.249">描</span><span begin="01:31.249" end="01:31.840">い</span><span begin="01:31.840" end="01:32.579">てた</span> <span begin="01:32.830" end="01:33.368">妄</span><span begin="01:33.368" end="01:34.446">想</span><span begin="01:34.446" end="01:34.895">へ</span><span begin="01:34.895" end="01:37.206">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">向着你描绘的妄想</span></p><p begin="01:37.365" end="01:46.009" ttm:agent="v1" itunes:key="L10"><span begin="01:37.365" end="01:38.204">泣か</span><span begin="01:38.204" end="01:39.096">ない</span><span begin="01:39.096" end="01:39.823">で</span> <span begin="01:39.987" end="01:40.715">隠</span><span begin="01:40.715" end="01:41.519">して</span><span begin="01:41.519" end="01:42.498">た</span> <span begin="01:42.791" end="01:43.967">つばさを</span><span begin="01:43.967" end="01:44.781">広</span><span begin="01:44.781" end="01:46.009">げ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不要哭泣 展开曾经藏起来的翅膀</span></p><p begin="01:46.080" end="01:53.080" ttm:agent="v1" itunes:key="L11"><span begin="01:46.080" end="01:46.639">どこ</span><span begin="01:46.639" end="01:47.667">ま</span><span begin="01:47.667" end="01:48.199">で</span><span begin="01:48.199" end="01:49.416">も</span> <span begin="01:50.619" end="01:51.492">飛</span><span begin="01:51.492" end="01:52.325">べる</span><span begin="01:52.325" end="01:53.080">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">就可以到达任何地方</span></p><p begin="01:53.172" end="01:56.127" ttm:agent="v1" itunes:key="L12"><span begin="01:53.172" end="01:53.679">意</span><span begin="01:53.679" end="01:54.030">味</span><span begin="01:54.030" end="01:54.329">の</span><span begin="01:54.329" end="01:54.675">ない</span><span begin="01:54.675" end="01:55.047">宇</span><span begin="01:55.047" end="01:55.419">宙(そら)</span><span begin="01:55.419" end="01:56.127">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这个没有意义的宇宙</span></p><p begin="01:56.179" end="02:03.751" ttm:agent="v1" itunes:key="L13"><span begin="01:56.179" end="01:56.989">煌</span><span begin="01:56.989" end="01:57.638">めく</span><span begin="01:57.638" end="01:58.433">何</span><span begin="01:58.433" end="01:59.318">かを</span> <span begin="01:59.318" end="02:00.287">見つ</span><span begin="02:00.287" end="02:01.013">け</span><span begin="02:01.013" end="02:01.504">たん</span><span begin="02:01.504" end="02:03.751">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我找到了一些闪亮的东西</span></p><p begin="02:03.896" end="02:12.755" ttm:agent="v1" itunes:key="L14"><span begin="02:03.896" end="02:04.844">抱き</span><span begin="02:04.844" end="02:05.686">しめ</span><span begin="02:05.686" end="02:06.456">て</span> <span begin="02:06.599" end="02:07.733">止まっ</span><span begin="02:07.733" end="02:08.141">て</span><span begin="02:08.141" end="02:09.133">た</span> <span begin="02:09.469" end="02:10.665">未来が</span><span begin="02:10.665" end="02:11.414">開</span><span begin="02:11.414" end="02:12.755">く</span><span ttm:role="x-translation" xml:lang="zh-Hans">怀抱着它 停止的时间开始转动</span></p><p begin="02:12.765" end="02:23.164" ttm:agent="v1" itunes:key="L15"><span begin="02:12.765" end="02:13.355">ボク</span><span begin="02:13.355" end="02:14.455">は</span><span begin="02:14.455" end="02:16.095">今</span> <span begin="02:17.393" end="02:18.099">前</span><span begin="02:18.099" end="02:18.680">に</span><span begin="02:18.680" end="02:19.779">進め</span><span begin="02:19.779" end="02:23.164">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">我终于可以前进</span></p><p begin="02:46.139" end="02:57.488" ttm:agent="v1" itunes:key="L16"><span begin="02:46.139" end="02:47.745">茜</span><span begin="02:47.745" end="02:48.725">色</span> <span begin="02:49.599" end="02:50.525">バカ</span><span begin="02:50.525" end="02:51.443">ねと</span><span begin="02:51.443" end="02:52.389">じゃれ</span><span begin="02:52.389" end="02:53.186">合っ</span><span begin="02:53.186" end="02:54.058">た</span> <span begin="02:54.454" end="02:55.801">帰</span><span begin="02:55.801" end="02:56.295">り</span><span begin="02:56.295" end="02:57.488">道</span><span ttm:role="x-translation" xml:lang="zh-Hans">黄昏色 我们笑对方傻瓜 回家的路</span></p><p begin="02:58.139" end="03:02.716" ttm:agent="v1" itunes:key="L17"><span begin="02:58.139" end="02:59.756">気付かぬ</span><span begin="02:59.756" end="03:01.056">う</span><span begin="03:01.056" end="03:01.593">ち</span><span begin="03:01.593" end="03:02.716">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">不知不觉中</span></p><p begin="03:02.726" end="03:11.377" ttm:agent="v1" itunes:key="L18"><span begin="03:02.726" end="03:03.462">見え</span><span begin="03:03.462" end="03:03.997">て</span><span begin="03:03.997" end="03:04.733">きた</span><span begin="03:04.733" end="03:05.564">よ</span> <span begin="03:05.780" end="03:06.585">鮮</span><span begin="03:06.585" end="03:07.770">や</span><span begin="03:07.770" end="03:08.825">かな</span><span begin="03:09.214" end="03:09.855">世</span><span begin="03:09.855" end="03:11.377">界</span><span ttm:role="x-translation" xml:lang="zh-Hans">鲜明的世界逐渐浮现</span></p><p begin="03:10.577" end="03:23.354" ttm:agent="v1" itunes:key="L19"><span begin="03:10.577" end="03:11.549">現実(い</span><span begin="03:11.549" end="03:12.404">ま)</span><span begin="03:12.404" end="03:13.223">と</span> <span begin="03:13.223" end="03:14.322">妄想の</span><span begin="03:14.322" end="03:15.409">あいだ</span><span begin="03:15.409" end="03:16.137">を</span> <span begin="03:16.137" end="03:17.452">揺れてる</span><span begin="03:17.452" end="03:18.679">透明</span><span begin="03:18.679" end="03:19.484">な</span> <span begin="03:19.484" end="03:21.106">心</span><span begin="03:21.106" end="03:21.573">た</span><span begin="03:21.573" end="03:23.354">ち</span><span ttm:role="x-translation" xml:lang="zh-Hans">在现实和妄想间摇摆</span></p><p begin="03:24.088" end="03:26.462" ttm:agent="v1" itunes:key="L20"><span begin="03:24.088" end="03:24.767">壊</span><span begin="03:24.767" end="03:25.389">さ</span><span begin="03:25.389" end="03:25.848">ない</span><span begin="03:25.848" end="03:26.462">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">不要破坏它</span></p><p begin="03:26.472" end="03:32.708" ttm:agent="v1" itunes:key="L21"><span begin="03:26.472" end="03:27.692">ボクは</span><span begin="03:27.692" end="03:28.731">もう</span> <span begin="03:29.435" end="03:30.376">独り</span><span begin="03:30.376" end="03:30.856">じゃ</span><span begin="03:30.856" end="03:31.513">ないか</span><span begin="03:31.513" end="03:32.708">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">我已经不是孤身一人</span></p><p begin="03:32.718" end="03:39.751" ttm:agent="v1" itunes:key="L22"><span begin="03:32.718" end="03:33.303">どこ</span><span begin="03:33.303" end="03:34.305">ま</span><span begin="03:34.305" end="03:34.815">で</span><span begin="03:34.815" end="03:36.004">も</span> <span begin="03:37.219" end="03:38.147">行</span><span begin="03:38.147" end="03:39.118">ける</span><span begin="03:39.118" end="03:39.751">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">所以能去任何地方</span></p><p begin="03:39.859" end="03:50.626" ttm:agent="v1" itunes:key="L23"><span begin="03:39.859" end="03:40.658">退</span><span begin="03:40.658" end="03:41.463">屈な</span><span begin="03:41.463" end="03:42.154">宇宙(そら)</span><span begin="03:42.154" end="03:42.856">で</span> <span begin="03:42.856" end="03:43.686">ボク</span><span begin="03:43.686" end="03:44.678">たちの</span><span begin="03:44.678" end="03:46.004">歌を</span> <span begin="03:46.004" end="03:46.943">響</span><span begin="03:46.943" end="03:47.589">か</span><span begin="03:47.589" end="03:48.204">せよ</span><span begin="03:48.204" end="03:50.626">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">让我们的歌</span></p><p begin="03:50.636" end="03:59.359" ttm:agent="v1" itunes:key="L24"><span begin="03:50.636" end="03:51.490">重</span><span begin="03:51.490" end="03:52.858">なった</span> <span begin="03:53.250" end="03:54.113">柔</span><span begin="03:54.113" end="03:54.933">らか</span><span begin="03:54.933" end="03:56.048">な</span><span begin="03:56.222" end="03:57.329">鼓動が</span><span begin="03:57.329" end="03:58.135">きっ</span><span begin="03:58.135" end="03:59.359">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">重叠在一起的温柔心跳</span></p><p begin="03:59.369" end="04:09.965" ttm:agent="v1" itunes:key="L25"><span begin="03:59.369" end="04:00.036">この</span><span begin="04:00.036" end="04:01.337">時</span><span begin="04:01.337" end="04:02.809">を</span> <span begin="04:04.005" end="04:04.842">繋</span><span begin="04:04.842" end="04:05.668">いで</span><span begin="04:05.668" end="04:06.599">くれ</span><span begin="04:06.599" end="04:09.965">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">一定会把这时间延续下去</span></p></div></body></tt>