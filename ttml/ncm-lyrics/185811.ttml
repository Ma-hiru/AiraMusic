<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="185811"/><amll:meta key="appleMusicId" value="536030695"/><amll:meta key="musicName" value="青花瓷"/><amll:meta key="artists" value="周杰伦"/><amll:meta key="album" value="我很忙"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:59.347"><div begin="00:21.606" end="03:35.961"><p begin="00:21.606" end="00:25.986" ttm:agent="v1" itunes:key="L1"><span begin="00:21.606" end="00:21.955">素</span><span begin="00:21.955" end="00:22.270">胚</span><span begin="00:22.270" end="00:22.568">勾</span><span begin="00:22.568" end="00:23.046">勒</span><span begin="00:23.046" end="00:23.395">出</span><span begin="00:23.395" end="00:23.646">青</span><span begin="00:23.646" end="00:24.141">花</span><span begin="00:24.238" end="00:24.765">筆鋒</span><span begin="00:24.765" end="00:25.299">濃轉</span><span begin="00:25.299" end="00:25.986">淡</span><span ttm:role="x-translation" xml:lang="zh-Hans">素胚勾勒出青花笔锋浓转淡</span></p><p begin="00:26.130" end="00:30.449" ttm:agent="v1" itunes:key="L2"><span begin="00:26.130" end="00:26.442">瓶</span><span begin="00:26.442" end="00:26.689">身</span><span begin="00:26.689" end="00:27.025">描</span><span begin="00:27.025" end="00:27.441">繪</span><span begin="00:27.554" end="00:28.097">的牡</span><span begin="00:28.097" end="00:28.464">丹</span><span begin="00:28.618" end="00:29.479">一如妳</span><span begin="00:29.479" end="00:29.799">初</span><span begin="00:29.799" end="00:30.449">妝</span><span ttm:role="x-translation" xml:lang="zh-Hans">瓶身描绘的牡丹一如你初妆</span></p><p begin="00:30.577" end="00:34.864" ttm:agent="v1" itunes:key="L3"><span begin="00:30.577" end="00:31.120">冉冉</span><span begin="00:31.120" end="00:31.420">檀</span><span begin="00:31.420" end="00:31.953">香</span><span begin="00:31.953" end="00:32.512">透過</span><span begin="00:32.512" end="00:33.023">窗</span><span begin="00:33.023" end="00:33.597">心事</span><span begin="00:33.597" end="00:33.930">我</span><span begin="00:33.930" end="00:34.481">了</span><span begin="00:34.481" end="00:34.864">然</span><span ttm:role="x-translation" xml:lang="zh-Hans">冉冉檀香透过窗心事我了然</span></p><p begin="00:34.999" end="00:39.185" ttm:agent="v1" itunes:key="L4"><span begin="00:34.999" end="00:35.897">宣紙上</span> <span begin="00:35.897" end="00:36.941">走筆至此</span><span begin="00:36.941" end="00:37.528">擱</span><span begin="00:37.528" end="00:37.859">一</span><span begin="00:37.859" end="00:39.185">半</span><span ttm:role="x-translation" xml:lang="zh-Hans">宣纸上 走笔至此搁一半</span></p><p begin="00:39.522" end="00:43.708" ttm:agent="v1" itunes:key="L5"><span begin="00:39.522" end="00:39.739">釉</span><span begin="00:39.739" end="00:39.975">色</span><span begin="00:39.975" end="00:40.285">渲</span><span begin="00:40.285" end="00:40.775">染</span><span begin="00:40.775" end="00:41.409">仕女</span><span begin="00:41.409" end="00:41.889">圖</span><span begin="00:41.980" end="00:42.542">韻味</span><span begin="00:42.542" end="00:42.822">被</span><span begin="00:42.822" end="00:43.153">私</span><span begin="00:43.153" end="00:43.708">藏</span><span ttm:role="x-translation" xml:lang="zh-Hans">釉色渲染仕女图韵味被私藏</span></p><p begin="00:43.936" end="00:48.260" ttm:agent="v1" itunes:key="L6"><span begin="00:43.936" end="00:44.787">而妳嫣</span><span begin="00:44.787" end="00:45.330">然</span><span begin="00:45.330" end="00:45.820">的一</span><span begin="00:45.820" end="00:46.375">笑</span><span begin="00:46.375" end="00:46.950">如含</span><span begin="00:46.950" end="00:47.334">苞</span><span begin="00:47.334" end="00:47.530">待</span><span begin="00:47.530" end="00:48.260">放</span><span ttm:role="x-translation" xml:lang="zh-Hans">而你嫣然的一笑如含苞待放</span></p><p begin="00:48.362" end="00:50.696" ttm:agent="v1" itunes:key="L7"><span begin="00:48.362" end="00:48.680">妳</span><span begin="00:48.680" end="00:48.893">的</span><span begin="00:48.893" end="00:49.171">美</span><span begin="00:49.171" end="00:49.491">一</span><span begin="00:49.491" end="00:49.733">縷</span><span begin="00:49.733" end="00:50.282">飄</span><span begin="00:50.282" end="00:50.696">散</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的美一缕飘散</span></p><p begin="00:50.812" end="00:56.004" ttm:agent="v1" itunes:key="L8"><span begin="00:50.812" end="00:51.179">去</span><span begin="00:51.179" end="00:51.520">到</span><span begin="00:51.520" end="00:52.576">我去不了</span><span begin="00:52.576" end="00:53.006">的</span><span begin="00:53.127" end="00:53.349">地</span><span begin="00:53.349" end="00:56.004">方</span><span ttm:role="x-translation" xml:lang="zh-Hans">去到我去不了的地方</span></p><p begin="00:57.210" end="01:01.470" ttm:agent="v1" itunes:key="L9"><span begin="00:57.210" end="00:57.765">天青</span><span begin="00:57.765" end="00:58.149">色</span><span begin="00:58.149" end="00:58.634">等煙</span><span begin="00:58.634" end="00:59.042">雨</span> <span begin="00:59.271" end="01:00.049">而我在</span><span begin="01:00.049" end="01:00.391">等</span><span begin="01:00.391" end="01:01.470">妳</span><span ttm:role="x-translation" xml:lang="zh-Hans">天青色等烟雨 而我在等你</span></p><p begin="01:01.567" end="01:05.873" ttm:agent="v1" itunes:key="L10"><span begin="01:01.567" end="01:01.954">炊</span><span begin="01:01.954" end="01:02.288">煙</span><span begin="01:02.288" end="01:02.737">裊裊</span><span begin="01:02.737" end="01:03.020">昇</span><span begin="01:03.020" end="01:03.451">起</span> <span begin="01:03.643" end="01:04.727">隔江千萬</span><span begin="01:04.727" end="01:05.873">里</span><span ttm:role="x-translation" xml:lang="zh-Hans">炊烟袅袅升起 隔江千万里</span></p><p begin="01:06.101" end="01:10.032" ttm:agent="v1" itunes:key="L11"><span begin="01:06.101" end="01:06.414">在</span><span begin="01:06.414" end="01:06.769">瓶</span><span begin="01:06.769" end="01:06.922">底</span><span begin="01:06.922" end="01:08.106">書漢隸仿</span><span begin="01:08.106" end="01:08.895">前朝的</span><span begin="01:08.895" end="01:09.172">飄</span><span begin="01:09.172" end="01:10.032">逸</span><span ttm:role="x-translation" xml:lang="zh-Hans">在瓶底书汉隶仿前朝的飘逸</span></p><p begin="01:10.529" end="01:14.849" ttm:agent="v1" itunes:key="L12"><span begin="01:10.529" end="01:11.145">就當</span><span begin="01:11.145" end="01:11.393">我</span> <span begin="01:11.393" end="01:11.976">為</span><span begin="01:11.976" end="01:12.267">遇</span><span begin="01:12.267" end="01:12.854">見</span><span begin="01:12.854" end="01:13.348">妳</span><span begin="01:13.348" end="01:13.980">伏</span><span begin="01:13.980" end="01:14.849">筆</span><span ttm:role="x-translation" xml:lang="zh-Hans">就当我 为遇见你伏笔</span></p><p begin="01:14.987" end="01:19.247" ttm:agent="v1" itunes:key="L13"><span begin="01:14.987" end="01:15.571">天青</span><span begin="01:15.571" end="01:15.882">色</span><span begin="01:15.882" end="01:16.411">等煙</span><span begin="01:16.411" end="01:16.819">雨</span> <span begin="01:17.048" end="01:17.826">而我在</span><span begin="01:17.826" end="01:18.168">等</span><span begin="01:18.168" end="01:19.247">妳</span><span ttm:role="x-translation" xml:lang="zh-Hans">天青色等烟雨 而我在等你</span></p><p begin="01:19.482" end="01:23.654" ttm:agent="v1" itunes:key="L14"><span begin="01:19.482" end="01:20.077">月色</span><span begin="01:20.077" end="01:20.837">被打撈</span><span begin="01:20.837" end="01:21.267">起</span> <span begin="01:21.475" end="01:22.277">暈開了</span><span begin="01:22.277" end="01:22.629">結</span><span begin="01:22.629" end="01:23.654">局</span><span ttm:role="x-translation" xml:lang="zh-Hans">月色被打捞起 晕开了结局</span></p><p begin="01:23.954" end="01:27.612" ttm:agent="v1" itunes:key="L15"><span begin="01:23.954" end="01:24.707">如傳世</span><span begin="01:24.707" end="01:25.005">的</span><span begin="01:25.005" end="01:25.611">青花</span><span begin="01:25.611" end="01:25.911">瓷</span><span begin="01:25.911" end="01:26.716">自顧自</span><span begin="01:26.716" end="01:26.976">美</span><span begin="01:26.976" end="01:27.612">麗</span><span ttm:role="x-translation" xml:lang="zh-Hans">如传世的青花瓷自顾自美丽</span></p><p begin="01:27.778" end="01:31.372" ttm:agent="v1" itunes:key="L16"><span begin="01:27.778" end="01:28.139">妳</span><span begin="01:28.139" end="01:28.609">眼</span><span begin="01:28.609" end="01:28.837">帶</span><span begin="01:28.837" end="01:29.498">笑</span><span begin="01:29.498" end="01:31.372">意</span><span ttm:role="x-translation" xml:lang="zh-Hans">你眼带笑意</span></p><p begin="01:50.548" end="01:54.757" ttm:agent="v1" itunes:key="L17"><span begin="01:50.548" end="01:50.890">色</span><span begin="01:50.890" end="01:51.160">白</span><span begin="01:51.160" end="01:51.397">花</span><span begin="01:51.397" end="01:51.973">青</span><span begin="01:51.973" end="01:52.448">的錦</span><span begin="01:52.448" end="01:53.040">鯉</span><span begin="01:53.040" end="01:53.619">躍然</span><span begin="01:53.619" end="01:53.890">於</span><span begin="01:53.890" end="01:54.242">碗</span><span begin="01:54.242" end="01:54.757">底</span><span ttm:role="x-translation" xml:lang="zh-Hans">色白花青的锦鲤跃然于碗底</span></p><p begin="01:55.015" end="01:59.323" ttm:agent="v1" itunes:key="L18"><span begin="01:55.015" end="01:55.554">臨摹</span><span begin="01:55.554" end="01:55.873">宋</span><span begin="01:55.873" end="01:56.321">體</span><span begin="01:56.395" end="01:56.942">落款</span><span begin="01:56.942" end="01:57.475">時</span><span begin="01:57.475" end="01:58.395">卻惦記</span><span begin="01:58.395" end="01:58.629">著</span><span begin="01:58.629" end="01:59.323">妳</span><span ttm:role="x-translation" xml:lang="zh-Hans">临摹宋体落款时却惦记着你</span></p><p begin="01:59.479" end="02:03.816" ttm:agent="v1" itunes:key="L19"><span begin="01:59.479" end="02:00.045">妳隱</span><span begin="02:00.045" end="02:00.365">藏</span><span begin="02:00.365" end="02:00.877">在</span><span begin="02:00.877" end="02:01.449">窯燒</span><span begin="02:01.449" end="02:02.006">裡</span><span begin="02:02.006" end="02:02.486">千年</span><span begin="02:02.486" end="02:02.860">的</span><span begin="02:02.860" end="02:03.357">秘</span><span begin="02:03.357" end="02:03.816">密</span><span ttm:role="x-translation" xml:lang="zh-Hans">你隐藏在窑烧里千年的秘密</span></p><p begin="02:03.915" end="02:08.124" ttm:agent="v1" itunes:key="L20"><span begin="02:03.915" end="02:04.505">極細</span><span begin="02:04.505" end="02:04.746">膩</span> <span begin="02:04.746" end="02:05.242">猶如</span><span begin="02:05.242" end="02:05.863">繡花</span><span begin="02:05.863" end="02:06.407">針</span><span begin="02:06.407" end="02:06.764">落</span><span begin="02:06.764" end="02:08.124">地</span><span ttm:role="x-translation" xml:lang="zh-Hans">极细腻 犹如绣花针落地</span></p><p begin="02:08.358" end="02:12.562" ttm:agent="v1" itunes:key="L21"><span begin="02:08.358" end="02:08.891">簾外</span><span begin="02:08.891" end="02:09.166">芭</span><span begin="02:09.166" end="02:09.726">蕉</span><span begin="02:09.726" end="02:10.032">惹</span><span begin="02:10.032" end="02:10.331">驟</span><span begin="02:10.331" end="02:10.820">雨</span><span begin="02:10.820" end="02:11.103">門</span><span begin="02:11.103" end="02:11.449">環</span><span begin="02:11.449" end="02:11.748">惹</span><span begin="02:11.748" end="02:12.024">銅</span><span begin="02:12.024" end="02:12.562">綠</span><span ttm:role="x-translation" xml:lang="zh-Hans">帘外芭蕉惹骤雨门环惹铜绿</span></p><p begin="02:12.753" end="02:17.036" ttm:agent="v1" itunes:key="L22"><span begin="02:12.753" end="02:13.048">而</span><span begin="02:13.048" end="02:13.379">我</span><span begin="02:13.379" end="02:13.671">路</span><span begin="02:13.671" end="02:14.263">過</span><span begin="02:14.263" end="02:14.732">那江</span><span begin="02:14.732" end="02:15.256">南</span><span begin="02:15.256" end="02:15.596">小</span><span begin="02:15.596" end="02:15.890">鎮</span><span begin="02:15.890" end="02:16.172">惹</span><span begin="02:16.172" end="02:16.482">了</span><span begin="02:16.482" end="02:17.036">妳</span><span ttm:role="x-translation" xml:lang="zh-Hans">而我路过那江南小镇惹了你</span></p><p begin="02:17.237" end="02:19.534" ttm:agent="v1" itunes:key="L23"><span begin="02:17.237" end="02:17.559">在</span><span begin="02:17.559" end="02:18.007">潑墨</span><span begin="02:18.007" end="02:18.323">山</span><span begin="02:18.323" end="02:18.625">水</span><span begin="02:18.625" end="02:19.159">畫</span><span begin="02:19.159" end="02:19.534">裡</span><span ttm:role="x-translation" xml:lang="zh-Hans">在泼墨山水画里</span></p><p begin="02:19.753" end="02:24.508" ttm:agent="v1" itunes:key="L24"><span begin="02:19.753" end="02:20.002">妳</span><span begin="02:20.002" end="02:20.248">從</span><span begin="02:20.248" end="02:20.845">墨色</span><span begin="02:20.845" end="02:21.187">深</span><span begin="02:21.187" end="02:21.517">處</span><span begin="02:21.517" end="02:21.968">被</span><span begin="02:21.968" end="02:22.257">隱</span><span begin="02:22.257" end="02:24.508">去</span><span ttm:role="x-translation" xml:lang="zh-Hans">你从墨色深处被隐去</span></p><p begin="02:26.046" end="02:30.273" ttm:agent="v1" itunes:key="L25"><span begin="02:26.046" end="02:26.601">天青</span><span begin="02:26.601" end="02:26.985">色</span><span begin="02:26.985" end="02:27.470">等煙</span><span begin="02:27.470" end="02:27.878">雨</span> <span begin="02:28.107" end="02:28.914">而我在</span><span begin="02:28.914" end="02:29.293">等</span><span begin="02:29.293" end="02:30.273">妳</span><span ttm:role="x-translation" xml:lang="zh-Hans">天青色等烟雨 而我在等你</span></p><p begin="02:30.453" end="02:34.759" ttm:agent="v1" itunes:key="L26"><span begin="02:30.453" end="02:30.840">炊</span><span begin="02:30.840" end="02:31.174">煙</span><span begin="02:31.174" end="02:31.660">裊裊</span><span begin="02:31.660" end="02:31.950">昇</span><span begin="02:31.950" end="02:32.337">起</span> <span begin="02:32.529" end="02:33.613">隔江千萬</span><span begi