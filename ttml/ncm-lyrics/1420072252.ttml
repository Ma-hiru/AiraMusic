<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><ttm:agent type="person" xml:id="v4"/><ttm:agent type="person" xml:id="v5"/><ttm:agent type="person" xml:id="v6"/><ttm:agent type="person" xml:id="v7"/><amll:meta key="ncmMusicId" value="1420072252"/><amll:meta key="appleMusicId" value="1011787193"/><amll:meta key="musicName" value="恋音と雨空"/><amll:meta key="artists" value="春茶 / 茶泡饭"/><amll:meta key="album" value="恋音と雨空"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="05:16.400"><div begin="00:01.245" end="04:44.635"><p begin="00:01.245" end="00:04.983" ttm:agent="v1" itunes:key="L1"><span begin="00:01.245" end="00:02.099">「好きだよ」</span><span begin="00:02.135" end="00:02.609">と</span><span begin="00:02.609" end="00:03.253">伝え</span><span begin="00:03.253" end="00:03.732">れば</span><span begin="00:03.732" end="00:04.222">いい</span><span begin="00:04.222" end="00:04.413">の</span><span begin="00:04.413" end="00:04.983">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明想要将「喜欢你」的心情传达给你</span></p><p begin="00:04.805" end="00:08.369" ttm:agent="v1" itunes:key="L2"><span begin="00:04.805" end="00:05.229">願</span><span begin="00:05.229" end="00:05.495">う</span><span begin="00:05.495" end="00:06.142">先</span> <span begin="00:06.201" end="00:06.789">怖くて</span><span begin="00:06.914" end="00:07.097">い</span><span begin="00:07.097" end="00:07.563">え</span><span begin="00:07.563" end="00:08.369">ず</span></p><p begin="00:08.568" end="00:10.417" ttm:agent="v1" itunes:key="L3"><span begin="00:08.568" end="00:09.419">「好きだよ」</span><span begin="00:09.419" end="00:10.417">と</span></p><p begin="00:10.479" end="00:12.269" ttm:agent="v1" itunes:key="L4"><span begin="00:10.479" end="00:11.310">「好きだよ」</span><span begin="00:11.310" end="00:12.269">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">喜欢你的那句表白</span></p><p begin="00:12.279" end="00:15.927" ttm:agent="v1" itunes:key="L5"><span begin="00:12.279" end="00:13.154">募って</span><span begin="00:13.154" end="00:13.710">は</span><span begin="00:13.710" end="00:14.939">溶けて</span><span begin="00:14.939" end="00:15.927">く</span></p><p begin="00:15.937" end="00:20.560" ttm:agent="v2" itunes:key="L6"><span begin="00:15.937" end="00:16.420">君</span><span begin="00:16.420" end="00:16.855">との</span><span begin="00:16.855" end="00:17.330">時</span><span begin="00:17.330" end="00:17.767">間が</span><span begin="00:17.767" end="00:18.869">一秒でも</span><span begin="00:18.869" end="00:19.414">長く</span><span begin="00:19.644" end="00:20.560">なるなら</span></p><p begin="00:20.570" end="00:23.372" ttm:agent="v2" itunes:key="L7"><span begin="00:20.570" end="00:21.196">ずっと</span><span begin="00:21.196" end="00:22.015">じゃなくて</span><span begin="00:22.015" end="00:22.471">い</span><span begin="00:22.471" end="00:23.372">い</span></p><p begin="00:23.381" end="00:25.229" ttm:agent="v2" itunes:key="L8"><span begin="00:23.381" end="00:24.083">願い</span><span begin="00:24.117" end="00:24.289">か</span><span begin="00:24.289" end="00:24.735">け</span><span begin="00:24.735" end="00:25.229">る</span></p><p begin="00:25.239" end="00:31.734" ttm:agent="v2" itunes:key="L9"><span begin="00:25.239" end="00:25.886">恋</span><span begin="00:25.886" end="00:27.087">音</span><span begin="00:27.106" end="00:27.461">と</span><span begin="00:27.461" end="00:27.820">雨</span><span begin="00:27.820" end="00:31.734">空</span><span ttm:role="x-translation" xml:lang="zh-Hans">许下心愿 恋音 雨空</span></p><p begin="00:43.590" end="00:47.834" ttm:agent="v3" itunes:key="L10"><span begin="00:43.590" end="00:44.271">君と</span><span begin="00:44.271" end="00:45.146">離れて</span><span begin="00:45.146" end="00:45.664">から</span><span begin="00:45.664" end="00:46.087">数</span><span begin="00:46.087" end="00:46.851">日</span><span begin="00:47.443" end="00:47.834">目の</span></p><p begin="00:47.869" end="00:51.044" ttm:agent="v3" itunes:key="L11"><span begin="00:47.869" end="00:48.272">土砂</span><span begin="00:48.272" end="00:48.918">降りの</span><span begin="00:48.918" end="00:49.345">雨</span><span begin="00:49.345" end="00:49.868">の</span><span begin="00:49.868" end="00:51.044">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">这样的瓢泼大雨之中</span></p><p begin="00:51.110" end="00:57.920" ttm:agent="v3" itunes:key="L12"><span begin="00:51.110" end="00:51.722">こんな</span><span begin="00:51.722" end="00:52.164">日は</span><span begin="00:52.321" end="00:53.248">必</span><span begin="00:53.248" end="00:53.711">ず</span><span begin="00:53.711" end="00:54.291">傘を</span><span begin="00:54.291" end="00:55.219">届けに</span><span begin="00:55.219" end="00:55.697">いっ</span><span begin="00:55.697" end="00:57.920">た</span></p><p begin="00:58.667" end="01:02.243" ttm:agent="v4" itunes:key="L13"><span begin="00:58.667" end="00:59.370">いつもの</span><span begin="00:59.370" end="01:00.553">待ち合わせ</span><span begin="01:00.553" end="01:01.010">の</span><span begin="01:01.010" end="01:01.229">場</span><span begin="01:01.229" end="01:02.243">所</span></p><p begin="01:02.254" end="01:06.008" ttm:agent="v4" itunes:key="L14"><span begin="01:02.254" end="01:02.665">いる</span><span begin="01:02.665" end="01:03.328">はずの</span><span begin="01:03.328" end="01:03.868">ない</span><span begin="01:03.868" end="01:04.783">面影</span><span begin="01:04.783" end="01:05.044">待</span><span begin="01:05.044" end="01:06.008">つ</span></p><p begin="01:06.017" end="01:07.865" ttm:agent="v4" itunes:key="L15"><span begin="01:06.017" end="01:06.561">傘も</span><span begin="01:06.561" end="01:06.980">ささ</span><span begin="01:06.980" end="01:07.865">ず</span></p><p begin="01:07.874" end="01:11.735" ttm:agent="v4" itunes:key="L16"><span begin="01:07.874" end="01:08.258">ずぶ</span><span begin="01:08.258" end="01:09.026">濡れな</span><span begin="01:09.026" end="01:09.576">君は</span><span begin="01:09.576" end="01:10.294">そこに</span><span begin="01:10.294" end="01:10.531">い</span><span begin="01:10.531" end="01:11.735">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">被雨淋湿的你曾就在这里</span></p><p begin="01:11.744" end="01:16.724" ttm:agent="v5" itunes:key="L17"><span begin="01:11.744" end="01:12.889">悴</span><span begin="01:12.889" end="01:13.555">んだ</span><span begin="01:13.555" end="01:14.176">手を</span><span begin="01:14.176" end="01:15.212">温</span><span begin="01:15.212" end="01:15.710">める</span><span begin="01:16.202" end="01:16.724">ことが</span></p><p begin="01:16.736" end="01:20.035" ttm:agent="v5" itunes:key="L18"><span begin="01:16.736" end="01:17.125">もう</span><span begin="01:17.125" end="01:18.003">一度</span><span begin="01:18.003" end="01:18.227">で</span><span begin="01:18.227" end="01:18.528">き</span><span begin="01:18.528" end="01:19.078">るな</span><span begin="01:19.078" end="01:20.035">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果可以想要再一次</span></p><p begin="01:20.110" end="01:27.624" ttm:agent="v6" itunes:key="L19"><span begin="01:20.110" end="01:20.827">始</span><span begin="01:20.827" end="01:21.065">ま</span><span begin="01:21.065" end="01:21.390">り</span><span begin="01:21.390" end="01:21.779">の</span><span begin="01:21.779" end="01:22.337">時</span><span begin="01:22.337" end="01:22.955">まで</span><span begin="01:22.955" end="01:23.710">戻</span><span begin="01:23.710" end="01:24.524">り</span><span begin="01:24.524" end="01:25.635">た</span><span begin="01:25.635" end="01:27.624">い</span></p><p begin="01:28.519" end="01:32.257" ttm:agent="v1" itunes:key="L20"><span begin="01:28.519" end="01:29.373">「好きだよ」</span><span begin="01:29.409" end="01:29.883">と</span><span begin="01:29.883" end="01:30.570">伝え</span><span begin="01:30.570" end="01:31.024">れば</span><span begin="01:31.024" end="01:31.532">いい</span><span begin="01:31.532" end="01:31.744">の</span><span begin="01:31.744" end="01:32.257">に</span></p><p begin="01:32.267" end="01:35.831" ttm:agent="v1" itunes:key="L21"><span begin="01:32.267" end="01:32.691">願</span><span begin="01:32.691" end="01:32.957">う</span><span begin="01:32.957" end="01:33.604">先</span> <span begin="01:33.663" end="01:34.251">怖くて</span><span begin="01:34.376" end="01:34.559">い</span><span begin="01:34.559" end="01:34.987">え</span><span begin="01:34.987" end="01:35.831">ず</span></p><p begin="01:35.997" end="01:37.809" ttm:agent="v1" itunes:key="L22"><span begin="01:35.997" end="01:36.339">「好き</span><span begin="01:36.339" end="01:36.609">じゃ</span><span begin="01:36.609" end="01:36.902">な</span><span begin="01:36.902" end="01:37.809">い？」</span></p><p begin="01:37.854" end="01:39.681" ttm:agent="v1" itunes:key="L23"><span begin="01:37.854" end="01:38.657">「好きだよ？」</span><span begin="01:38.748" end="01:39.681">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">不喜欢你 喜欢你</span></p><p begin="01:39.736" end="01:43.426" ttm:agent="v1" itunes:key="L24"><span begin="01:39.736" end="01:40.363">揺れる</span><span begin="01:40.363" end="01:40.972">恋</span><span begin="01:40.972" end="01:41.309">と</span><span begin="01:41.309" end="01:42.054">雨</span><span begin="01:42.054" end="01:43.426">空</span></p><p begin="01:43.509" end="01:48.030" ttm:agent="v2" itunes:key="L25"><span begin="01:43.509" end="01:44.280">君との</span><span begin="01:44.280" end="01:44.823">時</span><span begin="01:44.823" end="01:45.285">間が</span><span begin="01:45.285" end="01:45.985">一秒</span><span begin="01:45.985" end="01:46.385">でも</span><span begin="01:46.385" end="01:46.725">長</span><span begin="01:46.725" end="01:47.136">く</span><span begin="01:47.210" end="01:48.030">なるなら</span></p><p begin="01:48.098" end="01:50.800" ttm:agent="v2" itunes:key="L26"><span begin="01:48.098" end="01:48.445">ずっ</span><span begin="01:48.445" end="01:48.720">と</span><span begin="01:48.797" end="01:49.491">じゃなくて</span><span begin="01:49.491" end="01:49.797">い</span><span begin="01:49.797" end="01:50.800">い</span></p><p begin="01:50.901" end="01:57.309" ttm:agent="v2" itunes:key="L27"><span begin="01:50.901" end="01:51.703">雨が止</span><span begin="01:51.703" end="01:52.253">む</span><span begin="01:52.253" end="01:53.037">まで</span><span begin="01:53.037" end="01:53.458">こ</span><span begin="01:53.458" end="01:54.402">の</span><span begin="01:54.402" end="01:54.840">まま</span><span begin="01:54.840" end="01:55.436">いさせ</span><span begin="01:55.436" end="01:57.309">て</span></p><p begin="01:55.889" end="01:57.263" ttm:agent="v7" itunes:key="L28"><span begin="01:55.889" end="01:56.485">信じた</span><span begin="01:56.485" end="01:56.827">明日</span><span begin="01:56.827" end="01:57.263">も</span></p><p begin="01:57.311" end="01:59.125" ttm:agent="v7" itunes:key="L29"><span begin="01:57.311" end="01:57.751">君は</span><span begin="01:57.751" end="01:58.113">過去と</span><span begin="01:58.113" end="01:58.435">笑う</span><span begin="01:58.435" end="01:59.125">の？</span><span ttm:role="x-translation" xml:lang="zh-Hans">相信的明天</span></p><p begin="01:59.165" end="02:01.008" ttm:agent="v7" itunes:key="L30"><span begin="01:59.165" end="01:59.603">流し</span><span begin="01:59.603" end="01:59.878">去る</span><span begin="01:59.878" end="02:00.510">力も</span><span begin="02:00.510" end="02:01.008">無く</span><span ttm:role="x-translation" xml:lang="zh-Hans">你在某处 笑着？</span></p><p begin="02:01.018" end="02:03.124" ttm:agent="v7" itunes:key="L31"><span begin="02:01.018" end="02:01.464">あの日の</span><span begin="02:01.464" end="02:01.927">ままで</span><span begin="02:01.927" end="02:02.399">時間が</span><span begin="02:02.399" end="02:02.683">止ま</span><span begin="02:02.683" end="02:03.124">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">让这些逝去的力量都没有</span></p><p begin="02:03.134" end="02:04.733" ttm:agent="v7" itunes:key="L32"><span begin="02:03.134" end="0