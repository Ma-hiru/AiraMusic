66" end="00:44.077" ttm:agent="v1" itunes:key="L5"><span begin="00:40.666" end="00:41.533">離開你</span><span begin="00:41.676" end="00:42.981">我安靜地</span><span begin="00:42.981" end="00:44.077">抽離</span></p><p begin="00:44.332" end="00:47.323" ttm:agent="v1" itunes:key="L6"><span begin="00:44.332" end="00:45.827">不忍揭曉</span><span begin="00:45.827" end="00:46.575">的劇</span><span begin="00:46.575" end="00:47.323">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;我回来了&quot;的瞬间</span></p><p begin="00:47.332" end="00:50.030" ttm:agent="v1" itunes:key="L7"><span begin="00:47.332" end="00:48.304">我的淚</span><span begin="00:48.304" end="00:48.978">流在</span><span begin="00:48.978" end="00:49.374">心</span><span begin="00:49.374" end="00:50.030">裡</span></p><p begin="00:50.258" end="00:52.924" ttm:agent="v1" itunes:key="L8"><span begin="00:50.258" end="00:50.939">學</span><span begin="00:50.939" end="00:51.373">會</span><span begin="00:51.373" end="00:51.861">放</span><span begin="00:51.861" end="00:52.924">棄</span></p><p begin="00:53.210" end="00:56.117" ttm:agent="v1" itunes:key="L9"><span begin="00:53.210" end="00:53.555">聽雨的</span><span begin="00:53.555" end="00:53.983">聲</span><span begin="00:53.983" end="00:54.429">音</span> <span begin="00:54.584" end="00:55.055">一滴滴</span><span begin="00:55.055" end="00:55.534">清</span><span begin="00:55.534" end="00:56.117">晰</span></p><p begin="00:56.417" end="01:01.152" ttm:agent="v1" itunes:key="L10"><span begin="00:56.417" end="00:57.604">你的呼吸像</span><span begin="00:57.604" end="00:58.488">雨滴</span><span begin="00:58.608" end="00:59.971">滲入我的</span><span begin="00:59.971" end="01:01.152">愛裡</span><span ttm:role="x-translation" xml:lang="zh-Hans">无需刻意变得坚强</span></p><p begin="01:01.602" end="01:05.205" ttm:agent="v1" itunes:key="L11"><span begin="01:01.602" end="01:02.673">真希望</span><span begin="01:02.673" end="01:03.834">雨能下</span><span begin="01:03.834" end="01:05.205">不停</span><span ttm:role="x-translation" xml:lang="zh-Hans">自诞生那刻起始终纯粹如初</span></p><p begin="01:05.315" end="01:11.315" ttm:agent="v1" itunes:key="L12"><span begin="01:05.315" end="01:05.651">讓</span><span begin="01:05.651" end="01:06.607">想</span><span begin="01:06.607" end="01:08.061">念繼續</span> <span begin="01:08.315" end="01:08.636">讓</span><span begin="01:08.636" end="01:09.591">愛</span><span begin="01:09.591" end="01:11.315">變透明</span></p><p begin="01:11.319" end="01:16.889" ttm:agent="v1" itunes:key="L13"><span begin="01:11.319" end="01:11.812">我愛</span><span begin="01:11.812" end="01:12.305">上</span><span begin="01:12.305" end="01:12.798">給</span><span begin="01:12.798" end="01:13.291">我</span><span begin="01:13.547" end="01:14.592">勇氣的</span><span begin="01:14.592" end="01:15.699">Rainie</span> <span begin="01:15.699" end="01:16.889">Love</span></p><p begin="01:17.113" end="01:20.181" ttm:agent="v1" itunes:key="L14"><span begin="01:17.113" end="01:17.573">窗外的</span><span begin="01:17.573" end="01:18.033">雨</span><span begin="01:18.033" end="01:18.493">滴</span> <span begin="01:18.617" end="01:19.109">一滴滴</span><span begin="01:19.109" end="01:19.658">累</span><span begin="01:19.658" end="01:20.181">積</span><span ttm:role="x-translation" xml:lang="zh-Hans">感谢你将这个道理教予我</span></p><p begin="01:20.416" end="01:25.552" ttm:agent="v1" itunes:key="L15"><span begin="01:20.416" end="01:21.700">屋內的濕氣</span><span begin="01:21.700" end="01:22.869">像儲存</span><span begin="01:22.869" end="01:23.741">愛你</span><span begin="01:23.741" end="01:24.498">的</span><span begin="01:24.498" end="01:25.552">記憶</span></p><p begin="01:25.604" end="01:29.228" ttm:agent="v1" itunes:key="L16"><span begin="01:25.604" end="01:26.682">真希望</span><span begin="01:26.682" end="01:27.840">雨能下</span><span begin="01:27.840" end="01:29.228">不停</span></p><p begin="01:29.337" end="01:35.098" ttm:agent="v1" itunes:key="L17"><span begin="01:29.337" end="01:29.840">雨</span><span begin="01:29.840" end="01:30.649">愛</span><span begin="01:30.649" end="01:32.124">的秘密</span><span begin="01:32.214" end="01:32.650">能</span><span begin="01:32.650" end="01:33.507">一</span><span begin="01:33.507" end="01:35.098">直延續</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你共度的美味餐食</span></p><p begin="01:35.369" end="01:44.186" ttm:agent="v1" itunes:key="L18"><span begin="01:35.369" end="01:35.749">我相</span><span begin="01:35.749" end="01:36.403">信</span><span begin="01:36.403" end="01:37.199">我將</span><span begin="01:37.529" end="01:38.582">會看到</span> <span begin="01:38.582" end="01:41.279">彩虹的美</span><span begin="01:41.279" end="01:44.186">麗</span></p><p begin="02:06.484" end="02:10.099" ttm:agent="v1" itunes:key="L19"><span begin="02:06.484" end="02:07.797">冷冷的</span><span begin="02:07.797" end="02:08.746">空</span><span begin="02:08.746" end="02:10.099">氣</span></p><p begin="02:10.875" end="02:15.384" ttm:agent="v1" itunes:key="L20"><span begin="02:10.875" end="02:11.537">很窒</span><span begin="02:11.537" end="02:12.199">息</span> <span begin="02:13.006" end="02:13.897">我無法</span><span begin="02:13.897" end="02:15.384">呼吸</span><span ttm:role="x-translation" xml:lang="zh-Hans">怀有贪念也未尝不可</span></p><p begin="02:16.617" end="02:22.132" ttm:agent="v1" itunes:key="L21"><span begin="02:16.617" end="02:17.840">一萬顆</span> <span begin="02:18.355" end="02:19.678">雨滴的</span><span begin="02:19.678" end="02:20.617">距</span><span begin="02:20.617" end="02:22.132">離</span></p><p begin="02:22.991" end="02:28.304" ttm:agent="v1" itunes:key="L22"><span begin="02:22.991" end="02:23.622">很徹</span><span begin="02:23.622" end="02:24.253">底</span> <span begin="02:24.762" end="02:25.998">讓愛消失</span><span begin="02:25.998" end="02:28.304">無息</span></p><p begin="02:28.614" end="02:32.274" ttm:agent="v1" itunes:key="L23"><span begin="02:28.614" end="02:29.607">離開你</span><span begin="02:29.607" end="02:31.001">我安靜地</span><span begin="02:31.001" end="02:32.274">抽離</span><span ttm:role="x-translation" xml:lang="zh-Hans">正因如此更要坦诚以对</span></p><p begin="02:32.341" en