<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="29017078"/><amll:meta key="appleMusicId" value="1535535911"/><amll:meta key="musicName" value="unravel"/><amll:meta key="artists" value="TK from 凛として時雨"/><amll:meta key="album" value="Fantastic Magic"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:00.667"><div begin="00:00.795" end="03:48.760"><p begin="00:00.795" end="00:06.438" ttm:agent="v1" itunes:key="L1"><span begin="00:00.795" end="00:01.396">教</span><span begin="00:01.396" end="00:01.697">え</span><span begin="00:01.697" end="00:02.072">て</span> <span begin="00:02.157" end="00:02.975">教</span><span begin="00:02.975" end="00:03.455">え</span><span begin="00:03.455" end="00:03.963">て</span><span begin="00:03.963" end="00:04.170">よ</span> <span begin="00:04.274" end="00:04.826">その</span><span begin="00:05.186" end="00:05.924">仕組み</span><span begin="00:05.924" end="00:06.438">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">请告诉我 告诉我吧 世间之理</span></p><p begin="00:08.078" end="00:13.668" ttm:agent="v1" itunes:key="L2"><span begin="00:08.078" end="00:08.679">僕</span><span begin="00:08.679" end="00:08.912">の</span><span begin="00:08.912" end="00:09.695">中</span><span begin="00:09.695" end="00:10.351">に</span><span begin="00:11.260" end="00:12.196">誰</span><span begin="00:12.196" end="00:12.560">が</span><span begin="00:12.560" end="00:13.147">いる</span><span begin="00:13.147" end="00:13.668">の？</span><span ttm:role="x-translation" xml:lang="zh-Hans">有谁存在于我的体内？</span></p><p begin="00:15.148" end="00:20.898" ttm:agent="v1" itunes:key="L3"><span begin="00:15.148" end="00:15.857">壊</span><span begin="00:15.857" end="00:16.539">れた</span> <span begin="00:16.539" end="00:17.458">壊</span><span begin="00:17.458" end="00:18.261">れた</span><span begin="00:18.261" end="00:18.596">よ</span> <span begin="00:18.641" end="00:19.565">この</span><span begin="00:19.565" end="00:19.795">世</span><span begin="00:19.795" end="00:20.464">界</span><span begin="00:20.464" end="00:20.898">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在这个坏掉了的世界里</span></p><p begin="00:22.288" end="00:27.788" ttm:agent="v1" itunes:key="L4"><span begin="00:22.288" end="00:23.050">君</span><span begin="00:23.050" end="00:23.225">が</span><span begin="00:23.225" end="00:23.920">笑</span><span begin="00:23.920" end="00:24.821">う</span> <span begin="00:25.722" end="00:26.513">何</span><span begin="00:26.513" end="00:27.171">も見え</span><span begin="00:27.171" end="00:27.788">ずに</span><span ttm:role="x-translation" xml:lang="zh-Hans">你笑着 什么也没有看到</span></p><p begin="00:41.904" end="00:47.614" ttm:agent="v1" itunes:key="L5"><span begin="00:41.904" end="00:42.419">壊</span><span begin="00:42.419" end="00:43.288">れた</span><span begin="00:43.437" end="00:43.907">僕</span><span begin="00:43.907" end="00:44.517">なんて</span><span begin="00:44.517" end="00:44.800">さ</span> <span begin="00:45.340" end="00:45.987">息</span><span begin="00:45.987" end="00:46.358">を</span><span begin="00:46.358" end="00:47.124">止め</span><span begin="00:47.124" end="00:47.614">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">逐渐崩坏的我屏住气息</span></p><p begin="00:48.924" end="00:55.714" ttm:agent="v1" itunes:key="L6"><span begin="00:48.924" end="00:49.887">ほどけない</span> <span begin="00:50.281" end="00:50.647">もう</span> <span begin="00:50.647" end="00:52.060">ほどけない</span><span begin="00:52.060" end="00:52.423">よ</span> <span begin="00:52.662" end="00:53.102">真</span><span begin="00:53.102" end="00:53.796">実</span><span begin="00:54.072" end="00:54.742">さえ</span> <span begin="00:55.028" end="00:55.714">Freeze</span><span ttm:role="x-translation" xml:lang="zh-Hans">解不开啊 已经无法解开</span></p><p begin="00:56.064" end="00:59.504" ttm:agent="v1" itunes:key="L7"><span begin="00:56.064" end="00:56.430">壊</span><span begin="00:56.430" end="00:56.886">せる</span> <span begin="00:56.886" end="00:57.301">壊</span><span begin="00:57.301" end="00:57.727">せない</span> <span begin="00:57.727" end="00:58.051">狂</span><span begin="00:58.051" end="00:58.674">える</span> <span begin="00:58.674" end="00:59.032">狂</span><span begin="00:59.032" end="00:59.504">えない</span><span ttm:role="x-translation" xml:lang="zh-Hans">逐渐崩坏 没有崩坏 快要疯狂 没有疯狂</span></p><p begin="00:59.613" end="01:03.183" ttm:agent="v1" itunes:key="L8"><span begin="00:59.613" end="01:00.353">あなたを</span><span begin="01:00.506" end="01:01.013">見つ</span><span begin="01:01.013" end="01:01.687">けて</span> <span begin="01:02.291" end="01:03.183">揺れた</span><span ttm:role="x-translation" xml:lang="zh-Hans">追逐着你的身影</span></p><p begin="01:03.193" end="01:10.208" ttm:agent="v1" itunes:key="L9"><span begin="01:03.193" end="01:03.627">歪</span><span begin="01:03.627" end="01:04.055">んだ</span><span begin="01:04.055" end="01:04.693">世界</span><span begin="01:04.693" end="01:05.040">に</span><span begin="01:05.040" end="01:05.818">だんだん</span><span begin="01:05.818" end="01:06.318">僕</span><span begin="01:06.318" end="01:06.667">は</span> <span begin="01:06.667" end="01:07.325">透き</span><span begin="01:07.325" end="01:07.984">通っ</span><span begin="01:07.984" end="01:08.498">て</span><span begin="01:08.498" end="01:09.102">見え</span><span begin="01:09.102" end="01:09.424">なく</span><span begin="01:09.424" end="01:10.208">なって</span><span ttm:role="x-translation" xml:lang="zh-Hans">立于动荡扭曲的世界之中</span></p><p begin="01:10.263" end="01:17.327" ttm:agent="v1" itunes:key="L10"><span begin="01:10.263" end="01:10.535">見</span><span begin="01:10.535" end="01:11.211">つけ</span><span begin="01:11.211" end="01:11.606">ない</span><span begin="01:11.606" end="01:12.073">で</span> <span begin="01:12.073" end="01:12.786">僕</span><span begin="01:12.786" end="01:13.045">の</span><span begin="01:13.045" end="01:13.896">こと</span><span begin="01:13.896" end="01:14.797">を</span> <span begin="01:15.433" end="01:16.550">見つめ</span><span begin="01:16.550" end="01:16.869">ない</span><span begin="01:16.869" end="01:17.327">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">不要找到我 不要寻找我</span></p><p begin="01:17.403" end="01:20.763" ttm:agent="v1" itunes:key="L11"><span begin="01:17.403" end="01:17.775">誰</span><span begin="01:17.775" end="01:18.303">かが</span><span begin="01:18.303" end="01:18.600">描</span><span begin="01:18.600" end="01:19.131">いた</span><span begin="01:19.131" end="01:19.569">世界</span><span begin="01:19.569" end="01:20.008">の</span><span begin="01:20.008" end="01:20.417">中</span><span begin="01:20.417" end="01:20.763">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">在某人描绘的世界中</span></p><p begin="01:20.933" end="01:24.363" ttm:agent="v1" itunes:key="L12"><span begin="01:20.933" end="01:21.530">あなた</span><span begin="01:21.530" end="01:21.852">を</span><span begin="01:21.852" end="01:22.342">傷</span><span begin="01:22.342" end="01:22.722">つけ</span><span begin="01:22.722" end="01:22.970">た</span><span begin="01:22.970" end="01:23.297">く</span><span begin="01:23.297" end="01:23.678">は</span><span begin="01:23.678" end="01:23.987">ない</span><span begin="01:23.987" end="01:24.363">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不想让你受到伤害</span></p><p begin="01:24.503" end="01:28.723" ttm:agent="v1" itunes:key="L13"><span begin="01:24.503" end="01:25.085">覚</span><span begin="01:25.085" end="01:25.910">えていて</span> <span begin="01:26.323" end="01:27.030">僕</span><span begin="01:27.030" end="01:27.274">の</span><span begin="01:27.274" end="01:28.205">こと</span><span begin="01:28.205" end="01:28.723">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">希望在你的心中</span></p><p begin="01:33.413" end="01:35.685" ttm:agent="v1" itunes:key="L14"><span begin="01:33.413" end="01:33.921">鮮</span><span begin="01:33.921" end="01:34.724">やかな</span><span begin="01:34.724" end="01:35.685">まま</span><span ttm:role="x-translation" xml:lang="zh-Hans">这鲜明的存在</span></p><p begin="01:42.324" end="01:45.714" ttm:agent="v1" itunes:key="L15"><span begin="01:42.324" end="01:42.823">無限</span><span begin="01:42.823" end="01:43.124">に</span><span begin="01:43.124" end="01:43.491">広</span><span begin="01:43.491" end="01:43.967">がる</span><span begin="01:43.967" end="01:44.506">孤独</span><span begin="01:44.506" end="01:44.912">が</span><span begin="01:44.912" end="01:45.301">絡</span><span begin="01:45.301" end="01:45.714">まる</span><span ttm:role="x-translation" xml:lang="zh-Hans">坠入无限扩张的孤独</span></p><p begin="01:45.837" end="01:49.237" ttm:agent="v1" itunes:key="L16"><span begin="01:45.837" end="01:46.651">無邪気に</span><span begin="01:46.651" end="01:47.057">笑っ</span><span begin="01:47.057" end="01:47.540">た</span><span begin="01:47.540" end="01:48.012">記憶</span><span begin="01:48.012" end="01:48.352">が</span><span begin="01:48.352" end="01:48.956">刺さっ</span><span begin="01:48.956" end="01:49.237">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">纯洁的欢乐记忆刺痛神经</span></p><p begin="01:49.374" end="01:52.854" ttm:agent="v1" itunes:key="L17"><span begin="01:49.374" end="01:49.778">動</span><span begin="01:49.778" end="01:50.244">けない</span> <span begin="01:50.244" end="01:50.794">動</span><span begin="01:50.794" end="01:51.271">けない</span> <span begin="01:51.271" end="01:51.694">動</span><span begin="01:51.694" end="01:52.133">けない</span> <span begin="01:52.133" end="01:52.553">動</span><span begin="01:52.553" end="01:52.854">けない</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法动弹 无法动弹 无法动弹</span></p><p begin="01:52.997" end="01:55.477" ttm:agent="v1" itunes:key="L18"><span begin="01:52.997" end="01:53.419">動</span><span begin="01:53.419" end="01:53.945">けない</span> <span begin="01:53.945" end="01:54.455">動</span><span begin="01:54.455" end="01:55.101">けない</span><span begin="01:55.101" end="01:55.477">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">无法动弹 无法动弹 无法动弹啊</span></p><p begin="01:55.652" end="01:57.562" ttm:agent="v1" itunes:key="L19"><span begin="01:55.652" end="01:56.543">Unravelling</span> <span begin="01:56.543" end="01:56.811">the</span> <span begin="01:56.811" end="01:57.562">world</span><span ttm:role="x-translation" xml:lang="zh-Hans">解开世界的面纱</span></p><p begin="02:25.001" end="02:28.401" ttm:agent="v1" itunes:key="L20"><span begin="02:25.001" end="02:25.790">変わって</span><span begin="02:25.790" end="02:26.407">しまっ</span><span begin="02:26.407" end="02:26.757">た</span> <span begin="02:26.757" end="02:27.509">変えられ</span><span begin="02:27.509" end="02:28.125">なかっ</span><span begin="02:28.125" end="02:28.401">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经改变的 改变不了的</span></p><p begin="02:28.521" end="02:31.911" ttm:agent="v1" itunes:key="L21"><span begin="02:28.521" end="02:29.072">2つ</span><span begin="02:29.072" end="02:29.347">が</span><span begin="02:29.347" end="02:29.802">絡</span><span begin="02:29.802" end="02:29.965">ま</span><span begin="02:29.965" end="02:30.190">る</span> <span begin="02:30.190" end="02:30.715">2人</span><span begin="02:30.715" end="02:31.068">が</span><span begin="02:31.172" end="02:31.576">滅</span><span begin="02:31.576" end="02:31.911">びる</span><span ttm:role="x-translation" xml:lang="zh-Hans">两人交错缠绕 两人走向毁灭</span></p><p begin="02:32.051" end="02:35.491" ttm:agent="v1" itunes:key="L22"><span begin="02:32.051" end="02:32.417">壊</span><span begin="02:32.417" end="02:32.873">せる</span> <span begin="02:32.873" end="02:33.288">壊</span><span begin="02:33.288" end="02:33.714">せない</span> <span begin="02:33.714" end="02:34.038">狂</span><span begin="02:34.038" end="02:34.661">える</span> <span begin="02:34.661" end="02:35.019">狂</span><span begin="02:35.019" end="02:35.491">えない</span><span ttm:role="x-translation" xml:lang="zh-Hans">逐渐崩坏 没有崩坏 快要疯狂 没有疯狂</span></p><p begin="02:35.621" end="02:39.171" ttm:agent="v1" itunes:key="L23"><span begin="02:35.621" end="02:36.186">あなた</span><span begin="02:36.186" end="02:36.509">を</span><span begin="02:36.509" end="02:36.956">汚</span><span begin="02:36.956" end="02:37.840">せない</span><span begin="02:37.840" end="02:38.271">よ</span> <span begin="02:38.271" end="02:38.519">揺</span><span begin="02:38.519" end="02:38.907">れ</span><span begin="02:38.907" end="02:39.171">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">不想让你染上污秽</span></p><p begin="02:39.224" end="02:42.574" ttm:agent="v1" itunes:key="L24"><span begin="02:39.224" end="02:39.644">歪</span><span begin="02:39.644" end="02:40.087">んだ</span><span begin="02:40.087" end="02:40.616">世界</span><span begin="02:40.616" end="02:41.057">に</span><span begin="02:41.057" end="02:41.809">だんだん</span><span begin="02:41.809" end="02:42.202">僕</span><span begin="02:42.202" end="02:42.574">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">立于动荡扭曲的世界之中</span></p><p begin="02:42.765" end="02:46.195" ttm:agent="v1" itunes:key="L25"><span begin="02:42.765" end="02:43.443">透き</span><span begin="02:43.443" end="02:44.066">通っ</span><span begin="02:44.066" end="02:44.491">て</span><span begin="02:44.491" end="02:45.001">見え</span><span begin="02:45.001" end="02:45.292">なく</span><span begin="02:45.292" end="02:45.804">なっ</span><span begin="02:45.804" end="02:46.195">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">我的身影逐渐遁入黑暗</span></p><p begin="02:46.304" end="02:50.425" ttm:agent="v1" itunes:key="L26"><span begin="02:46.304" end="02:46.598">見</span><span begin="02:46.598" end="02:47.222">つけ</span><span begin="02:47.222" end="02:48.088">ないで</span> <span begin="02:48.088" end="02:48.766">僕</span><span begin="02:48.766" end="02:49.009">の</span><span begin="02:49.009" end="02:49.820">こと</span><span begin="02:49.820" end="02:50.425">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">不要找到我 不要寻找我</span></p><p begin="02:51.585" end="02:53.235" ttm:agent="v1" itunes:key="L27"><span begin="02:51.585" end="02:52.580">見つめ</span><span begin="02:52.580" end="02:52.865">ない</span><span begin="02:52.865" end="02:53.235">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">别再看着我</span></p><p begin="02:53.415" end="02:56.795" ttm:agent="v1" itunes:key="L28"><span begin="02:53.415" end="02:53.923">誰</span><span begin="02:53.923" end="02:54.299">かが</span><span begin="02:54.299" end="02:55.068">仕組んだ</span><span begin="02:55.068" end="02:55.662">孤独</span><span begin="02:55.662" end="02:56.074">な</span><span begin="02:56.074" end="02:56.490">罠</span><span begin="02:56.490" end="02:56.795">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在某人设下的孤独陷阱中</span></p><p begin="02:56.955" end="03:00.355" ttm:agent="v1" itunes:key="L29"><span begin="02:56.955" end="02:57.497">未来</span><span begin="02:57.497" end="02:57.874">が</span><span begin="02:57.874" end="02:58.334">ほど</span><span begin="02:58.334" end="02:58.763">けて</span><span begin="02:58.763" end="02:59.545">しまう</span><span begin="02:59.545" end="02:59.966">前</span><span begin="02:59.966" end="03:00.355">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">解开未来枷锁的前一刻</span></p><p begin="03:00.515" end="03:04.725" ttm:agent="v1" itunes:key="L30"><span begin="03:00.515" end="03:01.457">思い</span><span begin="03:01.457" end="03:02.104">出して</span> <span begin="03:02.293" end="03:02.861">僕</span><span begin="03:02.861" end="03:03.248">の</span><span begin="03:03.248" end="03:04.162">こと</span><span begin="03:04.162" end="03:04.725">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">希望在你的心中</span></p><p begin="03:07.667" end="03:10.771" ttm:agent="v1" itunes:key="L31"><span begin="03:07.667" end="03:08.293">鮮</span><span begin="03:08.293" end="03:09.425">やかな</span><span begin="03:09.425" end="03:09.833">ま</span><span begin="03:09.833" end="03:10.771">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">这鲜明的存在</span></p><p begin="03:11.205" end="03:14.555" ttm:agent="v1