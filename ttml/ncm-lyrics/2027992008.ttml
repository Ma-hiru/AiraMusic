<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="2027992008"/><amll:meta key="appleMusicId" value="1673191257"/><amll:meta key="musicName" value="uni-verse"/><amll:meta key="artists" value="オーイシマサヨシ"/><amll:meta key="album" value="ギフト"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:31.622"><div begin="00:01.025" end="04:20.159"><p begin="00:01.025" end="00:02.892" ttm:agent="v1" itunes:key="L1"><span begin="00:01.025" end="00:01.705">ユニ</span><span begin="00:01.705" end="00:02.524">バー</span><span begin="00:02.524" end="00:02.892">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="00:03.190" end="00:05.057" ttm:agent="v1" itunes:key="L2"><span begin="00:03.190" end="00:03.870">ユニ</span><span begin="00:03.870" end="00:04.689">バー</span><span begin="00:04.689" end="00:05.057">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="00:04.873" end="00:06.740" ttm:agent="v1" itunes:key="L3"><span begin="00:04.873" end="00:05.553">ユニ</span><span begin="00:05.553" end="00:06.372">バー</span><span begin="00:06.372" end="00:06.740">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="00:09.507" end="00:14.427" ttm:agent="v1" itunes:key="L4"><span begin="00:09.507" end="00:09.965">もう</span><span begin="00:09.965" end="00:10.378">忘</span><span begin="00:10.378" end="00:10.898">れて</span><span begin="00:10.898" end="00:12.087">しまったか</span><span begin="00:12.087" end="00:12.397">い？</span> <span begin="00:12.618" end="00:13.012">覚</span><span begin="00:13.012" end="00:13.271">えて</span><span begin="00:13.271" end="00:13.772">ない</span><span begin="00:13.772" end="00:14.054">か</span><span begin="00:14.054" end="00:14.427">い？</span><span ttm:role="x-translation" xml:lang="zh-Hans">你已经忘记了吗？</span></p><p begin="00:14.732" end="00:18.130" ttm:agent="v1" itunes:key="L5"><span begin="00:14.732" end="00:15.162">僕</span><span begin="00:15.162" end="00:15.539">らが</span><span begin="00:15.539" end="00:16.211">見た</span><span begin="00:16.623" end="00:17.021">「宇宙」</span><span begin="00:17.021" end="00:17.249">の</span><span begin="00:17.249" end="00:17.715">こと</span><span begin="00:17.715" end="00:18.130">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们曾经见到的那片“宇宙”</span></p><p begin="00:18.130" end="00:22.403" ttm:agent="v1" itunes:key="L6"><span begin="00:18.130" end="00:18.728">世界</span><span begin="00:18.728" end="00:18.972">の</span><span begin="00:18.972" end="00:19.628">平和</span><span begin="00:19.628" end="00:20.073">さえ</span> <span begin="00:20.452" end="00:20.719">僕</span><span begin="00:20.719" end="00:21.097">らの</span><span begin="00:21.097" end="00:21.581">手に</span><span begin="00:21.581" end="00:22.036">かかって</span><span begin="00:22.036" end="00:22.403">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">甚至连整个世界的和平</span></p><p begin="00:23.103" end="00:27.852" ttm:agent="v1" itunes:key="L7"><span begin="00:23.103" end="00:23.987">嘘</span><span begin="00:23.987" end="00:24.657">みた</span><span begin="00:24.657" end="00:25.184">いな</span><span begin="00:25.627" end="00:26.653">日々</span><span begin="00:26.653" end="00:27.143">の</span><span begin="00:27.143" end="00:27.852">こと</span><span ttm:role="x-translation" xml:lang="zh-Hans">如同谎言般虚幻的过往</span></p><p begin="00:27.852" end="00:34.840" ttm:agent="v1" itunes:key="L8"><span begin="00:27.852" end="00:29.036">自由</span><span begin="00:29.237" end="00:30.413">自在</span><span begin="00:30.413" end="00:31.241">に</span><span begin="00:31.241" end="00:31.628">手</span><span begin="00:31.628" end="00:32.159">を</span><span begin="00:32.159" end="00:32.670">伸ば</span><span begin="00:32.670" end="00:33.230">した</span><span begin="00:33.375" end="00:34.180">シナ</span><span begin="00:34.180" end="00:34.840">リオ</span><span ttm:role="x-translation" xml:lang="zh-Hans">自由自在伸出双手恣意书写的剧本</span></p><p begin="00:34.940" end="00:39.643" ttm:agent="v1" itunes:key="L9"><span begin="00:34.940" end="00:35.957">ジャンク</span><span begin="00:35.957" end="00:36.897">だらけ</span><span begin="00:36.897" end="00:37.984">に見える</span><span begin="00:37.984" end="00:38.951">今日の</span><span begin="00:38.951" end="00:39.643">日も</span><span ttm:role="x-translation" xml:lang="zh-Hans">就连犹如废物一般</span></p><p begin="00:39.643" end="00:43.303" ttm:agent="v1" itunes:key="L10"><span begin="00:39.643" end="00:40.468">ユニ</span><span begin="00:40.468" end="00:41.057">バー</span><span begin="00:41.057" end="00:41.308">ス</span> <span begin="00:41.468" end="00:42.391">あらゆるものが</span><span begin="00:42.391" end="00:43.051">生まれ</span><span begin="00:43.051" end="00:43.303">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">也是宇宙</span></p><p begin="00:43.303" end="00:47.204" ttm:agent="v1" itunes:key="L11"><span begin="00:43.303" end="00:44.138">ユニ</span><span begin="00:44.138" end="00:44.773">バー</span><span begin="00:44.773" end="00:45.105">ス</span> <span begin="00:45.285" end="00:45.622">何</span><span begin="00:45.622" end="00:46.242">にだっ</span><span begin="00:46.242" end="00:46.637">て</span><span begin="00:46.637" end="00:46.881">なれ</span><span begin="00:46.881" end="00:47.204">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="00:47.204" end="00:55.225" ttm:agent="v1" itunes:key="L12"><span begin="00:47.204" end="00:48.155">ユニ</span><span begin="00:48.155" end="00:48.994">バー</span><span begin="00:48.994" end="00:49.290">ス</span> <span begin="00:49.309" end="00:49.835">無限の</span><span begin="00:49.835" end="00:50.776">想像の</span><span begin="00:50.776" end="00:51.561">中から</span><span begin="00:51.644" end="00:52.124">宇</span><span begin="00:52.124" end="00:52.492">宙</span><span begin="00:52.492" end="00:53.083">が</span><span begin="00:53.083" end="00:54.616">広が</span><span begin="00:54.616" end="00:55.225">った</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="00:55.344" end="00:57.705" ttm:agent="v1" itunes:key="L13"><span begin="00:55.344" end="00:55.560">さ</span><span begin="00:55.560" end="00:55.812">あ</span><span begin="00:56.179" end="00:56.647">顔を</span><span begin="00:56.647" end="00:57.099">上げ</span><span begin="00:57.099" end="00:57.705">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 仰起头来</span></p><p begin="00:58.109" end="01:03.765" ttm:agent="v1" itunes:key="L14"><span begin="00:58.109" end="00:58.415">僕</span><span begin="00:58.415" end="00:58.638">に</span><span begin="00:58.638" end="00:59.050">見せ</span><span begin="00:59.050" end="00:59.845">て</span> <span begin="01:00.013" end="01:00.889">君が</span><span begin="01:00.889" end="01:02.009">持ってる</span><span begin="01:02.009" end="01:02.809">ユニ</span><span begin="01:02.809" end="01:03.273">バー</span><span begin="01:03.273" end="01:03.765">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽情向我展现</span></p><p begin="01:03.944" end="01:11.487" ttm:agent="v1" itunes:key="L15"><span begin="01:03.944" end="01:04.403">バカ</span><span begin="01:04.403" end="01:04.966">話</span><span begin="01:04.966" end="01:05.703">に</span><span begin="01:05.964" end="01:07.404">花咲かせて</span> <span begin="01:07.760" end="01:08.503">笑</span><span begin="01:08.503" end="01:08.846">い</span><span begin="01:08.846" end="01:09.476">転</span><span begin="01:09.476" end="01:09.917">げて</span><span begin="01:09.917" end="01:11.063">ユニバー</span><span begin="01:11.063" end="01:11.487">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">连闲聊玩笑也能让鲜花绽放</span></p><p begin="01:11.745" end="01:19.327" ttm:agent="v1" itunes:key="L16"><span begin="01:11.745" end="01:12.478">時代は</span><span begin="01:12.478" end="01:13.255">変わる</span> <span begin="01:13.456" end="01:13.944">僕</span><span begin="01:13.944" end="01:14.371">らも</span><span begin="01:14.371" end="01:14.798">変わ</span><span begin="01:14.798" end="01:15.165">る</span> <span begin="01:15.724" end="01:16.806">それでも</span><span begin="01:16.806" end="01:17.652">心</span><span begin="01:17.652" end="01:17.852">は</span><span begin="01:17.852" end="01:19.022">ユニバー</span><span begin="01:19.022" end="01:19.327">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">时代瞬息万变 我们也随之改变</span></p><p begin="01:19.547" end="01:23.566" ttm:agent="v1" itunes:key="L17"><span begin="01:19.547" end="01:19.971">独</span><span begin="01:19.971" end="01:20.563">りじゃ</span><span begin="01:20.563" end="01:21.155">ない</span> <span begin="01:21.618" end="01:22.328">いつの日も</span><span begin="01:22.328" end="01:23.002">どこまで</span><span begin="01:23.002" end="01:23.566">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">绝非孤身一人</span></p><p begin="01:23.566" end="01:27.328" ttm:agent="v1" itunes:key="L18"><span begin="01:23.566" end="01:24.277">重</span><span begin="01:24.277" end="01:24.875">なり</span><span begin="01:24.875" end="01:25.447">合うよ</span> <span begin="01:25.642" end="01:26.913">ユニバー</span><span begin="01:26.913" end="01:27.328">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们的宇宙 将会重合交融</span></p><p begin="01:30.047" end="01:32.147" ttm:agent="v1" itunes:key="L19"><span begin="01:30.047" end="01:30.499">その</span><span begin="01:30.499" end="01:30.937">設定</span><span begin="01:30.937" end="01:31.227">は</span><span begin="01:31.227" end="01:32.038">無理があると</span><span begin="01:32.038" end="01:32.147">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">那个设定有些勉强跳脱</span></p><p begin="01:32.147" end="01:34.067" ttm:agent="v1" itunes:key="L20"><span begin="01:32.147" end="01:32.737">いまいち</span><span begin="01:32.737" end="01:33.402">リアリティに</span><span begin="01:33.402" end="01:33.751">欠ける</span><span begin="01:33.751" end="01:34.067">とか</span><span ttm:role="x-translation" xml:lang="zh-Hans">仍然有些缺乏真实感</span></p><p begin="01:34.167" end="01:38.230" ttm:agent="v1" itunes:key="L21"><span begin="01:34.167" end="01:34.672">いや</span><span begin="01:34.672" end="01:35.516">実際問題</span> <span begin="01:35.516" end="01:36.011">怪獣</span><span begin="01:36.011" end="01:36.354">なんて</span><span begin="01:36.354" end="01:36.999">出ない</span><span begin="01:36.999" end="01:37.430">方が</span><span begin="01:37.430" end="01:38.230">いいけど</span><span ttm:role="x-translation" xml:lang="zh-Hans">不过最现实的问题</span></p><p begin="01:38.430" end="01:42.009" ttm:agent="v1" itunes:key="L22"><span begin="01:38.430" end="01:38.920">夢</span><span begin="01:38.920" end="01:40.179">みたいなことばかり</span> <span begin="01:40.179" end="01:41.205">起こってしまう</span><span begin="01:41.316" end="01:42.009">物語</span><span ttm:role="x-translation" xml:lang="zh-Hans">故事之中满载梦幻一般</span></p><p begin="01:42.009" end="01:48.490" ttm:agent="v1" itunes:key="L23"><span begin="01:42.009" end="01:42.833">疑</span><span begin="01:42.833" end="01:43.293">い</span><span begin="01:43.293" end="01:44.439">ようのない</span> <span begin="01:44.439" end="01:45.369">空想</span><span begin="01:45.369" end="01:46.404">という</span><span begin="01:46.404" end="01:47.266">名の</span><span begin="01:47.266" end="01:47.926">ビッグ</span><span begin="01:47.926" end="01:48.490">バン</span><span ttm:role="x-translation" xml:lang="zh-Hans">毋庸置疑</span></p><p begin="01:48.710" end="01:55.411" ttm:agent="v1" itunes:key="L24"><span begin="01:48.710" end="01:49.310">あ</span><span begin="01:49.310" end="01:50.072">の</span><span begin="01:50.072" end="01:51.945">時代に</span><span begin="01:51.945" end="01:53.933">思い描いた</span><span begin="01:53.933" end="01:54.966">ヒーロー</span><span begin="01:54.966" end="01:55.411">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">在往昔的时代中畅想描绘的英雄</span></p><p begin="01:55.411" end="01:59.990" ttm:agent="v1" itunes:key="L25"><span begin="01:55.411" end="01:56.028">きっ</span><span begin="01:56.028" end="01:56.592">と</span><span begin="01:56.592" end="01:57.067">まだ</span><span begin="01:57.067" end="01:57.543">胸</span><span begin="01:57.543" end="01:58.049">の</span><span begin="01:58.049" end="01:58.560">中</span><span begin="01:58.560" end="01:58.818">で</span><span begin="01:58.818" end="01:59.538">生き</span><span begin="01:59.538" end="01:59.721">て</span><span begin="01:59.721" end="01:59.990">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">时至今日 必定仍然活在我的心中</span></p><p begin="02:00.090" end="02:03.913" ttm:agent="v1" itunes:key="L26"><span begin="02:00.090" end="02:00.824">ビッグ</span><span begin="02:00.824" end="02:01.531">バ</span><span begin="02:01.531" end="02:01.770">ン</span> <span begin="02:01.915" end="02:02.433">すべて</span><span begin="02:02.433" end="02:02.991">ここから</span><span begin="02:02.991" end="02:03.531">始</span><span begin="02:03.531" end="02:03.913">まる</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙大爆炸 一切自此伊始</span></p><p begin="02:03.913" end="02:07.814" ttm:agent="v1" itunes:key="L27"><span begin="02:03.913" end="02:04.599">ビッグ</span><span begin="02:04.599" end="02:05.502">バ</span><span begin="02:05.502" end="02:05.774">ン</span> <span begin="02:05.774" end="02:06.784">全方位に</span><span begin="02:06.784" end="02:07.299">膨</span><span begin="02:07.299" end="02:07.814">らむ</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙大爆炸 全方位全面膨胀</span></p><p begin="02:07.814" end="02:15.975" ttm:agent="v1" itunes:key="L28"><span begin="02:07.814" end="02:08.702">ビッグ</span><span begin="02:08.702" end="02:09.750">バ</span><span begin="02:09.750" end="02:09.896">ン</span> <span begin="02:09.896" end="02:10.494">そして</span><span begin="02:10.494" end="02:12.060">時間さえ越えて</span> <span begin="02:12.153" end="02:13.926">いま君と</span><span begin="02:13.926" end="02:14.955">交</span><span begin="02:14.955" end="02:15.975">わる</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙大爆炸 甚至得以超越时间</span></p><p begin="02:15.994" end="02:18.695" ttm:agent="v1" itunes:key="L29"><span begin="02:15.994" end="02:16.815">さあ</span><span begin="02:16.815" end="02:17.251">思い</span><span begin="02:17.251" end="02:17.740">出し</span><span begin="02:17.740" end="02:18.695">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 尽快回想起来吧</span></p><p begin="02:18.695" end="02:24.334" ttm:agent="v1" itunes:key="L30"><span begin="02:18.695" end="02:19.289">やって</span><span begin="02:19.289" end="02:19.780">みせ</span><span begin="02:19.780" end="02:20.284">て</span> <span begin="02:20.596" end="02:21.255">君</span><span begin="02:21.255" end="02:21.732">が</span><span begin="02:21.732" end="02:22.599">起こした</span><span begin="02:22.599" end="02:23.213">ビッグ</span><span begin="02:23.382" end="02:24.334">バン</span><span ttm:role="x-translation" xml:lang="zh-Hans">不妨勇敢尝试</span></p><p begin="02:24.696" end="02:30.537" ttm:agent="v1" itunes:key="L31"><span begin="02:24.696" end="02:25.170">あの</span><span begin="02:25.170" end="02:25.678">景色</span><span begin="02:25.678" end="02:26.313">は</span><span begin="02:26.623" end="02:26.996">誰</span><span begin="02:26.996" end="02:27.423">がなんと</span><span begin="02:27.423" end="02:27.866">言おう</span><span begin="02:27.866" end="02:28.295">と</span><span begin="02:28.503" end="02:29.804">本物</span><span begin="02:29.804" end="02:30.066">なん</span><span begin="02:30.066" end="02:30.537">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">那片光景</span></p><p begin="02:30.737" end="02:31.875" ttm:agent="v1" itunes:key="L32"><span begin="02:30.737" end="02:31.306">ビッグ</span><span begin="02:31.306" end="02:31.875">バン</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙大爆炸</span></p><p begin="02:39.418" end="02:43.118" ttm:agent="v1" itunes:key="L33"><span begin="02:39.418" end="02:40.022">もっと</span><span begin="02:40.022" end="02:41.196">聞かせてよ</span> <span begin="02:41.196" end="02:41.881">自慢</span><span begin="02:41.881" end="02:42.924">していい</span><span begin="02:42.924" end="02:43.118">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再多给我讲讲吧 尽情引以为豪吧</span></p><p begin="02:43.210" end="02:46.939" ttm:agent="v1" itunes:key="L34"><span begin="02:43.210" end="02:43.899">君</span><span begin="02:43.899" end="02:44.292">が</span><span begin="02:44.292" end="02:44.584">生</span><span begin="02:44.584" end="02:44.807">き</span><span begin="02:44.807" end="02:45.173">た</span> <span begin="02:45.173" end="02:46.032">その</span><span begin="02:46.032" end="02:46.939">証</span><span ttm:role="x-translation" xml:lang="zh-Hans">这是你曾经活着的印证</span></p><p begin="02:47.256" end="02:51.076" ttm:agent="v1" itunes:key="L35"><span begin="02:47.256" end="02:47.664">ワン</span><span begin="02:47.664" end="02:48.178">バース</span> <span begin="02:48.178" end="02:48.741">ツー</span><span begin="02:48.741" end="02:49.215">バース</span> <span begin="02:49.215" end="02:50.243">スリーバース</span> <span begin="02:50.243" end="02:50.744">ユニ</span><span begin="02:50.744" end="02:51.076">バース</span><span ttm:role="x-translation" xml:lang="zh-Hans">一个宇宙 两个宇宙</span></p><p begin="02:51.076" end="02:56.478" ttm:agent="v1" itunes:key="L36"><span begin="02:51.076" end="02:51.876">繋</span><span begin="02:51.876" end="02:52.186">ぎ</span><span begin="02:52.186" end="02:53.186">合わせて</span> <span begin="02:53.186" end="02:53.738">この</span><span begin="02:53.738" end="02:54.180">歌</span><span begin="02:54.180" end="02:54.719">になる</span><span begin="02:54.719" end="02:56.478">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">全都维系相连 谱写成这首歌曲</span></p><p begin="02:58.140" end="03:00.501" ttm:agent="v1" itunes:key="L37"><span begin="02:58.140" end="02:58.812">さあ</span><span begin="02:58.975" end="02:59.394">顔を</span><span begin="02:59.394" end="02:59.990">上げ</span><span begin="02:59.990" end="03:00.501">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">来吧 仰起头来</span></p><p begin="03:01.080" end="03:06.736" ttm:agent="v1" itunes:key="L38"><span begin="03:01.080" end="03:01.386">僕</span><span begin="03:01.386" end="03:01.609">に</span><span begin="03:01.609" end="03:02.021">見せ</span><span begin="03:02.021" end="03:02.816">て</span> <span begin="03:02.984" end="03:03.860">君が</span><span begin="03:03.860" end="03:04.980">持ってる</span><span begin="03:04.980" end="03:05.780">ユニ</span><span begin="03:05.780" end="03:06.244">バー</span><span begin="03:06.244" end="03:06.736">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽情向我展现</span></p><p begin="03:06.901" end="03:14.444" ttm:agent="v1" itunes:key="L39"><span begin="03:06.901" end="03:07.360">バカ</span><span begin="03:07.360" end="03:07.923">話</span><span begin="03:07.923" end="03:08.660">に</span><span begin="03:08.921" end="03:10.361">花咲かせて</span> <span begin="03:10.717" end="03:11.460">笑</span><span begin="03:11.460" end="03:11.803">い</span><span begin="03:11.803" end="03:12.433">転</span><span begin="03:12.433" end="03:12.874">げて</span><span begin="03:12.874" end="03:14.020">ユニバー</span><span begin="03:14.020" end="03:14.444">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">连闲聊玩笑也能让鲜花绽放</span></p><p begin="03:14.679" end="03:22.261" ttm:agent="v1" itunes:key="L40"><span begin="03:14.679" end="03:15.412">時代は</span><span begin="03:15.412" end="03:16.189">変わる</span> <span begin="03:16.390" end="03:16.878">僕</span><span begin="03:16.878" end="03:17.305">らも</span><span begin="03:17.305" end="03:17.732">変わ</span><span begin="03:17.732" end="03:18.099">る</span> <span begin="03:18.658" end="03:19.740">それでも</span><span begin="03:19.740" end="03:20.586">心</span><span begin="03:20.586" end="03:20.786">は</span><span begin="03:20.786" end="03:21.956">ユニバー</span><span begin="03:21.956" end="03:22.261">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">时代瞬息万变 我们也随之改变</span></p><p begin="03:22.643" end="03:26.662" ttm:agent="v1" itunes:key="L41"><span begin="03:22.643" end="03:22.956">独</span><span begin="03:22.956" end="03:23.335">りじゃ</span><span begin="03:23.335" end="03:24.251">ない</span> <span begin="03:24.714" end="03:25.424">いつの日も</span><span begin="03:25.424" end="03:26.098">どこまで</span><span begin="03:26.098" end="03:26.662">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">绝非孤身一人</span></p><p begin="03:26.683" end="03:30.445" ttm:agent="v1" itunes:key="L42"><span begin="03:26.683" end="03:27.394">重</span><span begin="03:27.394" end="03:27.992">なり</span><span begin="03:27.992" end="03:28.564">合うよ</span> <span begin="03:28.759" end="03:30.030">ユニバー</span><span begin="03:30.030" end="03:30.445">ス</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们的宇宙 将会重合交融</span></p><p begin="03:37.883" end="03:41.774" ttm:agent="v1" itunes:key="L43"><span begin="03:37.883" end="03:38.865">ここ</span><span begin="03:38.865" end="03:39.378">が</span><span begin="03:39.378" end="03:39.887">僕</span><span begin="03:39.887" end="03:40.687">らの</span><span begin="03:40.687" end="03:41.190">ユニ</span><span begin="03:41.190" end="03:41.774">バース</span><span ttm:role="x-translation" xml:lang="zh-Hans">此处就是我们的宇宙</span></p><p begin="03:49.955" end="03:53.637" ttm:agent="v1" itunes:key="L44"><span begin="03:49.955" end="03:50.541">これ</span><span begin="03:50.541" end="03:50.910">が</span><span begin="03:50.910" end="03:51.471">僕</span><span begin="03:51.471" end="03:52.443">らの</span><span begin="03:52.443" end="03:52.929">ユニ</span><span begin="03:52.929" end="03:53.637">バース</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我们的宇宙</span></p><p begin="04:01.497" end="04:05.088" ttm:agent="v1" itunes:key="L45"><span begin="04:01.497" end="04:02.179">ここ</span><span begin="04:02.179" end="04:02.692">が</span><span begin="04:02.692" end="04:03.201">僕</span><span begin="04:03.201" end="04:04.001">らの</span><span begin="04:04.001" end="04:04.504">ユニ</span><span begin="04:04.504" end="04:05.088">バース</span><span ttm:role="x-translation" xml:lang="zh-Hans">此处就是我们的宇宙</span></p><p begin="04:13.198" end="04:17.380" ttm:agent="v1" itunes:key="L46"><span begin="04:13.198" end="04:14.284">これ</span><span begin="04:14.284" end="04:14.653">が</span><span begin="04:14.653" end="04:15.214">僕</span><span begin="04:15.214" end="04:16.186">らの</span><span begin="04:16.186" end="04:16.672">ユニ</span><span begin="04:16.672" end="04:17.380">バース</span><span ttm:role="x-translation" xml:lang="zh-Hans">这就是我们的宇宙</span></p><p begin="04:17.141" end="04:18.241" ttm:agent="v1" itunes:key="L47"><span begin="04:17.141" end="04:17.615">ユニ</span><span begin="04:17.615" end="04:18.008">バー</span><span begin="04:18.008" end="04:18.241">ス！</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="04:18.241" end="04:19.341" ttm:agent="v1" itunes:key="L48"><span begin="04:18.241" end="04:18.715">ユニ</span><span begin="04:18.715" end="04:19.108">バー</span><span begin="04:19.108" end="04:19.341">ス！</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p><p begin="04:19.059" end="04:20.159" ttm:agent="v1" itunes:key="L49"><span begin="04:19.059" end="04:19.533">ユニ</span><span begin="04:19.533" end="04:19.926">バー</span><span begin="04:19.926" end="04:20.159">ス！</span><span ttm:role="x-translation" xml:lang="zh-Hans">宇宙</span></p></div></body></tt>