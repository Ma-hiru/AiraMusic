<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="other" xml:id="v2"/><amll:meta key="ncmMusicId" value="36621810"/><amll:meta key="appleMusicId" value="1537254092"/><amll:meta key="musicName" value="No.1"/><amll:meta key="artists" value="西野カナ"/><amll:meta key="album" value="Secret Collection 〜GREEN〜"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="04:13.200"><div begin="00:21.226" end="03:47.397"><p begin="00:21.226" end="00:24.671" ttm:agent="v1" itunes:key="L1"><span begin="00:21.226" end="00:21.767">傷</span><span begin="00:21.767" end="00:24.023">つくかもしれないな</span><span begin="00:24.023" end="00:24.671">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果注定会受伤</span></p><p begin="00:25.172" end="00:28.405" ttm:agent="v1" itunes:key="L2"><span begin="00:25.172" end="00:26.675">きまずくなっ</span><span begin="00:26.675" end="00:26.874">ちゃ</span><span begin="00:26.874" end="00:28.405">うくらいなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果关系会尴尬</span></p><p begin="00:28.405" end="00:31.782" ttm:agent="v1" itunes:key="L3"><span begin="00:28.405" end="00:29.409">Ah</span> <span begin="00:29.550" end="00:30.329">恋な</span><span begin="00:30.329" end="00:30.660">ん</span><span begin="00:30.660" end="00:31.045">ても</span><span begin="00:31.045" end="00:31.782">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">Ah 还不如从一开始</span></p><p begin="00:31.907" end="00:35.261" ttm:agent="v1" itunes:key="L4"><span begin="00:31.907" end="00:32.253">し</span><span begin="00:32.253" end="00:32.637">ない</span><span begin="00:32.637" end="00:33.283">方が</span><span begin="00:33.283" end="00:33.591">いい</span><span begin="00:33.591" end="00:34.283">のか</span><span begin="00:34.283" end="00:35.261">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">就打消恋爱的念头</span></p><p begin="00:36.874" end="00:40.380" ttm:agent="v1" itunes:key="L5"><span begin="00:36.874" end="00:38.866">優しくしてくれる</span><span begin="00:38.866" end="00:39.599">誰か</span><span begin="00:39.599" end="00:40.380">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果只要谁对我好</span></p><p begin="00:40.789" end="00:44.038" ttm:agent="v1" itunes:key="L6"><span begin="00:40.789" end="00:41.552">適当</span><span begin="00:41.552" end="00:43.036">に付き合うく</span><span begin="00:43.036" end="00:44.038">らいなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">就能随随便便交往</span></p><p begin="00:44.038" end="00:47.486" ttm:agent="v1" itunes:key="L7"><span begin="00:44.038" end="00:44.971">Ah</span> <span begin="00:45.245" end="00:45.612">いっ</span><span begin="00:45.612" end="00:45.922">そ</span><span begin="00:45.922" end="00:46.289">の</span><span begin="00:46.289" end="00:46.418">こ</span><span begin="00:46.418" end="00:47.486">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">Ah 还不如就一直这样</span></p><p begin="00:47.616" end="00:51.773" ttm:agent="v1" itunes:key="L8"><span begin="00:47.616" end="00:48.628">一人</span><span begin="00:48.628" end="00:48.848">でい</span><span begin="00:48.848" end="00:49.848">た方</span><span begin="00:49.848" end="00:50.544">が</span><span begin="00:50.544" end="00:51.022">いい</span><span begin="00:51.022" end="00:51.773">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">继续这样单身下去</span></p><p begin="00:51.936" end="00:55.687" ttm:agent="v1" itunes:key="L9"><span begin="00:51.936" end="00:52.256">恥</span><span begin="00:52.256" end="00:52.789">ず</span><span begin="00:52.789" end="00:53.129">かし</span><span begin="00:53.129" end="00:53.482">く</span><span begin="00:53.482" end="00:54.145">て目をそ</span><span begin="00:54.145" end="00:54.704">らす</span><span begin="00:54.704" end="00:55.687">とか</span><span ttm:role="x-translation" xml:lang="zh-Hans">害羞得移开视线</span></p><p begin="00:55.916" end="00:59.379" ttm:agent="v1" itunes:key="L10"><span begin="00:55.916" end="00:56.621">緊張</span><span begin="00:56.621" end="00:57.006">してう</span><span begin="00:57.006" end="00:57.483">まく</span><span begin="00:57.483" end="00:58.047">話せ</span><span begin="00:58.047" end="00:59.379">ないなんて</span><span ttm:role="x-translation" xml:lang="zh-Hans">紧张得说不出话</span></p><p begin="00:59.379" end="01:03.065" ttm:agent="v1" itunes:key="L11"><span begin="00:59.379" end="01:00.913">ありえない</span> <span begin="01:01.277" end="01:01.905">大人</span><span begin="01:01.905" end="01:02.492">なんだ</span><span begin="01:02.492" end="01:03.065">し</span><span ttm:role="x-translation" xml:lang="zh-Hans">难以置信 我好歹是个成年人</span></p><p begin="01:03.225" end="01:06.030" ttm:agent="v1" itunes:key="L12"><span begin="01:03.225" end="01:04.237">かっこよく</span><span begin="01:04.237" end="01:05.185">生きたいの</span><span begin="01:05.185" end="01:06.030">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明想要我行我素的生活</span></p><p begin="01:06.136" end="01:09.936" ttm:agent="v1" itunes:key="L13"><span begin="01:06.136" end="01:06.410">'Cause</span> <span begin="01:06.410" end="01:06.923">baby</span> <span begin="01:06.923" end="01:07.125">you're</span> <span begin="01:07.125" end="01:07.380">my</span> <span begin="01:07.380" end="01:07.823">No.</span> <span begin="01:07.823" end="01:08.334">No.</span> <span begin="01:08.334" end="01:08.812">No.</span> <span begin="01:08.812" end="01:09.342">No.</span><span begin="01:09.342" end="01:09.936">1</span><span ttm:role="x-translation" xml:lang="zh-Hans">【因为你是我的No. No. No. No.1】</span></p><p begin="01:10.067" end="01:14.205" ttm:agent="v1" itunes:key="L14"><span begin="01:10.067" end="01:10.317">And</span> <span begin="01:10.317" end="01:10.792">you're</span> <span begin="01:10.792" end="01:11.107">the</span> <span begin="01:11.285" end="01:11.781">only</span> <span begin="01:11.781" end="01:12.277">only</span> <span begin="01:12.277" end="01:12.772">only</span> <span begin="01:12.772" end="01:13.248">only</span> <span begin="01:13.248" end="01:14.205">one</span><span ttm:role="x-translation" xml:lang="zh-Hans">【并且你是独一无二 绝无仅有的】</span></p><p begin="01:14.769" end="01:18.735" ttm:agent="v1" itunes:key="L15"><span begin="01:14.769" end="01:15.269">その笑</span><span begin="01:15.269" end="01:15.922">顔</span> <span begin="01:15.922" end="01:16.615">その</span><span begin="01:16.615" end="01:17.143">瞳</span> <span begin="01:17.143" end="01:18.735">全てが</span><span ttm:role="x-translation" xml:lang="zh-Hans">你的笑颜 你的眼眸 你的一切</span></p><p begin="01:18.855" end="01:21.783" ttm:agent="v1" itunes:key="L16"><span begin="01:18.855" end="01:19.096">ド</span><span begin="01:19.096" end="01:20.105">キド</span><span begin="01:20.105" end="01:21.079">キさ</span><span begin="01:21.079" end="01:21.278">せ</span><span begin="01:21.278" end="01:21.783">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">都让我心跳不已</span></p><p begin="01:21.783" end="01:25.601" ttm:agent="v1" itunes:key="L17"><span begin="01:21.783" end="01:22.050">'Cause</span> <span begin="01:22.050" end="01:22.546">baby</span> <span begin="01:22.546" end="01:22.746">you're</span> <span begin="01:22.746" end="01:23.004">my</span> <span begin="01:23.004" end="01:23.479">No.</span> <span begin="01:23.479" end="01:23.995">No.</span> <span begin="01:23.995" end="01:24.470">No.</span> <span begin="01:24.470" end="01:24.946">No.</span><span begin="01:24.946" end="01:25.601">1</span><span ttm:role="x-translation" xml:lang="zh-Hans">【因为你是我的No. No. No. No.1】</span></p><p begin="01:25.631" end="01:29.819" ttm:agent="v1" itunes:key="L18"><span begin="01:25.631" end="01:25.975">And</span> <span begin="01:25.975" end="01:26.432">you're</span> <span begin="01:26.432" end="01:26.787">the</span> <span begin="01:26.928" end="01:27.403">only</span> <span begin="01:27.403" end="01:27.881">only</span> <span begin="01:27.881" end="01:28.357">only</span> <span begin="01:28.357" end="01:28.852">only</span> <span begin="01:28.852" end="01:29.819">one</span><span ttm:role="x-translation" xml:lang="zh-Hans">【并且你是独一无二 绝无仅有的】</span></p><p begin="01:30.412" end="01:32.757" ttm:agent="v1" itunes:key="L19"><span begin="01:30.412" end="01:30.729">ちょっ</span><span begin="01:30.729" end="01:30.914">と自</span><span begin="01:30.914" end="01:31.207">分</span><span begin="01:31.207" end="01:31.714">でも</span><span begin="01:31.714" end="01:32.272">怖いく</span><span begin="01:32.272" end="01:32.757">らい</span><span ttm:role="x-translation" xml:lang="zh-Hans">连自己都有一点吓到</span></p><p begin="01:32.767" end="01:34.563" ttm:agent="v2" itunes:key="L20"><span begin="01:32.767" end="01:32.926">I</span> <span begin="01:32.926" end="01:33.090">wanna</span> <span begin="01:33.090" end="01:33.474">be</span> <span begin="01:33.474" end="01:33.694">your</span> <span begin="01:33.694" end="01:34.173">No.</span><span begin="01:34.173" end="01:34.563">1</span><span ttm:role="x-translation" xml:lang="zh-Hans">【我想要变成你的No.1】</span></p><p begin="01:34.643" end="01:38.637" ttm:agent="v1" itunes:key="L21"><span begin="01:34.643" end="01:34.966">この</span><span begin="01:34.966" end="01:36.192">想い止まら</span><span begin="01:36.192" end="01:38.637">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">完全按捺不住对你的感情</span></p><p begin="01:43.148" end="01:46.816" ttm:agent="v1" itunes:key="L22"><span begin="01:43.148" end="01:43.982">仕事</span><span begin="01:43.982" end="01:45.962">も手に付かないな</span><span begin="01:45.962" end="01:46.816">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果连工作都无心处理</span></p><p begin="01:47.071" end="01:50.351" ttm:agent="v1" itunes:key="L23"><span begin="01:47.071" end="01:47.617">自分</span><span begin="01:47.617" end="01:49.374">らしくいられな</span><span begin="01:49.374" end="01:50.351">いなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果会慢慢失去我自己</span></p><p begin="01:50.351" end="01:53.841" ttm:agent="v1" itunes:key="L24"><span begin="01:50.351" end="01:51.322">Ah</span> <span begin="01:51.560" end="01:51.982">いっ</span><span begin="01:51.982" end="01:52.258">そ</span><span begin="01:52.258" end="01:52.642">の</span><span begin="01:52.642" end="01:52.789">こ</span><span begin="01:52.789" end="01:53.841">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">Ah 还不如现在马上</span></p><p begin="01:53.911" end="01:58.095" ttm:agent="v1" itunes:key="L25"><span begin="01:53.911" end="01:54.616">好き</span><span begin="01:54.616" end="01:54.982">じゃ</span><span begin="01:54.982" end="01:55.577">ない</span><span begin="01:55.577" end="01:56.193">事</span><span begin="01:56.193" end="01:56.906">に</span><span begin="01:56.906" end="01:57.402">し</span><span begin="01:57.402" end="01:58.095">たい</span><span ttm:role="x-translation" xml:lang="zh-Hans">不要再喜欢你了</span></p><p begin="01:58.284" end="02:02.139" ttm:agent="v1" itunes:key="L26"><span begin="01:58.284" end="01:58.609">メー</span><span begin="01:58.609" end="01:58.932">ル</span><span begin="01:59.140" end="01:59.342">の</span><span begin="01:59.342" end="02:00.317">返信</span><span begin="02:00.317" end="02:01.036">がない</span><span begin="02:01.036" end="02:02.139">とか</span><span ttm:role="x-translation" xml:lang="zh-Hans">怎么还不回我邮件</span></p><p begin="02:02.229" end="02:05.670" ttm:agent="v1" itunes:key="L27"><span begin="02:02.229" end="02:02.822">今</span><span begin="02:03.051" end="02:03.731">何し</span><span begin="02:03.731" end="02:04.694">てるのか</span><span begin="02:04.694" end="02:04.967">な？</span><span begin="02:04.967" end="02:05.670">なんて</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你在做什么呢</span></p><p begin="02:05.670" end="02:09.458" ttm:agent="v1" itunes:key="L28"><span begin="02:05.670" end="02:07.348">気にしない</span> <span begin="02:07.662" end="02:08.240">忙</span><span begin="02:08.240" end="02:08.882">しい</span><span begin="02:08.882" end="02:09.458">し</span><span ttm:role="x-translation" xml:lang="zh-Hans">我才不在意 我也是很忙的好吗</spa