<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="zh-Hant"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="29822014"/><amll:meta key="appleMusicId" value="944321451"/><amll:meta key="musicName" value="听见下雨的声音"/><amll:meta key="artists" value="周杰伦"/><amll:meta key="album" value="哎呦, 不错哦"/></metadata></head><body dur="04:39.412"><div begin="00:13.342" end="04:18.059"><p begin="00:13.342" end="00:17.680" ttm:agent="v1" itunes:key="L1"><span begin="00:13.342" end="00:13.734">竹</span><span begin="00:13.734" end="00:15.466">籬上停留著</span><span begin="00:15.466" end="00:16.176">蜻</span><span begin="00:16.176" end="00:17.680">蜓</span><span ttm:role="x-translation" xml:lang="zh-Hans">竹篱上停留著蜻蜓</span></p><p begin="00:18.881" end="00:26.243" ttm:agent="v1" itunes:key="L2"><span begin="00:18.881" end="00:19.243">玻</span><span begin="00:19.243" end="00:20.717">璃瓶裡插</span><span begin="00:20.717" end="00:21.001">滿</span><span begin="00:21.001" end="00:21.681">小</span><span begin="00:21.681" end="00:23.451">小</span><span begin="00:23.800" end="00:24.573">森</span><span begin="00:24.573" end="00:26.243">林</span><span ttm:role="x-translation" xml:lang="zh-Hans">玻璃瓶里插满小小森林</span></p><p begin="00:26.497" end="00:34.806" ttm:agent="v1" itunes:key="L3"><span begin="00:26.497" end="00:30.321">青春嫩綠得</span><span begin="00:30.321" end="00:31.497">很</span><span begin="00:32.117" end="00:32.867">鮮</span><span begin="00:32.867" end="00:34.806">明</span><span ttm:role="x-translation" xml:lang="zh-Hans">青春嫩绿得很鲜明</span></p><p begin="00:35.652" end="00:40.326" ttm:agent="v1" itunes:key="L4"><span begin="00:35.652" end="00:36.057">百</span><span begin="00:36.057" end="00:37.762">葉窗折射的</span><span begin="00:37.762" end="00:38.462">光</span><span begin="00:38.462" end="00:40.326">影</span><span ttm:role="x-translation" xml:lang="zh-Hans">百叶窗折射的光影</span></p><p begin="00:41.113" end="00:48.621" ttm:agent="v1" itunes:key="L5"><span begin="00:41.113" end="00:41.589">像</span><span begin="00:41.589" end="00:43.377">有著心事的</span><span begin="00:43.377" end="00:44.059">一</span><span begin="00:44.059" end="00:45.395">張</span><span begin="00:46.127" end="00:46.799">表</span><span begin="00:46.799" end="00:48.621">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">像有著心事的一张表情</span></p><p begin="00:48.924" end="00:54.000" ttm:agent="v1" itunes:key="L6"><span begin="00:48.924" end="00:52.406">而你低頭拆</span><span begin="00:52.406" end="00:54.000">信</span><span ttm:role="x-translation" xml:lang="zh-Hans">而你低头拆信</span></p><p begin="00:54.730" end="00:58.997" ttm:agent="v1" itunes:key="L7"><span begin="00:54.730" end="00:55.193">想</span><span begin="00:55.193" end="00:57.023">知道關於我</span><span begin="00:57.023" end="00:57.450">的</span><span begin="00:57.450" end="00:58.009">事</span><span begin="00:58.009" end="00:58.997">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">想知道关于我的事情</span></p><p begin="00:59.296" end="01:08.272" ttm:agent="v1" itunes:key="L8"><span begin="00:59.296" end="00:59.767">青</span><span begin="00:59.767" end="01:00.859">苔入</span><span begin="01:00.859" end="01:01.965">鏡</span> <span begin="01:02.164" end="01:02.592">簷</span><span begin="01:02.592" end="01:03.628">下風</span><span begin="01:03.628" end="01:04.761">鈴</span> <span begin="01:04.967" end="01:05.378">搖</span><span begin="01:05.378" end="01:06.446">晃曾</span><span begin="01:06.446" end="01:08.272">經</span><span ttm:role="x-translation" xml:lang="zh-Hans">青苔入镜 簷下风铃 摇晃曾经</span></p><p begin="01:08.715" end="01:15.461" ttm:agent="v1" itunes:key="L9"><span begin="01:08.715" end="01:09.523">回憶</span><span begin="01:09.523" end="01:09.972">是</span><span begin="01:10.226" end="01:10.613">一</span><span begin="01:10.613" end="01:11.265">行行</span><span begin="01:11.265" end="01:12.682">無從</span><span begin="01:12.967" end="01:13.733">剪接</span><span begin="01:13.733" end="01:14.064">的</span><span begin="01:14.064" end="01:15.461">風景</span><span ttm:role="x-translation" xml:lang="zh-Hans">回忆是一行行无从剪接的风景</span></p><p begin="01:15.745" end="01:20.768" ttm:agent="v1" itunes:key="L10"><span begin="01:15.745" end="01:16.147">愛</span><span begin="01:16.147" end="01:16.504">始</span><span begin="01:16.504" end="01:16.848">終</span><span begin="01:16.848" end="01:17.520">年</span><span begin="01:17.520" end="01:20.768">輕</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱始终年轻</span></p><p begin="01:21.686" end="01:26.967" ttm:agent="v1" itunes:key="L11"><span begin="01:21.686" end="01:23.103">而我聽見</span><span begin="01:23.103" end="01:24.202">下</span><span begin="01:24.202" end="01:24.519">雨</span><span begin="01:24.519" end="01:25.938">的聲</span><span begin="01:25.938" end="01:26.967">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">而我听见下雨的声音</span></p><p begin="01:27.175" end="01:32.429" ttm:agent="v1" itunes:key="L12"><span begin="01:27.175" end="01:27.664">想</span><span begin="01:27.664" end="01:28.669">起你用</span><span begin="01:28.669" end="01:29.779">唇</span><span begin="01:29.779" end="01:30.082">語</span><span begin="01:30.082" end="01:31.461">說愛</span><span begin="01:31.461" end="01:32.429">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">想起你用唇语说爱情</span></p><p begin="01:32.731" end="01:37.980" ttm:agent="v1" itunes:key="L13"><span begin="01:32.731" end="01:33.281">幸</span><span begin="01:33.281" end="01:34.304">福也可</span><span begin="01:34.304" end="01:35.939">以</span><span begin="01:36.340" end="01:36.780">很</span><span begin="01:36.780" end="01:37.182">安</span><span begin="01:37.182" end="01:37.980">靜</span><span ttm:role="x-translation" xml:lang="zh-Hans">幸福也可以很安静</span></p><p begin="01:38.385" end="01:43.743" ttm:agent="v1" itunes:key="L14"><span begin="01:38.385" end="01:38.795">我</span><span begin="01:38.795" end="01:39.871">付出一</span><span begin="01:39.871" end="01:41.511">直</span><span begin="01:41.887" end="01:42.689">很小</span><span begin="01:42.689" end="01:43.743">心</span><span ttm:role="x-translation" xml:lang="zh-Hans">我付出一直很小心</span></p><p begin="01:43.933" end="01:49.122" ttm:agent="v1" itunes:key="L15"><span begin="01:43.933" end="01:44.422">終</span><span begin="01:44.422" end="01:45.425">於聽見</span><span begin="01:45.425" end="01:46.534">下</span><span begin="01:46.534" end="01:46.891">雨</span><span begin="01:46.891" end="01:48.293">的聲</span><span begin="01:48.293" end="01:49.122">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">终于听见下雨的声音</span></p><p begin="01:49.555" end="01:54.709" ttm:agent="v1" itunes:key="L16"><span begin="01:49.555" end="01:49.974">於</span><span begin="01:49.974" end="01:50.980">是我的</span><span begin="01:50.980" end="01:52.075">世</span><span begin="01:52.075" end="01:52.392">界</span><span begin="01:52.392" end="01:53.839">被吵</span><span begin="01:53.839" end="01:54.709">醒</span><span ttm:role="x-translation" xml:lang="zh-Hans">于是我的世界被吵醒</span></p><p begin="01:55.152" end="02:00.253" ttm:agent="v1" itunes:key="L17"><span begin="01:55.152" end="01:55.574">就</span><span begin="01:55.574" end="01:56.597">怕情緒</span><span begin="01:56.597" end="01:58.371">紅</span><span begin="01:58.626" end="01:59.028">了</span><span begin="01:59.028" end="01:59.397">眼</span><span begin="01:59.397" end="02:00.253">睛</span><span ttm:role="x-translation" xml:lang="zh-Hans">就怕情绪红了眼睛</span></p><p begin="02:00.717" end="02:10.851" ttm:agent="v1" itunes:key="L18"><span begin="02:00.717" end="02:01.115">不</span><span begin="02:01.115" end="02:02.143">捨的淚</span><span begin="02:02.143" end="02:04.005">在</span><span begin="02:04.210" end="02:05.053">彼此</span><span begin="02:05.053" end="02:06.040">的</span><span begin="02:06.040" end="02:06.403">臉</span><span begin="02:06.403" end="02:07.021">上</span><span begin="02:07.021" end="02:07.721">透</span><span begin="02:07.721" end="02:10.851">明</span><span ttm:role="x-translation" xml:lang="zh-Hans">不舍的泪在彼此的脸上透明</span></p><p begin="02:30.083" end="02:34.448" ttm:agent="v1" itunes:key="L19"><span begin="02:30.083" end="02:30.437">百</span><span begin="02:30.437" end="02:32.191">葉窗折射的</span><span begin="02:32.191" end="02:32.957">光</span><span begin="02:32.957" end="02:34.448">影</span><span ttm:role="x-translation" xml:lang="zh-Hans">百叶窗折射的光影</span></p><p begin="02:35.607" end="02:43.044" ttm:agent="v1" itunes:key="L20"><span begin="02:35.607" end="02:36.094">像</span><span begin="02:36.094" end="02:37.788">有著心事的</span><span begin="02:37.788" end="02:38.211">一</span><span begin="02:38.442" end="02:40.092">張</span><span begin="02:40.540" end="02:41.326">表</span><span begin="02:41.326" end="02:43.044">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">像有著心事的一张表情</span></p><p begin="02:43.308" end="02:48.405" ttm:agent="v1" itunes:key="L21"><span begin="02:43.308" end="02:46.844">而你低頭拆</span><span begin="02:46.844" end="02:48.405">信</span><span ttm:role="x-translation" xml:lang="zh-Hans">而你低头拆信</span></p><p begin="02:49.109" end="02:53.314" ttm:agent="v1" itunes:key="L22"><span begin="02:49.109" end="02:49.684">想</span><span begin="02:49.684" end="02:51.408">知道關於我</span><span begin="02:51.408" end="02:51.863">的</span><span begin="02:51.863" end="02:52.382">事</span><span begin="02:52.382" end="02:53.314">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">想知道关于我的事情</span></p><p begin="02:53.694" end="03:02.532" ttm:agent="v1" itunes:key="L23"><span begin="02:53.694" end="02:54.158">愛</span><span begin="02:54.158" end="02:55.210">在過</span><span begin="02:55.210" end="02:56.359">境</span> <span begin="02:56.601" end="02:56.978">緣</span><span begin="02:56.978" end="02:58.046">分不</span><span begin="02:58.046" end="02:59.140">停</span> <span begin="02:59.334" end="02:59.717">誰</span><span begin="02:59.717" end="03:00.740">在擔</span><span begin="03:00.740" end="03:02.532">心</span><span ttm:role="x-translation" xml:lang="zh-Hans">爱在过境 缘分不停 谁在担心</span></p><p begin="03:03.076" end="03:09.969" ttm:agent="v1" itunes:key="L24"><span begin="03:03.076" end="03:03.590">窗</span><span begin="03:03.590" end="03:03.906">台</span><span begin="03:03.906" end="03:04.406">上</span><span begin="03:04.618" end="03:05.363">滴落</span><span begin="03:05.363" end="03:05.711">的</span><span begin="03:05.711" end="03:06.455">雨</span><span begin="03:06.455" end="03:06.956">滴</span> <span begin="03:07.352" end="03:08.125">輕敲</span><span begin="03:08.125" end="03:08.376">著</span><span begin="03:08.376" end="03:09.120">傷</span><span begin="03:09.120" end="03:09.969">心</span><span ttm:role="x-translation" xml:lang="zh-Hans">窗台上滴落的雨滴 轻敲著伤心</span></p><p begin="03:10.186" end="03:15.244" ttm:agent="v1" itunes:key="L25"><span begin="03:10.186" end="03:11.224">淒美而</span><span begin="03:11.224" end="03:12.068">動</span><span begin="03:12.068" end="03:15.244">聽</span><span ttm:role="x-translation" xml:lang="zh-Hans">凄美而动听</span></p><p begin="03:16.072" end="03:21.206" ttm:agent="v1" itunes:key="L26"><span begin="03:16.072" end="03:17.541">而我聽見</span><span begin="03:17.541" end="03:18.600">下</span><span begin="03:18.600" end="03:18.975">雨</span><span begin="03:18.975" end="03:20.353">的聲</span><span begin="03:20.353" end="03:21.206">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">而我听见下雨的声音</span></p><p begin="03:21.553" end="03:26.811" ttm:agent="v1" itunes:key="L27"><span begin="03:21.553" end="03:22.066">想</span><span begin="03:22.066" end="03:23.107">起你用</span><span begin="03:23.107" end="03:24.244">唇</span><span begin="03:24.244" end="03:24.527">語</span><span begin="03:24.527" end="03:25.931">說愛</span><span begin="03:25.931" end="03:26.811">情</span><span ttm:role="x-translation" xml:lang="zh-Hans">想起你用唇语说爱情</span></p><p begin="03:27.198" end="03:32.385" ttm:agent="v1" itunes:key="L28"><span begin="03:27.198" end="03:27.677">熱</span><span begin="03:27.677" end="03:28.716">戀的時</span><span begin="03:28.716" end="03:30.557">刻</span><span begin="03:30.750" end="03:31.119">最</span><span begin="03:31.119" end="03:31.656">任</span><span begin="03:31.656" end="03:32.385">性</span><span ttm:role="x-translation" xml:lang="zh-Hans">热恋的时刻最任性</span></p><p begin="03:32.826" end="03:38.088" ttm:agent="v1" itunes:key="L29"><span begin="03:32.826" end="03:33.232">不</span><span begin="03:33.232" end="03:34.321">顧一切</span><span begin="03:34.321" end="03:36.082">的</span><span begin="03:36.318" end="03:36.707">給</span><span begin="03:36.707" end="03:37.072">約</span><span begin="03:37.072" end="03:38.088">定</span><span ttm:role="x-translation" xml:lang="zh-Hans">不顾一切的给约定</span></p><p begin="03:38.326" end="03:44.879" ttm:agent="v1" itunes:key="L30"><span begin="03:38.326" end="03:38.823">終</span><span begin="03:38.823" end="03:39.548">於聽</span><span begin="03:39.548" end="03:40.042">見</span><span begin="03:41.515" end="03:42.376">下</span><span begin="03:42.376" end="03:42.678">雨</span><span begin="03:42.678" end="03:44.054">的聲</span><span begin="03:44.054" end="03:44.879">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">终于听见下雨的声音</span></p><p begin="03:45.377" end="03:50.671" ttm:agent="v1" itunes:key="L31"><span begin="03:45.377" end="03:45.750">於</span><span begin="03:45.750" end="03:46.779">是我的</span><span begin="03:46.779" end="03:47.917">世</span><span begin="03:47.917" end="03:48.286">界</span><span begin="03:48.286" end="03:49.621">被吵</span><span begin="03:49.621" end="03:50.671">醒</span><span ttm:role="x-translation" xml:lang="zh-Hans">于是我的世界被吵醒</span></p><p begin="03:50.940" end="03:56.011" ttm:agent="v1" itunes:key="L32"><span begin="03:50.940" end="03:51.337">發</span><span begin="03:51.337" end="03:52.464">現你始</span><span begin="03:52.464" end="03:54.270">終</span><span begin="03:54.475" end="03:54.899">很</span><span begin="03:54.899" end="03:55.229">靠</span><span begin="03:55.229" end="03:56.011">近</span><span ttm:role="x-translation" xml:lang="zh-Hans">发现你始终很靠近</span></p><p begin="03:56.557" end="04:06.761" ttm:agent="v1" itunes:key="L33"><span begin="03:56.557" end="03:57.016">默</span><span begin="03:57.016" end="03:58.049">默的陪</span><span begin="03:58.049" end="03:59.813">在</span><span begin="04:00.028" end="04:00.470">我</span><span begin="04:00.470" end="04:00.818">身</span><span begin="04:00.818" end="04:01.728">邊</span> <span begin="04:01.809" end="04:02.170">態</span><span begin="04:02.170" end="04:02.887">度</span><span begin="04:02.887" end="04:03.545">堅</span><span begin="04:03.545" end="04:06.761">定</span><span ttm:role="x-translation" xml:lang="zh-Hans">默默的陪在我身边 态度坚定</span></p><p begin="04:12.927" end="04:18.059" ttm:agent="v1" itunes:key="L34"><span begin="04:12.927" end="04:13.379">雨</span><span begin="04:13.379" end="04:13.962">的</span><span begin="04:13.962" end="04:14.711">聲</span><span begin="04:14.711" end="04:18.059">音</span><span ttm:role="x-translation" xml:lang="zh-Hans">雨的声音</span></p></div></body></tt>