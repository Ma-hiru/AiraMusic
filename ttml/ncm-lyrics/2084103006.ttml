<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="2084103006"/><amll:meta key="appleMusicId" value="1708398293"/><amll:meta key="musicName" value="01"/><amll:meta key="artists" value="女王蜂"/><amll:meta key="album" value="01"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:12.746" end="00:13.285">korega</span><span begin="00:13.285" end="00:13.951">saigo</span><span begin="00:13.951" end="00:14.615">tokimema</span><span begin="00:14.615" end="00:14.968">shita</span></text><text for="L2"><span begin="00:14.968" end="00:15.632">aitsuwa</span><span begin="00:15.632" end="00:16.284">i'tta</span><span begin="00:16.284" end="00:17.477">「shindaradouna</span><span begin="00:17.477" end="00:18.041">ru？」</span></text><text for="L3"><span begin="00:18.135" end="00:18.599">soko</span><span begin="00:18.599" end="00:19.301">denaifu</span><span begin="00:19.301" end="00:19.965">gatobida</span><span begin="00:19.965" end="00:20.265">shite</span></text><text for="L4"><span begin="00:20.265" end="00:21.435">a'kkenaka'tta</span><span begin="00:21.435" end="00:22.467">namidayorimo</span><span begin="00:22.467" end="00:22.801">haya</span><span begin="00:22.801" end="00:23.289">ku</span></text><text for="L5"><span begin="00:23.459" end="00:24.019">anone</span><span begin="00:24.110" end="00:25.296">kokodekieta</span><span begin="00:25.296" end="00:26.089">raiminaishi</span></text><text for="L6"><span begin="00:26.089" end="00:26.766">rousoku</span><span begin="00:26.766" end="00:27.310">noyouni</span><span begin="00:27.310" end="00:28.294"></span><span begin="00:28.294" end="00:28.725"></span></text><text for="L7"><span begin="00:28.772" end="00:29.457">tsunage</span><span begin="00:29.457" end="00:29.940">teinai</span><span begin="00:29.940" end="00:30.975">tega</span><span begin="00:30.975" end="00:31.460"></span><span begin="00:31.460" end="00:31.791"></span><span begin="00:31.791" end="00:32.207"></span></text><text for="L8"><span begin="00:32.247" end="00:32.631">ne</span><span begin="00:32.631" end="00:33.799">shindaradou</span><span begin="00:33.799" end="00:34.899">naru？</span></text><text for="L9"><span begin="00:44.727" end="00:45.279">sokode</span><span begin="00:45.279" end="00:45.812">darewo</span><span begin="00:45.812" end="00:46.898">uramimasuka</span></text><text for="L10"><span begin="00:46.898" end="00:48.279">yanoyounisa'ttewa</span><span begin="00:48.279" end="00:48.946">sugiteku</span><span begin="00:48.946" end="00:49.884">kisetsu</span></text><text for="L11"><span begin="00:50.044" end="00:51.287">yuzurenaimama</span><span begin="00:51.287" end="00:51.620">mochi</span><span begin="00:51.620" end="00:51.905">nao</span><span begin="00:51.905" end="00:52.271">shite</span></text><text for="L12"><span begin="00:52.271" end="00:53.604">yurusebaki'tto</span><span begin="00:53.658" end="00:54.442"></span><span begin="00:54.442" end="00:55.421"></span></text><text for="L13"><span begin="00:55.436" end="00:56.116">yukusa</span><span begin="00:56.116" end="00:57.300">kiyasashisagata</span><span begin="00:57.300" end="00:58.155">tsukaerimichi</span></text><text for="L14"><span begin="00:58.155" end="00:58.939">furikae</span><span begin="00:58.939" end="01:00.121">rusenikanashige</span><span begin="01:00.121" end="01:00.750">namanazashi</span></text><text for="L15"><span begin="01:00.750" end="01:01.438">ariga</span><span begin="01:01.438" end="01:02.622">toutogomenwo</span><span begin="01:02.622" end="01:03.772"></span><span begin="01:03.772" end="01:04.278"></span></text