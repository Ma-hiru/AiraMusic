<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><amll:meta key="ncmMusicId" value="27279913"/><amll:meta key="appleMusicId" value="1807714400"/><amll:meta key="musicName" value="Fade Into Darkness"/><amll:meta key="artists" value="Avicii"/><amll:meta key="album" value="Pioneer: The Album, Volume XII"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/></metadata></head><body dur="03:18.133"><div begin="00:15.988" end="03:11.348"><p begin="00:15.988" end="00:19.923" ttm:agent="v1" itunes:key="L1"><span begin="00:15.988" end="00:16.609">Looking</span> <span begin="00:16.609" end="00:17.657">up,</span> <span begin="00:17.761" end="00:18.009">there's</span> <span begin="00:18.009" end="00:18.526">always</span> <span begin="00:18.526" end="00:19.923">sky</span><span ttm:role="x-translation" xml:lang="zh-Hans">抬头看去，依旧是那片天空</span></p><p begin="00:19.923" end="00:24.024" ttm:agent="v1" itunes:key="L2"><span begin="00:19.923" end="00:20.248">Rest</span> <span begin="00:20.248" end="00:20.464">your</span> <span begin="00:20.464" end="00:21.448">head,</span> <span begin="00:21.629" end="00:21.914">I'll</span> <span begin="00:21.914" end="00:22.165">take</span> <span begin="00:22.165" end="00:22.362">you</span> <span begin="00:22.362" end="00:24.024">high</span><span ttm:role="x-translation" xml:lang="zh-Hans">摸摸你头，我让你抬起头来</span></p><p begin="00:24.220" end="00:27.592" ttm:agent="v1" itunes:key="L3"><span begin="00:24.220" end="00:24.483">We</span> <span begin="00:24.483" end="00:24.715">won't</span> <span begin="00:24.715" end="00:25.099">fade</span> <span begin="00:25.099" end="00:25.699">into</span> <span begin="00:25.699" end="00:26.182">dark</span><span begin="00:26.182" end="00:27.592">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不会在黑暗中消失</span></p><p begin="00:27.682" end="00:31.182" ttm:agent="v1" itunes:key="L4"><span begin="00:27.682" end="00:28.028">Won't</span> <span begin="00:28.028" end="00:28.279">let</span> <span begin="00:28.279" end="00:28.529">you</span> <span begin="00:28.529" end="00:28.913">fade</span> <span begin="00:28.913" end="00:29.513">into</span> <span begin="00:29.513" end="00:29.964">dark</span><span begin="00:29.964" end="00:31.182">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我绝不会让你隐没于黑暗</span></p><p begin="00:31.182" end="00:35.111" ttm:agent="v1" itunes:key="L5"><span begin="00:31.182" end="00:31.432">Why</span> <span begin="00:31.432" end="00:31.901">worry</span> <span begin="00:31.901" end="00:33.062">now?</span> <span begin="00:33.283" end="00:33.533">You'll</span> <span begin="00:33.533" end="00:33.800">be</span> <span begin="00:33.800" end="00:35.111">safe</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么要忧心？你会安全的</span></p><p begin="00:35.208" end="00:39.098" ttm:agent="v1" itunes:key="L6"><span begin="00:35.208" end="00:35.461">Hold</span> <span begin="00:35.461" end="00:35.695">my</span> <span begin="00:35.695" end="00:36.811">hand,</span> <span begin="00:37.061" end="00:37.343">just</span> <span begin="00:37.343" end="00:37.594">in</span> <span begin="00:37.594" end="00:39.098">case</span><span ttm:role="x-translation" xml:lang="zh-Hans">以防万一你还是拉住我的手吧</span></p><p begin="00:39.248" end="00:43.533" ttm:agent="v1" itunes:key="L7"><span begin="00:39.248" end="00:39.541">And</span> <span begin="00:39.541" end="00:39.722">we</span> <span begin="00:39.722" end="00:39.970">won't</span> <span begin="00:39.970" end="00:40.373">fade</span> <span begin="00:40.373" end="00:40.914">into</span> <span begin="00:40.914" end="00:41.389">dark</span><span begin="00:41.389" end="00:43.533">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们绝不会隐没于黑暗</span></p><p begin="00:43.684" end="00:46.682" ttm:agent="v1" itunes:key="L8"><span begin="00:43.684" end="00:44.155">Fade</span> <span begin="00:44.155" end="00:44.739">into</span> <span begin="00:44.739" end="00:45.206">dark</span><span begin="00:45.206" end="00:46.682">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">绝不会隐没于黑暗</span></p><p begin="00:46.846" end="00:50.917" ttm:agent="v1" itunes:key="L9"><span begin="00:46.846" end="00:47.123">No,</span> <span begin="00:47.123" end="00:47.307">we</span> <span begin="00:47.307" end="00:47.560">won't</span> <span begin="00:47.560" end="00:47.973">fade</span> <span begin="00:47.973" end="00:48.557">into</span> <span begin="00:48.557" end="00:49.040">dark</span><span begin="00:49.040" end="00:50.917">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">不我们不会在黑暗中消失</span></p><p begin="00:51.246" end="01:00.428" ttm:agent="v1" itunes:key="L10"><span begin="00:51.246" end="00:51.763">Fade</span> <span begin="00:51.763" end="00:52.328">into</span> <span begin="00:52.328" end="00:52.795">dark</span><span begin="00:52.795" end="01:00.428">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">在黑暗中消失</span></p><p begin="01:17.325" end="01:21.605" ttm:agent="v1" itunes:key="L11"><span begin="01:17.325" end="01:17.586">And</span> <span begin="01:17.586" end="01:17.818">we</span> <span begin="01:17.818" end="01:18.036">won't</span> <span begin="01:18.036" end="01:18.450">fade</span> <span begin="01:18.450" end="01:19.002">into</span> <span begin="01:19.002" end="01:19.484">dark</span><span begin="01:19.484" end="01:21.605">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不会在黑暗中消失</span></p><p begin="01:21.807" end="01:24.754" ttm:agent="v1" itunes:key="L12"><span begin="01:21.807" end="01:22.198">Fade</span> <span begin="01:22.198" end="01:22.833">into</span> <span begin="01:22.833" end="01:23.300">dark</span><span begin="01:23.300" end="01:24.754">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">在黑暗中消失</span></p><p begin="01:24.969" end="01:28.998" ttm:agent="v1" itunes:key="L13"><span begin="01:24.969" end="01:25.176">No,</span> <span begin="01:25.176" end="01:25.427">we</span> <span begin="01:25.427" end="01:25.659">won't</span> <span begin="01:25.659" end="01:26.043">fade</span> <span begin="01:26.043" end="01:26.643">into</span> <span begin="01:26.643" end="01:27.110">dark</span><span begin="01:27.110" end="01:28.998">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">不我们不会在黑暗中消失</span></p><p begin="01:29.384" end="01:39.848" ttm:agent="v1" itunes:key="L14"><span begin="01:29.384" end="01:29.866">Fade</span> <span begin="01:29.866" end="01:30.434">into</span> <span begin="01:30.434" end="01:30.901">dark</span><span begin="01:30.901" end="01:38.277">ness</span> <span ttm:role="x-bg" begin="01:37.104" end="01:39.848"><span begin="01:37.104" end="01:37.482">(Fade</span> <span begin="01:37.482" end="01:38.098">into</span> <span begin="01:38.098" end="01:38.581">dark</span><span begin="01:38.581" end="01:39.848">ness)</span></span><span ttm:role="x-translation" xml:lang="zh-Hans">在黑暗中消失</span></p><p begin="01:47.267" end="01:51.148" ttm:agent="v1" itunes:key="L15"><span begin="01:47.267" end="01:47.506">This</span> <span begin="01:47.506" end="01:47.808">world</span> <span begin="01:47.808" end="01:48.106">can</span> <span begin="01:48.106" end="01:48.989">seem</span> <span begin="01:49.440" end="01:49.706">cold</span> <span begin="01:49.706" end="01:49.992">and</span> <span begin="01:49.992" end="01:51.148">grey</span><span ttm:role="x-translation" xml:lang="zh-Hans">这世界表面上看去是寒冷和黑暗</span></p><p begin="01:51.148" end="01:55.382" ttm:agent="v1" itunes:key="L16"><span begin="01:51.148" end="01:51.419">But</span> <span begin="01:51.419" end="01:51.670">you</span> <span begin="01:51.670" end="01:51.905">and</span> <span begin="01:51.905" end="01:52.803">I</span> <span begin="01:53.064" end="01:53.350">are</span> <span begin="01:53.350" end="01:53.582">here</span> <span begin="01:53.582" end="01:53.816">to</span><span begin="01:53.816" end="01:55.382">day</span><span ttm:role="x-translation" xml:lang="zh-Hans">但你和我今天在这里</span></p><p begin="01:55.382" end="01:59.007" ttm:agent="v1" itunes:key="L17"><span begin="01:55.382" end="01:55.685">And</span> <span begin="01:55.685" end="01:55.920">we</span> <span begin="01:55.920" end="01:56.120">won't</span> <span begin="01:56.120" end="01:56.520">fade</span> <span begin="01:56.520" end="01:57.120">into</span> <span begin="01:57.120" end="01:57.619">dark</span><span begin="01:57.619" end="01:59.007">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不会在黑暗中消失</span></p><p begin="01:59.107" end="02:02.509" ttm:agent="v1" itunes:key="L18"><span begin="01:59.107" end="01:59.456">No,</span> <span begin="01:59.456" end="01:59.690">we</span> <span begin="01:59.690" end="01:59.938">won't</span> <span begin="01:59.938" end="02:00.306">fade</span> <span begin="02:00.306" end="02:00.906">into</span> <span begin="02:00.906" end="02:01.389">dark</span><span begin="02:01.389" end="02:02.509">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">不我们不会在黑暗中消失</span></p><p begin="02:02.509" end="02:06.388" ttm:agent="v1" itunes:key="L19"><span begin="02:02.509" end="02:03.042">Nothing</span> <span begin="02:03.042" end="02:03.327">to</span> <span begin="02:03.327" end="02:04.200">fear</span> <span begin="02:04.476" end="02:04.743">but</span> <span begin="02:04.743" end="02:04.978">fear</span> <span begin="02:04.978" end="02:06.388">itself</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有什么好害怕的，除了恐惧本身</span></p><p begin="02:06.388" end="02:10.410" ttm:agent="v1" itunes:key="L20"><span begin="02:06.388" end="02:06.617">We'll</span> <span begin="02:06.617" end="02:06.851">be</span> <span begin="02:06.851" end="02:07.985">okay,</span> <span begin="02:08.256" end="02:08.585">just</span> <span begin="02:08.585" end="02:08.835">keep</span> <span begin="02:08.835" end="02:09.067">the</span> <span begin="02:09.067" end="02:10.410">faith</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们会好的，只要坚持信念</span></p><p begin="02:10.640" end="02:14.927" ttm:agent="v1" itunes:key="L21"><span begin="02:10.640" end="02:10.951">And</span> <span begin="02:10.951" end="02:11.151">we</span> <span begin="02:11.151" end="02:11.370">won't</span> <span begin="02:11.370" end="02:11.786">fade</span> <span begin="02:11.786" end="02:12.370">into</span> <span begin="02:12.370" end="02:12.821">dark</span><span begin="02:12.821" end="02:14.927">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不会在黑暗中消失</span></p><p begin="02:15.103" end="02:18.130" ttm:agent="v1" itunes:key="L22"><span begin="02:15.103" end="02:15.569">Fade</span> <span begin="02:15.569" end="02:16.169">into</span> <span begin="02:16.169" end="02:16.620">dark</span><span begin="02:16.620" end="02:18.130">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">绝不会隐没于黑暗</span></p><p begin="02:18.221" end="02:22.330" ttm:agent="v1" itunes:key="L23"><span begin="02:18.221" end="02:18.556">No,</span> <span begin="02:18.556" end="02:18.772">we</span> <span begin="02:18.772" end="02:18.991">won't</span> <span begin="02:18.991" end="02:19.407">fade</span> <span begin="02:19.407" end="02:19.972">into</span> <span begin="02:19.972" end="02:20.423">dark</span><span begin="02:20.423" end="02:22.330">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">不我们不会在黑暗中消失</span></p><p begin="02:22.604" end="02:31.391" ttm:agent="v1" itunes:key="L24"><span begin="02:22.604" end="02:23.155">Fade</span> <span begin="02:23.155" end="02:23.771">into</span> <span begin="02:23.771" end="02:24.238">dark</span><span begin="02:24.238" end="02:31.391">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">在黑暗中消失</span></p><p begin="02:38.026" end="02:41.201" ttm:agent="v1" itunes:key="L25"><span begin="02:38.026" end="02:38.428">Fade</span> <span begin="02:38.428" end="02:39.028">into</span> <span begin="02:39.028" end="02:39.511">dark</span><span begin="02:39.511" end="02:41.201">ness</span></p><p begin="02:45.604" end="02:48.741" ttm:agent="v1" itunes:key="L26"><span begin="02:45.604" end="02:46.049">Fade</span> <span begin="02:46.049" end="02:46.665">into</span> <span begin="02:46.665" end="02:47.131">dark</span><span begin="02:47.131" end="02:48.741">ness</span></p><p begin="02:48.741" end="02:52.941" ttm:agent="v1" itunes:key="L27"><span begin="02:48.741" end="02:49.052">And</span> <span begin="02:49.052" end="02:49.268">we</span> <span begin="02:49.268" end="02:49.487">won't</span> <span begin="02:49.487" end="02:49.868">fade</span> <span begin="02:49.868" end="02:50.452">into</span> <span begin="02:50.452" end="02:50.919">dark</span><span begin="02:50.919" end="02:52.941">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">噢,在黑暗中消失</span></p><p begin="02:53.229" end="02:56.207" ttm:agent="v1" itunes:key="L28"><span begin="02:53.229" end="02:53.642">Fade</span> <span begin="02:53.642" end="02:54.258">into</span> <span begin="02:54.258" end="02:54.724">dark</span><span begin="02:54.724" end="02:56.207">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们不会在黑暗中消失</span></p><p begin="02:56.387" end="03:00.451" ttm:agent="v1" itunes:key="L29"><span begin="02:56.387" end="02:56.645">No,</span> <span begin="02:56.645" end="02:56.861">we</span> <span begin="02:56.861" end="02:57.096">won't</span> <span begin="02:57.096" end="02:57.480">fade</span> <span begin="02:57.480" end="02:58.061">into</span> <span begin="02:58.061" end="02:58.546">dark</span><span begin="02:58.546" end="03:00.451">ness</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们绝不会隐没于黑暗</span></p><p begin="03:00.754" end="03:11.348" ttm:agent="v1" itunes:key="L30"><span begin="03:00.754" end="03:01.295">Fade</span> <span begin="03:01.295" end="03:01.860">into</span> <span begin="03:01.860" end="03:02.345">dark</span><span begin="03:02.345" end="03:09.491">ness</span> <span ttm:role="x-bg" begin="03:08.557" end="03:11.348"><span begin="03:08.557" end="03:08.970">(Fade</span> <span begin="03:08.970" end="03:09.503">into</span> <span begin="03:09.503" end="03:09.975">dark</span><span begin="03:09.975" end="03:11.348">ness)</span></span><span ttm:role="x-translation" xml:lang="zh-Hans">在黑暗中消失</span></p></div></body></tt>