><span begin="03:59.394" end="04:00.277">jimakuno</span><span begin="04:00.277" end="04:01.109">you</span><span begin="04:01.109" end="04:01.944">ni</span></text><text for="L52"><span begin="04:01.954" end="04:02.609">omoi</span><span begin="04:02.609" end="04:03.343">kaeshi</span><span begin="04:03.343" end="04:03.791">ta</span><span begin="04:03.791" end="04:05.306">toki</span><span begin="04:05.595" end="04:06.225">fui</span><span begin="04:06.225" end="04:06.692">ni</span><span begin="04:06.692" end="04:07.041">me</span><span begin="04:07.041" end="04:07.209">wo</span><span begin="04:07.209" end="04:07.492">ya</span><span begin="04:07.492" end="04:07.993">ru</span><span begin="04:07.993" end="04:08.409">toki</span><span begin="04:08.409" end="04:09.747">ni</span></text><text for="L53"><span begin="04:09.751" end="04:10.234">kimi</span><span begin="04:10.234" end="04:10.772">no</span><span begin="04:11.084" end="04:11.719">mune</span><span begin="04:11.719" end="04:12.170">wofu</span><span begin="04:12.170" end="04:12.671">ruwasu</span><span begin="04:12.671" end="04:13.284">mono</span><span begin="04:13.423" end="04:14.020">sagashi</span><span begin="04:14.020" end="04:14.385">tsuzu</span><span begin="04:14.385" end="04:15.299">ketai</span></text><text for="L54"><span begin="04:15.309" end="04:15.685">ai</span><span begin="04:15.685" end="04:16.302">shiteru</span><span begin="04:16.302" end="04:16.867">yori</span><span begin="04:16.867" end="04:17.651">moaiga</span><span begin="04:17.651" end="04:18.102">todo</span><span begin="04:18.102" end="04:18.603">kuma</span><span begin="04:18.603" end="04:19.789">de</span></text><text for="L55"><span begin="04:23.579" end="04:24.045">mo</span><span begin="04:24.045" end="04:24.693">usukoshi</span><span begin="04:24.693" end="04:25.144">dake</span><span begin="04:25.144" end="04:25.944">ma'tte</span><span begin="04:25.944" end="04:31.412">te</span></text><text for="L56"><span begin="04:31.422" end="04:32.022">koto</span><span begin="04:32.022" end="04:32.507">bana</span><span begin="04:32.507" end="04:33.246">donanimo</span><span begin="04:33.246" end="04:33.889">hoshi</span><span begin="04:33.889" end="04:34.374">kunai</span><span begin="04:34.374" end="04:35.127">hodo</span></text><text for="L57"><span begin="04:35.137" end="04:35.642">kana</span><span begin="04:35.642" end="04:36.280">shimini</span><span begin="04:36.280" end="04:37.214">itetsuku</span><span begin="04:37.214" end="04:37.864">yoru</span><span begin="04:37.864" end="04:38.412">demo</span></text><text for="L58"><span begin="04:38.422" end="04:39.296">ka'tteni</span><span begin="04:39.296" end="04:39.880">kimino</span><span begin="04:39.880" end="04:40.696">so</span><span begin="04:40.696" end="04:41.857">bade</span><span begin="04:42.039" end="04:42.579"></span><span begin="04:42.579" end="04:43.197"></span><span begin="04:43.197" end="04:43.812"></span><span begin="04:43.812" end="04:44.429"></span><span begin="04:44.429" end="04:45.505"></span></text><text for="L59"><span begin="04:45.715" end="04:46.409">yukiga</span><span begin="04:46.409" end="04:46.885">toke</span><span begin="04:46.885" end="04:47.599">temo</span><span begin="04:48.062" end="04:50.512">noko't</span><span begin="04:50.512" end="04:50.927">te</span><span begin="04:50.927" end="04:55.056">ru</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="05:05.509"><div begin="00:01.082" end="04:55.056"><p begin="00:01.082" end="00:04.195" ttm:agent="v1" itunes:key="L1"><span begin="00:01.082" end="00:01.514">「凍</span><span begin="00:01.514" end="00:02.132">りついた</span><span begin="00:02.132" end="00:02.710">心</span><span begin="00:02.710" end="00:03.031">には</span><span begin="00:03.031" end="00:03.898">太陽</span><span begin="00:03.898" end="00:04.195">を」</span><span ttm:role="x-translation" xml:lang="zh-Hans">“寒冰般冷彻的心需要暖阳融化”</span></p><p begin="00:04.405" end="00:08.181" ttm:agent="v1" itunes:key="L2"><span begin="00:04.405" end="00:04.874">そして</span><span begin="00:04.874" end="00:05.174">「僕</span><span begin="00:05.174" end="00:05.412">が</span><span begin="00:05.412" end="00:05.826">君に</span><span begin="00:05.826" end="00:06.508">とってその</span><span begin="00:06.508" end="00:07.159">ポジ</span><span begin="00:07.159" end="00:07.607">ション</span><span begin="00:07.607" end="00:08.181">を」</span><span ttm:role="x-translation" xml:lang="zh-Hans">就如同</span></p><p begin="00:08.518" end="00:14.876" ttm:agent="v1" itunes:key="L3"><span begin="00:08.518" end="00:09.091">そんな</span><span begin="00:09.091" end="00:09.523">だいぶ</span><span begin="00:09.523" end="00:10.073">傲慢</span><span begin="00:10.073" end="00:10.374">な</span><span begin="00:10.374" end="00:10.939">思い</span><span begin="00:10.939" end="00:11.621">込み</span><span begin="00:11.774" end="00:12.241">を</span><span begin="00:12.241" end="00:12.618">拗</span><span begin="00:12.618" end="00:13.257">らせて</span><span begin="00:13.257" end="00:13.923">たん</span><span begin="00:13.923" end="00:14.158">だ</span><span begin="00:14.158" end="00:14.876">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为我这相当傲慢的固执</span></p><p begin="00:14.886" end="00:17.150" ttm:agent="v1" itunes:key="L4"><span begin="00:14.886" end="00:15.091">ご</span><span begin="00:15.091" end="00:15.558">めん</span><span begin="00:15.558" end="00:17.150">ね</span><span ttm:role="x-translation" xml:lang="zh-Hans">抱歉啊 你就笑一笑吧</span></p><p begin="00:18.504" end="00:22.740" ttm:agent="v1" itunes:key="L5"><span begin="00:18.504" end="00:19.169">笑っ</span><span begin="00:19.169" end="00:20.336">て</span><span begin="00:20.573" end="00:21.052">やっ</span><span begin="00:21.052" end="00:22.740">て</span></p><p begin="00:23.268" end="00:26.576" ttm:agent="v1" itunes:key="L6"><span begin="00:23.268" end="00:24.095">火傷</span><span begin="00:24.095" end="00:24.714">しそうな</span><span begin="00:24.714" end="00:25.130">ほどの</span><span begin="00:25.130" end="00:25.615">ポジ</span><span begin="00:25.615" end="00:26.047">ティブ</span><span begin="00:26.047" end="00:26.576">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">我发现无论多么炽热的积极主动</span></p><p begin="00:26.586" end="00:30.496" ttm:agent="v1" itunes:key="L7"><span begin="00:26.586" end="00:27.059">冷</span><span begin="00:27.059" end="00:27.546">たさと</span><span begin="00:27.546" end="00:28.114">残酷</span><span begin="00:28.114" end="00:28.876">さに気付い</span><span begin="00:28.876" end="00:29.448">たん</span><span begin="00:29.448" end="00:30.496">だよ</span><span ttm:role="x-translation" xml:lang="zh-Hans">其中也有冰冷残酷的一面存在</span></p><p begin="00:30.606" end="00:37.371" ttm:agent="v1" itunes:key="L8"><span begin="00:30.606" end="00:31.150">きっと</span><span begin="00:31.150" end="00:31.619">君に</span><span begin="00:31.619" end="00:32.400">渡したい</span><span begin="00:32.400" end="00:33.536">ものは</span><span begin="00:33.536" end="00:34.000">もっ</span><span begin="00:34.000" end="00:34.334">と</span><span begin="00:34.334" end="00:34.784">ひん</span><span begin="00:34.784" end="00:35.219">やり</span><span begin="00:35.219" end="00:36.152">熱い</span><span begin="00:36.152" end="00:36.334">も</span><span begin="00:36.334" end="00:37.371">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">我想要向你传递的</span></p><p begin="00:38.498" end="00:42.243" ttm:agent="v1" itunes:key="L9"><span begin="00:38.498" end="00:39.284">綺麗事</span><span begin="00:39.284" end="00:39.816">じゃない</span><span begin="00:39.816" end="00:40.235">けど</span> <span begin="00:40.298" end="00:40.915">綺麗で</span><span begin="00:40.915" end="00:41.632">揺るぎない</span><span begin="00:41.632" end="00:42.243">もの</span><span ttm:role="x-translation" xml:lang="zh-Hans">不是什么嘴上说说而已的漂亮话</span></p><p begin="00:42.253" end="00:45.915" ttm:agent="v1" itunes:key="L10"><span begin="00:42.253" end="00:43.186">うわべよりも</span><span begin="00:43.186" end="00:44.119">胸の奥の</span><span begin="00:44.119" end="00:44.551">奥を</span><span begin="00:44.551" end="00:44.979">温</span><span begin="00:44.979" end="00:45.915">めるもの</span><span ttm:role="x-translation" xml:lang="zh-Hans">比起徒有其表</span></p><p begin="00:45.925" end="00:49.493" ttm:agent="v1" itunes:key="L11"><span begin="00:45.925" end="00:46.416">理想</span><span begin="00:46.416" end="00:46.816">だけは</span><span begin="00:46.816" end="00:47.549">あるけど</span> <span begin="00:47.645" end="00:48.216">心の</span><span begin="00:48.216" end="00:48.509">どこ</span><span begin="00:48.509" end="00:49.118">探して</span><span begin="00:49.118" end="00:49.493">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">仅凭理想</span></p><p begin="00:49.503" end="00:51.494" ttm:agent="v1" itunes:key="L12"><span begin="00:49.503" end="00:49.986">まるで</span><span begin="00:49.986" end="00:50.570">見つから</span><span begin="00:50.570" end="00:50.938">ないん</span><span begin="00:50.938" end="00:51.494">だよ</span><span ttm:role="x-translation" xml:lang="zh-Hans">却也几乎没有任何收获</span></p><p begin="00:51.504" end="00:56.239" ttm:agent="v1" itunes:key="L13"><span begin="00:51.504" end="00:51.828">伝</span><span begin="00:51.828" end="00:52.170">えたい</span><span begin="00:52.359" end="00:52.666">伝</span><span begin="00:52.666" end="00:53.155">わらない</span> <span begin="00:53.292" end="00:53.626">その</span><span begin="00:53.626" end="00:53.810">不</span><span begin="00:53.810" end="00:54.421">条</span><span begin="00:54.421" end="00:54.772">理が</span><span begin="00:54.772" end="00:56.239">今</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要告诉你 却开不了口</span></p><p begin="00:56.349" end="01:03.121" ttm:agent="v1" itunes:key="L14"><span begin="00:56.349" end="00:57.394">キツく</span><span begin="00:57.394" end="00:57.944">縛</span><span begin="00:57.944" end="00:58.245">り</span><span begin="00:58.245" end="00:58.760">つけるん</span><span begin="00:58.760" end="00:58.917">だ</span><span begin="00:58.917" end="01:00.390">よ</span> <span begin="01:00.982" end="01:01.928">臆病</span><span begin="01:01.928" end="01:02.128">な</span><span begin="01:02.128" end="01:02.421">僕</span><span begin="01:02.421" end="01:03.121">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">紧紧捆绑着我</span></p><p begin="01:03.476" end="01:08.346" ttm:agent="v1" itunes:key="L15"><span begin="01:03.476" end="01:03.959">この</span><span begin="01:03.959" end="01:04.911">一挙手</span><span begin="01:04.911" end="01:06.212">一投足</span><span begin="01:06.212" end="01:08.346">を</span></p><p begin="01:08.356" end="01:12.063" ttm:agent="v1" itunes:key="L16"><span begin="01:08.356" end="01:09.009">言葉</span><span begin="01:09.009" end="01:09.326">は</span><span begin="01:09.326" end="01:09.942">まるで</span><span begin="01:09.942" end="01:10.726">雪の</span><span begin="01:10.726" end="01:12.063">結晶</span><span ttm:role="x-translation" xml:lang="zh-Hans">都凝结在这如雪花般的话语中</span></p><p begin="01:12.073" end="01:15.368" ttm:agent="v1" itunes:key="L17"><span begin="01:12.073" end="01:12.708">君に</span><span begin="01:12.708" end="01:13.955">プレゼント</span><span begin="01:13.955" end="01:14.139">し</span><span begin="01:14.139" end="01:14.742">た</span><span begin="01:14.742" end="01:15.006">くて</span><span begin="01:15.006" end="01:15.368">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">将它当做礼物送给你</span></p><p begin="01:15.378" end="01:18.108" ttm:agent="v1" itunes:key="L18"><span begin="01:15.378" end="01:15.964">夢中に</span><span begin="01:15.964" end="01:16.415">なれば</span><span begin="01:16.415" end="01:16.964">なるほ</span><span begin="01:16.964" end="01:17.663">ど</span><span begin="01:17.663" end="01:18.108">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我越是不顾一切</span></p><p begin="01:18.118" end="01:21.774" ttm:agent="v1" itunes:key="L19"><span begin="01:18.118" end="01:18.715">形</span><span begin="01:18.715" end="01:19.080">は</span><span begin="01:19.080" end="01:19.684">崩れ</span><span begin="01:19.684" end="01:20.163">落ちて</span><span begin="01:20.163" end="01:20.598">溶けて</span><span begin="01:20.598" end="01:21.315">いっ</span><span begin="01:21.315" end="01:21.774">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">这脆弱的雪花便会支离破碎</span></p><p begin="01:21.784" end="01:23.593" ttm:agent="v1" itunes:key="L20"><span begin="01:21.784" end="01:22.353">消えて</span><span begin="01:22.353" end="01:22.453">し</span><span begin="01:22.453" end="01:23.168">まう</span><span begin="01:23.168" end="01:23.593">けど</span><span ttm:role="x-translation" xml:lang="zh-Hans">渐渐融化 消逝无踪</span></p><p begin="01:23.603" end="01:26.764" ttm:agent="v1" itunes:key="L21"><span begin="01:23.603" end="01:24.104">でも</span><span begin="01:24.104" end="01:24.771">僕が</span><span begin="01:24.771" end="01:25.454">選ぶ</span><span begin="01:25.454" end="01:26.088">言葉</span><span begin="01:26.088" end="01:26.764">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">我千挑万选的话语中</span></p><p begin="01:26.804" end="01:30.972" ttm:agent="v1" itunes:key="L22"><span begin="01:26.804" end="01:27.471">そこに</span><span begin="01:27.471" end="01:27.903">託</span><span begin="01:27.903" end="01:28.703">された</span><span begin="01:28.703" end="01:29.609">想</span><span begin="01:29.609" end="01:29.820">い</span><span begin="01:29.820" end="01:30.972">が</span><span ttm:role="x-translation" xml:lang="zh-Hans">寄托着我的心意</span></p><p begin="01:30.982" end="01:36.508" ttm:agent="v1" itunes:key="L23"><span begin="01:30.982" end="01:31.482">君</span><span begin="01:31.482" end="01:32.025">の</span><span begin="01:32.421" end="01:33.006">胸を</span><span begin="01:33.006" end="01:33.907">震わす</span><span begin="01:33.907" end="01:34.544">のを</span> <span begin="01:34.690" end="01:35.300">諦</span><span begin="01:35.300" end="01:36.088">められ</span><span begin="01:36.088" end="01:36.508">ない</span><span ttm:role="x-translation" xml:lang="zh-Hans">我不会放弃 用这话语中蕴藏的情感 动摇你的心</span></p><p begin="01:36.518" end="01:41.053" ttm:agent="v1" itunes:key="L24"><span begin="01:36.518" end="01:36.937">愛</span><span begin="01:36.937" end="01:37.529">してる</span><span begin="01:37.529" end="01:38.117">よりも</span><span begin="01:38.117" end="01:38.897">愛が</span><span begin="01:38.897" end="01:39.497">届く</span><span begin="01:39.497" end="01:39.796">ま</span><span begin="01:39.796" end="01:41.053">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">比起说出我爱你 不如将这份爱意传达到你的心底</span></p><p begin="01:44.855" end="01:48.511" ttm:agent="v1" itunes:key="L25"><span begin="01:44.855" end="01:45.406">もう</span><span begin="01:45.406" end="01:45.939">少し</span><span begin="01:45.939" end="01:46.390">だけ</span><span begin="01:46.390" end="01:47.174">待って</span><span begin="01:47.174" end="01:48.511">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">在此之前 请你再等等我</span></p><p begin="01:53.777" end="01:56.995" ttm:agent="v1" itunes:key="L26"><span begin="01:53.777" end="01:54.500">薄着</span><span begin="01:54.500" end="01:54.700">で</span><span begin="01:54.700" end="01:55.135">ただ</span><span begin="01:55.135" end="01:55.617">そばに</span><span begin="01:55.617" end="01:56.068">立っ</span><span begin="01:56.068" end="01:56.484">てて</span><span begin="01:56.484" end="01:56.995">も</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使穿着单薄地站在你身旁</span></p><p begin="01:57.005" end="02:01.038" ttm:agent="v1" itunes:key="L27"><span begin="01:57.005" end="01:57.892">不必要に</span><span begin="01:57.892" end="01:58.407">汗を</span><span begin="01:58.407" end="01:58.842">かいて</span><span begin="01:58.842" end="01:59.306">しまう</span><span begin="01:59.306" end="01:59.757">僕</span><span begin="01:59.757" end="02:00.175">なんか</span><span begin="02:00.175" end="02:01.038">もう</span><span ttm:role="x-translation" xml:lang="zh-Hans">却也会莫名其妙的汗流不止</span></p><p begin="02:01.148" end="02:07.825" ttm:agent="v1" itunes:key="L28"><span begin="02:01.148" end="02:01.691">どうし</span><span begin="02:01.691" end="02:02.107">たって</span><span begin="02:02.107" end="02:03.024">生温くて</span><span begin="02:03.024" end="02:03.925">君</span><span begin="02:03.925" end="02:04.256">を</span><span begin="02:04.256" end="02:04.875">痛め</span><span begin="02:04.875" end="02:05.773">つけてし</span><span begin="02:05.773" end="02:06.255">まう</span><span begin="02:06.255" end="02:06.691">のだ</span><span begin="02:06.691" end="02:07.825">ろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">会如此的不成熟</span></p><p begin="02:09.000" end="02:12.674" ttm:agent="v1" itunes:key="L29"><span begin="02:09.000" end="02:09.180">「手</span><span begin="02:09.180" end="02:09.828">のひらが</span><span begin="02:09.828" end="02:10.326">熱い</span><span begin="02:10.326" end="02:10.584">ほど</span><span begin="02:10.688" end="02:11.310">心は</span><span begin="02:11.310" end="02:11.590">冷</span><span begin="02:11.590" end="02:12.227">たいんで</span><span begin="02:12.227" end="02:12.674">しょう？」</span><span ttm:role="x-translation" xml:lang="zh-Hans">“是不是双手越发温暖</span></p><p begin="02:12.684" end="02:16.321" ttm:agent="v1" itunes:key="L30"><span begin="02:12.684" end="02:13.592">冗談でも</span><span begin="02:13.592" end="02:14.074">そんな</span><span begin="02:14.074" end="02:14.557">残酷</span><span begin="02:14.557" end="02:15.177">なこと</span><span begin="02:15.177" end="02:15.874">言わないで</span><span begin="02:15.874" end="02:16.321">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">哪怕是开玩笑</span></p><p begin="02:16.431" end="02:21.855" ttm:agent="v1" itunes:key="L31"><span begin="02:16.431" end="02:16.829">別に</span><span begin="02:16.829" end="02:17.308">言えば</span><span begin="02:17.308" end="02:18.013">いいけど</span> <span begin="02:18.158" end="02:19.141">全人生を</span><span begin="02:19.141" end="02:19.641">賭けて</span><span begin="02:19.641" end="02:19.946">も</span> <span begin="02:19.946" end="02:20.428">ちゃんと</span><span begin="02:20.428" end="02:21.013">覆</span><span begin="02:21.013" end="02:21.492">さして</span><span begin="02:21.492" end="02:21.855">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">不过就算你这么说 也没关系</span></p><p begin="02:21.865" end="02:26.668" ttm:agent="v1" itunes:key="L32"><span begin="02:21.865" end="02:22.749">救いたい＝</span><span begin="02:22.749" end="02:23.585">救われたい</span> <span begin="02:23.762" end="02:24.073">この</span><span begin="02:24.073" end="02:24.860">イコー</span><span begin="02:24.860" end="02:25.238">ルが</span><span begin="02:25.238" end="02:26.668">今</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要拯救你＝想被你拯救</span></p><p begin="02:26.778" end="02:31.060" ttm:agent="v1" itunes:key="L33"><span begin="02:26.778" end="02:27.354">優</span><span begin="02:27.354" end="02:27.789">しく</span><span begin="02:27.789" end="02:28.304">剥が</span><span begin="02:28.304" end="02:28.736">して</span><span begin="02:28.736" end="02:29.272">いくんだ</span><span begin="02:29.272" end="02:31.060">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">正悄悄地被揭下</span></p><p begin="02:31.400" end="02:38.557" ttm:agent="v1" itunes:key="L34"><span begin="02:31.400" end="02:31.917">堅い</span><span begin="02:31.917" end="02:32.434">理論</span><span begin="02:32.434" end="02:33.355">武装</span> <span begin="02:33.965" end="02:35.136">プライドの</span><span begin="02:35.136" end="02:35.733">過剰</span><span begin="02:35.733" end="02:36.538">包装</span><span begin="02:36.538" end="02:38.557">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">它表面坚固的理论武装</span></p><p begin="02:38.797" end="02:42.469" ttm:agent="v1" itunes:key="L35"><span begin="02:38.797" end="02:39.324">正</span><span begin="02:39.324" end="02:40.434">しさよりも</span><span begin="02:40.434" end="02:40.834">優</span><span begin="02:40.834" end="02:41.618">しさが</span><span begin="02:41.618" end="02:41.789">欲</span><span begin="02:41.789" end="02:42.469">しい</span><span ttm:role="x-translation" xml:lang="zh-Hans">比起合理的正确 我更加渴望变得温柔</span></p><p begin="02:42.509" end="02:45.844" ttm:agent="v1" itunes:key="L36"><span begin="02:42.509" end="02:43.124">そして</span><span begin="02:43.124" end="02:43.889">それを</span><span begin="02:43.889" end="02:44.372">受け</span><span begin="02:44.372" end="02:44.572">取</span><span begin="02:44.572" end="02:45.238">れ</span><span begin="02:45.238" end="02:45.524">るの</span><span begin="02:45.524" end="02:45.844">は</span><span ttm:role="x-translation" xml:lang="zh-Hans">与此同时 希望能够接收这份温柔的对象</span></p><p begin="02:45.954" end="02:48.510" ttm:agent="v1" itunes:key="L37"><span begin="02:45.954" end="02:46.436">イルミ</span><span begin="02:46.436" end="02:47.165">ネーション</span><span begin="02:47.165" end="02:47.287">み</span><span begin="02:47.287" end="02:48.103">たい</span><span begin="02:48.103" end="02:48.510">な</span><span ttm:role="x-translation" xml:lang="zh-Hans">并不是如霓虹灯般</span></p><p begin="02:48.560" end="02:52.212" ttm:agent="v1" itunes:key="L38"><span begin="02:48.560" end="02:49.491">不特定</span><span begin="02:49.491" end="02:49.941">多数</span><span begin="02:49.941" end="02:50.576">じゃなくて</span><span begin="02:50.576" end="02:50.903">ただ</span><span begin="02:50.903" end="02:52.212">1人</span><span ttm:role="x-translation" xml:lang="zh-Hans">模糊而泛滥的绝大多数人</span></p><p begin="02:52.222" end="02:58.687" ttm:agent="v1" itunes:key="L39"><span begin="02:52.222" end="02:52.861">君で</span><span begin="02:52.861" end="02:53.489">あっ</span><span begin="02:53.489" end="02:53.895">てほ</span><span begin="02:53.895" end="02:58.687">しい</span><span ttm:role="x-translation" xml:lang="zh-Hans">而是唯有一人 我希望 那会是你</span></p><p begin="03:09.495" end="03:15.766" ttm:agent="v1" itunes:key="L40"><span begin="03:09.495" end="03:10.222">かけた</span><span begin="03:10.222" end="03:11.355">言葉</span><span begin="03:11.355" end="03:11.911">で</span> <span begin="03:12.047" end="03:12.723">割れた</span><span begin="03:12.723" end="03:13.115">ヒビ</span><span begin="03:13.115" end="03:13.653">を</span><span begin="03:13.653" end="03:14.114">直</span><span begin="03:14.114" end="03:14.574">そう</span><span begin="03:14.574" end="03:15.041">とし</span><span begin="03:15.041" end="03:15.766">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使想用曾经的话语</span></p><p begin="03:15.976" end="03:23.779" ttm:agent="v1" itunes:key="L41"><span begin="03:15.976" end="03:16.842">足し</span><span begin="03:16.842" end="03:17.608">すぎた</span><span begin="03:17.608" end="03:18.741">熱量</span><span begin="03:18.741" end="03:19.211">で</span> <span begin="03:19.418" end="03:20.127">引かれ</span><span begin="03:20.127" end="03:20.508">て</span><span begin="03:20.508" end="03:21.427">しまっ</span><span begin="03:21.427" end="03:21.944">た</span><span begin="03:22.458" end="03:23.328">カー</span><span begin="03:23.328" end="03:23.779">テン</span><span ttm:role="x-translation" xml:lang="zh-Hans">但这过分炽热的热量</span></p><p begin="03:23.789" end="03:30.256" ttm:agent="v1" itunes:key="L42"><span begin="03:23.789" end="03:24.243">そん</span><span begin="03:24.243" end="03:24.693">な</span><span begin="03:24.693" end="03:26.093">失敗作</span><span begin="03:26.093" end="03:26.592">を</span> <span begin="03:26.992" end="03:27.544">重ね</span><span begin="03:27.544" end="03:27.973">て</span> <span begin="03:28.395" end="03:28.877">重ね</span><span begin="03:28.877" end="03:29.258">て</span> <span begin="03:29.328" end="03:29.811">重ね</span><span begin="03:29.811" end="03:30.256">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">不断重复 不断积累</span></p><p begin="03:30.266" end="03:32.860" ttm:agent="v1" itunes:key="L43"><span begin="03:30.266" end="03:30.715">見つけ</span><span begin="03:30.715" end="03:31.200">た</span><span begin="03:31.200" end="03:31.632">いんだ</span><span begin="03:31.632" end="03:31.917">いつ</span><span begin="03:31.917" end="03:32.860">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">总有一天我能够找到</span></p><p begin="03:32.970" end="03:39.215" ttm:agent="v1" itunes:key="L44"><span begin="03:32.970" end="03:33.938">最高</span><span begin="03:33.938" end="03:34.306">の</span><span begin="03:34.306" end="03:35.338">一言</span><span begin="03:35.338" end="03:35.789">一句</span><span begin="03:35.789" end="03:39.215">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">那最完美的一字一句</span></p><p begin="03:39.748" end="03:43.375" ttm:agent="v1" itunes:key="L45"><span begin="03:39.748" end="03:40.682">言葉は</span><span begin="03:40.682" end="03:41.301">まるで</span><span begin="03:41.301" end="03:42.082">雪の</span><span begin="03:42.082" end="03:43.375">結晶</span><span ttm:role="x-translation" xml:lang="zh-Hans">想要将这雪花般的话语</span></p><p begin="03:43.385" end="03:46.709" ttm:agent="v1" itunes:key="L46"><span begin="03:43.385" end="03:44.032">君に</span><span begin="03:44.032" end="03:45.318">プレゼント</span><span begin="03:45.318" end="03:45.473">し</span><span begin="03:45.473" end="03:46.200">た</span><span begin="03:46.200" end="03:46.467">とし</span><span begin="03:46.467" end="03:46.709">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">当做礼物送给你</span></p><p begin="03:46.719" end="03:49.386" ttm:agent="v1" itunes:key="L47"><span begin="03:46.719" end="03:47.340">時間が</span><span begin="03:47.340" end="03:47.775">経って</span><span begin="03:47.775" end="03:48.308">しまえば</span><span begin="03:48.308" end="03:48.991">大</span><span begin="03:48.991" end="03:49.386">抵</span><span ttm:role="x-translation" xml:lang="zh-Hans">或许随着时间流逝而去</span></p><p begin="03:49.426" end="03:53.085" ttm:agent="v1" itunes:key="L48"><span begin="03:49.426" end="03:50.111">記憶か</span><span begin="03:50.111" end="03:50.373">ら</span><span begin="03:50.373" end="03:50.991">溢れ</span><span begin="03:50.991" end="03:51.474">落ちて</span><span begin="03:51.474" end="03:51.956">溶けて</span><span begin="03:51.956" end="03:52.623">いっ</span><span begin="03:52.623" end="03:53.085">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">这雪花也会从满溢的回忆中飘落</span></p><p begin="03:53.125" end="03:54.979" ttm:agent="v1" itunes:key="L49"><span begin="03:53.125" end="03:53.736">消えて</span><span begin="03:53.736" end="03:53.844">し</span><span begin="03:53.844" end="03:54.557">まう</span> <span begin="03:54.557" end="03:54.979">でも</span><span ttm:role="x-translation" xml:lang="zh-Hans">渐渐融化 消逝无踪</span></p><p begin="03:54.989" end="03:58.061" ttm:agent="v1" itunes:key="L50"><span begin="03:54.989" end="03:55.533">絶えず</span><span begin="03:55.533" end="03:56.059">僕</span><span begin="03:56.059" end="03:56.533">らの</span><span begin="03:56.533" end="03:57.066">ストー</span><span begin="03:57.066" end="03:57.501">リー</span><span begin="03:57.501" end="03:58.061">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">但是 就如同在我们永不完结的故事之中</span></p><p begin="03:58.171" end="04:01.944" ttm:agent="v1" itunes:key="L51"><span begin="03:58.171" end="03:58.372">添</span><span begin="03:58.372" end="03:58.763">え</span><span begin="03:58.763" end="03:59.394">られた</span><span begin="03:59.394" end="04:00.277">字幕の</span><span begin="04:00.277" end="04:01.109">よう</span><span begin="04:01.109" end="04:01.944">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">添附上的滚动字幕一般</span></p><p begin="04:01.954" end="04:09.747" ttm:agent="v1" itunes:key="L52"><span begin="04:01.954" end="04:02.609">思い</span><span begin="04:02.609" end="04:03.343">返</span><span begin="04:03.343" end="04:03.791">した</span><span begin="04:03.791" end="04:05.306">時</span> <span begin="04:05.595" end="04:06.225">不意</span><span begin="04:06.225" end="04:06.692">に</span><span begin="04:06.692" end="04:07.041">目</span><span begin="04:07.041" end="04:07.209">を</span><span begin="04:07.209" end="04:07.492">や</span><span begin="04:07.492" end="04:07.993">る</span><span begin="04:07.993" end="04:08.409">時</span><span begin="04:08.409" end="04:09.747">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">在你回首过往时 会不经意间注意到</span></p><p begin="04:09.751" end="04:15.299" ttm:agent="v1" itunes:key="L53"><span begin="04:09.751" end="04:10.234">君</span><span begin="04:10.234" end="04:10.772">の</span><span begin="04:11.084" end="04:11.719">胸を</span><span begin="04:11.719" end="04:12.170">震</span><span begin="04:12.170" end="04:12.671">わす</span><span begin="04:12.671" end="04:13.284">もの</span> <span begin="04:13.423" end="04:14.020">探し</span><span begin="04:14.020" end="04:14.385">続</span><span begin="04:14.385" end="04:15.299">けたい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我会一直寻觅那份 能够撼动你内心的感情</span></p><p begin="04:15.309" end="04:19.789" ttm:agent="v1" itunes:key="L54"><span begin="04:15.309" end="04:15.685">愛</span><span begin="04:15.685" end="04:16.302">してる</span><span begin="04:16.302" end="04:16.867">よりも</span><span begin="04:16.867" end="04:17.651">愛が</span><span begin="04:17.651" end="04:18.102">届</span><span begin="04:18.102" end="04:18.603">くま</span><span begin="04:18.603" end="04:19.789">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">比起说出我爱你 不如将这份爱意传达到你的心底</span></p><p begin="04:23.579" end="04:31.412" ttm:agent="v1" itunes:key="L55"><span begin="04:23.579" end="04:24.045">もう</span><span begin="04:24.045" end="04:24.693">少し</span><span begin="04:24.693" end="04:25.144">だけ</span><span begin="04:25.144" end="04:25.944">待って</span><span begin="04:25.944" end="04:31.412">て</span><span ttm:role="x-translation" xml:lang="zh-Hans">在此之前 请你再等等我</span></p><p begin="04:31.422" end="04:35.127" ttm:agent="v1" itunes:key="L56"><span begin="04:31.422" end="04:32.022">言葉</span><span begin="04:32.022" end="04:32.507">など</span><span begin="04:32.507" end="04:33.246">何も</span><span begin="04:33.246" end="04:33.889">欲しく</span><span begin="04:33.889" end="04:34.374">ないほ</span><span begin="04:34.374" end="04:35.127">ど</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使在那想要独自安静</span></p><p begin="04:35.137" end="04:38.412" ttm:agent="v1" itunes:key="L57"><span begin="04:35.137" end="04:35.642">悲</span><span begin="04:35.642" end="04:36.280">しみに</span><span begin="04:36.280" end="04:37.214">凍てつく</span><span begin="04:37.214" end="04:37.864">夜</span><span begin="04:37.864" end="04:38.412">でも</span><span ttm:role="x-translation" xml:lang="zh-Hans">因悲伤而冰冷彻骨的夜晚</span></p><p begin="04:38.422" end="04:45.505" ttm:agent="v1" itunes:key="L58"><span begin="04:38.422" end="04:39.296">勝手に</span><span begin="04:39.296" end="04:39.880">君の</span><span begin="04:39.880" end="04:40.696">そば</span><span begin="04:40.696" end="04:41.857">で</span> <span begin="04:42.039" end="04:42.579">あれ</span><span begin="04:42.579" end="04:43.197">これと</span><span begin="04:43.197" end="04:43.812">考</span><span begin="04:43.812" end="04:44.429">えて</span><span begin="04:44.429" end="04:45.505">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也会任性的待在你身边</span></p><p begin="04:45.715" end="04:55.056" ttm:agent="v1" itunes:key="L59"><span begin="04:45.715" end="04:46.409">雪が</span><span begin="04:46.409" end="04:46.885">溶け</span><span begin="04:46.885" end="04:47.599">ても</span><span begin="04:48.062" end="04:50.512">残っ</span><span begin="04:50.512" end="04:50.927">て</span><span begin="04:50.927" end="04:55.056">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">即使雪花早已融化 曾经存在过的痕迹也会永远留存在你心中吧</span></p></div></body></tt>