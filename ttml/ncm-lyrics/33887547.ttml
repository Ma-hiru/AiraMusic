<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Word" xml:lang="ja-JP"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="group" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><amll:meta key="ncmMusicId" value="33887547"/><amll:meta key="appleMusicId" value="1538283674"/><amll:meta key="musicName" value="夜空。"/><amll:meta key="artists" value="miwa / ハジ→"/><amll:meta key="album" value="夜空。／ストレスフリー"/><amll:meta key="ttmlAuthorGithub" value="149807805"/><amll:meta key="ttmlAuthorGithubLogin" value="Ma-hiru"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><transliterations><transliteration xml:lang="ja-Latn"><text for="L1"><span begin="00:22.965" end="00:24.054">sayo</span><span begin="00:24.054" end="00:25.079">nara</span><span begin="00:25.218" end="00:26.697">itoshi</span><span begin="00:26.697" end="00:28.844">kihitoyo</span></text><text for="L2"><span begin="00:29.035" end="00:29.869">mou</span><span begin="00:29.869" end="00:30.887">nidotoae</span><span begin="00:30.970" end="00:32.302">nai</span></text><text for="L3"><span begin="00:32.412" end="00:32.822">nai</span><span begin="00:32.822" end="00:34.013">soukimeta</span><span begin="00:34.013" end="00:34.729">noni</span></text><text for="L4"><span begin="00:34.910" end="00:36.177">doushi</span><span begin="00:36.336" end="00:37.610">tedoushite</span></text><text for="L5"><span begin="00:37.620" end="00:37.951"></span><span begin="00:37.951" end="00:38.282">ana</span><span begin="00:38.282" end="00:39.783">tawowasurerarenai</span><span begin="00:39.783" end="00:41.386">ndarou</span></text><text for="L6"><span begin="00:41.666" end="00:42.469">kyou</span><span begin="00:42.469" end="00:43.711">moyozorani</span></text><text for="L8"><span begin="00:58.880" end="00:59.445">do</span><span begin="00:59.445" end="01:00.324">u