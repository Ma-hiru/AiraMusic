3:36.389">ka</span></text><text for="L45"><span begin="03:35.578" end="03:38.348">anatawaanatade</span><span begin="03:38.348" end="03:39.733">irarete</span><span begin="03:39.733" end="03:40.635">imasu</span><span begin="03:40.635" end="03:42.409">ka</span></text><text for="L46"><span begin="03:41.142" end="03:43.993">kimiwakimirashiku</span><span begin="03:43.993" end="03:46.276">irareteima</span><span begin="03:46.276" end="03:47.302">suka</span></text><text for="L47"><span begin="03:46.747" end="03:47.427">watashi</span><span begin="03:47.427" end="03:48.144">waanata</span><span begin="03:48.144" end="03:49.030">wotado't</span><span begin="03:49.030" end="03:49.916">teimashita</span></text><text for="L48"><span begin="03:50.126" end="03:51.171">ikidomari</span><span begin="03:51.171" end="03:52.216">nomainichi</span></text><text for="L49"><span begin="03:52.225" end="03:54.476">mayoikondama</span><span begin="03:54.664" end="03:55.280">mamae</span><span begin="03:55.280" end="03:56.652">nisusume</span><span begin="03:56.652" end="03:57.877">zuni</span></text><text for="L50"><span begin="03:58.102" end="03:58.691">ore</span><span begin="03:58.691" end="03:59.576">mokiminoko</span><span begin="03:59.576" end="04:00.461">toomo't</span><span begin="04:00.461" end="04:01.345">teimashita</span></text><text for="L51"><span begin="04:01.720" end="04:02.425">konya</span><span begin="04:02.425" end="04:03.845">moanokoronoma</span><span begin="04:03.845" end="04:05.062">manofutari</span></text><text for="L52"><span begin="04:05.071" end="04:06.188">i'sshonii</span><span begin="04:06.188" end="04:06.855">tajikan</span></text><text for="L53"><span begin="04:06.865" end="04:07.591">nando</span><span begin="04:07.591" end="04:08.902">moatamanonaka</span><span begin="04:08.902" end="04:09.899">dekurikaesa</span><span begin="04:09.899" end="04:12.581">reru</span></text><text for="L54"><span begin="04:20.107" end="04:21.196">sayo</span><span begin="04:21.196" end="04:22.221">nara</span><span begin="04:22.360" end="04:23.839">itoshi</span><span begin="04:23.839" end="04:25.986">kihitoyo</span></text><text for="L55"><span begin="04:26.204" end="04:27.038">mouni</span><span begin="04:27.038" end="04:28.056">dotoaena</span><span begin="04:28.139" end="04:29.471">i</span></text><text for="L56"><span begin="04:29.545" end="04:29.955">iso</span><span begin="04:29.955" end="04:31.146">ukimeta</span><span begin="04:31.146" end="04:31.862">noni</span></text><text for="L57"><span begin="04:32.004" end="04:33.271">doushite</span><span begin="04:33.430" end="04:34.704">doushite</span></text><text for="L58"><span begin="04:34.811" end="04:35.494">anata</span><span begin="04:35.494" end="04:36.939">wowasurerarenai</span><span begin="04:36.939" end="04:38.655">ndarou</span></text><text for="L59"><span begin="04:38.850" end="04:39.653">kyoumo</span><span begin="04:39.653" end="04:40.982">yozorani</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="05:11.573"><div begin="00:22.965" end="04:44.395"><p begin="00:22.965" end="00:28.844" ttm:agent="v3" itunes:key="L1"><span begin="00:22.965" end="00:24.054">さよな</span><span begin="00:24.054" end="00:25.079">ら</span> <span begin="00:25.218" end="00:26.697">愛しき</span><span begin="00:26.697" end="00:28.844">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="00:29.035" end="00:32.302" ttm:agent="v3" itunes:key="L2"><span begin="00:29.035" end="00:29.869">もう二度と</span><span begin="00:29.869" end="00:30.887">会えない</span> <span begin="00:30.970" end="00:32.302">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="00:32.412" end="00:34.729" ttm:agent="v3" itunes:key="L3"><span begin="00:32.412" end="00:32.822">そう</span><span begin="00:32.822" end="00:34.013">決めたの</span><span begin="00:34.013" end="00:34.729">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明已经决定不再见你</span></p><p begin="00:34.910" end="00:37.610" ttm:agent="v3" itunes:key="L4"><span begin="00:34.910" end="00:36.177">どうして</span> <span begin="00:36.336" end="00:37.610">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="00:37.620" end="00:41.386" ttm:agent="v3" itunes:key="L5"><span begin="00:37.620" end="00:37.951">あなた</span><span begin="00:37.951" end="00:38.282">を</span> <span begin="00:38.282" end="00:39.783">忘れられないん</span><span begin="00:39.783" end="00:41.386">だろう？</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="00:41.666" end="00:43.711" ttm:agent="v3" itunes:key="L6"><span begin="00:41.666" end="00:42.469">今日も</span><span begin="00:42.469" end="00:43.711">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="00:43.807" end="00:47.224" ttm:agent="v3" itunes:key="L7"><span begin="00:43.807" end="00:45.186">ネガウ</span> <span begin="00:45.186" end="00:46.001">アイ</span><span begin="00:46.001" end="00:47.224">タイ</span></p><p begin="00:58.880" end="01:02.444" ttm:agent="v3" itunes:key="L8"><span begin="00:58.880" end="00:59.445">どう</span><span begin="00:59.445" end="01:00.324">して</span> <span begin="01:00.324" end="01:01.318">あなた</span><span begin="01:01.318" end="01:02.444">を</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么我</span></p><p begin="01:03.454" end="01:07.880" ttm:agent="v3" itunes:key="L9"><span begin="01:03.454" end="01:04.054">好きに</span><span begin="01:04.054" end="01:05.216">なって</span><span begin="01:05.216" end="01:06.601">しまったん</span><span begin="01:06.601" end="01:07.880">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">会喜欢上你呢</span></p><p begin="01:10.323" end="01:14.849" ttm:agent="v3" itunes:key="L10"><span begin="01:10.323" end="01:11.660">出会った</span> <span begin="01:11.660" end="01:12.391">その</span><span begin="01:12.391" end="01:13.856">瞬間か</span><span begin="01:13.856" end="01:14.849">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">在相遇的那个瞬间</span></p><p begin="01:15.342" end="01:19.877" ttm:agent="v3" itunes:key="L11"><span begin="01:15.342" end="01:16.167">心</span><span begin="01:16.167" end="01:17.410">奪われて</span><span begin="01:17.410" end="01:18.437">しまった</span><span begin="01:18.437" end="01:19.877">の</span><span ttm:role="x-translation" xml:lang="zh-Hans">心就已经被你夺走</span></p><p begin="01:21.200" end="01:23.151" ttm:agent="v1" itunes:key="L12"><span begin="01:21.200" end="01:22.325">俺のどこが</span><span begin="01:22.325" end="01:23.151">いいのか</span><span ttm:role="x-translation" xml:lang="zh-Hans">我到底有什么好的</span></p><p begin="01:23.346" end="01:26.092" ttm:agent="v1" itunes:key="L13"><span begin="01:23.346" end="01:24.525">わからないけど</span> <span begin="01:24.525" end="01:26.092">君は言ってた</span><span ttm:role="x-translation" xml:lang="zh-Hans">我真的不知道 可你却对我说</span></p><p begin="01:26.102" end="01:29.888" ttm:agent="v3" itunes:key="L14"><span begin="01:26.102" end="01:26.880">あなたが</span> <span begin="01:26.880" end="01:27.970">望むように</span> <span begin="01:27.970" end="01:28.737">私が</span><span begin="01:28.737" end="01:29.888">変わるから</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;我会努力变成</span></p><p begin="01:29.898" end="01:32.457" ttm:agent="v1" itunes:key="L15"><span begin="01:29.898" end="01:30.250">でも</span> <span begin="01:30.250" end="01:31.138">そういうこと</span><span begin="01:31.138" end="01:32.457">じゃなかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">可并不应该是这样</span></p><p begin="01:32.667" end="01:33.836" ttm:agent="v2" itunes:key="L16"><span begin="01:32.667" end="01:33.836">今の俺には</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;现在的我</span></p><p begin="01:33.836" end="01:38.232" ttm:agent="v2" itunes:key="L17"><span begin="01:33.836" end="01:34.355">君を</span><span begin="01:34.355" end="01:36.126">幸せにすることは</span><span begin="01:36.126" end="01:38.232">できないからって</span><span ttm:role="x-translation" xml:lang="zh-Hans">没有办法</span></p><p begin="01:38.442" end="01:40.878" ttm:agent="v3" itunes:key="L18"><span begin="01:38.442" end="01:38.861">そう</span> <span begin="01:38.861" end="01:39.572">あなたは</span><span begin="01:39.572" end="01:40.878">言ってたけど</span><span ttm:role="x-translation" xml:lang="zh-Hans">你虽然那么说</span></p><p begin="01:40.988" end="01:42.498" ttm:agent="v3" itunes:key="L19"><span begin="01:40.988" end="01:42.498">幸せだった</span><span ttm:role="x-translation" xml:lang="zh-Hans">可是我真的很幸福</span></p><p begin="01:42.665" end="01:46.200" ttm:agent="v3" itunes:key="L20"><span begin="01:42.665" end="01:44.029">あなたの隣に</span><span begin="01:44.029" end="01:45.208">いるだけ</span><span begin="01:45.208" end="01:46.200">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">只是陪在你的身边</span></p><p begin="01:46.579" end="01:48.629" ttm:agent="v3" itunes:key="L21"><span begin="01:46.579" end="01:46.921">ただ</span><span begin="01:46.921" end="01:48.082">それだけ</span><span begin="01:48.082" end="01:48.629">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">仅仅如此就已足够</span></p><p begin="01:48.688" end="01:54.567" ttm:agent="v2" itunes:key="L22"><span begin="01:48.688" end="01:49.777">さよな</span><span begin="01:49.777" end="01:50.802">ら</span> <span begin="01:50.941" end="01:52.420">愛しき</span><span begin="01:52.420" end="01:54.567">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="01:54.726" end="01:57.993" ttm:agent="v2" itunes:key="L23"><span begin="01:54.726" end="01:55.560">もう二度と</span><span begin="01:55.560" end="01:56.578">会えない</span> <span begin="01:56.661" end="01:57.993">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="01:58.093" end="02:00.410" ttm:agent="v2" itunes:key="L24"><span begin="01:58.093" end="01:58.503">そう</span><span begin="01:58.503" end="01:59.694">決めたの</span><span begin="01:59.694" end="02:00.410">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明已经决定不再见你</span></p><p begin="02:00.559" end="02:03.259" ttm:agent="v2" itunes:key="L25"><span begin="02:00.559" end="02:01.826">どうして</span> <span begin="02:01.985" end="02:03.259">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="02:03.341" end="02:07.165" ttm:agent="v2" itunes:key="L26"><span begin="02:03.341" end="02:04.024">あなたを</span> <span begin="02:04.024" end="02:05.474">忘れられないん</span><span begin="02:05.474" end="02:07.165">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="02:07.424" end="02:09.556" ttm:agent="v2" itunes:key="L27"><span begin="02:07.424" end="02:08.101">今日も</span><span begin="02:08.101" end="02:09.556">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="02:09.464" end="02:12.931" ttm:agent="v2" itunes:key="L28"><span begin="02:09.464" end="02:10.896">ネガウ</span> <span begin="02:11.011" end="02:11.670">アイ</span><span begin="02:11.670" end="02:12.931">タイ</span></p><p begin="02:24.488" end="02:28.577" ttm:agent="v1" itunes:key="L29"><span begin="02:24.488" end="02:26.250">どうして</span> <span begin="02:26.250" end="02:26.938">君</span><span begin="02:26.938" end="02:28.577">と</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么我</span></p><p begin="02:29.231" end="02:34.011" ttm:agent="v1" itunes:key="L30"><span begin="02:29.231" end="02:30.279">別れる</span><span begin="02:30.279" end="02:31.194">ことを</span><span begin="02:31.194" end="02:32.237">選んだん</span><span begin="02:32.237" end="02:34.011">だろう</span></p><p begin="02:35.959" end="02:40.591" ttm:agent="v1" itunes:key="L31"><span begin="02:35.959" end="02:37.411">離れた</span> <span begin="02:37.411" end="02:38.069">その</span><span begin="02:38.069" end="02:39.504">瞬間か</span><span begin="02:39.504" end="02:40.591">ら</span><span ttm:role="x-translation" xml:lang="zh-Hans">在分开的那个瞬间</span></p><p begin="02:40.975" end="02:45.895" ttm:agent="v1" itunes:key="L32"><span begin="02:40.975" end="02:41.920">心</span><span begin="02:41.920" end="02:43.101">失って</span><span begin="02:43.101" end="02:43.893">しまった</span><span begin="02:43.893" end="02:45.895">よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">我就丢了自己的心</span></p><p begin="02:46.834" end="02:49.048" ttm:agent="v3" itunes:key="L33"><span begin="02:46.834" end="02:47.965">つないだ手の</span><span begin="02:47.965" end="02:49.048">温もり</span><span ttm:role="x-translation" xml:lang="zh-Hans">牵手的温度</span></p><p begin="02:49.057" end="02:51.811" ttm:agent="v3" itunes:key="L34"><span begin="02:49.057" end="02:50.579">見上げた星空の</span><span begin="02:50.579" end="02:51.811">下ふたり</span><span ttm:role="x-translation" xml:lang="zh-Hans">与你并肩仰望的星空</span></p><p begin="02:52.062" end="02:52.607" ttm:agent="v2" itunes:key="L35"><span begin="02:52.062" end="02:52.607">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">为什么现在想起的</span></p><p begin="02:52.607" end="02:55.466" ttm:agent="v2" itunes:key="L36"><span begin="02:52.607" end="02:53.665">楽しかった</span><span begin="02:53.665" end="02:54.479">思い出の</span><span begin="02:54.479" end="02:55.466">事ばかり</span></p><p begin="02:55.477" end="02:57.593" ttm:agent="v2" itunes:key="L37"><span begin="02:55.477" end="02:56.359">よみがえって</span><span begin="02:56.359" end="02:57.593">くるんだろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">尽是那些愉快的回忆</span></p><p begin="02:57.800" end="03:00.551" ttm:agent="v1" itunes:key="L38"><span begin="02:57.800" end="02:59.208">もっと寄り添って</span><span begin="02:59.208" end="03:00.551">やりたかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;还想陪你再久一点&quot;</span></p><p begin="03:00.551" end="03:04.059" ttm:agent="v3" itunes:key="L39"><span begin="03:00.551" end="03:01.152">もっと</span><span begin="03:01.152" end="03:02.593">あなたの癒しに</span><span begin="03:02.593" end="03:04.059">なりたかった</span><span ttm:role="x-translation" xml:lang="zh-Hans">&quot;还想治愈你</span></p><p begin="03:04.170" end="03:06.318" ttm:agent="v2" itunes:key="L40"><span begin="03:04.170" end="03:04.740">もしも</span> <span begin="03:04.740" end="03:05.275">想い</span><span begin="03:05.275" end="03:06.318">届くなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">如果这份想法可以传达</span></p><p begin="03:06.329" end="03:09.068" ttm:agent="v1" itunes:key="L41"><span begin="03:06.329" end="03:07.277">もう一度</span> <span begin="03:07.277" end="03:07.919">あの日に</span><span begin="03:07.919" end="03:09.068">戻りたい</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还想再次回到那一天</span></p><p begin="03:09.189" end="03:12.631" ttm:agent="v3" itunes:key="L42"><span begin="03:09.189" end="03:10.155">もう一度</span> <span begin="03:10.155" end="03:10.809">あなたと</span><span begin="03:10.809" end="03:11.305">出逢い</span><span begin="03:11.305" end="03:12.631">たい</span><span ttm:role="x-translation" xml:lang="zh-Hans">还想再次与你相逢</span></p><p begin="03:24.003" end="03:30.657" ttm:agent="v3" itunes:key="L43"><span begin="03:24.003" end="03:25.383">あなたは</span> <span begin="03:25.383" end="03:26.833">誰かと</span><span begin="03:26.833" end="03:28.320">笑えて</span><span begin="03:28.320" end="03:29.243">います</span><span begin="03:29.243" end="03:30.657">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你正在和他人相视而笑吗</span></p><p begin="03:29.781" end="03:36.389" ttm:agent="v1" itunes:key="L44"><span begin="03:29.781" end="03:32.554">君は今どこで</span><span begin="03:32.554" end="03:33.974">過ごして</span><span begin="03:33.974" end="03:35.006">います</span><span begin="03:35.006" end="03:36.389">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你在哪里过着你的人生呢</span></p><p begin="03:35.578" end="03:42.409" ttm:agent="v3" itunes:key="L45"><span begin="03:35.578" end="03:38.348">あなたはあなたで</span><span begin="03:38.348" end="03:39.733">いられて</span><span begin="03:39.733" end="03:40.635">います</span><span begin="03:40.635" end="03:42.409">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你是否还是当初的那个你</span></p><p begin="03:41.142" end="03:47.302" ttm:agent="v1" itunes:key="L46"><span begin="03:41.142" end="03:43.993">君は君らしく</span><span begin="03:43.993" end="03:46.276">いられています</span><span begin="03:46.276" end="03:47.302">か？</span><span ttm:role="x-translation" xml:lang="zh-Hans">现在你是否仍然坚持做你自己</span></p><p begin="03:46.747" end="03:49.916" ttm:agent="v3" itunes:key="L47"><span begin="03:46.747" end="03:47.427">私は</span> <span begin="03:47.427" end="03:48.144">あなたを</span><span begin="03:48.144" end="03:49.030">辿って</span><span begin="03:49.030" end="03:49.916">いました</span><span ttm:role="x-translation" xml:lang="zh-Hans">我仍追溯着你往昔的幻影</span></p><p begin="03:50.126" end="03:52.216" ttm:agent="v3" itunes:key="L48"><span begin="03:50.126" end="03:51.171">行き止まりの</span><span begin="03:51.171" end="03:52.216">毎日に</span><span ttm:role="x-translation" xml:lang="zh-Hans">迷失在裹足不前的每一天</span></p><p begin="03:52.225" end="03:57.877" ttm:agent="v3" itunes:key="L49"><span begin="03:52.225" end="03:54.476">迷い込んだまま</span> <span begin="03:54.664" end="03:55.280">前に</span><span begin="03:55.280" end="03:56.652">進めず</span><span begin="03:56.652" end="03:57.877">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">未能向前迈进一步</span></p><p begin="03:58.102" end="04:01.345" ttm:agent="v1" itunes:key="L50"><span begin="03:58.102" end="03:58.691">俺も</span> <span begin="03:58.691" end="03:59.576">君のこと</span><span begin="03:59.576" end="04:00.461">想って</span><span begin="04:00.461" end="04:01.345">いました</span><span ttm:role="x-translation" xml:lang="zh-Hans">我也仍然思念着你</span></p><p begin="04:01.720" end="04:05.062" ttm:agent="v1" itunes:key="L51"><span begin="04:01.720" end="04:02.425">今夜も</span> <span begin="04:02.425" end="04:03.845">あの頃のまま</span><span begin="04:03.845" end="04:05.062">の二人</span><span ttm:role="x-translation" xml:lang="zh-Hans">那时候的我们</span></p><p begin="04:05.071" end="04:06.855" ttm:agent="v2" itunes:key="L52"><span begin="04:05.071" end="04:06.188">一緒にいた</span><span begin="04:06.188" end="04:06.855">時間が</span><span ttm:role="x-translation" xml:lang="zh-Hans">一起共度的时光</span></p><p begin="04:06.865" end="04:12.581" ttm:agent="v2" itunes:key="L53"><span begin="04:06.865" end="04:07.591">何度も</span> <span begin="04:07.591" end="04:08.902">頭の中で</span><span begin="04:08.902" end="04:09.899">繰り返され</span><span begin="04:09.899" end="04:12.581">る</span><span ttm:role="x-translation" xml:lang="zh-Hans">今晚也在脑海中一遍遍闪现</span></p><p begin="04:20.107" end="04:25.986" ttm:agent="v2" itunes:key="L54"><span begin="04:20.107" end="04:21.196">さよな</span><span begin="04:21.196" end="04:22.221">ら</span> <span begin="04:22.360" end="04:23.839">愛しき</span><span begin="04:23.839" end="04:25.986">人よ</span><span ttm:role="x-translation" xml:lang="zh-Hans">再见 我心爱的人啊</span></p><p begin="04:26.204" end="04:29.471" ttm:agent="v2" itunes:key="L55"><span begin="04:26.204" end="04:27.038">もう二度と</span><span begin="04:27.038" end="04:28.056">会えない</span> <span begin="04:28.139" end="04:29.471">もう会わない</span><span ttm:role="x-translation" xml:lang="zh-Hans">已经 再也见不到你</span></p><p begin="04:29.545" end="04:31.862" ttm:agent="v2" itunes:key="L56"><span begin="04:29.545" end="04:29.955">そう</span><span begin="04:29.955" end="04:31.146">決めたの</span><span begin="04:31.146" end="04:31.862">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明决定不再见你</span></p><p begin="04:32.004" end="04:34.704" ttm:agent="v2" itunes:key="L57"><span begin="04:32.004" end="04:33.271">どうして</span> <span begin="04:33.430" end="04:34.704">どうして</span><span ttm:role="x-translation" xml:lang="zh-Hans">可为什么为什么</span></p><p begin="04:34.811" end="04:38.655" ttm:agent="v2" itunes:key="L58"><span begin="04:34.811" end="04:35.494">あなたを</span> <span begin="04:35.494" end="04:36.939">忘れられないん</span><span begin="04:36.939" end="04:38.655">だろう</span><span ttm:role="x-translation" xml:lang="zh-Hans">我还是忘不了你</span></p><p begin="04:38.850" end="04:40.982" ttm:agent="v2" itunes:key="L59"><span begin="04:38.850" end="04:39.653">今日も</span><span begin="04:39.653" end="04:40.982">夜空に</span><span ttm:role="x-translation" xml:lang="zh-Hans">今天也在夜空下 祈祷能与你相见</span></p><p begin="04:40.978" end="04:44.395" ttm:agent="v2" itunes:key="L60"><span begin="04:40.978" end="04:42.357">ネガウ</span> <span begin="04:42.357" end="04:43.172">アイ</span><span begin="04:43.172" end="04:44.395">タイ</span></p></div></body></tt>