ext for="L27"><span begin="03:14.428" end="03:15.095">bokura</span><span begin="03:15.095" end="03:15.629">wa</span><span begin="03:15.629" end="03:16.185">memoa</span><span begin="03:16.185" end="03:16.796">kanu</span><span begin="03:16.796" end="03:17.827">mama</span></text></transliteration></transliterations></iTunesMetadata></metadata></head><body dur="03:20.187"><div begin="00:00.808" end="03:17.827"><p begin="00:00.808" end="00:08.058" ttm:agent="v1" itunes:key="L1"><span begin="00:00.808" end="00:01.600">頬</span><span begin="00:02.533" end="00:04.130">色に</span><span begin="00:04.665" end="00:05.323">茜</span><span begin="00:05.323" end="00:05.812">さ</span><span begin="00:05.812" end="00:06.498">す日は</span><span begin="00:06.498" end="00:08.058">柔らかに</span><span ttm:role="x-translation" xml:lang="zh-Hans">日光温柔地将脸颊染上薄红</span></p><p begin="00:08.058" end="00:15.719" ttm:agent="v1" itunes:key="L2"><span begin="00:08.058" end="00:08.524">爆ぜ</span><span begin="00:08.524" end="00:09.175">た</span><span begin="00:10.161" end="00:10.466">斜</span><span begin="00:10.466" end="00:11.213">陽</span><span begin="00:11.213" end="00:11.862">に</span><span begin="00:12.427" end="00:13.565">僕らは</span><span begin="00:13.565" end="00:14.133">目も</span><span begin="00:14.133" end="00:14.932">開かぬま</span><span begin="00:14.932" end="00:15.719">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">喷薄斜阳</span></p><p begin="00:31.036" end="00:34.352" ttm:agent="v1" itunes:key="L3"><span begin="00:31.036" end="00:32.629">悲しくって</span><span begin="00:32.629" end="00:33.491">しようが</span><span begin="00:33.491" end="00:34.352">ないんだ</span><span ttm:role="x-translation" xml:lang="zh-Hans">内心悲伤叫我茫然无措</span></p><p begin="00:34.488" end="00:37.740" ttm:agent="v1" itunes:key="L4"><span begin="00:34.488" end="00:36.125">お日様で</span><span begin="00:36.125" end="00:36.959">手が</span><span begin="00:36.959" end="00:37.740">濡れた</span><span ttm:role="x-translation" xml:lang="zh-Hans">日光烤得手心发汗</span></p><p begin="00:38.884" end="00:42.098" ttm:agent="v1" itunes:key="L5"><span begin="00:38.884" end="00:40.359">眩しくって</span><span begin="00:40.359" end="00:41.263">仕方が</span><span begin="00:41.263" end="00:42.098">ないし</span><span ttm:role="x-translation" xml:lang="zh-Hans">可我对那份夺目束手无策</span></p><p begin="00:42.247" end="00:45.602" ttm:agent="v1" itunes:key="L6"><span begin="00:42.247" end="00:43.459">途方に</span><span begin="00:43.614" end="00:44.365">暮れた</span><span begin="00:44.621" end="00:45.602">帰り</span><span ttm:role="x-translation" xml:lang="zh-Hans">一筹莫展走在回家路上</span></p><p begin="00:47.288" end="00:58.882" ttm:agent="v1" itunes:key="L7"><span begin="00:47.288" end="00:49.364">落ちて</span><span begin="00:50.698" end="00:51.822">行く</span><span begin="00:51.822" end="00:52.505">よう</span><span begin="00:52.505" end="00:54.607">に</span><span begin="00:56.671" end="00:57.443">茜</span><span begin="00:57.443" end="00:58.882">が差したから</span><span ttm:role="x-translation" xml:lang="zh-Hans">而晚霞铺满天空 随日落西沉</span></p><p begin="00:58.882" end="01:02.295" ttm:agent="v1" itunes:key="L8"><span begin="00:58.882" end="00:59.296">もう</span><span begin="01:00.460" end="01:01.533">少し</span><span begin="01:01.533" end="01:02.295">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明很快</span></p><p begin="01:02.797" end="01:07.295" ttm:agent="v1" itunes:key="L9"><span begin="01:02.797" end="01:03.506">僕は</span><span begin="01:03.506" end="01:04.425">僕を</span><span begin="01:04.425" end="01:05.414">一つは</span><span begin="01:05.414" end="01:06.579">愛せたの</span><span begin="01:06.579" end="01:07.295">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">我便姑且能去爱自己了</span></p><p begin="01:08.281" end="01:13.981" ttm:agent="v1" itunes:key="L10"><span begin="01:08.281" end="01:08.559">斜</span><span begin="01:08.559" end="01:09.349">陽</span><span begin="01:09.349" end="01:09.985">に</span><span begin="01:10.432" end="01:11.718">気付けば</span><span begin="01:11.718" end="01:12.213">目も</span><span begin="01:12.213" end="01:13.115">開かぬま</span><span begin="01:13.115" end="01:13.981">ま</span><span ttm:role="x-translation" xml:lang="zh-Hans">回过神来却在斜阳下胆怯得睁不开眼</span></p><p begin="01:18.206" end="01:21.756" ttm:agent="v1" itunes:key="L11"><span begin="01:18.206" end="01:19.391">静かな</span><span begin="01:19.416" end="01:20.412">夕凪</span><span begin="01:20.412" end="01:20.664">の</span><span begin="01:20.664" end="01:21.756">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">于黄昏风平浪静的海岸</span></p><p begin="01:29.134" end="01:32.450" ttm:agent="v1" itunes:key="L12"><span begin="01:29.134" end="01:30.727">悲しくって</span><span begin="01:30.727" end="01:31.589">しようが</span><span begin="01:31.589" end="01:32.450">ないんだ</span><span ttm:role="x-translation" xml:lang="zh-Hans">内心悲伤叫我茫然无措</span></p><p begin="01:32.527" end="01:35.862" ttm:agent="v1" itunes:key="L13"><span begin="01:32.527" end="01:34.155">お日様に</span><span begin="01:34.155" end="01:34.947">手が</span><span begin="01:34.947" end="01:35.862">触れた</span><span ttm:role="x-translation" xml:lang="zh-Hans">双手碰到了日光</span></p><p begin="01:36.850" end="01:40.183" ttm:agent="v1" itunes:key="L14"><span begin="01:36.850" end="01:37.862">とろとろ</span><span begin="01:38.077" end="01:39.295">と燃えるみ</span><span begin="01:39.295" end="01:39.716">たい</span><span begin="01:39.716" end="01:40.183">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">好似就这样微弱地燃烧了起来</span></p><p begin="01:40.316" end="01:43.866" ttm:agent="v1" itunes:key="L15"><span begin="01:40.316" end="01:41.496">指先</span><span begin="01:41.720" end="01:42.433">ばかり</span><span begin="01:42.656" end="01:43.196">焦げ</span><span begin="01:43.196" end="01:43.866">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">烧焦了指尖</span></p><p begin="01:44.604" end="01:47.956" ttm:agent="v1" itunes:key="L16"><span begin="01:44.604" end="01:45.046">高</span><span begin="01:45.046" end="01:45.325">く</span><span begin="01:45.325" end="01:46.092">成った</span><span begin="01:46.092" end="01:46.762">葡萄</span><span begin="01:46.762" end="01:47.038">み</span><span begin="01:47.038" end="01:47.492">たい</span><span begin="01:47.492" end="01:47.956">だ</span><span ttm:role="x-translation" xml:lang="zh-Hans">你就好似那结在高处的葡萄</span></p><p begin="01:47.998" end="01:51.447" ttm:agent="v1" itunes:key="L17"><span begin="01:47.998" end="01:48.734">届</span><span begin="01:48.734" end="01:49.477">かな</span><span begin="01:49.477" end="01:50.234">いから</span><span begin="01:50.412" end="01:51.447">やめて</span><span ttm:role="x-translation" xml:lang="zh-Hans">因为触不可及所以只好放弃</span></p><p begin="01:52.354" end="01:55.653" ttm:agent="v1" itunes:key="L18"><span begin="01:52.354" end="01:52.799">僕</span><span begin="01:52.799" end="01:53.854">は恋を</span><span begin="01:53.854" end="01:54.518">したん</span><span begin="01:54.518" end="01:55.211">だろう</span><span begin="01:55.211" end="01:55.653">か</span><span ttm:role="x-translation" xml:lang="zh-Hans">我是否已经坠入了爱河呢</span></p><p begin="01:55.773" end="01:59.431" ttm:agent="v1" itunes:key="L19"><span begin="01:55.773" end="01:56.322">あ</span><span begin="01:56.322" end="01:56.691">のお</span><span begin="01:56.691" end="01:57.698">日様</span><span begin="01:57.698" end="01:57.927">の</span><span begin="01:58.167" end="01:58.749">よう</span><span begin="01:58.749" end="01:59.431">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">就像那轮太阳一样</span></p><p begin="02:00.850" end="02:15.264" ttm:agent="v1" itunes:key="L20"><span begin="02:00.850" end="02:02.903">落ちて</span><span begin="02:04.082" end="02:05.396">いく</span><span begin="02:05.396" end="02:06.086">の</span><span begin="02:06.086" end="02:08.146">に</span><span begin="02:10.255" end="02:11.144">理由も</span><span begin="02:11.144" end="02:12.411">ないのなら</span><span begin="02:12.411" end="02:13.225">も</span><span begin="02:13.225" end="02:15.264">う</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明在西沉</span></p><p begin="02:27.917" end="02:35.167" ttm:agent="v1" itunes:key="L21"><span begin="02:27.917" end="02:28.709">頬</span><span begin="02:29.642" end="02:31.239">色に</span><span begin="02:31.774" end="02:32.432">茜</span><span begin="02:32.432" end="02:32.921">さ</span><span begin="02:32.921" end="02:33.607">す日は</span><span begin="02:33.607" end="02:35.167">柔らかに</span><span ttm:role="x-translation" xml:lang="zh-Hans">日光温柔地将脸颊染上薄红</span></p><p begin="02:35.195" end="02:47.293" ttm:agent="v1" itunes:key="L22"><span begin="02:35.195" end="02:35.719">爆ぜ</span><span begin="02:35.719" end="02:36.388">た</span><span begin="02:37.217" end="02:38.248">斜陽</span><span begin="02:38.248" end="02:40.941">も</span><span begin="02:43.299" end="02:44.611">僕らの</span><span begin="02:44.611" end="02:45.812">道をただ</span><span begin="02:45.812" end="02:46.573">照らす</span><span begin="02:46.573" end="02:47.293">のなら</span><span ttm:role="x-translation" xml:lang="zh-Hans">若喷薄的斜阳</span></p><p begin="02:47.293" end="02:50.706" ttm:agent="v1" itunes:key="L23"><span begin="02:47.293" end="02:47.707">もう</span><span begin="02:48.871" end="02:49.944">少し</span><span begin="02:49.944" end="02:50.706">で</span><span ttm:role="x-translation" xml:lang="zh-Hans">明明很快</span></p><p begin="02:51.146" end="02:55.967" ttm:agent="v1" itunes:key="L24"><span begin="02:51.146" end="02:51.839">僕は</span><span begin="02:51.839" end="02:52.833">僕を</span><span begin="02:52.833" end="02:53.834">一つは</span><span begin="02:53.834" end="02:55.003">愛せるの</span><span begin="02:55.003" end="02:55.967">に</span><span ttm:role="x-translation" xml:lang="zh-Hans">我便姑且能去爱自己了</span></p><p begin="02:56.614" end="03:02.265" ttm:agent="v1" itunes:key="L25"><span begin="02:56.614" end="02:56.948">斜</span><span begin="02:56.948" end="02:57.675">陽</span><span begin="02:57.675" end="02:58.440">に</span><span begin="02:58.814" end="02:59.598">はにか</span><span begin="02:59.598" end="03:00.194">む</span><span begin="03:00.194" end="03:00.801">貴方</span><span begin="03:00.801" end="03:01.533">が見え</span><span begin="03:01.533" end="03:02.265">た</span><span ttm:role="x-translation" xml:lang="zh-Hans">我却看见了斜阳下面含羞怯的你</span></p><p begin="03:06.583" end="03:10.133" ttm:agent="v1" itunes:key="L26"><span begin="03:06.583" end="03:07.768">静かな</span><span begin="03:07.793" end="03:08.789">夕凪</span><span begin="03:08.789" end="03:09.041">の</span><span begin="03:09.041" end="03:10.133">中</span><span ttm:role="x-translation" xml:lang="zh-Hans">于黄昏风平浪静的海岸</span></p><p begin="03:14.428" end="03:17.827" ttm:agent="v1" itunes:key="L27"><span begin="03:14.428" end="03:15.095">僕ら</span><span begin="03:15.095" end="03:15.629">は</span><span begin="03:15.629" end="03:16.185">目も</span><span begin="03:16.185" end="03:16.796">開かぬ</span><span begin="03:16.796" end="03:17.827">まま</span><span ttm:role="x-translation" xml:lang="zh-Hans">我们连眼睛也不敢睁开</span></p></div></body></tt>