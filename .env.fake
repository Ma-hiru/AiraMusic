# 假宿主：在没有 Electron / Tauri 的情况下用浏览器验证 UI 与 IPC 契约
# 用法：yarn workspace @mahiru/ui dev --mode fake
#
# mode=fake 不会加载 .env.development，因此这里必须自带开发期变量，
# 否则端口会退回 Vite 默认的 5173，且 APP_MODE 缺失会影响渲染层判断。
APP_HOST=fake
APP_MODE=development
APP_TEST=false
APP_DEBUG_PORT=9229
APP_DEVTOOLS_REMOTE_PORT=9222
NCM_SERVER_PORT=8824
GO_SERVER_PORT=8825
EXPRESS_SERVER_PORT=8826
VITE_SERVER_PORT=8827
UI_LOG_LEVEL=TRACE
APP_LOG_LEVEL=TRACE
